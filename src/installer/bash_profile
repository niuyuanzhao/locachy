# root's login on the live medium. On tty1 (the screen, logged in by
# itself): the full-screen installer, then the console as it was, however
# the installer ended. Elsewhere (the serial console): a shell, as before.
[ -f ~/.bashrc ] && . ~/.bashrc
if [ "$(tty)" = /dev/tty1 ]; then
    # The interface is built from the fetched source too, not frozen to the ISO.
    # A failed refresh never starts an old interface pretending to be current.
    /usr/local/bin/locachy-install --ui
    /usr/local/bin/installer --text
fi
