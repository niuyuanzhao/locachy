#!/bin/bash
# The live entry: locachy-install of the newest LOCachy source, as the packages
# come from their mirrors. The source is fetched (git, shallow) from the update
# repository and branch given (--update-repo, --update-branch), else those the
# medium's own source came from (--resume, --trust-key: those of the
# installation they continue). A call that may install fetches it again; --describe-json,
# --check, --trust-key and --help use what was fetched, or fetch it the
# first time. When it cannot be fetched, what was fetched before from there
# runs, else the medium's own source (also with updates off). LOCACHY_SOURCE
# tells locachy-install which, and why: fetched, fetched earlier (not fetched
# again), fetched before: WHY, bundled: WHY.
set -uo pipefail
bundled=${LOCACHY_SOURCE_BUNDLED:-/usr/local/src/locachy}
fetched=${LOCACHY_SOURCE_FETCHED:-/run/locachy-source}
origin=${LOCACHY_SOURCE_ORIGIN:-/etc/locachy/source-origin.json}
record=${LOCACHY_RESUME_RECORD:-/run/locachy-install/resume.json}
export GIT_ALLOW_PROTOCOL=${GIT_ALLOW_PROTOCOL:-https:ssh} GIT_TERMINAL_PROMPT=0

repo= branch= again=1 prev= continued=0
for a in "$@"; do
    case $prev in
    --update-repo) repo=$a ;;
    --update-branch) branch=$a ;;
    esac
    case $a in
    --update-repo=*) repo=${a#*=} ;;
    --update-branch=*) branch=${a#*=} ;;
    --describe-json | --check | --help | -h) again=0 ;;
    --trust-key) again=0 continued=1 ;;
    --resume) continued=1 ;;
    esac
    prev=$a
done
if [ -z "$repo" ] || [ -z "$branch" ]; then
    [ "$continued" = 1 ] || record=
    read -r o_repo o_branch < <(python3 -I -c 'import json, sys
def read(path, repo, branch):
    try:
        o = json.load(open(path, encoding="utf-8"))
        return o.get(repo) or "", o.get(branch) or ""
    except (OSError, ValueError, AttributeError):
        return "", ""
r_repo, r_branch = read(sys.argv[2], "update_repo", "update_branch") if sys.argv[2] else ("", "")
o_repo, o_branch = read(sys.argv[1], "repo", "branch")
print(r_repo or o_repo or "-", r_branch or o_branch or "main")' "$origin" "$record")
    [ -n "$repo" ] || repo=$o_repo
    [ -n "$branch" ] || branch=$o_branch
fi

why= now=0
if [ "$repo" = off ]; then
    why="updates are off"
elif ! [[ $repo =~ ^(https://|ssh://|git@)[^[:space:]]+$ ]] || ! [[ $branch =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]]; then
    why="no repository to fetch from ($repo, $branch)"
elif [ "$again" = 1 ] || [ "$(cat "$fetched.from" 2>/dev/null)" != "$repo $branch" ] ||
     [ ! -f "$fetched/src/link/locachy-install" ]; then
    echo "Fetching the newest LOCachy source: $repo ($branch)" >&2
    rm -rf "$fetched.new"
    err=$(timeout 300 git clone -q --depth=1 --single-branch --branch="$branch" -- "$repo" "$fetched.new" 2>&1)
    rc=$?
    if [ "$rc" = 0 ] && [ -f "$fetched.new/src/link/locachy-install" ]; then
        rm -rf "$fetched"
        mv "$fetched.new" "$fetched"
        printf '%s\n' "$repo $branch" >"$fetched.from"
        now=1
    else
        rm -rf "$fetched.new"
        if [ "$rc" = 124 ]; then
            err="no answer in 300 s"
        elif [ "$rc" = 0 ]; then
            err="no LOCachy source there"
        fi
        err=${err:-git failed ($rc)}
        why="could not fetch $repo ($branch): ${err##*$'\n'}"
    fi
fi

if [ -z "$why" ]; then
    if [ "$now" = 1 ]; then export LOCACHY_SOURCE=fetched; else export LOCACHY_SOURCE="fetched earlier"; fi
    exec python3 -I "$fetched/src/link/locachy-install" "$@"
fi
if [ "$(cat "$fetched.from" 2>/dev/null)" = "$repo $branch" ] && [ -f "$fetched/src/link/locachy-install" ]; then
    export LOCACHY_SOURCE="fetched before: $why"
    exec python3 -I "$fetched/src/link/locachy-install" "$@"
fi
export LOCACHY_SOURCE="bundled: $why"
exec python3 -I "$bundled/link/locachy-install" "$@"
