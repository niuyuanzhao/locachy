msgstr "复制链接地址"

#: progs/view.c
msgid "Copy Text"
msgstr "复制文本"

#: progs/view.c
msgid "Close a document tab before opening another."
msgstr "请先关闭一个文档标签页再打开新文档。"

#: progs/view.c
msgid "Choose a document to open."
msgstr "选择要打开的文档。"

#: progs/view.c
msgid "Clear List"
msgstr "清空列表"

#. TRANSLATORS: %.200s is the folder path; %s is the system error message.
#: progs/view.c
#, c-format
msgid "Cannot open the folder %.200s: %s."
msgstr "无法打开文件夹 %.200s：%s。"

#. TRANSLATORS: %.200s is the folder path.
#: progs/view.c
#, c-format
msgid "%.200s shown in the file manager."
msgstr "已在文件管理器中显示 %.200s。"

#. TRANSLATORS: follows the current page number in the presentation bar; %d is the total page count.
#: progs/view.c
#, c-format
msgid "of %d"
msgstr "/ %d"

#: progs/view.c
msgid "Pause"
msgstr "暂停"

#: progs/view.c
msgid "Play"
msgstr "播放"

#: progs/view.c
msgid "Exit Presentation Mode"
msgstr "退出演示模式"

#. TRANSLATORS: %d is the total page count.
#: progs/view.c
#, c-format
msgid "Go to page (1 to %d):"
msgstr "转到页（1 至 %d）："

#: progs/view.c
msgid "Change Dark & Light Colors"
msgstr "更改深浅颜色"

#: progs/view.c
msgid "Change Paper Color"
msgstr "更改纸张颜色"

#: progs/view.c
msgid "Convert to Black & White"
msgstr "转换为黑白"

#: progs/view.c
msgid "Invert Lightness"
msgstr "反转明度"

#: progs/view.c
msgid "Invert Luma (sRGB Linear)"
msgstr "反转亮度 (sRGB 线性)"

#: progs/view.c
msgid "Invert Luma (Symmetric)"
msgstr "反转亮度 (对称)"

#: progs/view.c
msgid "Shift Hue Negative"
msgstr "负向偏移色相"

#: progs/view.c
msgid "Shift Hue Positive"
msgstr "正向偏移色相"

#: progs/view.c
#, c-format
msgid "Paper Color: #%06X"
msgstr "纸张颜色：#%06X"

#: progs/view.c
#, c-format
msgid "Dark Color: #%06X"
msgstr "深色：#%06X"

#: progs/view.c
#, c-format
msgid "Light Color: #%06X"
msgstr "浅色：#%06X"

#: progs/view.c
#, c-format
msgid "Threshold: %d"
msgstr "阈值：%d"

#: progs/view.c
#, c-format
msgid "Contrast: %d"
msgstr "对比度：%d"

#: progs/view.c
msgid "Dark color (#RRGGBB):"
msgstr "深色 (#RRGGBB)："

#: progs/view.c
msgid "Light color (#RRGGBB):"
msgstr "浅色 (#RRGGBB)："

#: progs/view.c
msgid "Paper color (#RRGGBB):"
msgstr "纸张颜色 (#RRGGBB)："

#: progs/view.c
msgid "Contrast (2 to 6):"
msgstr "对比度（2 至 6）："

#: progs/view.c
msgid "Threshold (2 to 253):"
msgstr "阈值（2 至 253）："

#. TRANSLATORS: %.100s is the invalid value typed by the user.
#: progs/view.c
#, c-format
msgid "%.100s is not a colour (#RRGGBB)."
msgstr "%.100s 不是有效的颜色 (#RRGGBB)。"

#: progs/view.c
#, c-format
msgid "%.100s is not a value in the range."
msgstr "%.100s 不在有效范围内。"

#: progs/view.c
msgid "Normal Colors"
msgstr "正常颜色"

#: progs/view.c
msgid "Configure Color Modes..."
msgstr "配置颜色模式..."

#: progs/view.c
msgid "Bookmark name:"
msgstr "书签名称："

#: progs/view.c
msgid "Draw a rectangle on the page to trim to selection. Escape cancels."
msgstr "在页面上拖动框选裁剪区域。按 Esc 取消。"

#: progs/view.c
msgid "Remove Bookmark"
msgstr "移除书签"

#: progs/view.c
msgid "Rename Bookmark"
msgstr "重命名书签"

#. TRANSLATORS: the two %d values are the image width and height in pixels.
#: progs/view.c
#, c-format
msgid "Image [%d x %d] saved to PNG file."
msgstr "图像 [%d x %d] 已保存为 PNG 文件。"

#. TRANSLATORS: %.200s is the file path; %s is the system error message.
#: progs/view.c
#, c-format
msgid "File not saved: %.200s: %s."
msgstr "文件未保存：%.200s：%s。"

#. TRANSLATORS: %.200s is the invalid file name typed by the user.
#: progs/view.c
#, c-format
msgid "File not saved: %.200s cannot be a file's name here."
msgstr "文件未保存：%.200s 不能作为此处的文件名。"

#: progs/view.c
#, c-format
msgid "Text (1 character)"
msgid_plural "Text (%d characters)"
msgstr[0] "文本（%d 个字符）"

#: progs/view.c
msgid "Copy to Clipboard"
msgstr "复制到剪贴板"

#: progs/view.c
msgid "Copy Text (Without line breaks)"
msgstr "复制文本（不含换行）"

#. TRANSLATORS: %s is the selected text preview.
#: progs/view.c
#, c-format
msgid "Search for '%s...' in this document"
msgstr "在此文档中查找“%s...”"

#: progs/view.c
#, c-format
msgid "Search for '%s' in this document"
msgstr "在此文档中查找“%s”"

#. TRANSLATORS: the two %d values are the image width and height in pixels.
#: progs/view.c
#, c-format
msgid "Image (%d x %d pixels)"
msgstr "图像（%d x %d 像素）"

#: progs/view.c
msgid "Save to File..."
msgstr "保存到文件..."

#. TRANSLATORS: the two %d values are the image width and height in pixels.
#: progs/view.c
#, c-format
msgid "The clipboard takes text only: the image [%d x %d] was not copied."
msgstr "剪贴板仅支持文本：未复制图像 [%d x %d]。"

#. TRANSLATORS: o is the key in the file manager; keep it.
#: progs/view.c
msgid "Choose the folder to save the image into (o on it)."
msgstr "选择要保存图像的目标文件夹（在其上按 o）。"

#: progs/view.c
msgid "File not saved."
msgstr "文件未保存。"

#: progs/view.c
msgid "Save the image as:"
msgstr "将图像另存为："

#: progs/view.c
msgid "Copy Table Contents to Clipboard"
msgstr "复制表格内容到剪贴板"

#: progs/view.c
msgid "Select text"
msgstr "选择文本"

#: progs/view.c
msgid "Select zooming area. Right-click to zoom out."
msgstr "框选缩放区域。右键点击缩小。"

#: progs/view.c
msgid "Draw a rectangle around the text/graphics to copy."
msgstr "框选要复制的文本或图形。"

#. TRANSLATORS: Esc is the Escape key; keep it.
#: progs/view.c
msgid ""
"Draw a rectangle around the table, then click near edges to divide up; press "
"Esc to clear."
msgstr "框选表格区域，再点击边缘附近划分行列；按 Esc 清除。"

#: progs/view.c
msgid "Click to see the magnified view."
msgstr "点击查看放大视图。"

