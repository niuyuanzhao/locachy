+static double
+circular_scroll_sum_axis(struct libinput *li, enum libinput_pointer_axis axis)
+{
+	struct libinput_event *event;
+	double sum = 0;
+
+	litest_dispatch(li);
+	while ((event = libinput_get_event(li))) {
+		if (libinput_event_get_type(event) == LIBINPUT_EVENT_POINTER_SCROLL_FINGER) {
+			struct libinput_event_pointer *pointer = libinput_event_get_pointer_event(event);
+			if (libinput_event_pointer_has_axis(pointer, axis))
+				sum += libinput_event_pointer_get_scroll_value(pointer, axis);
+		}
+		libinput_event_destroy(event);
+	}
+	return sum;
+}
+
+START_TEST(touchpad_circular_scroll_multifinger)
+{
+	struct litest_device *dev = litest_current_device();
+	struct libinput *li = dev->libinput;
+
+	litest_enable_circular_scroll(dev);
+	for (int direction = 0; direction < 4; direction++) {
+		bool horizontal = direction < 2;
+		double distance = direction % 2 ? -20 : 20;
+		litest_drain_events(li);
+		/* The first contact is on the ring but the second arrives
+		 * before its dwell expires. Both belong to normal scrolling. */
+		double x1 = horizontal && distance > 0 ? 10 : 90;
+		double x2 = horizontal && distance > 0 ? 25 : 75;
+		litest_touch_down(dev, 0, x1, 50);
+		litest_touch_down(dev, 1, x2, 50);
+		litest_touch_move_two_touches(dev, x1, 50, x2, 50,
+				horizontal ? distance : 0,
+				horizontal ? 0 : distance, 20);
+		litest_touch_up(dev, 0);
+		litest_touch_up(dev, 1);
+		double sum = circular_scroll_sum_axis(li, horizontal ?
+			LIBINPUT_POINTER_AXIS_SCROLL_HORIZONTAL :
+			LIBINPUT_POINTER_AXIS_SCROLL_VERTICAL);
+		litest_assert_double_gt(sum * distance, 0);
+	}
+}
+END_TEST
