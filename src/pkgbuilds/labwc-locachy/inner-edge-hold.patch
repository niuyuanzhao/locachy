diff -ruN a/src/input/cursor.c b/src/input/cursor.c
--- a/src/input/cursor.c	2026-08-22 01:24:33.000000000 +0800
+++ b/src/input/cursor.c	2026-10-30 10:50:09.722085974 +0800
