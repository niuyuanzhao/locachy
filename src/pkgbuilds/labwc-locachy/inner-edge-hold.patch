+/* Window-edge resistance does not hold the pointer at the snap trigger.
+ * While moving a window, pause at a shared output edge long enough to use
+ * its snap preview. Continued motion after the hold crosses normally; a
+ * retreat cancels immediately. Ordinary pointer motion is never held. */
+static void
+inner_edge_hold(struct seat *seat, double *dx, double *dy)
+{
+	if (server.input_mode != LAB_INPUT_STATE_MOVE || !server.grabbed_view
+			|| !view_is_floating(server.grabbed_view)
+			|| rc.snap_inner_edge_hold <= 0 || rc.snap_edge_range_inner <= 0) {
+		seat->inner_edge_hold.active = false;
+		return;
+	}
+
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	int64_t msec = (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+	double x = seat->cursor->x, y = seat->cursor->y;
+	if (seat->inner_edge_hold.active) {
+		double delta = seat->inner_edge_hold.horizontal ? *dx : *dy;
+		double along = seat->inner_edge_hold.horizontal ? y + *dy : x + *dx;
+		if (delta * seat->inner_edge_hold.direction < 0
+				|| along < seat->inner_edge_hold.lo
+				|| along >= seat->inner_edge_hold.hi) {
+			seat->inner_edge_hold.active = false;
+		} else {
+			if (msec >= seat->inner_edge_hold.until_msec) {
+				double position = seat->inner_edge_hold.horizontal ? x : y;
+				/* Do not start another hold if this event is only vertical,
+				 * or a sub-pixel step has not crossed the boundary yet. */
+				if ((position - seat->inner_edge_hold.position)
+						* seat->inner_edge_hold.direction > 0) {
+					seat->inner_edge_hold.active = false;
+				}
+				return;
+			}
+			if (seat->inner_edge_hold.horizontal) {
+				*dx = seat->inner_edge_hold.position - x;
+			} else {
+				*dy = seat->inner_edge_hold.position - y;
+			}
+			return;
+		}
+	}
+
+	struct output *output = output_nearest_to(x, y);
+	if (!output_is_usable(output)) {
+		return;
+	}
+	struct wlr_box box;
+	wlr_output_layout_get_box(server.output_layout, output->wlr_output, &box);
+	double target_x = x + *dx, target_y = y + *dy;
+	enum wlr_direction directions[] = {
+		WLR_DIRECTION_LEFT, WLR_DIRECTION_RIGHT,
+		WLR_DIRECTION_UP, WLR_DIRECTION_DOWN,
+	};
+	for (size_t i = 0; i < ARRAY_SIZE(directions); ++i) {
+		bool horizontal = i < 2;
+		int direction = (i == 0 || i == 2) ? -1 : 1;
+		double edge = horizontal ? box.x + (direction > 0 ? box.width : 0)
+			: box.y + (direction > 0 ? box.height : 0);
+		double current = horizontal ? x : y;
+		double target = horizontal ? target_x : target_y;
+		if ((target - edge) * direction < 0 || (current - edge) * direction > 0
+				|| (horizontal ? *dx : *dy) * direction <= 0) {
+			continue;
+		}
+		/* Test the motion segment where it crosses this edge, not its
+		 * endpoint, which may already be past an offset neighbor. */
+		double fraction = (edge - current) / (target - current);
+		double along = horizontal ? y + *dy * fraction : x + *dx * fraction;
+		struct wlr_output *next = wlr_output_layout_adjacent_output(
+			server.output_layout, directions[i], output->wlr_output, x, y);
+		if (!next) {
+			continue; /* The layout already constrains exterior edges. */
+		}
+		struct wlr_box neighbor;
+		wlr_output_layout_get_box(server.output_layout, next, &neighbor);
+		double near = horizontal ? neighbor.x + (direction < 0 ? neighbor.width : 0)
+			: neighbor.y + (direction < 0 ? neighbor.height : 0);
+		double lo = MAX(horizontal ? box.y : box.x,
+			horizontal ? neighbor.y : neighbor.x);
+		double hi = MIN(horizontal ? box.y + box.height : box.x + box.width,
+			horizontal ? neighbor.y + neighbor.height : neighbor.x + neighbor.width);
+		if (near != edge || along < lo || along >= hi) {
+			continue; /* Not a shared edge at this point (offset outputs or a gap). */
+		}
+
+		seat->inner_edge_hold.active = true;
+		seat->inner_edge_hold.horizontal = horizontal;
+		seat->inner_edge_hold.direction = direction;
+		seat->inner_edge_hold.position = edge - (direction > 0 ? 1 : 0);
+		seat->inner_edge_hold.lo = lo;
+		seat->inner_edge_hold.hi = hi;
+		seat->inner_edge_hold.until_msec = msec + rc.snap_inner_edge_hold;
+		if (horizontal) {
+			*dx = seat->inner_edge_hold.position - x;
+			*dy *= fraction;
+		} else {
+			*dy = seat->inner_edge_hold.position - y;
+			*dx *= fraction;
+		}
+		return;
+	}
+}
