# Add only our entries to the machine scripts policy and bump the machine half of GPT's version.
function Get-IniSection([string]$path, [string]$section) {
    $lines = if (Test-Path -LiteralPath $path) { @(Get-Content -LiteralPath $path) }
    $before = New-Object 'System.Collections.Generic.List[string]'
    $after = New-Object 'System.Collections.Generic.List[string]'
    $body = New-Object 'System.Collections.Generic.List[string]'
    $part = $before
    $found = $false
    foreach ($line in $lines) {
        if ($line -match '^\s*\[([^\]]+)\]\s*$') {
            if ($Matches[1].Trim() -eq $section) {
                if ($found) { throw "Duplicate [$section] section in $path" }
                $found = $true
                $part = $body
                continue
            }
            if ($found) { $part = $after }
        }
        $part.Add($line)
    }
    return @{ Before = $before; Body = $body; After = $after }
}

function Write-IniSection($path, $section, $ini, $encoding) {
    $lines = @($ini.Before.ToArray()) + "[$section]" + @($ini.Body.ToArray()) + @($ini.After.ToArray())
