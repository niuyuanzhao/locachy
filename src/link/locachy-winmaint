def detect_root_layout(*, allow_lsblk_fallback=False, mountpoint="/"):
    """Inspect the root filesystem mounted at mountpoint (this system's by default; create
    --root's target), its LUKS2 status, and the underlying disk/partition."""
    fm = json.loads(run_cmd(["findmnt", "--json", "--mountpoint", str(mountpoint), "--output",
                             "SOURCE,FSTYPE"]).stdout)
    root_fs_dev = os.path.realpath(fm["filesystems"][0]["source"])
    is_luks = False
    phys_part = root_fs_dev
    luks_payload_offset = 32768

    blk = json.loads(run_cmd(["lsblk", "--json", "--tree", "--paths", "--inverse", "--output",
                              "PATH,TYPE,PKNAME,PARTN,PARTUUID,PTTYPE", root_fs_dev]).stdout)
    node = blk["blockdevices"][0]
    if node.get("type") == "crypt":
        is_luks = True
        children = node.get("children") or []
        if not children:
            raise RuntimeError(f"Cannot resolve underlying partition for LUKS device {root_fs_dev}")
        phys_part = children[0]["path"]
        if not allow_lsblk_fallback:
            dump = run_cmd(["cryptsetup", "luksDump", phys_part]).stdout
            m = re.search(r"offset:\s*(\d+)\s*\[bytes\]", dump)
            if m:
                luks_payload_offset = int(m.group(1)) // SECTOR_SIZE
        else:
            r_dump = run_cmd(["cryptsetup", "luksDump", phys_part], check=False)
            if r_dump.returncode == 0:
                m = re.search(r"offset:\s*(\d+)\s*\[bytes\]", r_dump.stdout)
                if m:
                    luks_payload_offset = int(m.group(1)) // SECTOR_SIZE

    props_by = "blkid,udev" if allow_lsblk_fallback else "blkid"
    part_info = json.loads(run_cmd(["lsblk", "--json", "--nodeps", "--paths", "--properties-by", props_by,
                                    "--output", "PATH,TYPE,PKNAME,PARTN,PARTUUID,PTTYPE", phys_part]).stdout)
    p = part_info["blockdevices"][0]
    if p.get("type") != "part" or p.get("pttype") != "gpt":
        raise RuntimeError(f"Root device {phys_part} is not a GPT partition")
    disk = p["pkname"]
    partn = int(p["partn"])
    partuuid = str(uuid.UUID(p["partuuid"])).lower()

    gpt = _parse_gpt_readonly(disk) if allow_lsblk_fallback else parse_gpt_disk(disk)
    cur_part = next((x for x in gpt["partitions"] if x["partn"] == partn), None)
    if not cur_part:
        raise RuntimeError(f"Root partition {partn} not found in GPT of {disk}")

    return {
        "root_fs_dev": root_fs_dev,
        "phys_part": phys_part,
        "disk": disk,
        "partn": partn,
        "part_uuid": partuuid,
        "is_luks": is_luks,
        "luks_payload_offset_sectors": luks_payload_offset,
        "part_start_lba": cur_part["start_lba"],
        "part_end_lba": cur_part["end_lba"],
        "part_sectors": cur_part["sectors"],
        "gpt": gpt,
    }


def measure_ext4_usage(dev):
    """Return (total_bytes, used_bytes, min_bytes) for an ext4 device."""
    dump = run_cmd(["dumpe2fs", "-h", dev]).stdout
    def grab(pattern):
        m = re.search(pattern, dump)
        if not m:
            raise RuntimeError(f"dumpe2fs missing {pattern} on {dev}")
        return int(m.group(1))

    block_size = grab(r"Block size:\s*(\d+)")
    block_count = grab(r"Block count:\s*(\d+)")
    free_blocks = grab(r"Free blocks:\s*(\d+)")
    total_bytes = block_count * block_size
    used_bytes = max(0, (block_count - free_blocks) * block_size)

    r = run_cmd(["resize2fs", "-P", dev], check=False)
    min_bytes = used_bytes
    m = re.search(r"Estimated minimum size of the filesystem:\s*(\d+)", r.stdout + "\n" + r.stderr)
    if m:
        min_bytes = int(m.group(1)) * block_size
    return total_bytes, used_bytes, min_bytes


def free_tail_sectors(gpt):
    """Contiguous unallocated sectors after the last partition up to last_lba."""
    if not gpt["partitions"]:
        start = max(ALIGN_SECTORS, gpt["first_lba"])
    else:
        last_end = max(p["end_lba"] for p in gpt["partitions"])
        start = ((last_end + ALIGN_SECTORS) // ALIGN_SECTORS) * ALIGN_SECTORS
    if start > gpt["last_lba"]:
        return 0, start
    return gpt["last_lba"] - start + 1, start


def live_medium_disks():
    """Whole disks the live medium was started from (archiso's boot mount): never a target."""
    disks = set()
    try:
        src = run_cmd(["findmnt", "--noheadings", "--output", "SOURCE",
                       "--mountpoint", "/run/archiso/bootmnt"], check=False).stdout.strip()
        if src.startswith("/dev/"):
            data = json.loads(run_cmd(["lsblk", "--json", "--nodeps", "--paths", "--output", "PATH,TYPE,PKNAME",
                                       src], check=False).stdout or "{}")
            for dev in data.get("blockdevices") or []:
                if dev.get("type") == "part" and dev.get("pkname"):
                    disks.add(dev["pkname"])
                elif dev.get("path"):
                    disks.add(dev["path"])
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return disks


def candidate_disks(root_disk=None):
    """Whole GPT disks that may host Maintenance Windows: not the live medium, readable GPT only."""
    live = {os.path.realpath(d) for d in live_medium_disks()}
    root_real = os.path.realpath(root_disk) if root_disk else None
    lsblk_cache = {}
    out = []
    for dev in _whole_disks():
        path = dev["path"]
        if os.path.realpath(path) in live:
            continue
        try:
            gpt = _parse_gpt_readonly(path, lsblk_cache=lsblk_cache)
            has_triplet = find_winmaint_triplet(gpt) is not None
        except (OSError, RuntimeError, ValueError, struct.error):
            continue
        avail, _ = free_tail_sectors(gpt)
        out.append({
            "path": path,
            "model": dev["model"],
            "serial": dev.get("serial", ""),
            "size_bytes": dev["size_bytes"],
            "is_root": root_real is not None and os.path.realpath(path) == root_real,
            "free_tail_gib": round(avail * SECTOR_SIZE / (1024 ** 3), 2),
            "disk_guid": gpt["disk_guid"],
            "has_maintenance_windows": has_triplet,
        })
    return out


# ---------------------------------------------------------------------------
# Online GPT creation, formatting, sanitization, and online reclaim
# ---------------------------------------------------------------------------

def append_tail_triplet_sfdisk(disk_path, win_c_gib, win_esp_mib=WIN_ESP_MIB,
                               win_msr_mib=WIN_MSR_MIB, is_image=False):
    """Create the 3 tail partitions in unallocated tail space via sfdisk."""
    gpt = parse_gpt_disk(disk_path)
    if find_winmaint_triplet(gpt):
        raise RuntimeError(f"{disk_path}: Maintenance Windows partitions already exist")
    win_c_mib = int(win_c_gib) * 1024
    need_sectors = (int(win_esp_mib) + int(win_msr_mib) + win_c_mib) * 2048
    avail, _ = free_tail_sectors(gpt)
    if avail < need_sectors:
        raise RuntimeError(
            f"{disk_path}: need {need_sectors // 2048} MiB free tail space, only {avail // 2048} MiB available"
        )
    script = (
        f"size={int(win_esp_mib)}M,type={GPT_TYPE_ESP.upper()},name={LABEL_ESP}\n"
        f"size={int(win_msr_mib)}M,type={GPT_TYPE_MSR.upper()},name={LABEL_MSR}\n"
        f"size={win_c_mib}M,type={GPT_TYPE_BASIC.upper()},name={LABEL_C}\n"
    )
    cmd = ["sfdisk", "--no-reread", "--append", str(disk_path)]
    run_cmd(cmd, input_text=script)
    if not is_image:
        run_cmd(["partx", "-u", str(disk_path)], check=False)
        if shutil.which("udevadm"):
            run_cmd(["udevadm", "settle"], check=False)
    new_gpt = parse_gpt_disk(disk_path)
    triplet = find_winmaint_triplet(new_gpt)
    if not triplet:
        raise RuntimeError(f"{disk_path}: failed to verify newly created tail triplet")
    return new_gpt, triplet


def format_winmaint_esp_and_msr(disk_path, triplet, is_image=False):
    esp = triplet["esp"]
    msr = triplet["msr"]
    if is_image:
        esp_kib = (esp["sectors"] * SECTOR_SIZE) // 1024
        run_cmd([
            "mkfs.fat", "-F", "32", "-n", FAT_LABEL_ESP,
            "--offset", str(esp["start_lba"]),
            str(disk_path), str(esp_kib),
        ])
        with open(disk_path, "r+b") as f:
            f.seek(msr["start_lba"] * SECTOR_SIZE)
            zero_chunk = b"\x00" * (1024 * 1024)
            rem = msr["sectors"] * SECTOR_SIZE
            while rem > 0:
                n = min(rem, len(zero_chunk))
                f.write(zero_chunk[:n])
                rem -= n
            f.flush()
    else:
        esp_dev = partition_child(disk_path, esp["partn"])
        msr_dev = partition_child(disk_path, msr["partn"])
        run_cmd(["mkfs.fat", "-F", "32", "-n", FAT_LABEL_ESP, esp_dev])
        with open(msr_dev, "wb") as f:
            zero_chunk = b"\x00" * (1024 * 1024)
            rem = msr["sectors"] * SECTOR_SIZE
            while rem > 0:
                n = min(rem, len(zero_chunk))
                f.write(zero_chunk[:n])
                rem -= n
            f.flush()


def sanitize_esp_blockdev(esp_dev):
    """Layer-1 defense on a real FAT32 partition: strip \\EFI\\BOOT\\BOOTX64.EFI."""
    removed = []
    bootmgfw_present = False
    with tempfile.TemporaryDirectory(prefix="winmaint-esp-") as mnt:
        run_cmd(["mount", "-t", "vfat", "-o", "nosuid,nodev,noexec", esp_dev, mnt])
        try:
            root = Path(mnt)
            for dirpath, _dirnames, filenames in os.walk(root):
                rel_dir = Path(dirpath).relative_to(root).as_posix().lower()
                for fn in filenames:
                    fn_l = fn.lower()
                    if rel_dir == "efi/boot" and fn_l == "bootx64.efi":
                        p = Path(dirpath) / fn
                        p.unlink()
                        removed.append(str(p.relative_to(root)))
                    elif rel_dir == "efi/microsoft/boot" and fn_l == "bootmgfw.efi":
                        bootmgfw_present = True
            os.sync()
        finally:
            run_cmd(["umount", mnt], check=False)
    return {"removed": removed, "bootmgfw_present": bootmgfw_present}


def sanitize_esp_image(image_path, offset_sectors):
    """Layer-1 defense on a raw disk image via mtools (rootless)."""
    spec = f"{image_path}@@{int(offset_sectors) * SECTOR_SIZE}"
    removed = []
    bootmgfw_present = False

    r_boot = run_cmd(["mdir", "-b", "-i", spec, "::/EFI/BOOT"], check=False)
    if r_boot.returncode == 0:
        for line in r_boot.stdout.splitlines():
            item = line.strip()
            if item.lower().endswith("/bootx64.efi"):
                run_cmd(["mdel", "-i", spec, item])
                removed.append(item)

    r_ms = run_cmd(["mdir", "-b", "-i", spec, "::/EFI/Microsoft/Boot"], check=False)
    if r_ms.returncode == 0:
        for line in r_ms.stdout.splitlines():
            if line.strip().lower().endswith("/bootmgfw.efi"):
                bootmgfw_present = True
    return {"removed": removed, "bootmgfw_present": bootmgfw_present}


def is_triplet_at_tail(gpt, triplet):
    """Ensure no non-managed partition lies after the Maintenance Windows triplet."""
    managed = {triplet["esp"]["partn"], triplet["msr"]["partn"], triplet["c"]["partn"]}
    min_start = min(triplet[k]["start_lba"] for k in ("esp", "msr", "c"))
    for p in gpt["partitions"]:
        if p["partn"] in managed:
            continue
        if p["start_lba"] >= min_start or p["end_lba"] >= min_start:
            return False
    return True


def reclaim_tail_triplet(disk_path, state, is_image=False, grow_root=True, root_info=None):
    """Delete the verified tail triplet and optionally grow the preceding root partition online."""
    gpt = parse_gpt_disk(disk_path)
    triplet = verify_state_against_gpt(state, gpt)
    if not is_triplet_at_tail(gpt, triplet):
        raise RuntimeError(f"{disk_path}: Maintenance Windows partitions are not at the tail of the disk")

    esp_n = triplet["esp"]["partn"]
    msr_n = triplet["msr"]["partn"]
    c_n = triplet["c"]["partn"]
    esp_start = triplet["esp"]["start_lba"]

    if not is_image:
        if Path(f"/dev/mapper/{DM_NAME}").exists():
            raise RuntimeError(f"/dev/mapper/{DM_NAME} is still active; stop the VM first")
        for n in (esp_n, msr_n, c_n):
            pdev = partition_child(disk_path, n)
            fm = run_cmd(["findmnt", "--noheadings", "--source", pdev], check=False)
            if fm.returncode == 0 and fm.stdout.strip():
                raise RuntimeError(f"{pdev} is currently mounted; unmount it before reclaiming")

    run_cmd(["sfdisk", "--no-reread", "--delete", str(disk_path), str(esp_n), str(msr_n), str(c_n)])

    grew_root = False
    if grow_root and state.get("on_root_disk"):
        root_partn = None
        root_uuid = (state.get("root_part_uuid") or "").lower()
        for p in gpt["partitions"]:
            if p["partn"] in (esp_n, msr_n, c_n):
                continue
            if root_uuid and p["part_guid"].lower() == root_uuid:
                root_partn = p["partn"]
                break
        if root_partn is None and root_info is not None and root_info["disk"] == str(disk_path):
            root_partn = root_info["partn"]
        if root_partn is not None:
            rpart = next((p for p in gpt["partitions"] if p["partn"] == root_partn), None)
            if rpart and rpart["end_lba"] < esp_start and (esp_start - rpart["end_lba"]) <= 2 * ALIGN_SECTORS:
                run_cmd(["sfdisk", "--no-reread", "-N", str(root_partn), str(disk_path)], input_text=",+\n")
                grew_root = True

    if not is_image:
        run_cmd(["partx", "-u", str(disk_path)], check=False)
        if shutil.which("udevadm"):
            run_cmd(["udevadm", "settle"], check=False)
        if grew_root and root_info is not None:
            if root_info["is_luks"]:
                run_cmd(["cryptsetup", "resize", "locachy-crypt"])
            run_cmd(["resize2fs", root_info["root_fs_dev"]])

    return {"deleted": [esp_n, msr_n, c_n], "grew_root": grew_root}


