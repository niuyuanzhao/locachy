def pick_first_existing(paths):
    for p in paths:
        if Path(p).is_file():
            return p
    return None


# Hyper-V enlightenments as QEMU's docs list them. hv-passthrough is not used (QEMU's docs
# advise against passthrough for production) and hv-default is not used either.
HYPERV_CPU = ("host,hv-relaxed,hv-vapic,hv-spinlocks=0x1fff,hv-time,hv-vpindex,hv-synic,"
              "hv-stimer,hv-stimer-direct,hv-reset,hv-frequencies,hv-tlbflush,hv-ipi")
_QEMU_HELP = {}


def _qemu_help_lines(flag):
    """Lines of `qemu-system-x86_64 FLAG help`; empty when QEMU cannot run here."""
    if flag not in _QEMU_HELP:
        try:
            res = subprocess.run(["qemu-system-x86_64", flag, "help"], stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True, timeout=30)
            _QEMU_HELP[flag] = res.stdout.splitlines()
        except (OSError, subprocess.SubprocessError):
            _QEMU_HELP[flag] = []
    return _QEMU_HELP[flag]


def qemu_device_names():
    """Devices this host's QEMU has. Modules ship in packages: virtio-vga is in
    qemu-hw-display-virtio-vga (part of Arch's qemu-desktop), not in qemu-system-x86."""
    names = set()
    for line in _qemu_help_lines("-device"):
        m = re.match(r'\s*name "([^"]+)"', line)
        if m:
            names.add(m.group(1))
    return names


def choose_netdev():
    """passt when passt is on PATH and this QEMU has the netdev; user-mode NAT otherwise."""
    if shutil.which("passt") and "passt" in {ln.strip() for ln in _qemu_help_lines("-netdev")}:
        return "passt"
    return "user"


def find_virtiofsd():
    """virtiofsd: LOCACHY_VIRTIOFSD, then PATH, then the usual install places."""
    override = os.environ.get("LOCACHY_VIRTIOFSD", "").strip()
    if override:
        found = override if (os.path.isfile(override) and os.access(override, os.X_OK)) else shutil.which(override)
        if not found:
            raise RuntimeError(f"LOCACHY_VIRTIOFSD is not executable: {override!r}")
        return found
    found = shutil.which("virtiofsd")
    if found:
        return found
    for cand in VIRTIOFSD_CANDIDATES:
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    raise RuntimeError("--share-dir needs virtiofsd (install it, for example at /usr/lib/virtiofsd)")


def virtiofsd_argv(binary, host_dir, sock_path):
    """virtiofsd for one share: a vhost-user socket, namespace sandbox, cache=auto (as locachy-compute)."""
    return [binary, f"--socket-path={sock_path}", f"--shared-dir={host_dir}",
            "--sandbox=namespace", "--cache=auto"]


def parse_share_dir(raw, index):
    """PATH[:TAG] for --share-dir: an absolute existing directory and the tag the guest mounts."""
    host, sep, tag = raw.rpartition(":")
    if not sep:
        host, tag = raw, ""
    if not os.path.isabs(host) or not os.path.isdir(host):
        raise RuntimeError(f"--share-dir needs an absolute existing directory: {host!r}")
    tag = tag or f"share{index}"
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,31}", tag):
        raise RuntimeError(f"invalid --share-dir tag {tag!r}: 1 to 31 of A-Z a-z 0-9 _ . -")
    return {"host": host, "tag": tag}


def stop_virtiofsd(procs, socks):
    """Stop the share daemons (after QEMU has exited) and remove their sockets."""
    for proc in procs:
        if proc.poll() is None:
            proc.terminate()
    for proc in procs:
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
    for sock in socks:
        Path(sock).unlink(missing_ok=True)


def build_qemu_argv(
    dm_dev,
    ovmf_code,
    ovmf_vars,
    memory_mib=4096,
    cpus=4,
    iso_path=None,
    seed_path=None,
    tpm_sock=None,
    display_spec=None,
    vnc_addr=None,
    qmp_sock=None,
    disk_bus="nvme",
    nic="e1000e",
    netdev="user",
    gpu="virtio-vga",
    virtio_iso=None,
    share_sockets=(),
):
    """QEMU argv for the Windows VM. disk_bus: nvme (the default; the same stornvme path as
    bare metal) or virtio (virtio-blk with an iothread, for virtio-win). nic: e1000e (inbox
    driver, the default) or virtio (virtio-net, for NetKVM). gpu: virtio-vga, or std for a
    QEMU without the module (its default VGA). share_sockets: (tag, socket) per --share-dir."""
    if disk_bus not in VM_DISK_BUSES:
        raise ValueError(f"unknown disk bus {disk_bus!r}")
    if nic not in VM_NICS:
        raise ValueError(f"unknown NIC {nic!r}")
    if netdev not in ("user", "passt"):
        raise ValueError(f"unknown netdev {netdev!r}")
    if gpu not in ("virtio-vga", "std"):
        raise ValueError(f"unknown GPU {gpu!r}")
    nic_model = "virtio-net-pci" if nic == "virtio" else "e1000e"
    machine = "q35,smm=on" + (",memory-backend=mem" if share_sockets else "")
    argv = [
        "qemu-system-x86_64",
        "-name", "locachy-winmaint",
        "-enable-kvm",
        "-machine", machine,
        "-cpu", HYPERV_CPU,
        "-smp", str(int(cpus)),
        "-m", str(int(memory_mib)),
        "-drive", f"if=pflash,format=raw,unit=0,readonly=on,file={ovmf_code}",
        "-drive", f"if=pflash,format=raw,unit=1,file={ovmf_vars}",
    ]
    if share_sockets:
        argv += ["-object", f"memory-backend-memfd,id=mem,size={int(memory_mib)}M,share=on"]
    disk = f"file={dm_dev},format=raw,if=none,id=disk0,cache=none,aio=io_uring"
    if disk_bus == "virtio":
        argv += [
            "-object", "iothread,id=io0",
            "-drive", disk,
            "-device", "virtio-blk-pci,drive=disk0,iothread=io0,discard=on,serial=locachy-winmaint",
        ]
    else:
        argv += ["-drive", disk, "-device", "nvme,drive=disk0,serial=locachy-winmaint"]
    argv += [
        "-object", "rng-builtin,id=rng0",
        "-device", "virtio-rng-pci,rng=rng0",
        "-device", "qemu-xhci,id=xhci",
        "-device", "usb-tablet,bus=xhci.0",
        "-netdev", f"{netdev},id=net0",
        "-device", f"{nic_model},netdev=net0",
    ]
    if tpm_sock:
        argv += [
            "-chardev", f"socket,id=chrtpm,path={tpm_sock}",
            "-tpmdev", "emulator,id=tpm0,chardev=chrtpm",
            "-device", "tpm-tis,tpmdev=tpm0",
        ]
    # Each port of q35's AHCI controller (ide.0..ide.5) accepts only one device;
    # assign explicit buses so both the Windows ISO and virtio-win CD coexist.
    if iso_path:
        argv += [
            "-drive", f"file={iso_path},media=cdrom,readonly=on,if=none,id=cd0",
            "-device", "ide-cd,drive=cd0,bus=ide.0,bootindex=1",
        ]
    if seed_path:
        argv += [
            "-drive", f"file={seed_path},format=raw,readonly=on,if=none,id=seed0",
            "-device", "usb-storage,drive=seed0,bus=xhci.0,removable=on",
        ]
    if virtio_iso:
        argv += [
            "-drive", f"file={virtio_iso},media=cdrom,readonly=on,if=none,id=cd1",
            "-device", "ide-cd,drive=cd1,bus=ide.1",
        ]
    for idx, (tag, sock) in enumerate(share_sockets):
        argv += [
            "-chardev", f"socket,id=vfs{idx},path={sock}",
            "-device", f"vhost-user-fs-pci,queue-size=1024,chardev=vfs{idx},tag={tag}",
        ]
    if gpu == "virtio-vga":
        # Unverified in Windows: whether it gets UEFI GOP or a viogpudo driver is not tested here.
        argv += ["-vga", "none", "-device", "virtio-vga"]
    if qmp_sock:
        # QMP over a unix socket: locachy-app asks QEMU to stop and freeze through it.
        argv += ["-qmp", f"unix:{qmp_sock},server=on,wait=off"]
    if vnc_addr:
        argv += ["-display", "none", "-vnc", vnc_addr]
    elif display_spec:
        argv += ["-display", qemu_gtk_display(display_spec)]
    elif os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"):
        argv += ["-display", qemu_gtk_display("gtk")]
    else:
        argv += ["-display", "none", "-vnc", "127.0.0.1:0"]
    return argv


def qemu_gtk_display(spec):
    """GTK on a Wayland session runs with OpenGL off: QEMU's GL path needs an EGL setup
    LOCachy's session does not provide. Every GTK display gets window-close=off: QEMU's
    default quits at once on a window close (the bar's middle-click, the overview's close,
    the window's own button), pulling Windows' power with NTFS on the real partition left
    dirty; stopping is QMP system_powerdown (vm-stop) or a shutdown inside Windows. Other
    displays keep the spec as given."""
    if spec != "gtk" and not spec.startswith("gtk,"):
        return spec
    if spec == "gtk" and os.environ.get("WAYLAND_DISPLAY"):
        spec = "gtk,gl=off"
    if "window-close=" not in spec:
        spec += ",window-close=off"
    return spec


def qmp_execute(sock_path, command, timeout=5.0):
    """Send one QMP command to a QEMU monitor unix socket and wait for its return."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        s.connect(str(sock_path))
        buf = b""

        def next_msg():
            nonlocal buf
            while b"\n" not in buf:
                chunk = s.recv(4096)
                if not chunk:
                    raise RuntimeError("QMP closed the connection")
                buf += chunk
            line, buf = buf.split(b"\n", 1)
            return json.loads(line.decode("utf-8"))

        greeting = next_msg()
        if "QMP" not in greeting:
            raise RuntimeError("unexpected QMP greeting")
        s.sendall(b'{"execute":"qmp_capabilities"}\n')
        while True:
            msg = next_msg()
            if "return" in msg:
                break
            if "error" in msg:
                raise RuntimeError(f"QMP capabilities rejected: {msg['error']}")
        s.sendall((json.dumps({"execute": command}) + "\n").encode("utf-8"))
        while True:
            msg = next_msg()
            if "return" in msg:
                return msg["return"]
            if "error" in msg:
                raise RuntimeError(f"QMP {command} failed: {msg['error']}")


def cmd_vm_stop(args):
    """Ask a running Maintenance Windows QEMU instance to shut down cleanly via QMP."""
    sock = Path(args.qmp_sock or os.environ.get("LOCACHY_VM_QMP_SOCK") or QMP_SOCK)
    if not sock.exists():
        return 0
    if args.powerdown_only:
        qmp_execute(sock, "system_powerdown", timeout=args.timeout)
        return 0
    deadline = time.monotonic() + float(args.wait)
    try:
        qmp_execute(sock, "system_powerdown", timeout=args.timeout)
    except OSError:
        return 0
    while sock.exists() and time.monotonic() < deadline:
        time.sleep(0.2)
    if sock.exists() and args.quit_after:
        try:
            qmp_execute(sock, "quit", timeout=args.timeout)
        except OSError:
            pass
    return 0


def _vm_sigterm(vm_state):
    """SIGTERM to a Maintenance Windows VM: forwarded to QEMU, which powers the guest off
    (cleanup follows its exit); before QEMU runs it unwinds through cmd_vm's cleanup so no
    dm-linear, loop device or swtpm is left behind; ignored while that cleanup runs."""
    def handle(signum, frame):
        if vm_state.get("cleaning"):
            return
        proc = vm_state.get("qemu")
        if proc is None:
            raise SystemExit(128 + signum)
        if proc.poll() is None:
            proc.send_signal(signal.SIGTERM)
    return handle


def cmd_vm(args):
    if os.geteuid() != 0 and not args.dry_run:
        raise RuntimeError("locachy-winmaint vm must run as root")
    state = load_state()
    if not state:
        raise RuntimeError("Maintenance Windows is not configured (run 'locachy-winmaint create' first)")
    disk, gpt = resolve_state_disk(state)
    triplet = verify_state_against_gpt(state, gpt)
    esp_dev = partition_child(disk, triplet["esp"]["partn"])
    msr_dev = partition_child(disk, triplet["msr"]["partn"])
    c_dev = partition_child(disk, triplet["c"]["partn"])

    ovmf_code = pick_first_existing(OVMF_CODE_CANDIDATES)
    ovmf_vars_tpl = pick_first_existing(OVMF_VARS_CANDIDATES)
    if not ovmf_code or not ovmf_vars_tpl:
        raise RuntimeError("OVMF firmware images not found under /usr/share/edk2/x64")

    iso, virtio_arg = args.iso, args.virtio_iso
    if not (iso and virtio_arg) and windows_installed(esp_dev) is not True:
        # Installation media from locachy-winiso when it is there and has them (explicit
        # options win; once Windows is installed nothing is attached unasked).
        if not iso:
            iso = winiso_path("windows")
        if not virtio_arg:
            virtio_arg = winiso_path("virtio-win")
    if iso:
        iso = regular_file(iso, "ISO")
    virtio_iso = find_virtio_iso(virtio_arg)
    shares = [parse_share_dir(raw, idx) for idx, raw in enumerate(args.share_dir or [])]
    if len({s["tag"] for s in shares}) != len(shares):
        raise RuntimeError("duplicate --share-dir tag")
    gpu = "virtio-vga" if "virtio-vga" in qemu_device_names() else "std"
    if gpu == "std":
        print("locachy-winmaint: virtio-vga is not in this QEMU (qemu-hw-display-virtio-vga); "
              "using QEMU's default VGA", file=sys.stderr)
    netdev = choose_netdev()

    with WinmaintLock():
        for pdev in (esp_dev, msr_dev, c_dev):
            fm = run_cmd(["findmnt", "--noheadings", "--source", pdev], check=False)
            if fm.returncode == 0 and fm.stdout.strip():
                raise RuntimeError(f"{pdev} is mounted; unmount it before launching VM")

        head_bytes, tail_bytes, layout = build_virtual_gpt_blobs(state["disk_guid"], triplet)
        qmp_path = args.qmp_sock or os.environ.get("LOCACHY_VM_QMP_SOCK") or ""
        qmp_sock = Path(qmp_path) if qmp_path else None
        share_socks = [(s["tag"], str(RUN_DIR / f"virtiofs-{i}.sock")) for i, s in enumerate(shares)]
        if args.dry_run:
            table = dm_linear_table("/dev/loopX", esp_dev, msr_dev, c_dev, "/dev/loopY", layout)
            argv = build_qemu_argv(
                f"/dev/mapper/{DM_NAME}",
                ovmf_code,
                str(OVMF_VARS_STATE),
                memory_mib=args.memory,
                cpus=args.cpus,
                iso_path=iso,
                seed_path=str(RUN_DIR / "seed.img") if (iso or args.seed or virtio_iso) else None,
                tpm_sock=None if args.no_tpm else str(RUN_DIR / "swtpm.sock"),
                display_spec=args.display,
                vnc_addr=args.vnc,
                qmp_sock=str(qmp_sock) if qmp_sock else None,
                disk_bus=args.disk_bus,
                nic=args.nic,
                netdev=netdev,
                gpu=gpu,
                virtio_iso=virtio_iso if (virtio_iso and Path(virtio_iso).is_file()) else None,
                share_sockets=share_socks,
            )
            vfs_argv = []
            if shares:
                vfs_bin = find_virtiofsd()
                vfs_argv = [virtiofsd_argv(vfs_bin, s["host"], sock) for s, (_tag, sock) in zip(shares, share_socks)]
            print(json.dumps({"dm_table": table.splitlines(), "qemu_argv": argv, "virtiofsd": vfs_argv}, indent=2))
            return 0

        STATE_DIR.mkdir(parents=True, exist_ok=True)
        RUN_DIR.mkdir(parents=True, exist_ok=True)
        if qmp_sock is not None:
            qmp_sock.parent.mkdir(parents=True, exist_ok=True)
            qmp_sock.unlink(missing_ok=True)
        if not OVMF_VARS_STATE.is_file():
            shutil.copyfile(ovmf_vars_tpl, OVMF_VARS_STATE)
            os.chmod(OVMF_VARS_STATE, 0o600)

        head_path = RUN_DIR / "gpt-head.img"
        tail_path = RUN_DIR / "gpt-tail.img"
        seed_path = RUN_DIR / "seed.img"
        tpm_sock = RUN_DIR / "swtpm.sock"

        head_path.write_bytes(head_bytes)
        tail_path.write_bytes(tail_bytes)
        use_seed = None
        if iso or args.seed or virtio_iso:
            build_seed_image(seed_path, virtio_iso=virtio_iso, virtio_os=args.virtio_os)
            use_seed = str(seed_path)

        vm_state = {}
        previous_term = signal.signal(signal.SIGTERM, _vm_sigterm(vm_state))
        loop_head = None
        loop_tail = None
        dm_created = False
        swtpm_proc = None
        vfs_procs = []
        vfs_socks = []
        try:
            loop_head = run_cmd(["losetup", "--find", "--show", str(head_path)]).stdout.strip()
            loop_tail = run_cmd(["losetup", "--find", "--show", str(tail_path)]).stdout.strip()
            table = dm_linear_table(loop_head, esp_dev, msr_dev, c_dev, loop_tail, layout)
            run_cmd(["dmsetup", "create", DM_NAME], input_text=table)
            dm_created = True

            if shares:
                vfs_bin = find_virtiofsd()
                for idx, share in enumerate(shares):
                    sock_path = Path(share_socks[idx][1])
                    sock_path.unlink(missing_ok=True)
                    log_path = RUN_DIR / f"virtiofsd-{idx}.log"
                    with open(log_path, "wb") as log_fh:
                        proc = subprocess.Popen(
                            virtiofsd_argv(vfs_bin, share["host"], sock_path),
                            stdin=subprocess.DEVNULL, stdout=log_fh, stderr=subprocess.STDOUT,
                        )
                    vfs_procs.append(proc)
                    vfs_socks.append(sock_path)
                    deadline = time.monotonic() + 5.0
                    while not sock_path.exists() and time.monotonic() < deadline:
                        if proc.poll() is not None:
                            err = log_path.read_text(encoding="utf-8", errors="replace").strip()
                            raise RuntimeError(f"virtiofsd for {share['tag']!r} exited ({proc.returncode}): {err}")
                        time.sleep(0.05)
                    if not sock_path.exists():
                        raise RuntimeError(f"virtiofsd socket did not appear for {share['tag']!r}")

            use_tpm = None
            if not args.no_tpm:
                if not shutil.which("swtpm"):
                    raise RuntimeError("swtpm is not installed (install swtpm or pass --no-tpm)")
                SWTPM_STATE_DIR.mkdir(parents=True, exist_ok=True)
                os.chmod(SWTPM_STATE_DIR, 0o700)
                tpm_sock.unlink(missing_ok=True)
                swtpm_proc = subprocess.Popen([
                    "swtpm", "socket", "--tpm2",
                    "--tpmstate", f"dir={SWTPM_STATE_DIR}",
                    "--ctrl", f"type=unixio,path={tpm_sock}",
                ])
                deadline = time.monotonic() + 5.0
                while not tpm_sock.exists() and time.monotonic() < deadline:
                    if swtpm_proc.poll() is not None:
                        raise RuntimeError(f"swtpm exited early ({swtpm_proc.returncode})")
                    time.sleep(0.05)
                if not tpm_sock.exists():
                    raise RuntimeError("swtpm control socket did not appear")
                use_tpm = str(tpm_sock)

            argv = build_qemu_argv(
                f"/dev/mapper/{DM_NAME}",
                ovmf_code,
                str(OVMF_VARS_STATE),
                memory_mib=args.memory,
                cpus=args.cpus,
                iso_path=iso,
                seed_path=use_seed,
                tpm_sock=use_tpm,
                display_spec=args.display,
                vnc_addr=args.vnc,
                qmp_sock=str(qmp_sock) if qmp_sock else None,
                disk_bus=args.disk_bus,
                nic=args.nic,
                netdev=netdev,
                gpu=gpu,
                virtio_iso=virtio_iso if (virtio_iso and Path(virtio_iso).is_file()) else None,
                share_sockets=share_socks,
            )
            qemu = subprocess.Popen(argv)
            vm_state["qemu"] = qemu
            rc = qemu.wait()
            return rc if rc >= 0 else 128 - rc
        finally:
            vm_state["cleaning"] = True
            qemu = vm_state.get("qemu")
            if qemu is not None and qemu.poll() is None:
                qemu.send_signal(signal.SIGTERM)
                try:
                    qemu.wait(timeout=60)
                except subprocess.TimeoutExpired:
                    qemu.kill()
                    qemu.wait()
            stop_virtiofsd(vfs_procs, vfs_socks)
            if swtpm_proc is not None and swtpm_proc.poll() is None:
                swtpm_proc.terminate()
                try:
                    swtpm_proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    swtpm_proc.kill()
                    swtpm_proc.wait(timeout=5)
            tpm_sock.unlink(missing_ok=True)
            if qmp_sock is not None:
                qmp_sock.unlink(missing_ok=True)
            if dm_created:
                run_cmd(["dmsetup", "remove", DM_NAME], check=False)
            if loop_head:
                run_cmd(["losetup", "-d", loop_head], check=False)
            if loop_tail:
                run_cmd(["losetup", "-d", loop_tail], check=False)
            for p in (head_path, tail_path, seed_path):
                p.unlink(missing_ok=True)
            # Layer-1 defense: strip \EFI\BOOT\BOOTX64.EFI if Windows created it.
            try:
                info = sanitize_esp_blockdev(esp_dev)
                if info["removed"]:
                    print(f"locachy-winmaint: stripped fallback from {esp_dev}: {', '.join(info['removed'])}")
            except Exception as e:
                print(f"locachy-winmaint: warning: post-VM ESP sanitize failed: {e}", file=sys.stderr)
            signal.signal(signal.SIGTERM, previous_term)


