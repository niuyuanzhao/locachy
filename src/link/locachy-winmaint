def load_state(path=None):
    p = Path(path) if path is not None else STATE_FILE
    if not p.is_file():
        return None
    return json.loads(p.read_text(encoding="utf-8"))


def save_state(state, path=None):
    p = Path(path) if path is not None else STATE_FILE
    atomic_write_text(p, json.dumps(state, indent=2, sort_keys=True) + "\n", mode=0o600)


def state_path_for_root(root):
    """state.json of the system installed under root ("/" is this running system)."""
    return Path(root) / "var/lib/locachy/winmaint/state.json"


# The container entry locachy-app runs Windows by: written with the Maintenance
# Windows triplet, removed with it, and never over a file someone else wrote.
CONTAINER_CONF_REL = Path("etc/locachy/containers/winmaint.conf")
CONTAINER_CONF_TEXT = 'vm="1"\nvm_kind="winmaint"\nvm_freeze="qmp"\nnetwork="1"\n'


def write_container_conf(root):
    """Write the managed container entry under root, unless one already exists there."""
    path = Path(root) / CONTAINER_CONF_REL
    if os.path.lexists(path):
        return False
    atomic_write_text(path, CONTAINER_CONF_TEXT, mode=0o644)
    return True


def remove_container_conf(root):
    """Remove the container entry under root only if it is the managed vm_kind="winmaint" file."""
    path = Path(root) / CONTAINER_CONF_REL
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError):
        return False
    if 'vm_kind="winmaint"' not in [line.strip() for line in lines]:
        return False
    path.unlink(missing_ok=True)
    return True


def verify_state_against_gpt(state, gpt):
    """Confirm disk GUID and all 3 partition GUIDs/types/names match state.json."""
    if gpt["disk_guid"].lower() != state["disk_guid"].lower():
        raise RuntimeError(
            f"Disk GUID mismatch: GPT has {gpt['disk_guid']}, state expects {state['disk_guid']}"
        )
    triplet = find_winmaint_triplet(gpt)
    if not triplet:
        raise RuntimeError("Maintenance Windows partitions missing from GPT")
    for key in ("esp", "msr", "c"):
        rec = state["partitions"][key]
        live = triplet[key]
        if live["part_guid"].lower() != rec["part_guid"].lower():
            raise RuntimeError(f"Partition {key} GUID mismatch: {live['part_guid']} != {rec['part_guid']}")
        if live["type_guid"].lower() != rec["type_guid"].lower():
            raise RuntimeError(f"Partition {key} type mismatch: {live['type_guid']} != {rec['type_guid']}")
    return triplet


SKIP_BLOCK_PREFIXES = ("zram", "loop", "sr", "ram")


def _is_block_device_path(path):
    """Return True if path refers to a /dev/... device path or block device node."""
    s = str(path)
    if s.startswith("/dev/"):
        return True
    try:
        return stat.S_ISBLK(os.stat(s).st_mode)
    except OSError:
        return False


def _whole_disks():
    """Whole-disk block devices as {path, model, serial, size_bytes}; virtual and optical ones are left out."""
    res = run_cmd(["lsblk", "--json", "--nodeps", "--bytes", "--paths", "--output", "PATH,TYPE,MODEL,SERIAL,SIZE"],
                  check=False)
    out = []
    if res.returncode == 0 and res.stdout.strip():
        for dev in json.loads(res.stdout).get("blockdevices") or []:
            path = dev.get("path") or ""
            if dev.get("type") != "disk" or not path or os.path.basename(path).startswith(SKIP_BLOCK_PREFIXES):
                continue
            out.append({
                "path": path,
                "model": str(dev.get("model") or "").strip(),
                "serial": str(dev.get("serial") or "").strip(),
                "size_bytes": int(dev.get("size") or 0),
            })
        return out
    sys_block = Path("/sys/block")
    if not sys_block.is_dir():
        return []
    for entry in sorted(sys_block.iterdir()):
        if entry.name.startswith(SKIP_BLOCK_PREFIXES) or not os.path.exists(f"/dev/{entry.name}"):
            continue
        try:
            size = int((entry / "size").read_text().strip()) * SECTOR_SIZE
        except (OSError, ValueError):
            size = 0
        try:
            model = (entry / "device/model").read_text().strip()
        except OSError:
            model = ""
        try:
            serial = (entry / "device/serial").read_text().strip()
        except OSError:
            serial = ""
        out.append({"path": f"/dev/{entry.name}", "model": model, "serial": serial, "size_bytes": size})
    return out


def _scan_whole_disk_candidates():
    return [d["path"] for d in _whole_disks()]


def resolve_state_disk(state, *, disk_candidates=None, allow_lsblk_fallback=False):
    """Resolve state['disk'] to the live disk whose GPT Disk GUID matches state['disk_guid'].

    A regular file image (--image, tests) is read as its own GPT, never scanned.
    For a block device (or when disk_candidates is given) every whole disk is
    read and the one carrying state['disk_guid'] is returned, so a swap of
    nvme0n1 and nvme1n1 across boots resolves. Two disks carrying the GUID (a
    raw clone attached at the same time) are refused, even when the recorded
    path is one of them: the GUID alone cannot say which is the real disk.
    """
    recorded = str(state["disk"])
    expected = str(state["disk_guid"]).lower()
    lsblk_cache = {} if allow_lsblk_fallback else None
    read_gpt = (lambda p: _parse_gpt_readonly(p, lsblk_cache=lsblk_cache)) if allow_lsblk_fallback else parse_gpt_disk

    if disk_candidates is None and not _is_block_device_path(recorded):
        gpt = read_gpt(recorded)
        if gpt["disk_guid"].lower() != expected:
            raise RuntimeError(
                f"Disk GUID mismatch on {recorded}: GPT has {gpt['disk_guid']}, state expects {state['disk_guid']}"
            )
        return recorded, gpt

    if disk_candidates is None:
        candidates = _scan_whole_disk_candidates()
    else:
        candidates = [str(c) for c in disk_candidates]
    matches = []
    seen = set()
    for cand in [recorded] + candidates:
        key = os.path.realpath(cand)
        if key in seen:
            continue
        seen.add(key)
        try:
            gpt = read_gpt(cand)
        except (OSError, RuntimeError, ValueError):
            continue
        if gpt["disk_guid"].lower() == expected:
            matches.append((cand, gpt))

    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        paths = ", ".join(p for p, _ in matches)
        raise RuntimeError(
            f"Ambiguous disk GUID {state['disk_guid']}: {len(matches)} disks carry it ({paths}); refusing to operate"
        )
    raise RuntimeError(
        f"Disk GUID mismatch: no disk carries GUID {state['disk_guid']} (recorded as {recorded})"
    )


