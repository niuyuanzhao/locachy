# Clears StartOverride (Windows writes it on boot-start drivers it finds unused) and makes
# the NVMe and virtio storage drivers boot-start, so a VM run that used virtio-blk does not
# leave the same Windows unable to boot bare-metal NVMe. Runs at install, at each boot
# (LOCachyStorageBoot) and at each shutdown. UNVERIFIED on hardware: see WINMAINT.md.
STORAGE_PS1 = r"""# LOCachy storage boot guard: stornvme (in-box NVMe) and viostor (virtio-win) must load at boot.
$ErrorActionPreference = 'SilentlyContinue'
foreach ($svc in @('stornvme', 'viostor')) {
    $base = "HKLM:\SYSTEM\CurrentControlSet\Services\$svc"
    if (-not (Test-Path $base)) { continue }
    $override = Join-Path $base 'StartOverride'
    if (Test-Path $override) { Remove-Item -Path $override -Recurse -Force }
    Set-ItemProperty -Path $base -Name Start -Value 0 -Type DWord
}
"""


def regular_file(path, what):
    """path, when it names a regular file (a link to one is followed): a root QEMU and bsdtar
    read ISO paths, so block devices, directories and every other kind are refused."""
    try:
        st = os.stat(path)
    except OSError:
        raise RuntimeError(f"{what} not found: {path}") from None
    if not stat.S_ISREG(st.st_mode):
        raise RuntimeError(f"{what} must be a regular file: {path}")
    return str(path)


def find_virtio_iso(explicit=None):
    """The --virtio-iso path: a virtio-win ISO, a regular file."""
    if not explicit:
        return None
    return regular_file(explicit, "virtio-win ISO")


def _find_ci(root, rel):
    """Directory rel (a/b/c) under root, matched case-insensitively; None when absent."""
    cur = Path(root)
    for part in rel.split("/"):
        if not cur.is_dir():
            return None
        cur = next((p for p in cur.iterdir() if p.name.lower() == part.lower()), None)
        if cur is None:
            return None
    return cur if cur.is_dir() else None


def stage_virtio_drivers(virtio_src, os_dir, stage):
    """Copy the amd64 viostor and NetKVM folders of os_dir (w10 or w11) from virtio-win (an
    ISO, or a directory tree of it) into stage/$WinPEDriver$/<name>/ for Windows Setup."""
    if os_dir not in VIRTIO_OS_CHOICES:
        raise RuntimeError(f"--virtio-os must be one of {', '.join(VIRTIO_OS_CHOICES)}")
    src = Path(virtio_src)
    rels = {name: f"{name}/{os_dir}/amd64" for name in VIRTIO_SEED_DRIVERS}
    if src.is_dir():
        tree = src
    else:
        tree = Path(stage) / "_iso"
        tree.mkdir(parents=True, exist_ok=True)
        # Real virtio-win ISOs deduplicate identical files across directories as
        # ISO-9660 shared-extent hard links (e.g. viostor/w11/amd64/viostor.sys
        # "link to amd64/w11/viostor.sys"). Include every hard-link target in the
        # extraction list so bsdtar can resolve each link in a single pass.
        entries = []
        links = {}
        for line in run_cmd(["bsdtar", "-tvf", str(src)]).stdout.splitlines():
            parts = line.split(None, 8)
            if len(parts) < 9:
                continue
            rest = parts[8]
            if " link to " in rest:
                name, target = rest.rsplit(" link to ", 1)
                links[name] = target
            else:
                name = rest.split(" -> ", 1)[0]
            entries.append(name)
        wanted = [e for e in entries
                  if any(e.lstrip("./").lower().startswith(rel.lower() + "/") and not e.endswith("/")
                         for rel in rels.values())]
        if not wanted:
            raise RuntimeError(f"{virtio_src} has no {os_dir}/amd64 viostor or NetKVM folders (use --virtio-os)")
        to_extract = []
        seen = set()
        for e in wanted:
            cur = e
            chain = [cur]
            while cur in links and links[cur] not in seen:
                cur = links[cur]
                chain.append(cur)
            for item in reversed(chain):
                if item not in seen:
                    seen.add(item)
                    to_extract.append(item)
        run_cmd(["bsdtar", "--no-same-permissions", "-xf", str(src), "-C", str(tree), *to_extract])
    dest = Path(stage) / "$WinPEDriver$"
    for name, rel in rels.items():
        found = _find_ci(tree, rel)
        if found is None:
            raise RuntimeError(f"{virtio_src} has no {rel} folder (virtio-win build for {os_dir})")
        dest.mkdir(parents=True, exist_ok=True)
        shutil.copytree(found, dest / name, dirs_exist_ok=True)
    if tree != src:
        shutil.rmtree(tree, ignore_errors=True)
    return sorted(VIRTIO_SEED_DRIVERS)


SEED_PART_OFFSET_SECTORS = 2048
SEED_PART_OFFSET_BYTES = SEED_PART_OFFSET_SECTORS * SECTOR_SIZE


def _write_mbr_fat_image(dest_path, size_mib, fat_bits, label, populate_fn):
    """Build an MBR-partitioned single-partition FAT disk image at dest_path.

    Observed in QEMU 11.1 with Windows 11 26H2 Setup: a seed attached as
    usb-storage with removable=on and an MBR partition table (partition 1 at
    1 MiB) is listed as a removable volume and its $WinPEDriver$ drivers load
    (the virtio disk then appears in Setup). Without removable=on the drivers
    on it are not loaded; the superfloppy layout was not tested with
    removable=on, so this layout is what the code produces.
    """
    total_sectors = size_mib * (1024 * 1024 // SECTOR_SIZE)
    part_sectors = total_sectors - SEED_PART_OFFSET_SECTORS
    if part_sectors <= 0:
        raise RuntimeError(f"seed image size too small for 1 MiB MBR offset: {size_mib} MiB")
    ptype = {"12": "1", "16": "e", "32": "c"}[str(fat_bits)]
    with tempfile.TemporaryDirectory(prefix="winmaint-fat-") as td:
        td_path = Path(td)
        part_img = td_path / "part.fat"
        with open(part_img, "wb") as f:
            f.truncate(part_sectors * SECTOR_SIZE)
        run_cmd(["mkfs.fat", "-F", str(fat_bits), "-n", label, str(part_img)])
        populate_fn(part_img)
        disk_img = td_path / "disk.img"
        with open(disk_img, "wb") as f:
            f.truncate(total_sectors * SECTOR_SIZE)
        run_cmd(
            ["sfdisk", "--quiet", "--no-reread", str(disk_img)],
            input_text=f"label: dos\nstart={SEED_PART_OFFSET_SECTORS}, size={part_sectors}, type={ptype}\n",
        )
        with open(disk_img, "r+b") as df, open(part_img, "rb") as pf:
            df.seek(SEED_PART_OFFSET_BYTES)
            shutil.copyfileobj(pf, df)
        shutil.copyfile(disk_img, dest_path)


def build_seed_image(output_path, virtio_iso=None, virtio_os="w11"):
    """Build the MBR-partitioned FAT seed image: autounattend.xml, hardening
    scripts, and (with virtio_iso) the viostor and NetKVM drivers as
    $WinPEDriver$ at its root. 16 MiB FAT16 without drivers; FAT32 with drivers."""
    ET.fromstring(AUTOUNATTEND_XML)  # self-validate XML
    out = Path(output_path)
    out.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="winmaint-seed-") as td:
        td_path = Path(td)
        stage = td_path / "stage"
        stage.mkdir()
        if virtio_iso:
            stage_virtio_drivers(virtio_iso, virtio_os, stage)
        payload = sum(p.stat().st_size for p in stage.rglob("*") if p.is_file())
        if payload:
            size_mib = max(64, payload // (1024 * 1024) + 16)
            fat_bits = "32"
        else:
            size_mib = 16
            fat_bits = "16"
        files = {
            "autounattend.xml": AUTOUNATTEND_XML,
            "locachy-postinstall.cmd": POSTINSTALL_CMD.replace("\n", "\r\n"),
            "locachy-register.ps1": REGISTER_PS1.replace("\n", "\r\n"),
            "locachy-win-shutdown.ps1": SHUTDOWN_PS1.replace("\n", "\r\n"),
            "locachy-storage.ps1": STORAGE_PS1.replace("\n", "\r\n"),
            "locachy-return.ps1": RETURN_PS1.replace("\n", "\r\n"),
            "LOCACHY_WINSEED_MARKER": "locachy-winmaint\n",
        }
        staged_files = []
        for name, content in files.items():
            src = td_path / name
            src.write_text(content, encoding="utf-8")
            staged_files.append((name, src))

        def populate(part_img):
            for name, src in staged_files:
                run_cmd(["mcopy", "-o", "-i", str(part_img), str(src), f"::/{name}"])
            if payload:
                run_cmd(["mcopy", "-s", "-o", "-i", str(part_img), str(stage / "$WinPEDriver$"), "::/"])

        _write_mbr_fat_image(out, size_mib, fat_bits, "WINSEED", populate)
    return out


def build_driver_seed(output_path, virtio_iso, virtio_os="w11"):
    """A small MBR-partitioned FAT16 image with only $WinPEDriver$\\viostor and
    $WinPEDriver$\\NetKVM (amd64) at its root, staged from virtio-win as the
    seed's are: Windows Setup loads drivers from that folder on any removable
    disk (locachy-app attaches it read-only as usb-storage,removable=on).
    Rootless. Returns the absolute path; IMG is replaced as a whole."""
    out = Path(output_path).absolute()
    out.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="winmaint-drivers-") as td:
        td_path = Path(td)
        stage = td_path / "stage"
        stage.mkdir()
        stage_virtio_drivers(virtio_iso, virtio_os, stage)
        payload = sum(p.stat().st_size for p in stage.rglob("*") if p.is_file())
        size_mib = max(16, -(-payload // (1024 * 1024)) + 9)
        img = td_path / "drivers.img"

        def populate(part_img):
            run_cmd(["mcopy", "-s", "-o", "-i", str(part_img), str(stage / "$WinPEDriver$"), "::/"])

        _write_mbr_fat_image(img, size_mib, "16", "LOCDRIVERS", populate)
        fd, tmp = tempfile.mkstemp(prefix=out.name + ".", dir=str(out.parent))
        os.close(fd)
        try:
            shutil.copyfile(img, tmp)
            os.chmod(tmp, 0o644)
            os.replace(tmp, out)
        except BaseException:
            Path(tmp).unlink(missing_ok=True)
            raise
    return out


def windows_installed(esp_dev):
    """Whether the Maintenance Windows ESP holds \\EFI\\Microsoft\\Boot\\bootmgfw.efi, read with
    mtools (never mounted, never written); None when the partition cannot be read."""
    if not os.access(str(esp_dev), os.R_OK):
        return None
    try:
        if run_cmd(["mdir", "-b", "-i", str(esp_dev), "::/"], check=False).returncode != 0:
            return None
        res = run_cmd(["mdir", "-b", "-i", str(esp_dev), "::/EFI/Microsoft/Boot"], check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    return res.returncode == 0 and any(line.strip().lower().endswith("/bootmgfw.efi")
                                       for line in res.stdout.splitlines())


