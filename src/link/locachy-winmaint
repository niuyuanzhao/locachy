def cmd_status(args):
    state = load_state()
    plan_armed = SHRINK_PLAN_FILE.is_file()
    locked = is_lock_held()
    last_status = parse_kv_file(SHRINK_STATUS_VAR) if SHRINK_STATUS_VAR.is_file() else {}
    root_disk = None
    try:
        root_disk = detect_root_layout(allow_lsblk_fallback=True)["disk"]
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError):
        pass  # not a booted LOCachy root: no disk is marked as this system's
    info = {
        "configured": state is not None,
        "shrink_plan_armed": plan_armed,
        "lock_held": locked,
        "last_shrink": last_status,
        "state": state,
        "resolved_disk": None,
        "on_root_disk": bool(state and state.get("on_root_disk")),
    }
    # boot-default: set in this boot (Windows comes at the next restart) or in an earlier one
    # (LOCachy is running although Windows starts first: picked in the firmware boot menu).
    mode = boot_default_of(state)
    set_boot = (state or {}).get("boot_default_boot_id") or ""
    info["boot_default"] = mode
    info["boot_default_pending_reboot"] = mode == "windows" and bool(set_boot) and set_boot == current_boot_id()
    info["boot_default_overridden"] = mode == "windows" and not info["boot_default_pending_reboot"]
    try:
        info["candidate_disks"] = candidate_disks(root_disk)
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as e:
        info["candidate_disks"] = []
        info["candidate_error"] = str(e)
    if state:
        try:
            disk, gpt = resolve_state_disk(state, allow_lsblk_fallback=True)
            triplet = verify_state_against_gpt(state, gpt)
            info["gpt_verified"] = True
            info["resolved_disk"] = disk
            info["esp_dev"] = partition_child(disk, triplet["esp"]["partn"])
            info["msr_dev"] = partition_child(disk, triplet["msr"]["partn"])
            info["c_dev"] = partition_child(disk, triplet["c"]["partn"])
            info["win_c_gib"] = round((triplet["c"]["sectors"] * SECTOR_SIZE) / (1024 ** 3), 2)
        except Exception as e:
            info["gpt_verified"] = False
            info["gpt_error"] = str(e)
    if args.json:
        print(json.dumps(info, indent=2, sort_keys=True))
    else:
        if state:
            shown = info["resolved_disk"] or state["disk"]
            where = f"configured on {shown} (disk GUID {state['disk_guid']})"
            if shown != state["disk"]:
                where += f", recorded as {state['disk']}"
            print(f"Maintenance Windows: {where}")
            print(f"  ESP: part {state['partitions']['esp']['partn']} ({state['partitions']['esp']['part_guid']})")
            print(f"  MSR: part {state['partitions']['msr']['partn']} ({state['partitions']['msr']['part_guid']})")
            print(f"  C:   part {state['partitions']['c']['partn']} ({state['partitions']['c']['part_guid']})")
            print(f"  VM/op lock active: {'yes' if locked else 'no'}")
            if mode == "windows":
                when = ("from the next restart" if info["boot_default_pending_reboot"] else
                        "(LOCachy was picked in the firmware boot menu)")
                print(f"  Starts first: Windows until switched back {when}")
            else:
                print("  Starts first: LOCachy")
        elif plan_armed:
            print("Maintenance Windows: one-shot offline shrink plan armed (reboot to create partitions)")
        else:
            print("Maintenance Windows: not configured")
    return 0


def cmd_create(args):
    size_gib = int(args.size_gib)
    if not (MIN_WIN_C_GIB <= size_gib <= MAX_WIN_C_GIB):
        raise RuntimeError(f"--size-gib must be between {MIN_WIN_C_GIB} and {MAX_WIN_C_GIB}")
    is_image = bool(args.image)
    if not is_image and os.geteuid() != 0:
        raise RuntimeError("locachy-winmaint create must run as root")

    root_arg = Path(args.root or "/")
    live = os.path.realpath(root_arg) == "/"
    state_path = state_path_for_root(root_arg)
    lock_ctx = contextlib.nullcontext() if is_image else WinmaintLock()
    with lock_ctx:
        if not is_image and state_path.is_file():
            raise RuntimeError("Maintenance Windows is already configured (reclaim it first)")

        if is_image:
            target = args.image
            new_gpt, triplet = append_tail_triplet_sfdisk(target, size_gib, is_image=True)
            format_winmaint_esp_and_msr(target, triplet, is_image=True)
            state = state_from_gpt(new_gpt, target, on_root_disk=False)
            if args.state_file:
                save_state(state, args.state_file)
            print(json.dumps(state, indent=2, sort_keys=True))
            return 0

        if live:
            root = detect_root_layout()
            target_disk = args.disk or root["disk"]
        else:
            if not args.disk:
                raise RuntimeError("--disk is required with --root: the target system's disk")
            target_disk = args.disk
            # The system being installed: when --disk holds its root partition, record
            # on_root_disk and root_part_uuid as for this system, so reclaim grows that root.
            try:
                root = detect_root_layout(mountpoint=root_arg)
            except (OSError, RuntimeError, ValueError, KeyError, IndexError, subprocess.SubprocessError) as e:
                print(f"locachy-winmaint: {root_arg}: root partition not resolved ({e}); "
                      f"{target_disk} is recorded as another disk", file=sys.stderr)
                root = None
        medium = {os.path.realpath(d) for d in live_medium_disks()}
        if os.path.realpath(target_disk) in medium:
            raise RuntimeError(f"{target_disk} is the live medium; Maintenance Windows cannot go there")
        on_root = root is not None and os.path.realpath(target_disk) == os.path.realpath(root["disk"])
        gpt = root["gpt"] if on_root else parse_gpt_disk(target_disk)

        need_sectors = (WIN_ESP_MIB + WIN_MSR_MIB + size_gib * 1024) * 2048
        avail_sectors, _ = free_tail_sectors(gpt)

        # Case A: Online zero-reboot creation if free tail space suffices.
        if avail_sectors >= need_sectors:
            new_gpt, triplet = append_tail_triplet_sfdisk(target_disk, size_gib, is_image=False)
            format_winmaint_esp_and_msr(target_disk, triplet, is_image=False)
            state = state_from_gpt(new_gpt, target_disk, on_root_disk=on_root,
                                   root_part_uuid=root["part_uuid"] if on_root else "")
            save_state(state, state_path)
            write_container_conf(root_arg)
            print(f"locachy-winmaint: created tail triplet online on {target_disk} (no reboot required)")
            return 0

        if not on_root or not live:  # --root never shrinks a root partition
            raise RuntimeError(
                f"{target_disk}: only {avail_sectors // 2048} MiB unallocated tail space, "
                f"need {need_sectors // 2048} MiB"
            )

        # Case B: One-shot offline root shrink plan in initramfs.
        total_b, used_b, min_b = measure_ext4_usage(root["root_fs_dev"])
        plan = compute_shrink_plan(
            root_part_uuid=root["part_uuid"],
            root_luks=root["is_luks"],
            cur_part_sectors=root["part_sectors"],
            fs_total_bytes=total_b,
            fs_used_bytes=used_b,
            fs_min_bytes=min_b,
            win_c_gib=size_gib,
            luks_payload_offset_sectors=root["luks_payload_offset_sectors"],
        )
        atomic_write_text(SHRINK_PLAN_FILE, format_shrink_plan(plan), mode=0o600)
        if not args.no_boot_rebuild:
            run_cmd([str(boot_helper_path())])
        print(f"locachy-winmaint: armed one-shot offline shrink plan for {size_gib} GiB Windows C:; reboot to apply")
        return 0


def cmd_finalize_create(args):
    if os.geteuid() != 0:
        raise RuntimeError("locachy-winmaint finalize-create must run as root")
    status_file = SHRINK_STATUS_RUN if SHRINK_STATUS_RUN.is_file() else SHRINK_STATUS_VAR
    if not status_file.is_file():
        return 0
    kv = parse_kv_file(status_file)
    try:
        if kv.get("status") == "ok":
            disk = kv.get("disk")
            if not disk:
                raise RuntimeError("shrink status missing disk path")
            root = detect_root_layout()
            gpt = parse_gpt_disk(disk)
            triplet = find_winmaint_triplet(gpt)
            if not triplet:
                raise RuntimeError(f"tail triplet missing on {disk} after shrink")
            format_winmaint_esp_and_msr(disk, triplet, is_image=False)
            state = state_from_gpt(gpt, disk, on_root_disk=(os.path.realpath(disk) == os.path.realpath(root["disk"])),
                                   root_part_uuid=root["part_uuid"])
            save_state(state)
            write_container_conf("/")
            sanitize_esp_blockdev(partition_child(disk, triplet["esp"]["partn"]))
            print(f"locachy-winmaint: finalized tail triplet on {disk}")
        else:
            print(f"locachy-winmaint: offline shrink reported failure: {kv.get('reason', 'unknown')}", file=sys.stderr)
    finally:
        SHRINK_PLAN_FILE.unlink(missing_ok=True)
        SHRINK_STATUS_RUN.unlink(missing_ok=True)
        if not args.no_boot_rebuild and boot_helper_path().is_file():
            run_cmd([str(boot_helper_path())], check=False)
    return 0 if kv.get("status") == "ok" else 1


def cmd_reclaim(args):
    is_image = bool(args.image)
    if not is_image and os.geteuid() != 0:
        raise RuntimeError("locachy-winmaint reclaim must run as root")

    lock_ctx = contextlib.nullcontext() if is_image else WinmaintLock()
    with lock_ctx:
        if is_image:
            state = load_state(args.state_file)
            if not state:
                raise RuntimeError("--state-file is required with --image")
            res = reclaim_tail_triplet(args.image, state, is_image=True, grow_root=True)
            print(json.dumps(res, indent=2, sort_keys=True))
            return 0

        if SHRINK_PLAN_FILE.is_file() and not STATE_FILE.is_file():
            SHRINK_PLAN_FILE.unlink(missing_ok=True)
            if boot_helper_path().is_file():
                run_cmd([str(boot_helper_path())], check=False)
            print("locachy-winmaint: cancelled armed shrink plan")
            return 0

        state = load_state()
        if not state:
            raise RuntimeError("Maintenance Windows is not configured")

        if not args.force_no_efi and EFI_DIR.is_dir():
            run_cmd([
                str(efi_helper_path()),
                "--remove-entry",
                "--label", WIN_EFI_LABEL,
                "--partuuid", state["partitions"]["esp"]["part_guid"],
            ], check=False)

        root = detect_root_layout()
        disk, _gpt = resolve_state_disk(state)
        res = reclaim_tail_triplet(disk, state, is_image=False, grow_root=True, root_info=root)
        STATE_FILE.unlink(missing_ok=True)
        OVMF_VARS_STATE.unlink(missing_ok=True)
        SHRINK_PLAN_FILE.unlink(missing_ok=True)
        remove_container_conf("/")
        if EFI_DIR.is_dir() and Path("/efi/EFI/locachy/locachy.efi").is_file():
            run_cmd([str(efi_helper_path()), "--ensure-first", "--esp", "/efi"], check=False)
        print(f"locachy-winmaint: reclaimed partitions {res['deleted']} online (grew_root={res['grew_root']})")
        return 0


def cmd_sanitize_esp(args):
    if args.image:
        if args.offset_sectors is None:
            gpt = parse_gpt_disk(args.image)
            triplet = find_winmaint_triplet(gpt)
            if not triplet:
                raise RuntimeError("No LOCACHY_WIN_ESP found in image")
            offset = triplet["esp"]["start_lba"]
        else:
            offset = args.offset_sectors
        info = sanitize_esp_image(args.image, offset)
        print(json.dumps(info, indent=2, sort_keys=True))
        return 0

    if os.geteuid() != 0:
        raise RuntimeError("locachy-winmaint sanitize-esp must run as root on block devices")
    part = args.part
    if not part:
        state = load_state()
        if not state:
            return 0
        disk, gpt = resolve_state_disk(state)
        triplet = verify_state_against_gpt(state, gpt)
        part = partition_child(disk, triplet["esp"]["partn"])
    info = sanitize_esp_blockdev(part)
    if info["removed"]:
        print(f"locachy-winmaint: removed {', '.join(info['removed'])} from {part}")
    return 0


def ensure_first_argv(esp, state, part_guid=None):
    """locachy-efi --ensure-first for this state: with --keep-windows-first while the
    Windows-first mode is recorded, so no heal undoes it."""
    cmd = [str(efi_helper_path()), "--ensure-first", "--esp", esp]
    guid = part_guid or (state["partitions"]["esp"]["part_guid"] if state else None)
    if guid:
        cmd += ["--winmaint-guid", guid]
    if boot_default_of(state) == "windows":
        cmd.append("--keep-windows-first")
    return cmd


def windows_first_released(res, state, state_path=None):
    """After ensure_first_argv: exit 3 means the Windows-first entry no longer preceded LOCachy
    (Return to LOCachy in Windows, or the firmware dropped it) and LOCachy is first again, so
    the mode ends here too: its entry is deleted and state.json says LOCachy."""
    if res.returncode != EFI_RELEASED or boot_default_of(state) != "windows":
        return False
    run_cmd([str(efi_helper_path()), "--remove-entry", "--label", WIN_FIRST_LABEL], check=False)
    clear_boot_default(state)
    save_state(state, state_path)
    print("locachy-winmaint: LOCachy starts first again (Windows-first mode ended outside LOCachy)")
    return True


def cmd_heal_boot(args):
    if os.geteuid() != 0:
        raise RuntimeError("locachy-winmaint heal-boot must run as root")
    state = load_state()
    res = run_cmd(ensure_first_argv(args.esp, state), check=False)
    if res.returncode not in (0, EFI_RELEASED):
        raise RuntimeError(res.stderr.strip() or res.stdout.strip() or f"locachy-efi exit {res.returncode}")
    if not windows_first_released(res, state) and boot_default_of(state) == "windows":
        print("locachy-winmaint: Windows stays first (boot-default windows), LOCachy second; "
              "boot-default locachy switches back")
    return 0


def cmd_boot_guard(args):
    if os.geteuid() != 0:
        raise RuntimeError("locachy-winmaint boot-guard must run as root")
    state = load_state()
    if not state:
        return 0
    with WinmaintLock():
        disk, gpt = resolve_state_disk(state)
        triplet = verify_state_against_gpt(state, gpt)
        esp_dev = partition_child(disk, triplet["esp"]["partn"])
        try:
            sanitize_esp_blockdev(esp_dev)
        except Exception as e:
            print(f"locachy-winmaint: boot-guard sanitize warning: {e}", file=sys.stderr)
        if EFI_DIR.is_dir() and Path(args.esp, "EFI/locachy/locachy.efi").is_file():
            res = run_cmd(ensure_first_argv(args.esp, state, triplet["esp"]["part_guid"]), check=False)
            windows_first_released(res, state)
    return 0


def cmd_boot_once(args):
    if os.geteuid() != 0 and not args.allow_unprivileged_test:
        raise RuntimeError("locachy-winmaint boot-once must run as root")
    with WinmaintLock():
        state = load_state(args.state_file)
        if not state:
            raise RuntimeError("Maintenance Windows is not configured")
        if boot_default_of(state) == "windows":
            # Arming BootNext would heal BootOrder to LOCachy first and so end the mode.
            print("locachy-winmaint: Windows already starts first (boot-default windows); nothing to arm")
            if args.reboot:
                request_reboot()
            return 0
        disk, gpt = resolve_state_disk(state)
        triplet = verify_state_against_gpt(state, gpt)
        esp_part = triplet["esp"]
        esp_dev = partition_child(disk, esp_part["partn"])

        # Layer-1 check + verify Windows Boot Manager exists before arming BootNext.
        if not args.skip_esp_check:
            info = sanitize_esp_blockdev(esp_dev)
            if not info["bootmgfw_present"]:
                raise RuntimeError(
                    f"{esp_dev}: \\EFI\\Microsoft\\Boot\\bootmgfw.efi not found; install Windows in VM first"
                )

        # Layer-3 + Layer-4: keep LOCachy first in BootOrder, never add WinMaint
        # to BootOrder, arm one-shot BootNext.
        run_cmd([
            str(efi_helper_path()),
            "--bootnext-entry",
            "--disk", disk,
            "--part", str(esp_part["partn"]),
            "--partuuid", esp_part["part_guid"],
            "--label", WIN_EFI_LABEL,
            "--loader", WIN_EFI_LOADER,
            "--esp", args.esp,
        ])
        print("locachy-winmaint: one-shot BootNext armed for Maintenance Windows; BootOrder keeps LOCachy first")
        if args.reboot:
            request_reboot()
    return 0


def cmd_boot_default(args):
    """windows: the Windows-first entry first in BootOrder, LOCachy second (never removed), the
    mode in state.json; the Windows-side guard stands down while it precedes LOCachy.
    locachy: LOCachy first again, the entry deleted, the mode cleared (the guard re-arms)."""
    if os.geteuid() != 0 and not args.allow_unprivileged_test:
        raise RuntimeError("locachy-winmaint boot-default must run as root")
    with WinmaintLock():
        state = load_state(args.state_file)
        if not state:
            raise RuntimeError("Maintenance Windows is not configured")
        disk, gpt = resolve_state_disk(state)
        triplet = verify_state_against_gpt(state, gpt)
        esp_part = triplet["esp"]
        efi = str(efi_helper_path())
        if args.mode == "windows":
            if not args.skip_esp_check:
                esp_dev = partition_child(disk, esp_part["partn"])
                info = sanitize_esp_blockdev(esp_dev)
                if not info["bootmgfw_present"]:
                    raise RuntimeError(
                        f"{esp_dev}: \\EFI\\Microsoft\\Boot\\bootmgfw.efi not found; install Windows in VM first"
                    )
            run_cmd([efi, "--windows-first", "--disk", disk, "--part", str(esp_part["partn"]),
                     "--partuuid", esp_part["part_guid"], "--loader", WIN_EFI_LOADER, "--esp", args.esp])
            state["boot_default"] = "windows"
            state["boot_default_boot_id"] = current_boot_id()
            save_state(state, args.state_file)
            print("locachy-winmaint: Windows starts first until switched back (boot-default locachy here, "
                  "or Return to LOCachy on the Windows desktop); LOCachy stays second in BootOrder")
        else:
            run_cmd([efi, "--ensure-first", "--esp", args.esp, "--winmaint-guid", esp_part["part_guid"]])
            res = run_cmd([efi, "--remove-entry", "--label", WIN_FIRST_LABEL], check=False)
            if res.returncode:
                print(f"locachy-winmaint: warning: {WIN_FIRST_LABEL} entry not deleted (it is out of BootOrder): "
                      f"{res.stderr.strip()}", file=sys.stderr)
            clear_boot_default(state)
            save_state(state, args.state_file)
            print("locachy-winmaint: LOCachy starts first again")
        if args.reboot:
            request_reboot()
    return 0


def cmd_build_seed(args):
    virtio_iso = find_virtio_iso(args.virtio_iso) if args.virtio_iso else None
    out = build_seed_image(args.output, virtio_iso=virtio_iso, virtio_os=args.virtio_os)
    print(f"locachy-winmaint: wrote seed image {out}")
    return 0


def cmd_driver_seed(args):
    """Prints only the image's absolute path (the contract locachy-app reads)."""
    out = build_driver_seed(args.out, find_virtio_iso(args.virtio_iso), virtio_os=args.virtio_os)
    print(out)
    return 0


def cmd_build_virtual_gpt(args):
    gpt = parse_gpt_disk(args.disk)
    triplet = find_winmaint_triplet(gpt)
    if not triplet:
        raise RuntimeError(f"{args.disk}: Maintenance Windows tail triplet not found")
    head, tail, layout = build_virtual_gpt_blobs(gpt["disk_guid"], triplet)
    Path(args.head_out).write_bytes(head)
    Path(args.tail_out).write_bytes(tail)
    print(json.dumps(layout, indent=2, sort_keys=True))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="locachy-winmaint", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("status", help="show Maintenance Windows partition and lock state")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("create", help="create tail partitions online or arm one-shot initramfs shrink")
    p.add_argument("--size-gib", type=int,
                   default=read_rc_int("winmaint_size_gib", DEFAULT_WIN_C_GIB, MIN_WIN_C_GIB, MAX_WIN_C_GIB))
    p.add_argument("--disk", default=None, help="target disk (defaults to root disk)")
    p.add_argument("--image", default=None, help="raw disk image for offline/test creation")
    p.add_argument("--state-file", default=None)
    p.add_argument("--root", default="/",
                   help="root of the system to record (default: this system); with --root --disk is required")
    p.add_argument("--no-boot-rebuild", action="store_true")
    p.set_defaults(func=cmd_create)

    p = sub.add_parser("finalize-create", help="post-boot format/record after offline initramfs shrink")
    p.add_argument("--no-boot-rebuild", action="store_true")
    p.set_defaults(func=cmd_finalize_create)

    p = sub.add_parser("reclaim", help="delete tail partitions and grow root online with zero reboot")
    p.add_argument("--image", default=None)
    p.add_argument("--state-file", default=None)
    p.add_argument("--force-no-efi", action="store_true")
    p.set_defaults(func=cmd_reclaim)

    p = sub.add_parser("vm", help="launch Windows inside QEMU/KVM over dm-linear NVMe wrapper")
    p.add_argument("--iso", default=None, help="Windows installation ISO")
    p.add_argument("--virtio-iso", default=None,
                   help="virtio-win.iso (a regular file) for $WinPEDriver$ on the seed and a second CD")
    p.add_argument("--virtio-os", choices=VIRTIO_OS_CHOICES, default="w11",
                   help="Windows tree inside virtio-win (default: w11)")
    p.add_argument("--seed", action="store_true", help="attach autounattend/hardening seed image")
    p.add_argument("--memory", type=int, default=4096)
    p.add_argument("--cpus", type=int, default=4)
    p.add_argument("--disk-bus", choices=VM_DISK_BUSES, default="nvme",
                   help="disk controller: nvme (default, matches bare metal) or virtio (virtio-blk + iothread)")
    p.add_argument("--nic", choices=VM_NICS, default="e1000e",
                   help="network device: e1000e (default, Windows inbox) or virtio (NetKVM)")
    p.add_argument("--share-dir", action="append", default=[], metavar="PATH[:TAG]",
                   help="share host directory into Windows via virtiofs (repeatable)")
    p.add_argument("--display", default=None)
    p.add_argument("--vnc", default=None)
    p.add_argument("--qmp-sock", default=None,
                   help="QMP unix control socket (also LOCACHY_VM_QMP_SOCK)")
    p.add_argument("--no-tpm", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_vm)

    p = sub.add_parser("vm-stop", help="ask a running Maintenance Windows VM to shut down via QMP")
    p.add_argument("--qmp-sock", default=None)
    p.add_argument("--wait", type=float, default=15.0)
    p.add_argument("--timeout", type=float, default=5.0)
    p.add_argument("--quit-after", action="store_true", help="send QMP quit if the VM is still up after --wait")
    p.add_argument("--powerdown-only", action="store_true", help="send system_powerdown and return immediately")
    p.set_defaults(func=cmd_vm_stop)

    p = sub.add_parser("boot-once", help="arm one-shot UEFI BootNext for bare-metal Maintenance Windows")
    p.add_argument("--reboot", action="store_true")
    p.add_argument("--esp", default="/efi")
    p.add_argument("--state-file", default=None)
    p.add_argument("--skip-esp-check", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--allow-unprivileged-test", action="store_true", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_boot_once)

    p = sub.add_parser("boot-default", help="start Windows first until switched back, or LOCachy first again")
    p.add_argument("mode", choices=BOOT_DEFAULTS)
    p.add_argument("--reboot", action="store_true")
    p.add_argument("--esp", default="/efi")
    p.add_argument("--state-file", default=None)
    p.add_argument("--skip-esp-check", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--allow-unprivileged-test", action="store_true", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_boot_default)

    p = sub.add_parser("sanitize-esp", help="strip \\EFI\\BOOT\\BOOTX64.EFI from Maintenance Windows ESP")
    p.add_argument("--part", default=None)
    p.add_argument("--image", default=None)
    p.add_argument("--offset-sectors", type=int, default=None)
    p.set_defaults(func=cmd_sanitize_esp)

    p = sub.add_parser("heal-boot", help="ensure LOCachy stays first in UEFI BootOrder")
    p.add_argument("--esp", default="/efi")
    p.set_defaults(func=cmd_heal_boot)

    p = sub.add_parser("boot-guard", help="post-boot Layer-1 + Layer-4 protection check")
    p.add_argument("--esp", default="/efi")
    p.set_defaults(func=cmd_boot_guard)

    p = sub.add_parser("build-seed", help="build the FAT seed image with autounattend.xml and scripts")
    p.add_argument("--output", required=True)
    p.add_argument("--virtio-iso", default=None, help="virtio-win ISO (a regular file) to stage $WinPEDriver$ from")
    p.add_argument("--virtio-os", choices=VIRTIO_OS_CHOICES, default="w11")
    p.set_defaults(func=cmd_build_seed)

    p = sub.add_parser("driver-seed", help="build a FAT image with $WinPEDriver$ viostor and NetKVM; print its path")
    p.add_argument("--virtio-iso", required=True, help="virtio-win ISO (a regular file)")
    p.add_argument("--out", required=True, help="image to write (replaced)")
    p.add_argument("--virtio-os", choices=VIRTIO_OS_CHOICES, default="w11")
    p.set_defaults(func=cmd_driver_seed)

    p = sub.add_parser("build-virtual-gpt", help="build virtual dm-linear GPT head/tail blobs for a disk")
    p.add_argument("--disk", required=True)
    p.add_argument("--head-out", required=True)
    p.add_argument("--tail-out", required=True)
    p.set_defaults(func=cmd_build_virtual_gpt)

    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as e:
        print(f"locachy-winmaint: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
