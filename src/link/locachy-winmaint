def read_rc_int(key, default, lo, hi):
    try:
        text = RC_CONF_PATH.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return default
    val = None
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        if k.strip() != key:
            continue
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in ('"', "'"):
            v = v[1:-1]
        if v.isdigit():
            n = int(v)
            if lo <= n <= hi:
                val = n
    return default if val is None else val

