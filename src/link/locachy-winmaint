def detect_root_layout():
    """Inspect active LOCachy root filesystem, LUKS2 status, and underlying disk/partition."""
    fm = json.loads(run_cmd(["findmnt", "--json", "--mountpoint", "/", "--output", "SOURCE,FSTYPE"]).stdout)
    root_fs_dev = os.path.realpath(fm["filesystems"][0]["source"])
    is_luks = False
    phys_part = root_fs_dev
    luks_payload_offset = 32768

    blk = json.loads(run_cmd(["lsblk", "--json", "--paths", "--inverse", "--output",
                              "PATH,TYPE,PKNAME,PARTN,PARTUUID,PTTYPE", root_fs_dev]).stdout)
    node = blk["blockdevices"][0]
    if node.get("type") == "crypt":
        is_luks = True
        children = node.get("children") or []
        if not children:
            raise RuntimeError(f"Cannot resolve underlying partition for LUKS device {root_fs_dev}")
        phys_part = children[0]["path"]
        dump = run_cmd(["cryptsetup", "luksDump", phys_part]).stdout
        m = re.search(r"offset:\s*(\d+)\s*\[bytes\]", dump)
        if m:
            luks_payload_offset = int(m.group(1)) // SECTOR_SIZE

    part_info = json.loads(run_cmd(["lsblk", "--json", "--nodeps", "--paths", "--properties-by", "blkid",
                                    "--output", "PATH,TYPE,PKNAME,PARTN,PARTUUID,PTTYPE", phys_part]).stdout)
    p = part_info["blockdevices"][0]
    if p.get("type") != "part" or p.get("pttype") != "gpt":
        raise RuntimeError(f"Root device {phys_part} is not a GPT partition")
    disk = p["pkname"]
    partn = int(p["partn"])
    partuuid = str(uuid.UUID(p["partuuid"])).lower()

    gpt = parse_gpt_disk(disk)
    cur_part = next((x for x in gpt["partitions"] if x["partn"] == partn), None)
    if not cur_part:
        raise RuntimeError(f"Root partition {partn} not found in GPT of {disk}")

    return {
        "root_fs_dev": root_fs_dev,
        "phys_part": phys_part,
        "disk": disk,
        "partn": partn,
        "part_uuid": partuuid,
        "is_luks": is_luks,
        "luks_payload_offset_sectors": luks_payload_offset,
        "part_start_lba": cur_part["start_lba"],
        "part_end_lba": cur_part["end_lba"],
        "part_sectors": cur_part["sectors"],
        "gpt": gpt,
    }


def measure_ext4_usage(dev):
    """Return (total_bytes, used_bytes, min_bytes) for an ext4 device."""
    dump = run_cmd(["dumpe2fs", "-h", dev]).stdout
    def grab(pattern):
        m = re.search(pattern, dump)
        if not m:
            raise RuntimeError(f"dumpe2fs missing {pattern} on {dev}")
        return int(m.group(1))

    block_size = grab(r"Block size:\s*(\d+)")
    block_count = grab(r"Block count:\s*(\d+)")
    free_blocks = grab(r"Free blocks:\s*(\d+)")
    total_bytes = block_count * block_size
    used_bytes = max(0, (block_count - free_blocks) * block_size)

    r = run_cmd(["resize2fs", "-P", dev], check=False)
    min_bytes = used_bytes
    m = re.search(r"Estimated minimum size of the filesystem:\s*(\d+)", r.stdout + "\n" + r.stderr)
    if m:
        min_bytes = int(m.group(1)) * block_size
    return total_bytes, used_bytes, min_bytes


def free_tail_sectors(gpt):
    """Contiguous unallocated sectors after the last partition up to last_lba."""
    if not gpt["partitions"]:
        start = max(ALIGN_SECTORS, gpt["first_lba"])
    else:
        last_end = max(p["end_lba"] for p in gpt["partitions"])
        start = ((last_end + ALIGN_SECTORS) // ALIGN_SECTORS) * ALIGN_SECTORS
    if start > gpt["last_lba"]:
        return 0, start
    return gpt["last_lba"] - start + 1, start


