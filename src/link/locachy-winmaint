def compute_shrink_plan(
    root_part_uuid,
    root_luks,
    cur_part_sectors,
    fs_total_bytes,
    fs_used_bytes,
    fs_min_bytes,
    win_c_gib,
    luks_payload_offset_sectors=32768,
    win_esp_mib=WIN_ESP_MIB,
    win_msr_mib=WIN_MSR_MIB,
):
    """Validate free space and compute exact 1-MiB-aligned offline shrink targets."""
    if not (MIN_WIN_C_GIB <= int(win_c_gib) <= MAX_WIN_C_GIB):
        raise ValueError(f"Windows C: size must be between {MIN_WIN_C_GIB} and {MAX_WIN_C_GIB} GiB")
    win_c_mib = int(win_c_gib) * 1024
    need_tail_mib = int(win_esp_mib) + int(win_msr_mib) + win_c_mib
    need_tail_sectors = need_tail_mib * 2048
    if cur_part_sectors <= need_tail_sectors + MIN_ROOT_TOTAL_GIB * 1024 * 2048:
        raise RuntimeError("Root partition is too small to carve out the requested Windows partitions")

    part_target_sectors = ((cur_part_sectors - need_tail_sectors) // ALIGN_SECTORS) * ALIGN_SECTORS
    if root_luks:
        overhead = max(int(luks_payload_offset_sectors) + 32768, LUKS2_MIN_OVERHEAD_SECTORS)
        if part_target_sectors <= overhead + MIN_ROOT_TOTAL_GIB * 1024 * 2048:
            raise RuntimeError("Insufficient room left for LUKS2 root after shrink")
        luks_target_sectors = ((part_target_sectors - overhead) // ALIGN_SECTORS) * ALIGN_SECTORS
        # Keep ext4 8 MiB inside the LUKS2 payload boundary.
        fs_target_sectors = ((luks_target_sectors - 16384) // ALIGN_SECTORS) * ALIGN_SECTORS
    else:
        luks_target_sectors = 0
        fs_target_sectors = ((part_target_sectors - 16384) // ALIGN_SECTORS) * ALIGN_SECTORS

    fs_target_kib = fs_target_sectors // 2
    fs_target_bytes = fs_target_kib * 1024

    min_required_free = fs_used_bytes + MIN_ROOT_FREE_GIB * (1024 ** 3)
    min_required_resize = fs_min_bytes + 4 * (1024 ** 3)
    min_required = max(min_required_free, min_required_resize, MIN_ROOT_TOTAL_GIB * (1024 ** 3))
    if fs_target_bytes < min_required:
        avail_gib = max(0.0, (fs_total_bytes - min_required) / (1024 ** 3))
        raise RuntimeError(
            f"Not enough free space on LOCachy root (must keep at least {MIN_ROOT_FREE_GIB} GiB free; "
            f"maximum reclaimable is ~{avail_gib:.1f} GiB)"
        )
    if fs_target_bytes >= fs_total_bytes:
        raise RuntimeError("Computed target filesystem size is not smaller than current root filesystem")

    return {
        "version": 1,
        "action": "shrink-create",
        "root_part_uuid": str(uuid.UUID(root_part_uuid)).lower(),
        "root_luks": 1 if root_luks else 0,
        "fs_target_kib": int(fs_target_kib),
        "luks_target_sectors": int(luks_target_sectors),
        "part_target_sectors": int(part_target_sectors),
        "win_esp_mib": int(win_esp_mib),
        "win_msr_mib": int(win_msr_mib),
        "win_c_mib": int(win_c_mib),
    }


def format_shrink_plan(plan):
    keys = (
        "version",
        "action",
        "root_part_uuid",
        "root_luks",
        "fs_target_kib",
        "luks_target_sectors",
        "part_target_sectors",
        "win_esp_mib",
        "win_msr_mib",
        "win_c_mib",
    )
    return "".join(f"{k}={plan[k]}\n" for k in keys)


def parse_kv_file(path):
    out = {}
    for line in Path(path).read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip()] = v.strip()
    return out


