def winiso_helper_path():
    """locachy-winiso (installation ISOs), next to this program or installed; None without it."""
    for cand in (Path(__file__).with_name("locachy-winiso"), Path("/usr/local/bin/locachy-winiso")):
        if cand.is_file() and os.access(cand, os.X_OK):
            return cand
    return None


def winiso_path(kind):
    """`locachy-winiso path KIND` (windows, virtio-win): its one absolute path, or None when
    the command is absent, has no such ISO (exit 3) or answers anything else (warned)."""
    helper = winiso_helper_path()
    if helper is None:
        return None
    try:
        res = run_cmd([str(helper), "path", kind], check=False, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"locachy-winmaint: warning: locachy-winiso path {kind}: {e}", file=sys.stderr)
        return None
    if res.returncode == WINISO_UNAVAILABLE:
        return None
    lines = [line.strip() for line in res.stdout.splitlines() if line.strip()]
    path = lines[0] if res.returncode == 0 and len(lines) == 1 else ""
    try:
        regular = os.path.isabs(path) and stat.S_ISREG(os.stat(path).st_mode)
    except OSError:
        regular = False
    if not regular:
        why = res.stderr.strip() or f"exit {res.returncode}, output {res.stdout.strip()!r}"
        print(f"locachy-winmaint: warning: locachy-winiso path {kind} gave no usable path ({why})", file=sys.stderr)
        return None
    return path


