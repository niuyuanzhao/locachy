"""locachy-winmaint: Maintenance Windows tail partition manager.

Manages an isolated, reclaimable tail GPT partition triplet:
  p4 (LOCACHY_WIN_ESP, 128 MiB FAT32, never keeps \\EFI\\BOOT\\BOOTX64.EFI)
  p5 (LOCACHY_WIN_MSR, 16 MiB Microsoft Reserved)
  p6 (LOCACHY_WIN_C, 40..4096 GiB NTFS, default 48 GiB)

Subcommands:
  status [--json]
  create --size-gib N [--disk /dev/...] [--image FILE] [--no-boot-rebuild]
  finalize-create [--no-boot-rebuild]
  reclaim [--disk /dev/...] [--image FILE] [--force-no-efi]
  vm [--iso FILE] [--virtio-iso FILE] [--memory MIB] [--cpus N]
     [--disk-bus nvme|virtio] [--nic e1000e|virtio] [--share-dir PATH[:TAG]]
     [--display SPEC | --vnc ADDR] [--qmp-sock PATH] [--no-tpm] [--dry-run]
  vm-stop [--qmp-sock PATH] [--wait SEC] [--quit-after] [--powerdown-only]
  boot-once [--reboot] [--esp /efi]
  boot-default windows|locachy [--reboot] [--esp /efi]
  sanitize-esp [--part DEV | --image FILE --offset-sectors N]
  heal-boot [--esp /efi]
  boot-guard [--esp /efi]
  build-seed --output FILE [--virtio-iso FILE]
  driver-seed --virtio-iso PATH --out IMG [--virtio-os w11|w10]
  build-virtual-gpt --disk PATH --head-out FILE --tail-out FILE
"""
