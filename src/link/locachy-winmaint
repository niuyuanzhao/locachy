# Shared by the guard and the Return to LOCachy script: parses `bcdedit /enum firmware /v` by
# block structure and invariant values, never localized field labels (such as English
# identifier/displayorder/description vs Chinese/German/etc.):
# - Blocks are separated by blank lines or a '---...' underline.
# - The first line in a block ending in a {GUID} (or {fwbootmgr}/{bootmgr}) is its identifier;
#   {fwbootmgr} is {a5a30fa2-3d06-4e9f-b5f4-a01df9d1fcba} under /v (both recognised).
# - Inside {fwbootmgr}'s block, the first field after identifier whose value is a {...} is
#   displayorder (plus all indented continuation {...} lines); stops at the next key-value line.
# - Inside every other block, a key-value line whose value equals one of the exact ASCII UEFI
#   descriptions written by locachy-efi (never localized) identifies that entry.
# Keep pure ASCII: Windows PowerShell 5.1 reads UTF-8 without BOM in the system ANSI codepage.
FIRMWARE_PS_FUNCTIONS = r"""function Get-LOCachyFirmware {
    $fw = @{ Order = @(); LOCachy = $null; WinMaint = @(); WinFirst = @() }
    $lines = bcdedit /enum firmware /v
    if (-not $lines) { return $fw }
    $fwMgr = '{a5a30fa2-3d06-4e9f-b5f4-a01df9d1fcba}'
    $current = $null
    $isFwMgr = $false
    $orderState = 0  # 0: before displayorder, 1: collecting displayorder, 2: finished
    foreach ($line in $lines) {
        if ($line -match '^\s*$' -or $line -match '^\s*-{3,}\s*$') {
            $current = $null
            $isFwMgr = $false
            $orderState = 0
            continue
        }
        if (-not $current) {
            if ($line -match '^\s*\S.*?\s+(\{(?:[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}|fwbootmgr|bootmgr)\})\s*$') {
                $current = $Matches[1].ToLowerInvariant()
                $isFwMgr = ($current -eq '{fwbootmgr}' -or $current -eq $fwMgr)
                $orderState = 0
            }
            continue
        }
        if ($isFwMgr) {
            # The first key line after the identifier is displayorder (its first entry is on that
            # line); indented GUID lines continue it; any other key line (bootsequence, timeout) ends it.
            if ($orderState -eq 0) {
                if ($line -match '^\s*\S.*?\s+(\{(?:[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}|[a-zA-Z0-9_-]+)\})\s*$') {
                    $fw.Order += $Matches[1].ToLowerInvariant()
                    $orderState = 1
                } else {
                    $orderState = 2
                }
                continue
            }
            if ($orderState -eq 1) {
                if ($line -match '^\s+(\{(?:[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}|[a-zA-Z0-9_-]+)\})\s*$') {
                    $fw.Order += $Matches[1].ToLowerInvariant()
                } else {
                    $orderState = 2
                }
            }
            continue
        }
        $val = $null
        if ($line -match '^\s*\S.*?\s{2,}(.+?)\s*$') {
            $val = $Matches[1]
        } elseif ($line -match '^\s*\S+\s+(.+?)\s*$') {
            $val = $Matches[1]
        }
        if ($null -eq $val) { continue }
        if ($val -ceq 'LOCachy') {
            $fw.LOCachy = $current
        } elseif ($val -ceq 'LOCachy Maintenance Windows') {
            $fw.WinMaint += $current
        } elseif ($val -ceq 'LOCachy Maintenance Windows (default)') {
            $fw.WinFirst += $current
        }
    }
    return $fw
}

# Windows first (locachy-winmaint boot-default windows) while an entry described as
# 'LOCachy Maintenance Windows (default)' precedes LOCachy in {fwbootmgr}'s display order.
function Test-LOCachyWindowsFirst($fw) {
    $loc = -1
    if ($fw.LOCachy) { $loc = [array]::IndexOf([object[]]$fw.Order, $fw.LOCachy) }
    foreach ($id in $fw.WinFirst) {
        $i = [array]::IndexOf([object[]]$fw.Order, $id)
        if ($i -ge 0 -and ($loc -lt 0 -or $i -lt $loc)) { return $true }
    }
    return $false
}
"""

