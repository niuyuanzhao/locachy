        "-device", "usb-tablet,bus=xhci.0",
        "-netdev", "user,id=net0",
        "-device", "e1000e,netdev=net0",
    ]
    if tpm_sock:
        argv += [
            "-chardev", f"socket,id=chrtpm,path={tpm_sock}",
            "-tpmdev", "emulator,id=tpm0,chardev=chrtpm",
            "-device", "tpm-tis,tpmdev=tpm0",
        ]
    if iso_path:
        argv += [
            "-drive", f"file={iso_path},media=cdrom,readonly=on,if=none,id=cd0",
            "-device", "ide-cd,drive=cd0,bootindex=1",
        ]
    if seed_path:
        argv += [
            "-drive", f"file={seed_path},format=raw,readonly=on,if=none,id=seed0",
            "-device", "usb-storage,drive=seed0,bus=xhci.0",
        ]
    if vnc_addr:
        argv += ["-display", "none", "-vnc", vnc_addr]
    elif display_spec:
        argv += ["-display", display_spec]
    elif os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"):
        argv += ["-display", "gtk"]
    else:
        argv += ["-display", "none", "-vnc", "127.0.0.1:0"]
    return argv


def cmd_vm(args):
    if os.geteuid() != 0 and not args.dry_run:
        raise RuntimeError("locachy-winmaint vm must run as root")
    state = load_state()
    if not state:
        raise RuntimeError("Maintenance Windows is not configured (run 'locachy-winmaint create' first)")
    disk = state["disk"]
    gpt = parse_gpt_disk(disk)
    triplet = verify_state_against_gpt(state, gpt)
    esp_dev = partition_child(disk, triplet["esp"]["partn"])
    msr_dev = partition_child(disk, triplet["msr"]["partn"])
    c_dev = partition_child(disk, triplet["c"]["partn"])

    ovmf_code = pick_first_existing(OVMF_CODE_CANDIDATES)
    ovmf_vars_tpl = pick_first_existing(OVMF_VARS_CANDIDATES)
    if not ovmf_code or not ovmf_vars_tpl:
        raise RuntimeError("OVMF firmware images not found under /usr/share/edk2/x64")

    if args.iso and not Path(args.iso).is_file():
        raise RuntimeError(f"ISO not found: {args.iso}")

    with WinmaintLock():
        for pdev in (esp_dev, msr_dev, c_dev):
            fm = run_cmd(["findmnt", "--noheadings", "--source", pdev], check=False)
            if fm.returncode == 0 and fm.stdout.strip():
                raise RuntimeError(f"{pdev} is mounted; unmount it before launching VM")

        head_bytes, tail_bytes, layout = build_virtual_gpt_blobs(state["disk_guid"], triplet)
        if args.dry_run:
            table = dm_linear_table("/dev/loopX", esp_dev, msr_dev, c_dev, "/dev/loopY", layout)
            argv = build_qemu_argv(
                f"/dev/mapper/{DM_NAME}",
                ovmf_code,
                str(OVMF_VARS_STATE),
                memory_mib=args.memory,
                cpus=args.cpus,
                iso_path=args.iso,
                seed_path=str(RUN_DIR / "seed.img") if (args.iso or args.seed) else None,
                tpm_sock=None if args.no_tpm else str(RUN_DIR / "swtpm.sock"),
                display_spec=args.display,
                vnc_addr=args.vnc,
            )
            print(json.dumps({"dm_table": table.splitlines(), "qemu_argv": argv}, indent=2))
            return 0

        STATE_DIR.mkdir(parents=True, exist_ok=True)
        RUN_DIR.mkdir(parents=True, exist_ok=True)
        if not OVMF_VARS_STATE.is_file():
            shutil.copyfile(ovmf_vars_tpl, OVMF_VARS_STATE)
            os.chmod(OVMF_VARS_STATE, 0o600)

        head_path = RUN_DIR / "gpt-head.img"
        tail_path = RUN_DIR / "gpt-tail.img"
        seed_path = RUN_DIR / "seed.img"
        tpm_sock = RUN_DIR / "swtpm.sock"

        head_path.write_bytes(head_bytes)
        tail_path.write_bytes(tail_bytes)
        use_seed = None
        if args.iso or args.seed:
            build_seed_image(seed_path)
            use_seed = str(seed_path)

        loop_head = None
        loop_tail = None
        dm_created = False
        swtpm_proc = None
        try:
            loop_head = run_cmd(["losetup", "--find", "--show", str(head_path)]).stdout.strip()
            loop_tail = run_cmd(["losetup", "--find", "--show", str(tail_path)]).stdout.strip()
            table = dm_linear_table(loop_head, esp_dev, msr_dev, c_dev, loop_tail, layout)
            run_cmd(["dmsetup", "create", DM_NAME], input_text=table)
            dm_created = True

            use_tpm = None
            if not args.no_tpm:
                if not shutil.which("swtpm"):
                    raise RuntimeError("swtpm is not installed (install swtpm or pass --no-tpm)")
                SWTPM_STATE_DIR.mkdir(parents=True, exist_ok=True)
                os.chmod(SWTPM_STATE_DIR, 0o700)
                tpm_sock.unlink(missing_ok=True)
                swtpm_proc = subprocess.Popen([
                    "swtpm", "socket", "--tpm2",
                    "--tpmstate", f"dir={SWTPM_STATE_DIR}",
                    "--ctrl", f"type=unixio,path={tpm_sock}",
                ])
                deadline = time.monotonic() + 5.0
                while not tpm_sock.exists() and time.monotonic() < deadline:
                    if swtpm_proc.poll() is not None:
                        raise RuntimeError(f"swtpm exited early ({swtpm_proc.returncode})")
                    time.sleep(0.05)
                if not tpm_sock.exists():
                    raise RuntimeError("swtpm control socket did not appear")
                use_tpm = str(tpm_sock)

            argv = build_qemu_argv(
                f"/dev/mapper/{DM_NAME}",
                ovmf_code,
                str(OVMF_VARS_STATE),
                memory_mib=args.memory,
                cpus=args.cpus,
                iso_path=args.iso,
                seed_path=use_seed,
                tpm_sock=use_tpm,
                display_spec=args.display,
                vnc_addr=args.vnc,
            )
            res = subprocess.run(argv)
            return res.returncode
        finally:
            if swtpm_proc is not None and swtpm_proc.poll() is None:
                swtpm_proc.terminate()
                try:
                    swtpm_proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    swtpm_proc.kill()
                    swtpm_proc.wait(timeout=5)
            tpm_sock.unlink(missing_ok=True)
            if dm_created:
                run_cmd(["dmsetup", "remove", DM_NAME], check=False)
            if loop_head:
                run_cmd(["losetup", "-d", loop_head], check=False)
            if loop_tail:
                run_cmd(["losetup", "-d", loop_tail], check=False)
            for p in (head_path, tail_path, seed_path):
                p.unlink(missing_ok=True)
            # Layer-1 defense: strip \EFI\BOOT\BOOTX64.EFI if Windows created it.
            try:
                info = sanitize_esp_blockdev(esp_dev)
                if info["removed"]:
                    print(f"locachy-winmaint: stripped fallback from {esp_dev}: {', '.join(info['removed'])}")
            except Exception as e:
                print(f"locachy-winmaint: warning: post-VM ESP sanitize failed: {e}", file=sys.stderr)


