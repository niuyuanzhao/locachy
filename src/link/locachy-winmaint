# Pure-Python GPT parser and virtual dm-linear GPT builder
# ---------------------------------------------------------------------------

def guid_to_le(guid_str):
    return uuid.UUID(str(guid_str)).bytes_le


def le_to_guid(raw16):
    return str(uuid.UUID(bytes_le=bytes(raw16))).lower()


def _device_size_bytes(fd):
    st = os.fstat(fd)
    if stat.S_ISBLK(st.st_mode):
        # Linux BLKGETSIZE64 = 0x80081272
        buf = bytearray(8)
        fcntl.ioctl(fd, 0x80081272, buf)
        return struct.unpack("<Q", buf)[0]
    return st.st_size


def parse_gpt_disk(path):
    """Read and validate a GPT disk or raw disk image without requiring root."""
    with open(path, "rb") as f:
        size_bytes = _device_size_bytes(f.fileno())
        if size_bytes < 68 * SECTOR_SIZE:
            raise RuntimeError(f"{path}: disk too small for GPT ({size_bytes} bytes)")
        total_sectors = size_bytes // SECTOR_SIZE
        f.seek(SECTOR_SIZE)
        hdr = f.read(SECTOR_SIZE)
        if len(hdr) < 92 or hdr[:8] != b"EFI PART":
            raise RuntimeError(f"{path}: missing primary GPT header")
        (sig, rev, hdr_size, hdr_crc, reserved, my_lba, alt_lba,
         first_lba, last_lba, disk_guid_raw, part_lba, num_entries,
         entry_size, entries_crc) = struct.unpack("<8sIIIIQQQQ16sQIII", hdr[:92])
        if hdr_size < 92 or hdr_size > SECTOR_SIZE:
            raise RuntimeError(f"{path}: invalid GPT header size {hdr_size}")
        hdr_check = bytearray(hdr[:hdr_size])
        hdr_check[16:20] = b"\x00\x00\x00\x00"
        if (zlib.crc32(hdr_check) & 0xFFFFFFFF) != hdr_crc:
            raise RuntimeError(f"{path}: primary GPT header CRC mismatch")
        if entry_size < 128 or num_entries == 0 or num_entries > 4096:
            raise RuntimeError(f"{path}: unsupported GPT entry table ({num_entries}x{entry_size})")
        f.seek(part_lba * SECTOR_SIZE)
        table = f.read(num_entries * entry_size)
        if (zlib.crc32(table) & 0xFFFFFFFF) != entries_crc:
            raise RuntimeError(f"{path}: primary GPT partition array CRC mismatch")
        parts = []
        zero_guid = b"\x00" * 16
        for idx in range(num_entries):
            ent = table[idx * entry_size:(idx + 1) * entry_size]
            type_raw, part_raw, start_lba, end_lba, attrs = struct.unpack("<16s16sQQQ", ent[:56])
            if type_raw == zero_guid:
                continue
            name_raw = ent[56:128]
            name = name_raw.decode("utf-16le", errors="ignore").split("\x00", 1)[0]
            parts.append({
                "partn": idx + 1,
                "type_guid": le_to_guid(type_raw),
                "part_guid": le_to_guid(part_raw),
                "start_lba": start_lba,
                "end_lba": end_lba,
                "sectors": end_lba - start_lba + 1,
                "attributes": attrs,
                "name": name,
            })
        return {
            "path": str(path),
            "size_bytes": size_bytes,
            "total_sectors": total_sectors,
            "disk_guid": le_to_guid(disk_guid_raw),
            "my_lba": my_lba,
            "alt_lba": alt_lba,
            "first_lba": first_lba,
            "last_lba": last_lba,
            "partitions": parts,
        }


LSBLK_GPT_COLUMNS = "PATH,TYPE,PKNAME,MODEL,SERIAL,SIZE,PTTYPE,PTUUID,START,PARTN,PARTUUID,PARTLABEL,PARTTYPE"


def _gpt_from_lsblk_node(dev, children):
    """Build a parse_gpt_disk()-shaped dict from a single lsblk disk node and its partition nodes."""
    path = str(dev.get("path") or "")
    pttype = str(dev.get("pttype") or "").lower()
    ptuuid = str(dev.get("ptuuid") or "").strip()
    if pttype != "gpt" or not ptuuid:
        raise RuntimeError(f"{path}: not a GPT disk in lsblk metadata")
    size_bytes = int(dev.get("size") or 0)
    if size_bytes < 68 * SECTOR_SIZE:
        raise RuntimeError(f"{path}: disk too small for GPT ({size_bytes} bytes)")
    total_sectors = size_bytes // SECTOR_SIZE
    disk_guid = str(uuid.UUID(ptuuid)).lower()

    parts = []
    for child in children:
        if child.get("type") != "part":
            continue
        partn = child.get("partn")
        start = child.get("start")
        psize = child.get("size")
        partuuid = str(child.get("partuuid") or "").strip()
        parttype = str(child.get("parttype") or "").strip()
        if partn is None or start is None or psize is None:
            raise RuntimeError(f"{path}: incomplete lsblk partition geometry")
        sectors = int(psize) // SECTOR_SIZE
        if sectors <= 0:
            continue
        start_lba = int(start)
        parts.append({
            "partn": int(partn),
            "type_guid": str(uuid.UUID(parttype)).lower() if parttype else "",
            "part_guid": str(uuid.UUID(partuuid)).lower() if partuuid else "",
            "start_lba": start_lba,
            "end_lba": start_lba + sectors - 1,
            "sectors": sectors,
            "attributes": 0,
            "name": str(child.get("partlabel") or ""),
        })
    parts.sort(key=lambda p: p["partn"])
    return {
        "path": path,
        "size_bytes": size_bytes,
        "total_sectors": total_sectors,
        "disk_guid": disk_guid,
        "my_lba": 1,
        "alt_lba": total_sectors - 1,
        "first_lba": 34,
        "last_lba": total_sectors - 34,
        "partitions": parts,
    }


def _lsblk_gpt_map(disk_path=None):
    """Query lsblk once and return {realpath: gpt_dict} for whole GPT disks (unprivileged read-only)."""
    cmd = ["lsblk", "--json", "--tree", "--bytes", "--paths", "--output", LSBLK_GPT_COLUMNS]
    if disk_path is not None:
        cmd.append(str(disk_path))
    res = run_cmd(cmd, check=False)
    if res.returncode != 0 or not res.stdout.strip():
        return {}
    try:
        devs = json.loads(res.stdout).get("blockdevices") or []
    except ValueError:
        return {}

    # Support both --tree output (children nested) and flat output (children linked by pkname).
    flat_parts = {}
    disks = []
    for node in devs:
        ntype = node.get("type")
        if ntype == "disk":
            disks.append(node)
        elif ntype == "part" and node.get("pkname"):
            flat_parts.setdefault(os.path.realpath(str(node["pkname"])), []).append(node)

    out = {}
    for dev in disks:
        path = str(dev.get("path") or "")
        if not path or os.path.basename(path).startswith(SKIP_BLOCK_PREFIXES):
            continue
        key = os.path.realpath(path)
        children = dev.get("children")
        if children is None:
            children = flat_parts.get(key, [])
        try:
            gpt = _gpt_from_lsblk_node(dev, children)
        except (RuntimeError, ValueError, TypeError):
            continue
        out[key] = gpt
    return out


def parse_gpt_via_lsblk(disk_path):
    """Read GPT metadata for one disk from lsblk/udev without raw block-device read access."""
    key = os.path.realpath(str(disk_path))
    gpt_map = _lsblk_gpt_map(disk_path)
    if key in gpt_map:
        return gpt_map[key]
    raise RuntimeError(f"{disk_path}: GPT metadata unavailable via lsblk")


def _parse_gpt_readonly(path, lsblk_cache=None):
    """Read GPT directly; fall back to lsblk metadata ONLY when raw open fails with PermissionError."""
    try:
        return parse_gpt_disk(path)
    except PermissionError:
        pass
    except OSError as e:
        if e.errno not in (errno.EACCES, errno.EPERM):
            raise
    if lsblk_cache is not None:
        if "map" not in lsblk_cache:
            lsblk_cache["map"] = _lsblk_gpt_map()
        key = os.path.realpath(str(path))
        if key in lsblk_cache["map"]:
            return lsblk_cache["map"][key]
        raise RuntimeError(f"{path}: GPT metadata unavailable via lsblk")
    return parse_gpt_via_lsblk(path)


def find_winmaint_triplet(gpt):
    """Locate and validate the (ESP, MSR, C) triplet in a parsed GPT dict."""
    by_name = {p["name"]: p for p in gpt["partitions"]}
    esp = by_name.get(LABEL_ESP)
    msr = by_name.get(LABEL_MSR)
    winc = by_name.get(LABEL_C)
    if not (esp and msr and winc):
        return None
    if esp["type_guid"] != GPT_TYPE_ESP:
        raise RuntimeError(f"{LABEL_ESP} has wrong GPT type {esp['type_guid']}")
    if msr["type_guid"] != GPT_TYPE_MSR:
        raise RuntimeError(f"{LABEL_MSR} has wrong GPT type {msr['type_guid']}")
    if winc["type_guid"] != GPT_TYPE_BASIC:
        raise RuntimeError(f"{LABEL_C} has wrong GPT type {winc['type_guid']}")
    return {"esp": esp, "msr": msr, "c": winc}


def _pack_pmbr(total_sectors):
    mbr = bytearray(SECTOR_SIZE)
    lba_size = min(total_sectors - 1, 0xFFFFFFFF)
    # Protective MBR entry: boot=0, start CHS=0/2/0, type=0xEE, end CHS=FF/FF/FF, start LBA=1, size=lba_size
    mbr[446:462] = struct.pack("<BBBBBBBBII", 0x00, 0x00, 0x02, 0x00, 0xEE, 0xFF, 0xFF, 0xFF, 1, lba_size)
    mbr[510:512] = b"\x55\xAA"
    return bytes(mbr)


def _pack_gpt_header(my_lba, alt_lba, first_lba, last_lba, disk_guid, part_lba, entries_crc):
    hdr = bytearray(92)
    struct.pack_into(
        "<8sIIIIQQQQ16sQIII",
        hdr,
        0,
        b"EFI PART",
        0x00010000,
        92,
        0,
        0,
        my_lba,
        alt_lba,
        first_lba,
        last_lba,
        guid_to_le(disk_guid),
        part_lba,
        GPT_ENTRIES_COUNT,
        GPT_ENTRY_SIZE,
        entries_crc,
    )
    crc = zlib.crc32(hdr) & 0xFFFFFFFF
    struct.pack_into("<I", hdr, 16, crc)
    return bytes(hdr) + b"\x00" * (SECTOR_SIZE - 92)


def _pack_gpt_entries(entries):
    buf = bytearray(GPT_ENTRIES_COUNT * GPT_ENTRY_SIZE)
    for idx, ent in enumerate(entries):
        if idx >= GPT_ENTRIES_COUNT:
            raise ValueError("too many GPT entries")
        name_u16 = ent["name"].encode("utf-16le")[:72]
        name_u16 = name_u16.ljust(72, b"\x00")
        offset = idx * GPT_ENTRY_SIZE
        struct.pack_into(
            "<16s16sQQQ",
            buf,
            offset,
            guid_to_le(ent["type_guid"]),
            guid_to_le(ent["part_guid"]),
            int(ent["start_lba"]),
            int(ent["end_lba"]),
            int(ent.get("attributes", 0)),
        )
        buf[offset + 56:offset + 128] = name_u16
    return bytes(buf)


def build_virtual_gpt_blobs(disk_guid, triplet):
    """Build (head_bytes, tail_bytes, layout) for a dm-linear virtual disk.

    Virtual layout:
      [0 .. 2047]                   head_bytes (PMBR + primary GPT)
      [2048 .. +esp_sectors)        real p4 (LOCACHY_WIN_ESP)
      [+esp .. +msr_sectors)        real p5 (LOCACHY_WIN_MSR)
      [+msr .. +c_sectors)          real p6 (LOCACHY_WIN_C)
      [tail_start .. +2048)         tail_bytes (backup GPT at end of disk)

    Preserves the EXACT physical DiskGUID and PartitionGUIDs so Windows BCD
    written inside QEMU matches bare-metal GPT headers 1-to-1, while exposing
    ZERO sectors of LOCachy's p1/p2/p3 partitions.
    """
    esp_sec = int(triplet["esp"]["sectors"])
    msr_sec = int(triplet["msr"]["sectors"])
    c_sec = int(triplet["c"]["sectors"])
    if esp_sec <= 0 or msr_sec <= 0 or c_sec <= 0:
        raise ValueError("partition sector counts must be positive")

    esp_start = HEAD_SECTORS
    esp_end = esp_start + esp_sec - 1
    msr_start = esp_end + 1
    msr_end = msr_start + msr_sec - 1
    c_start = msr_end + 1
    c_end = c_start + c_sec - 1
    tail_start = c_end + 1
    total_sectors = tail_start + TAIL_SECTORS

    first_usable = 34
    last_usable = total_sectors - 34

    virt_entries = [
        {
            "type_guid": triplet["esp"]["type_guid"],
            "part_guid": triplet["esp"]["part_guid"],
            "start_lba": esp_start,
            "end_lba": esp_end,
            "attributes": triplet["esp"].get("attributes", 0),
            "name": LABEL_ESP,
        },
        {
            "type_guid": triplet["msr"]["type_guid"],
            "part_guid": triplet["msr"]["part_guid"],
            "start_lba": msr_start,
            "end_lba": msr_end,
            "attributes": triplet["msr"].get("attributes", 0),
            "name": LABEL_MSR,
        },
        {
            "type_guid": triplet["c"]["type_guid"],
            "part_guid": triplet["c"]["part_guid"],
            "start_lba": c_start,
            "end_lba": c_end,
            "attributes": triplet["c"].get("attributes", 0),
            "name": LABEL_C,
        },
    ]
    entries_blob = _pack_gpt_entries(virt_entries)
    entries_crc = zlib.crc32(entries_blob) & 0xFFFFFFFF

    primary_hdr = _pack_gpt_header(
        my_lba=1,
        alt_lba=total_sectors - 1,
        first_lba=first_usable,
        last_lba=last_usable,
        disk_guid=disk_guid,
        part_lba=2,
        entries_crc=entries_crc,
    )
    backup_hdr = _pack_gpt_header(
        my_lba=total_sectors - 1,
        alt_lba=1,
        first_lba=first_usable,
        last_lba=last_usable,
        disk_guid=disk_guid,
        part_lba=total_sectors - 33,
        entries_crc=entries_crc,
    )

    head = bytearray(HEAD_SECTORS * SECTOR_SIZE)
    head[0:SECTOR_SIZE] = _pack_pmbr(total_sectors)
    head[SECTOR_SIZE:2 * SECTOR_SIZE] = primary_hdr
    head[2 * SECTOR_SIZE:2 * SECTOR_SIZE + len(entries_blob)] = entries_blob

    tail = bytearray(TAIL_SECTORS * SECTOR_SIZE)
    backup_entries_off = (TAIL_SECTORS - 33) * SECTOR_SIZE
    tail[backup_entries_off:backup_entries_off + len(entries_blob)] = entries_blob
    tail[(TAIL_SECTORS - 1) * SECTOR_SIZE:TAIL_SECTORS * SECTOR_SIZE] = backup_hdr

    layout = {
        "disk_guid": str(uuid.UUID(disk_guid)).lower(),
        "total_sectors": total_sectors,
        "head_sectors": HEAD_SECTORS,
        "tail_sectors": TAIL_SECTORS,
        "tail_start": tail_start,
        "esp": {"start_lba": esp_start, "end_lba": esp_end, "sectors": esp_sec, "part_guid": triplet["esp"]["part_guid"]},
        "msr": {"start_lba": msr_start, "end_lba": msr_end, "sectors": msr_sec, "part_guid": triplet["msr"]["part_guid"]},
        "c": {"start_lba": c_start, "end_lba": c_end, "sectors": c_sec, "part_guid": triplet["c"]["part_guid"]},
    }
    return bytes(head), bytes(tail), layout


def dm_linear_table(loop_head, esp_dev, msr_dev, c_dev, loop_tail, layout):
    """Build the 5-segment dm-linear table string for dmsetup create."""
    lines = [
        f"0 {layout['head_sectors']} linear {loop_head} 0",
        f"{layout['esp']['start_lba']} {layout['esp']['sectors']} linear {esp_dev} 0",
        f"{layout['msr']['start_lba']} {layout['msr']['sectors']} linear {msr_dev} 0",
        f"{layout['c']['start_lba']} {layout['c']['sectors']} linear {c_dev} 0",
        f"{layout['tail_start']} {layout['tail_sectors']} linear {loop_tail} 0",
    ]
    return "\n".join(lines) + "\n"


