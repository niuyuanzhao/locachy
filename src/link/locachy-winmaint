        run_cmd([str(reboot_bin)])
    else:
        os.kill(1, signal.SIGTERM)


# ---------------------------------------------------------------------------
# Exclusive locking (blocks boot-once/reclaim while VM or mutation is active)
# ---------------------------------------------------------------------------

class WinmaintLock:
    def __init__(self, path=None, nonblocking=True):
        self.path = Path(path) if path is not None else LOCK_PATH
        self.nonblocking = nonblocking
        self.fd = None

    def __enter__(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(str(self.path), flags, 0o600)
        op = fcntl.LOCK_EX | (fcntl.LOCK_NB if self.nonblocking else 0)
        try:
            fcntl.flock(fd, op)
        except OSError as e:
            os.close(fd)
            if e.errno in (errno.EACCES, errno.EAGAIN, errno.EWOULDBLOCK):
                raise RuntimeError("Maintenance Windows lock is busy (VM or disk operation active)") from None
            raise
        self.fd = fd
        return self

    def __exit__(self, exc_type, exc, tb):
        if self.fd is not None:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            finally:
                os.close(self.fd)
                self.fd = None


def is_lock_held(path=None):
    p = Path(path) if path is not None else LOCK_PATH
    if not p.exists():
        return False
    try:
        fd = os.open(str(p), os.O_RDWR | os.O_CLOEXEC)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(fd, fcntl.LOCK_UN)
        return False
    except OSError as e:
        return e.errno in (errno.EACCES, errno.EAGAIN, errno.EWOULDBLOCK)
    finally:
        os.close(fd)


