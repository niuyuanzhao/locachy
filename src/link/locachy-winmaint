def load_state(path=None):
    p = Path(path) if path is not None else STATE_FILE
    if not p.is_file():
        return None
    return json.loads(p.read_text(encoding="utf-8"))


def save_state(state, path=None):
    p = Path(path) if path is not None else STATE_FILE
    atomic_write_text(p, json.dumps(state, indent=2, sort_keys=True) + "\n", mode=0o600)


def verify_state_against_gpt(state, gpt):
    """Confirm disk GUID and all 3 partition GUIDs/types/names match state.json."""
    if gpt["disk_guid"].lower() != state["disk_guid"].lower():
        raise RuntimeError(
            f"Disk GUID mismatch: GPT has {gpt['disk_guid']}, state expects {state['disk_guid']}"
        )
    triplet = find_winmaint_triplet(gpt)
    if not triplet:
        raise RuntimeError("Maintenance Windows partitions missing from GPT")
    for key in ("esp", "msr", "c"):
        rec = state["partitions"][key]
        live = triplet[key]
        if live["part_guid"].lower() != rec["part_guid"].lower():
            raise RuntimeError(f"Partition {key} GUID mismatch: {live['part_guid']} != {rec['part_guid']}")
        if live["type_guid"].lower() != rec["type_guid"].lower():
            raise RuntimeError(f"Partition {key} type mismatch: {live['type_guid']} != {rec['type_guid']}")
    return triplet


