#!/bin/bash
# tor-enforce: the firewall of full-system Tor (service_tor, tor-client), in
# the locachy-net namespace, where everything that goes out runs: nftables
# rules every process there goes through, as Tails enforces Tor
# (tails.net/contribute/design/Tor_enforcement, its ferm.conf and torrc).
#   tor-enforce load FRONT   load them for Tor's front FRONT (mihomo or
#                            bridges; anything else: Tor itself gets nothing),
#                            in place of those there are, in one transaction
#   tor-enforce lan          the local networks again, after they changed
#   tor-enforce remove       take them away: Tor is off
#   tor-enforce loaded       0 if they are loaded
#   tor-enforce rules FRONT  what load would load (the tests)
# The rules, for IPv4 (IPv6 goes nowhere but loopback):
#   - the tor user's connections: with bridges, TCP anywhere and DNS
#     (lyrebird's WebTunnel finds its host); via mihomo, only mihomo's port for
#     Tor (127.0.0.1:7891), which sends them through one of its proxies
#   - via mihomo, mihomo's own connections (MIHOMO_FRONT_MARK) go out: it is
#     Tor's front. Its ports are closed to every other program: it carries
#     Tor only
#   - with bridges, what goes into mihomo's TUN is mihomo's (it is above Tor);
#     mihomo's own connections then go through Tor as everyone's do
#   - DNS (port 53, UDP and TCP), wherever it is sent, to Tor's DNSPort
#     (127.0.0.1:5353; Tor answers UDP there, TCP is refused)
#   - the addresses Tor gives .onion names (127.192.0.0/10) to its TransPort
#   - what is for this machine stays on it: loopback (Tor's ports are
#     there), the answers of Tor's ports and of whatever is on the machine,
#     to whichever of its addresses (mihomo's TUN's, the local network's)
#   - the local networks (the subnets of the namespace's Ethernet and Wi-Fi
#     interfaces; none while it has none) are reached directly, but for DNS
#     and NetBIOS names
#   - every other TCP connection to Tor's TransPort (127.0.0.1:9040)
#   - everything else is refused where it starts, never sent: UDP, ICMP,
#     other protocols, IPv6; nothing is forwarded
# The rules stay while Tor is on, whatever becomes of tor: without it, what
# they send to its ports is refused there, so nothing goes out (the kill
# switch). Root in locachy-net could change them, as root could on Tails.
set -u

NS=${LOCACHY_TOR_NETNS:-locachy-net}
TOR_USER=${LOCACHY_TOR_USER:-tor}
TABLE="inet locachy-tor"
TRANS_PORT=9040
DNS_PORT=5353
MIHOMO_PORT=7890       # mihomo's own (clash-client)
MIHOMO_TOR_PORT=7891   # its port for Tor (clash-client)
MIHOMO_FRONT_MARK=2023 # its connections as Tor's front (clash-client)
TUN=mihomo             # its TUN (clash-client)

in_ns() {
    ip netns exec "$NS" "$@"
}

# The connected IPv4 subnets of the namespace's Ethernet and Wi-Fi
# interfaces (not loopback, mihomo's TUN or tailscale0), comma-separated.
lan() {
    local net dev seen=" "
    in_ns ip -4 -o route show table main proto kernel scope link 2>/dev/null |
        while read -r net _ dev _; do
            in_ns ip -o link show dev "$dev" 2>/dev/null | grep -q ' link/ether ' || continue
            case $seen in *" $net "*) continue ;; esac
            seen="$seen$net "
            printf '%s\n' "$net"
        done | paste -sd, -
}

rules() { # FRONT
    local front=$1 uid elements
    uid=$(id -u "$TOR_USER" 2>/dev/null) || uid=
    case $front in mihomo | bridges) ;; *) front=none ;; esac
    [ -n "$uid" ] || front=none
    elements=$(lan)
    cat <<EOF
table $TABLE
delete table $TABLE
table $TABLE {
    counter redirected {}
    counter dns {}
    counter onion {}
    counter lan {}
    counter tor {}
    counter front {}
    counter dropped {}
    counter ipv6 {}
    counter leaving {}

    set lan {
        type ipv4_addr
        flags interval
        auto-merge
EOF
    [ -z "$elements" ] || echo "        elements = { $elements }"
    cat <<EOF
    }

    chain nat {
        type nat hook output priority dstnat; policy accept;
        meta nfproto ipv6 return
EOF
    [ "$front" = none ] || echo "        meta skuid $uid return"
    [ "$front" != mihomo ] || echo "        meta mark $MIHOMO_FRONT_MARK return"
    [ "$front" != bridges ] || echo "        oifname \"$TUN\" return"
    cat <<EOF
        ip daddr 127.192.0.0/10 meta l4proto tcp counter name onion redirect to :$TRANS_PORT
        udp dport 53 counter name dns redirect to :$DNS_PORT
        tcp dport 53 counter name dns redirect to :$DNS_PORT
        fib daddr type local return
        ip daddr @lan return
        meta l4proto tcp counter name redirected redirect to :$TRANS_PORT
    }

    chain output {
        type filter hook output priority filter; policy drop;
        meta nfproto ipv6 oif lo accept
        meta nfproto ipv6 counter name ipv6 reject
EOF
    if [ "$front" = mihomo ]; then
        cat <<EOF
        fib daddr type local tcp dport $MIHOMO_PORT counter name dropped reject with tcp reset
        fib daddr type local tcp dport $MIHOMO_TOR_PORT meta skuid != $uid counter name dropped reject with tcp reset
EOF
    fi
    echo "        fib daddr type local accept"
    [ "$front" = none ] || echo "        meta skuid $uid jump tor"
    [ "$front" != mihomo ] || echo "        meta mark $MIHOMO_FRONT_MARK counter name front accept"
    [ "$front" != bridges ] || echo "        oifname \"$TUN\" accept"
    cat <<EOF
        ip daddr @lan udp dport 137 counter name dropped reject
        ip daddr @lan counter name lan accept
        meta l4proto tcp counter name dropped reject with tcp reset
        counter name dropped reject
    }
EOF
    if [ "$front" != none ]; then
        echo "    chain tor {"
        if [ "$front" = bridges ]; then
            echo "        meta l4proto tcp counter name tor accept"
            echo "        udp dport 53 counter name tor accept"
        fi
        echo "        meta l4proto tcp counter name dropped reject with tcp reset"
        echo "        counter name dropped reject"
        echo "    }"
    fi
    cat <<EOF

    # What leaves the machine: a connection redirected to loopback by a
    # program bound to an interface would leave on it as it is.
    chain leaving {
        type filter hook postrouting priority filter; policy accept;
        oif lo accept
        ip daddr 127.0.0.0/8 counter name leaving drop
        meta nfproto ipv6 counter name leaving drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }
}
EOF
}

case "${1:-}" in
load)
    [ $# -eq 2 ] || { echo "usage: tor-enforce load mihomo|bridges" >&2; exit 2; }
    if [ ! -e "/run/netns/$NS" ]; then
        echo "tor-enforce: no $NS yet: network-client loads the rules when it makes it" >&2
        exit 0
    fi
    rules "$2" | in_ns nft -f - || { echo "tor-enforce: nft refused the rules" >&2; exit 1; }
    ;;
lan)
    [ -e "/run/netns/$NS" ] && in_ns nft list table $TABLE >/dev/null 2>&1 || exit 0
    elements=$(lan)
    { echo "flush set $TABLE lan"; [ -z "$elements" ] || echo "add element $TABLE lan { $elements }"; } |
        in_ns nft -f -
    ;;
remove)
    [ -e "/run/netns/$NS" ] || exit 0
    if in_ns nft list table $TABLE >/dev/null 2>&1; then
        in_ns nft delete table $TABLE
    fi
    ;;
loaded)
    [ -e "/run/netns/$NS" ] && in_ns nft list table $TABLE >/dev/null 2>&1
    ;;
rules)
    [ $# -eq 2 ] || { echo "usage: tor-enforce rules mihomo|bridges" >&2; exit 2; }
    rules "$2"
    ;;
*)
    echo "usage: tor-enforce load FRONT | lan | remove | loaded | rules FRONT" >&2
    exit 2
    ;;
esac
