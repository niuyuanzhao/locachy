        for d in $USER_DIRS; do
            mount --bind "$uhome/$d" "$cbase/merged$uhome/$d"
        done
        # USB drives and memory cards, mounted by the drives service in its
        # shared mount point: with the drives in it now, and the ones to come.
        if mountpoint -q "$uhome/Drives"; then
            install -d -o "$uid" -g "$gid" "$cbase/data/Drives"
            mount --rbind "$uhome/Drives" "$cbase/merged$uhome/Drives"
            mount --make-rslave "$cbase/merged$uhome/Drives"
        fi
        # Its own directories of the home (directories=, checked before), at the
        # same paths. Their mount points are made in its home, which its programs
        # write: a link there is not followed.
        IFS=: read -r -a dirs <<<"$directories" || true
        for d in "${dirs[@]}"; do
            [ -n "$d" ] || continue
            d=${d%/}
            IFS=/ read -r -a parts <<<"${d#"$uhome"/}"
            p=$cbase/data
            for part in "${parts[@]}"; do
                p=$p/$part
                if [ -L "$p" ]; then
                    printf "locachy-app: %s is a link in its home: %s not given\n" "${p#"$cbase"/data/}" "$d" >&2
                    continue 2
                fi
                [ -d "$p" ] || install -d -o "$uid" -g "$gid" "$p"
            done
            mount --bind "$d" "$cbase/merged$d"
        done
