        # (camera_nodes: lines NAME MAJOR MINOR), the user their owner, the
        # host nodes as they were (root, video); more as they come (cameras).
        while read -r node major minor; do
            [ -n "$node" ] || continue
            mknod -m 0600 "$cbase/merged/dev/$node" c "$major" "$minor"
            chown "$uid:$gid" "$cbase/merged/dev/$node"
        done <<<"$cameras"
        ln -sf /proc/self/fd "$cbase/merged/dev/fd"
        ln -sf /proc/self/fd/0 "$cbase/merged/dev/stdin"
        ln -sf /proc/self/fd/1 "$cbase/merged/dev/stdout"
        ln -sf /proc/self/fd/2 "$cbase/merged/dev/stderr"

