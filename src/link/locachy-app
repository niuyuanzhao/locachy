        # them in the container chosen for their type. The directory, not the
        # socket, so that a new bar socket reaches running containers too.
        if [ -x /usr/local/lib/locachy/xdg-open ]; then
            mkdir -p "$cbase/merged/usr/local/bin" "$cbase/merged/run/locachy-open" /run/locachy/open
            touch "$cbase/merged/usr/local/bin/xdg-open"
            mount --bind -o ro /usr/local/lib/locachy/xdg-open "$cbase/merged/usr/local/bin/xdg-open"
            mount --bind -o ro /run/locachy/open "$cbase/merged/run/locachy-open"
        fi
