        # $cbase/data), with the shared user directories of the host home on it
        # at the same paths, so that a path means the same file everywhere.
        mkdir -p "$cbase/merged$uhome"
        mount --bind "$cbase/data" "$cbase/merged$uhome"
        _need_cd=()
        _check_cd=()
        for d in $USER_DIRS; do
            if [ -d "$cbase/data/$d" ] && [ ! -L "$cbase/data/$d" ]; then
                _check_cd+=("$cbase/data/$d")
            else
                _need_cd+=("$cbase/data/$d")
            fi
        done
        if [ "${#_check_cd[@]}" -gt 0 ]; then
            _stat_cd=()
            mapfile -t _stat_cd < <(stat -c "%u:%g" "${_check_cd[@]}" 2>/dev/null || true)
            if [ "${#_stat_cd[@]}" -ne "${#_check_cd[@]}" ]; then
                _need_cd+=("${_check_cd[@]}")
            else
                for _idx in "${!_check_cd[@]}"; do
                    [ "${_stat_cd[$_idx]}" = "$uid:$gid" ] || _need_cd+=("${_check_cd[$_idx]}")
                done
