        touch "$cbase/merged/run/locachy-app-init"
        mount --bind -o ro "$init" "$cbase/merged/run/locachy-app-init"
        if [ -x /usr/local/lib/locachy/container-documents ]; then
            touch "$cbase/merged/run/locachy-container-documents"
            mount --bind -o ro /usr/local/lib/locachy/container-documents "$cbase/merged/run/locachy-container-documents"
        fi
