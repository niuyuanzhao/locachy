        # host runtime of the container, where locachy-bar finds it to be the
        # tray watcher. Waited for below only when the bar is there.
        bus_dir="$state_dir/bus"
        rm -rf "$bus_dir"
        install -d -o "$uid" -g "$gid" -m 0700 "$bus_dir"
        mkdir -p "$cbase/merged/run/locachy-bus"
        mount --bind "$bus_dir" "$cbase/merged/run/locachy-bus"
        tray_bar=0
        [ -S "$host_runtime/locachy-bar.sock" ] && tray_bar=1

