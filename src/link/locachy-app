#!/bin/bash
# Daemonless per-app OverlayFS roots and root-level cgroup v2 control.
#
#   locachy-app run|start [--own-tor] NAME [COMMAND...]  COMMAND: this once, not its own
#   locachy-app open [--own-tor] NAME TARGET  --own-tor: confirmed Tor Browser
#                                            bundled tor, only while system Tor is off
#   locachy-app [-n] NAME [COMMAND...]       legacy start; -n: network="1" in NAME's
#                                            configuration
#   locachy-app resume|freeze|stop NAME      kill is an alias for stop
#   locachy-app install NAME PKG...          PKG... added to NAME's extras, then build
#   locachy-app build NAME                   build its upper, or install host-access packages
#                                            (the old one kept as upper.prev)
#   locachy-app rollback NAME                upper.prev back in its place
#   locachy-app remove NAME [--data]         its configuration and state gone; its
#                                            home (data) too only with --data
#   locachy-app list [--machine]             name<TAB>state<TAB>ram_bytes<TAB>swap_bytes
#   locachy-app open NAME TARGET             NAME's command with TARGET (path or URL),
#                                            in it if it runs, else starting it
#   locachy-app again NAME                   NAME's command once more, in it (asked
#                                            first: it may start a second copy)
#   locachy-app new NAME                     a window of it: started, or its command
#                                            once more if it runs (the terminal key)
#   locachy-app cameras                      the cameras there are now into the running
#                                            containers with camera="1" (udev, as they
#                                            come and go: 91-locachy-cameras.rules)
#
# All launcher/reaper/app processes belong to /sys/fs/cgroup/app_NAME, a
# sibling of the host compositor. Controls must run outside the target group.
# Resume only thaws: showing the window is the compositor's job.
#
# A container is its configuration, /etc/locachy/containers/NAME.conf (lines
# NAME="VALUE"), and its state, /var/lib/locachy/containers/NAME (the
# overlay's upper and work, its home in data). The configuration:
#   package       its program's package (the repositories' or the AUR's)
#   extras        more packages, separated by spaces
#   command       the program it runs
#   arguments     the program's arguments, separated by spaces (no quoting); a
#                 file or URL it opens goes after them
#   network       "1": on locachy-net (without it, a network of its own with
#                 loopback only); with Tor on (service_tor), Tor is its only
#                 way off the local network: its TCP to the TransPort, DNS to
#                 the DNSPort, and Tor's SocksPort (127.0.0.1:9050 there) for
#                 a program that speaks SOCKS, as Tor Browser does
#                 (tor-client, tor-enforce)
#   tor           "1": only full-system Tor, through its SocksPort. A separate
#                 cgroup firewall permits only TCP to 127.0.0.1:9050, even if
#                 Tor is switched off while it runs. Tor Browser alone may
#                 start its bundled tor with --own-tor while system Tor is off,
#                 after the caller warns and the user explicitly confirms.
#                 network="0" still means entirely offline.
#   camera        "1": the ordinary cameras (V4L2 capture nodes, /dev/videoN, and
#                 their media controller nodes, as video calls use them), the
#                 user's in it, as they come and go; never the face unlock or an
#                 infrared one (locachy-face-camera ordinary); its sound (and so
#                 the microphone) it has whatever this says
#   directories   more directories of the user's home, separated by colons, at
#                 the same paths in it (not the home itself, not in Drives,
#                 not in the shared user directories, which it has already)
#   host          "1": real-system access: packages on the host (the manifest),
#                 the real root and home with the user's permissions; still its
#                 own namespaces, cgroup, display socket (locachy-0) and bus,
#                 so home starts, freezes and stops it like every other app
#   desktop       a host program's .desktop files in /usr/share/applications,
#                 separated by spaces: its windows, and what it opens
#   x11           "1": the shared X server too (Xwayland: DISPLAY and its
#                 socket), for a program that has no Wayland; the X11 programs
#                 on it can read each other's windows, input and selections
#                 (XWAYLAND.md), so a program has it only when this says so
#   vm            "1": a managed KVM virtual machine (tools/VM-APPS.md), shown
#                 on the shared Wayland display in its own app_NAME cgroup with
#                 QMP pause/resume/powerdown lifecycle; no OverlayFS or package
#                 build. Keys: vm_kind (winmaint, compute, custom), vm_name
#                 (compute VM name, default NAME), vm_freeze (qmp or none),
#                 vm_display (default gtk), vm_memory, vm_cpus, vm_iso, and
#                 command/arguments for custom launchers. A Windows custom VM
#                 without vm_iso / vm_virtio_iso gets them from locachy-winiso.
# A container sees the host root through its overlay, minus the host's own
# state (/var/lib/locachy, /var/log/locachy). Its programs run as the user
# (uid 1000, made by locachy-setup) with a home of their own, in which the
# shared user directories of the host home (USER_DIRS) are mounted at the
# same paths. Of the host runtime they get the display (locachy-0) and the
# restricted sound sockets (PipeWire, Pulse: audio-client) only; of the
# devices, the GPU render nodes, and with camera="1" the ordinary cameras
# (nodes of its own /dev, the user's). A
# container has a session bus of its own, none of the host; locachy-bar is
# the tray watcher on it. Its Settings portal reads just the host appearance
# snapshot from a dedicated read-only directory. At /run/user/UID/doc it has
# its own view of the host's document portal (locachy-docs, tools/DOCUMENTS.md): the private
# files dropped on it, nothing else; a host program (host="1") too.
set -euo pipefail

die() {
    printf 'locachy-app: %s\n' "$*" >&2
    exit 1
}

CGROUP_BASE="${LOCACHY_CGROUP_BASE:-/sys/fs/cgroup}"
APP_UID=1000
# The user directories every container shares with the host (XDG names).
USER_DIRS="Documents Downloads Music Pictures Videos"
CONT_BASE="${LOCACHY_CONT_BASE:-/var/lib/locachy/containers}"
CONT_CONF="${LOCACHY_CONT_CONF:-/etc/locachy/containers}"
APP_RUNTIME="${LOCACHY_APP_RUNTIME:-/run/locachy/apps}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
APP_INIT="${LOCACHY_APP_INIT:-/usr/local/lib/locachy/app-init}"
CLIPBOARD="${LOCACHY_CLIPBOARD_TOOL:-/usr/local/lib/locachy/clipboard}"
TOR_ENFORCE="${LOCACHY_TOR_ENFORCE:-/usr/local/lib/locachy/tor-enforce}"
RC_CONF="${LOCACHY_RC_CONF:-/etc/locachy/rc.conf}"
WINMAINT_TOOL="${LOCACHY_WINMAINT_TOOL:-/usr/local/bin/locachy-winmaint}"
COMPUTE_TOOL="${LOCACHY_COMPUTE_TOOL:-/usr/local/bin/locachy-compute}"
# The installation ISOs a Windows VM without vm_iso / vm_virtio_iso is given (tools/WINISO.md).
WINISO_TOOL="${LOCACHY_WINISO_TOOL:-/usr/local/bin/locachy-winiso}"
FOOT_WRAPPER=/usr/local/lib/locachy/locachy-foot
# The containers' sound: the directories of the restricted sockets of the
# host's servers (audio-client; 50-locachy-sockets.conf, 50-locachy-pulse.conf).
# A container gets the directories, not the sockets: servers started again
# (one ended, an update) make new sockets, which a bound socket file never
# reaches; a bound directory has them.
PIPEWIRE_SOCKETS=/run/pipewire/restricted
PULSE_SOCKETS=/run/pulse/restricted
FACE_CAMERA=/usr/local/bin/locachy-face-camera
# The document service (locachy-docs): a container's view of its documents
# is attached on DOCS_VIEWS/NAME, which the container has at
# /run/user/UID/doc. DOCS_DIR, the service's, is never in a container.
DOCS_TOOL=/usr/local/lib/locachy/locachy-docs
DOCS_DIR=/run/locachy/docs
DOCS_VIEWS=$DOCS_DIR/views

# These overrides are intentionally a root-only integration-test seam. They
# cannot be used to redirect a normal unprivileged invocation, and all paths
# must be absolute so the test namespace cannot be selected accidentally.
for override_name in LOCACHY_CGROUP_BASE LOCACHY_CONT_BASE LOCACHY_CONT_CONF LOCACHY_APP_RUNTIME LOCACHY_APP_INIT \
    LOCACHY_CLIPBOARD_TOOL LOCACHY_TOR_ENFORCE LOCACHY_RC_CONF LOCACHY_WINMAINT_TOOL LOCACHY_COMPUTE_TOOL \
    LOCACHY_VM_STATE LOCACHY_QEMU_BIN LOCACHY_VIRTIOFSD LOCACHY_SWTPM LOCACHY_WINISO_TOOL; do
    if [ -n "${!override_name+x}" ]; then
        [ "$(id -u)" = 0 ] || die "${override_name} override requires root"
        override_value=${!override_name}
        case "$override_value" in
        /*) ;;
        *) die "${override_name} must be an absolute path" ;;
        esac
    fi
done
case "$RUNTIME_DIR" in
/*) ;;
*) die 'XDG_RUNTIME_DIR must be an absolute path' ;;
esac
export XDG_RUNTIME_DIR="$RUNTIME_DIR"
umask 077

# The value of KEY in NAME's configuration, "" if it has none.
declare -A APP_CONF=()

is_host() { # NAME: managed real-system access (host="1"), no private filesystem
    [ "$(conf_value "$1" host)" = 1 ]
}

is_vm() { # NAME: managed KVM virtual machine (vm="1"), no container package build
    [ "$(conf_value "$1" vm)" = 1 ]
}

vm_qmp_sock() {
    # In the VM's own state directory: QEMU runs as the VM's uid and must be
    # able to create this socket; $APP_RUNTIME is root's.
    printf '%s/%s/qmp.sock\n' "$VM_STATE" "$1"
}

vm_paused_file() {
    printf '%s/%s/vm-paused\n' "$APP_RUNTIME" "$1"
}

vm_freeze_mode() {
    local mode
    mode=$(conf_value "$1" vm_freeze)
    case "${mode:-qmp}" in
    qmp|none) printf '%s\n' "${mode:-qmp}" ;;
    *) die "$1: unknown vm_freeze \"$mode\" (expected qmp or none)" ;;
    esac
}

# Send one QMP command to SOCK (greeting -> qmp_capabilities -> COMMAND).
# Bounded timeout so a stalled or absent monitor never hangs freeze/resume/stop.
vm_qmp() { # SOCK COMMAND [TIMEOUT_SECONDS]
    local sock="$1" cmd="$2" timeout="${3:-3}"
    [ -S "$sock" ] || return 1
    python3 -I - "$sock" "$cmd" "$timeout" <<'PY'
import json
import socket
import sys

sock_path, cmd, timeout_s = sys.argv[1], sys.argv[2], float(sys.argv[3])
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
    s.settimeout(timeout_s)
    s.connect(sock_path)
    buf = b""

    def next_msg():
        global buf
        while b"\n" not in buf:
            chunk = s.recv(4096)
            if not chunk:
                raise RuntimeError("QMP closed the connection")
            buf += chunk
        line, buf = buf.split(b"\n", 1)
        return json.loads(line.decode("utf-8"))

    greeting = next_msg()
    if "QMP" not in greeting:
        raise RuntimeError("unexpected QMP greeting")
    s.sendall(b'{"execute":"qmp_capabilities"}\n')
    while True:
        msg = next_msg()
        if "return" in msg:
            break
        if "error" in msg:
            raise RuntimeError(f"QMP capabilities rejected: {msg['error']}")
    s.sendall((json.dumps({"execute": cmd}) + "\n").encode("utf-8"))
    while True:
        msg = next_msg()
        if "return" in msg:
            sys.exit(0)
        if "error" in msg:
            raise RuntimeError(f"QMP {cmd} failed: {msg['error']}")
PY
}

# Build the foreground launcher command for a vm="1" app into vm_cmd.
vm_command() { # NAME QMP_SOCK
    local name="$1" qmp_sock="$2" kind display mem cpus iso vname nic bus virtio_iso
    kind=$(conf_value "$name" vm_kind)
    display=$(conf_value "$name" vm_display)
    [ -n "$display" ] || display=gtk
    [[ "$display" =~ ^[A-Za-z0-9][A-Za-z0-9_,=.-]{0,63}$ ]] || die "$name: invalid vm_display ($display)"
    vm_cmd=()
    case "$kind" in
    winmaint)
        [ -x "$WINMAINT_TOOL" ] || die "$name: $WINMAINT_TOOL is not installed"
        vm_cmd=("$WINMAINT_TOOL" vm --display "$display" --qmp-sock "$qmp_sock")
        mem=$(conf_value "$name" vm_memory)
        cpus=$(conf_value "$name" vm_cpus)
        iso=$(conf_value "$name" vm_iso)
        if [ -n "$mem" ]; then
            [[ "$mem" =~ ^[1-9][0-9]*$ ]] || die "$name: invalid vm_memory ($mem)"
            vm_cmd+=(--memory "$mem")
        fi
        if [ -n "$cpus" ]; then
            [[ "$cpus" =~ ^[1-9][0-9]*$ ]] || die "$name: invalid vm_cpus ($cpus)"
            vm_cmd+=(--cpus "$cpus")
        fi
        if [ -n "$iso" ]; then
            case $iso in /*) ;; *) die "$name: vm_iso must be an absolute path: $iso" ;; esac
            vm_iso_ok "$name" vm_iso "$iso"
            vm_cmd+=(--iso "$iso")
        fi
        nic=$(conf_value "$name" vm_nic)
        if [ -n "$nic" ]; then
            case $nic in virtio|e1000e) ;; *) die "$name: unknown vm_nic \"$nic\" for winmaint (expected virtio or e1000e)" ;; esac
            vm_cmd+=(--nic "$nic")
        fi
        bus=$(conf_value "$name" vm_disk_bus)
        if [ -n "$bus" ]; then
            case $bus in virtio|nvme) ;; *) die "$name: unknown vm_disk_bus \"$bus\" for winmaint (expected virtio or nvme)" ;; esac
            vm_cmd+=(--disk-bus "$bus")
        fi
        virtio_iso=$(conf_value "$name" vm_virtio_iso)
        if [ -n "$virtio_iso" ]; then
            case $virtio_iso in /*) ;; *) die "$name: vm_virtio_iso must be an absolute path: $virtio_iso" ;; esac
            vm_iso_ok "$name" vm_virtio_iso "$virtio_iso"
            vm_cmd+=(--virtio-iso "$virtio_iso")
        fi
        ;;
    compute)
        [ -x "$COMPUTE_TOOL" ] || die "$name: $COMPUTE_TOOL is not installed"
        vname=$(conf_value "$name" vm_name)
        [ -n "$vname" ] || vname=$name
        valid_name "$vname" || die "$name: invalid vm_name ($vname)"
        vm_cmd=("$COMPUTE_TOOL" vm run "$vname" --display "$display" --qmp-sock "$qmp_sock")
        ;;
    custom|"")
        if [ -n "$(conf_value "$name" command)" ]; then
            [ -z "$(conf_value "$name" vm_base)$(conf_value "$name" vm_disk)" ] ||
                die "$name: command= is exclusive with vm_base and vm_disk (command= is a launcher, not a disk)"
            saved_command "$name"
            vm_cmd=("${saved_cmd[@]}")
        else
            vm_custom_build "$name" "$qmp_sock" "$3"
        fi
        ;;
    *)
        die "$name: unknown vm_kind \"$kind\" (expected winmaint, compute, or custom)"
        ;;
    esac
}

# The vm_* keys a VM's configuration may have; any other vm_* key is refused.
VM_KEYS=" vm_kind vm_name vm_freeze vm_display vm_memory vm_cpus vm_iso vm_base vm_disk vm_uefi vm_tpm vm_share_home vm_virtio_iso vm_os vm_nic vm_gpu vm_disk_bus vm_audio "
VM_STATE="${LOCACHY_VM_STATE:-/var/lib/locachy/vms}"
vm_drop=()
vm_helpers=()
vm_need_tpm=0
vm_need_vfs=0
vm_vfs_dir=

vm_check_keys() { # NAME: refuse unknown vm_* keys and keys that do not apply to the kind
    local name="$1" line key kind
    [ -r "$CONT_CONF/$name.conf" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line#"${line%%[![:space:]]*}"}
        key=${line%%=*}
        case $key in
        vm_*)
            case $VM_KEYS in
            *" $key "*) ;;
            *) die "$name: unknown $key in $CONT_CONF/$name.conf (the vm_* keys are a closed set: see VM-APPS.md)" ;;
            esac
            ;;
        esac
    done <"$CONT_CONF/$name.conf"
    kind=$(conf_value "$name" vm_kind)
    case $kind in
    winmaint)
        # winmaint takes its NIC, disk bus and virtio-win ISO (locachy-winmaint's
        # --nic, --disk-bus, --virtio-iso); the other custom-only keys do not apply.
        for key in vm_base vm_disk vm_uefi vm_tpm vm_share_home vm_os vm_gpu vm_audio; do
            [ -z "$(conf_value "$name" "$key")" ] || die "$name: $key is for vm_kind custom only (vm_kind is $kind)"
        done
        ;;
    compute)
        for key in vm_base vm_disk vm_uefi vm_tpm vm_share_home vm_virtio_iso vm_os vm_nic vm_gpu vm_disk_bus vm_audio; do
            [ -z "$(conf_value "$name" "$key")" ] || die "$name: $key is for vm_kind custom only (vm_kind is $kind)"
        done
        ;;
    esac
    if [ "$kind" = compute ]; then
        for key in vm_memory vm_cpus vm_iso; do
            [ -z "$(conf_value "$name" "$key")" ] || die "$name: $key does not apply to vm_kind compute (the VM keeps its own hardware)"
        done
    fi
    if [ "$kind" != compute ] && [ -n "$(conf_value "$name" vm_name)" ]; then
        die "$name: vm_name applies to vm_kind compute only"
    fi
    # Checked here, not only in vm_command: start NAME COMMAND... skips that,
    # and the name goes into /run/locachy/compute/vm-NAME as real root.
    if [ "$kind" = compute ] && [ -n "$(conf_value "$name" vm_name)" ]; then
        valid_name "$(conf_value "$name" vm_name)" || die "$name: invalid vm_name ($(conf_value "$name" vm_name))"
    fi
}

# True when running as real init_user_ns root (not a rootless --map-root-user namespace).
vm_real_root() {
    local a b c
    [ "$(id -u)" = 0 ] || return 1
    [ -r /proc/self/uid_map ] || return 0
    while read -r a b c; do
        [ "$a" = 0 ] && [ "$b" = 0 ] && [ "$c" -gt "$APP_UID" ] && return 0
    done </proc/self/uid_map
    return 1
}

# The launch prefix of a VM's helpers and QEMU: uid 1000 with the kvm group and
# no_new_privs when running as real host root; nothing in unprivileged namespaces.
vm_set_drop() {
    local gid kvm_gid
    vm_drop=()
    vm_real_root || return 0
    gid=$(getent passwd "$APP_UID" | cut -d: -f4)
    [ -n "$gid" ] || die "there is no user with uid $APP_UID: create it with locachy-setup"
    kvm_gid=$(getent group kvm | cut -d: -f3 || true)
    if [ -n "$kvm_gid" ]; then
        vm_drop=(setpriv --reuid="$APP_UID" --regid="$gid" --groups="$kvm_gid" --no-new-privs --)
    else
        vm_drop=(setpriv --reuid="$APP_UID" --regid="$gid" --clear-groups --no-new-privs --)
    fi
}

# A path a VM is given: absolute, without . or .., and never inside the VM
# state directory, which remove deletes (a user's disk is never removed).
vm_path_ok() { # NAME KEY PATH
    local name="$1" key="$2" path="$3"
    case $path in
    /*) ;;
    *) die "$name: $key must be an absolute path: $path" ;;
    esac
    case $path in
    */../*|*/..|*/./*|*/.) die "$name: $key has . or .. in it: $path" ;;
    "$VM_STATE"/*) die "$name: $key is inside $VM_STATE, which remove deletes: $path" ;;
    esac
    [ -e "$path" ] || die "$name: $key does not exist: $path"
}

# An ISO a VM is given is a regular file (after links), never a directory or a
# block device: QEMU (as root for winmaint) reads it.
vm_iso_ok() { # NAME KEY PATH
    [ -f "$3" ] || die "$1: $2 must be a regular file (not a directory or a device): $3"
}

# The VM's uid can read (r) or write (w) PATH; nothing is changed on PATH.
vm_app_can() { # NAME KEY r|w PATH
    local name="$1" key="$2" access="$3" path="$4"
    if ! ${vm_drop[@]+"${vm_drop[@]}"} test "-$access" "$path"; then
        die "$name: $key ($path) is not $([ "$access" = r ] && echo readable || echo writable) by uid $APP_UID"
    fi
}

# The format qemu-img reads for an image (raw or qcow2 only), as the VM's uid.
vm_disk_format() { # NAME KEY PATH
    local name="$1" key="$2" path="$3" fmt
    fmt=$(${vm_drop[@]+"${vm_drop[@]}"} qemu-img info --output=json "$path" 2>/dev/null |
        python3 -I -c 'import json, sys; print(json.load(sys.stdin)["format"])' 2>/dev/null) ||
        die "$name: $key is not an image qemu-img can read: $path"
    case $fmt in
    raw|qcow2) printf '%s\n' "$fmt" ;;
    *) die "$name: $key has format $fmt: only raw and qcow2 are taken" ;;
    esac
}

# The VM's own state directory (overlay, UEFI variables, TPM state, which
# remove deletes). Copy-on-write is turned off for it on Btrfs, best effort:
# Btrfs checksums and compression are then not kept for the VM images in it.
vm_state_dir() { # NAME
    local dir="$VM_STATE/$1"
    if vm_real_root; then
        install -d -m 0711 "$VM_STATE"
        install -d -o "$APP_UID" -m 0700 "$dir"
    else
        mkdir -p -m 0700 "$VM_STATE" "$dir"
    fi
    chattr +C "$dir" >/dev/null 2>&1 || true
    printf '%s\n' "$dir"
}

# DIR/disk.qcow2: a copy-on-write overlay over the read-only BASE, made once
# (the base is only ever read). Prints the overlay's path.
vm_overlay() { # NAME BASE DIR
    local name="$1" base="$2" dir="$3" fmt overlay="$3/disk.qcow2"
    if [ ! -e "$overlay" ]; then
        fmt=$(vm_disk_format "$name" vm_base "$base")
        ${vm_drop[@]+"${vm_drop[@]}"} qemu-img create -f qcow2 -F "$fmt" -b "$base" "$overlay" >/dev/null ||
            die "$name: cannot create its overlay over $base"
    fi
    printf '%s\n' "$overlay"
}

# Helpers of a VM (swtpm, virtiofsd) run as the VM's uid, in its cgroup; they
# are stopped when the launcher ends, and cgroup.kill covers them on stop.
vm_helper_stop() {
    local p
    for p in ${vm_helpers[@]+"${vm_helpers[@]}"}; do kill -TERM "$p" 2>/dev/null || true; done
    for p in ${vm_helpers[@]+"${vm_helpers[@]}"}; do wait "$p" 2>/dev/null || true; done
    vm_helpers=()
}

vm_wait_socket() { # NAME PID PATH: the helper made its socket, or it ended
    local name="$1" pid="$2" sock="$3" i
    for ((i = 0; i < 100; ++i)); do
        [ -S "$sock" ] && return 0
        kill -0 "$pid" 2>/dev/null || die "$name: a helper ended before it made $sock"
        sleep 0.05
    done
    die "$name: a helper did not make $sock"
}

vm_ovmf_pair() { # NAME DIR: prints CODE and a private writable VARS in DIR
    local name="$1" dir="$2" c v code= vars=
    for c in /usr/share/edk2/x64/OVMF_CODE.4m.fd /usr/share/edk2-ovmf/x64/OVMF_CODE.4m.fd \
        /usr/share/OVMF/x64/OVMF_CODE.4m.fd /usr/share/edk2/x64/OVMF_CODE.fd; do
        [ -r "$c" ] && { code=$c; break; }
    done
    for v in /usr/share/edk2/x64/OVMF_VARS.4m.fd /usr/share/edk2-ovmf/x64/OVMF_VARS.4m.fd \
        /usr/share/OVMF/x64/OVMF_VARS.4m.fd /usr/share/edk2/x64/OVMF_VARS.fd; do
        [ -r "$v" ] && { vars=$v; break; }
    done
    [ -n "$code" ] && [ -n "$vars" ] || die "$name: UEFI requested (vm_uefi=\"1\") but OVMF firmware is not installed"
    if [ ! -e "$dir/ovmf-vars.fd" ]; then
        ${vm_drop[@]+"${vm_drop[@]}"} cp "$vars" "$dir/ovmf-vars.fd" ||
            die "$name: cannot copy OVMF variables into $dir"
    fi
    printf '%s\n%s\n' "$code" "$dir/ovmf-vars.fd"
}

vm_virtiofsd_bin() {
    local b
    if [ -n "${LOCACHY_VIRTIOFSD:-}" ]; then
        printf '%s\n' "$LOCACHY_VIRTIOFSD"
        return 0
    fi
    for b in /usr/lib/virtiofsd /usr/libexec/virtiofsd; do
        [ -x "$b" ] && { printf '%s\n' "$b"; return 0; }
    done
    command -v virtiofsd 2>/dev/null || return 1
}

vm_note() {
    printf 'locachy-app: %s\n' "$*" >&2
}

# The installation ISO locachy-winiso supplies (KIND windows or virtio-win), or
# nothing: it has none (status 3), it is not installed, or its answer is unusable.
vm_winiso_path() { # NAME KIND
    local out rc=0
    [ -x "$WINISO_TOOL" ] || return 0
    out=$("$WINISO_TOOL" path "$2" </dev/null 2>/dev/null) || rc=$?
    case $rc in
    0) ;;
    3) return 0 ;;
    *) vm_note "$1: locachy-winiso path $2 failed (status $rc): none supplied"; return 0 ;;
    esac
    if [[ "$out" == /* && "$out" != *$'\n'* ]] && [ -f "$out" ]; then
        printf '%s\n' "$out"
    else
        vm_note "$1: locachy-winiso path $2 gave no usable path: none supplied"
    fi
}

# Nothing is on the disk yet (qemu-img map, its backing chain included: no
# extent with data that is not known to be zeros), so nothing is installed on
# it. qemu-img create writes the first block of a raw image (zeros): a raw
# image whose few data blocks (1 MiB at most) are all zeros is still blank.
# Read as the VM's uid. Unreadable: not blank.
vm_disk_blank() { # PATH FORMAT
    ${vm_drop[@]+"${vm_drop[@]}"} python3 -I -c '
import json, subprocess, sys
path, fmt = sys.argv[1], sys.argv[2]
out = subprocess.run(["qemu-img", "map", "--output=json", "-f", fmt, path],
                     check=True, capture_output=True, text=True).stdout
data = [e for e in json.loads(out) if e.get("data") and not e.get("zero")]
if not data:
    sys.exit(0)
if fmt != "raw" or sum(e["length"] for e in data) > (1 << 20):
    sys.exit(1)
with open(path, "rb") as f:
    for e in data:
        f.seek(e.get("offset", e["start"]))
        if f.read(e["length"]).strip(b"\0"):
            sys.exit(1)
' "$1" "$2" 2>/dev/null
}

# DIR/drivers.img: viostor and NetKVM as $WinPEDriver$, which Windows Setup
# loads by itself from a removable disk, made from VIRTIO_ISO by locachy-winmaint
# driver-seed as the VM's uid; made again only when the ISO is newer. Prints its path.
vm_driver_seed() { # NAME VIRTIO_ISO DIR
    local name="$1" virtio="$2" seed="$3/drivers.img" out
    if [ -s "$seed" ] && [ ! "$virtio" -nt "$seed" ]; then
        printf '%s\n' "$seed"
        return 0
    fi
    if [ ! -x "$WINMAINT_TOOL" ]; then
        vm_note "$name: no drivers seed: $WINMAINT_TOOL is not installed"
        return 1
    fi
    if ! out=$(${vm_drop[@]+"${vm_drop[@]}"} "$WINMAINT_TOOL" driver-seed --virtio-iso "$virtio" --out "$seed" </dev/null); then
        vm_note "$name: no drivers seed: locachy-winmaint driver-seed failed"
        return 1
    fi
    if [ "$out" != "$seed" ] || [ ! -s "$seed" ]; then
        vm_note "$name: no drivers seed: locachy-winmaint driver-seed did not make $seed"
        return 1
    fi
    printf '%s\n' "$seed"
}

# Build the QEMU argv for a declarative custom VM (vm_base or vm_disk, no
# command=) into vm_cmd, and record any helper commands to start (vm_need_tpm,
# vm_need_vfs, vm_vfs_dir) after entering app_NAME. Never starts helpers here:
# helpers must live inside app_NAME so freeze and stop include them.
vm_custom_build() { # NAME QMP_SOCK WANT_NET
    local name="$1" qmp_sock="$2" want_net="$3"
    local os base disk iso virtio_iso mem cpus display uefi tpm share_home nic gpu bus audio
    local state_dir disk_path disk_fmt aio qemu accel cpu_arg machine code vars_fd
    local iso_boot=1 blank=0 seed= record=()
    vm_need_tpm=0
    vm_need_vfs=0
    vm_vfs_dir=
    vm_state_used=
    vm_check_keys "$name"
    os=$(conf_value "$name" vm_os)
    [ -n "$os" ] || os=linux
    case $os in
    linux|windows) ;;
    *) die "$name: unknown vm_os \"$os\" (expected linux or windows)" ;;
    esac
    base=$(conf_value "$name" vm_base)
    disk=$(conf_value "$name" vm_disk)
    [ -n "$base" ] || [ -n "$disk" ] ||
        die "$name: custom VM needs command=, vm_base=, or vm_disk= in $CONT_CONF/$name.conf"
    [ -z "$base" ] || [ -z "$disk" ] ||
        die "$name: set either vm_base= (overlay) or vm_disk= (direct image), not both"
    mem=$(conf_value "$name" vm_memory); [ -n "$mem" ] || mem=4096
    cpus=$(conf_value "$name" vm_cpus); [ -n "$cpus" ] || cpus=4
    display=$(conf_value "$name" vm_display); [ -n "$display" ] || display=gtk
    [[ "$mem" =~ ^[1-9][0-9]*$ ]] || die "$name: invalid vm_memory ($mem)"
    [[ "$cpus" =~ ^[1-9][0-9]*$ ]] || die "$name: invalid vm_cpus ($cpus)"
    [[ "$display" =~ ^[A-Za-z0-9][A-Za-z0-9_,=.-]{0,63}$ ]] || die "$name: invalid vm_display ($display)"
    uefi=$(conf_value "$name" vm_uefi)
    [ -n "$uefi" ] || { [ "$os" = windows ] && uefi=1 || uefi=0; }
    tpm=$(conf_value "$name" vm_tpm)
    if [ -z "$tpm" ]; then
        tpm=0
        [ "$os" = windows ] && command -v "${LOCACHY_SWTPM:-swtpm}" >/dev/null 2>&1 && tpm=1
    fi
    share_home=$(conf_value "$name" vm_share_home); [ -n "$share_home" ] || share_home=0
    # virtio-blk (iothread, io_uring) and virtio-net are the fast defaults. A
    # Windows guest's are decided once its disk and virtio-win are known (below).
    nic=$(conf_value "$name" vm_nic)
    [ -n "$nic" ] || [ "$os" = windows ] || nic=virtio
    gpu=$(conf_value "$name" vm_gpu); [ -n "$gpu" ] || gpu=2d
    bus=$(conf_value "$name" vm_disk_bus)
    [ -n "$bus" ] || [ "$os" = windows ] || bus=virtio
    audio=$(conf_value "$name" vm_audio); [ -n "$audio" ] || audio=0
    case $uefi in 0|1) ;; *) die "$name: vm_uefi must be 0 or 1" ;; esac
    case $tpm in 0|1) ;; *) die "$name: vm_tpm must be 0 or 1" ;; esac
    case $share_home in 0|1) ;; *) die "$name: vm_share_home must be 0 or 1" ;; esac
    case $audio in 0|1) ;; *) die "$name: vm_audio must be 0 or 1" ;; esac
    [ -z "$nic" ] || case $nic in virtio|e1000e) ;; *) die "$name: unknown vm_nic \"$nic\" (expected virtio or e1000e)" ;; esac
    case $gpu in 2d|gl) ;; *) die "$name: unknown vm_gpu \"$gpu\" (expected 2d or gl)" ;; esac
    [ "$gpu" = gl ] && [ "$os" = windows ] && die "$name: vm_gpu=\"gl\" (virgl) is for Linux guests only"
    [ -z "$bus" ] || case $bus in virtio|nvme|sata) ;; *) die "$name: unknown vm_disk_bus \"$bus\" (expected virtio, nvme, or sata)" ;; esac
    case $display in gtk|sdl|none) ;; *) die "$name: unknown vm_display \"$display\" (expected gtk, sdl, or none)" ;; esac

    qemu=${LOCACHY_QEMU_BIN:-qemu-system-x86_64}
    command -v "$qemu" >/dev/null 2>&1 || die "$name: $qemu is not installed"
    command -v qemu-img >/dev/null 2>&1 || die "$name: qemu-img is not installed"

    state_dir=$(vm_state_dir "$name") || exit 1
    vm_state_used=$state_dir
    if [ -n "$base" ]; then
        vm_path_ok "$name" vm_base "$base"
        vm_app_can "$name" vm_base r "$base"
        disk_path=$(vm_overlay "$name" "$base" "$state_dir") || exit 1
        disk_fmt=qcow2
    else
        vm_path_ok "$name" vm_disk "$disk"
        vm_app_can "$name" vm_disk r "$disk"
        vm_app_can "$name" vm_disk w "$disk"
        disk_path=$disk
        disk_fmt=$(vm_disk_format "$name" vm_disk "$disk") || exit 1
    fi
    iso=$(conf_value "$name" vm_iso)
    virtio_iso=$(conf_value "$name" vm_virtio_iso)
    if [ "$os" = windows ]; then
        if vm_disk_blank "$disk_path" "$disk_fmt"; then blank=1; fi
        if [ -z "$iso" ]; then
            iso=$(vm_winiso_path "$name" windows)
            # The supplied installer boots first while the disk is blank (the
            # installation); later the firmware's own order decides, which puts
            # Windows Boot Manager first once Windows is installed.
            [ -z "$iso" ] || [ "$blank" = 1 ] || iso_boot=0
            [ -n "$iso" ] || [ "$blank" = 0 ] ||
                vm_note "$name: its disk is blank and it has no Windows installation ISO: set vm_iso, or run locachy-winiso fetch windows"
        fi
        [ -n "$virtio_iso" ] || virtio_iso=$(vm_winiso_path "$name" virtio-win)
    fi
    if [ -n "$iso" ]; then
        vm_path_ok "$name" vm_iso "$iso"
        vm_iso_ok "$name" vm_iso "$iso"
        vm_app_can "$name" vm_iso r "$iso"
    fi
    if [ -n "$virtio_iso" ]; then
        vm_path_ok "$name" vm_virtio_iso "$virtio_iso"
        vm_iso_ok "$name" vm_virtio_iso "$virtio_iso"
        vm_app_can "$name" vm_virtio_iso r "$virtio_iso"
    fi
    if [ "$os" = windows ]; then
        # With virtio-win, Windows Setup loads viostor and NetKVM from the seed by itself.
        [ -z "$virtio_iso" ] || seed=$(vm_driver_seed "$name" "$virtio_iso" "$state_dir") || seed=
        # Defaults, written into the configuration so that later starts keep
        # them whatever virtio-win becomes. virtio only for a blank disk that
        # Setup installs with the drivers seed; otherwise NVMe and e1000e, which
        # Windows has drivers for: a disk with data may hold a Windows installed
        # without viostor (INACCESSIBLE_BOOT_DEVICE on virtio-blk), vm_virtio_iso or not.
        if [ -z "$bus" ]; then
            [ "$blank" = 1 ] && [ -n "$seed" ] && bus=virtio || bus=nvme
            record+=(vm_disk_bus "$bus")
        fi
        if [ -z "$nic" ]; then
            [ "$blank" = 1 ] && [ -n "$seed" ] && nic=virtio || nic=e1000e
            record+=(vm_nic "$nic")
        fi
        if [ "${#record[@]}" -gt 0 ]; then
            if [ "$blank" = 1 ] && [ -z "$seed" ]; then
                if [ -z "$virtio_iso" ]; then
                    vm_note "$name: virtio-win is not available (no vm_virtio_iso, and locachy-winiso has none: the virtio-win package): NVMe disk and e1000e network, which Windows has drivers for"
                else
                    vm_note "$name: Windows Setup cannot load the virtio-win drivers by itself (no drivers seed): NVMe disk and e1000e network, which Windows has drivers for"
                fi
            fi
            conf_set "$name" "${record[@]}"
            vm_note "$name: recorded $(printf '%s="%s" ' "${record[@]}")in $CONT_CONF/$name.conf"
        fi
    fi
    if [ "$share_home" = 1 ]; then
        local uhome
        uhome=$(getent passwd "$APP_UID" | cut -d: -f6 || true)
        [ -n "$uhome" ] && [ -d "$uhome" ] || die "$name: vm_share_home=\"1\" but uid $APP_UID has no home directory"
        vm_virtiofsd_bin >/dev/null || die "$name: vm_share_home=\"1\" requires virtiofsd"
        vm_need_vfs=1
        vm_vfs_dir=$uhome
    fi
    if [ "$tpm" = 1 ]; then
        local swtpm_bin=${LOCACHY_SWTPM:-swtpm}
        command -v "$swtpm_bin" >/dev/null 2>&1 || die "$name: vm_tpm=\"1\" requires $swtpm_bin"
        vm_need_tpm=1
    fi
    if [ "$audio" = 1 ] && [ ! -S "$PULSE_SOCKETS/native" ]; then
        die "$name: vm_audio=\"1\" needs the sound server (no restricted socket at $PULSE_SOCKETS/native)"
    fi

    accel=tcg; cpu_arg=max
    if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
        accel=kvm
        if [ "$os" = windows ]; then
            cpu_arg=host,hv-relaxed,hv-vapic,hv-spinlocks=0x1fff,hv-time,hv-vpindex,hv-synic,hv-stimer,hv-stimer-direct,hv-reset,hv-frequencies,hv-tlbflush,hv-ipi
        else
            cpu_arg=host
        fi
    fi
    machine="q35,accel=$accel"
    [ "$os" = windows ] && [ "$uefi" = 1 ] && machine="$machine,smm=on"
    [ "$vm_need_vfs" = 1 ] && machine="$machine,memory-backend=mem"

    # io_uring is the disk engine; the host kernel must allow it (kernel.io_uring_disabled).
    aio=io_uring
    # 2d leaves OpenGL off; gl turns it on with virtio-vga-gl (Linux guests only).
    # window-close=off: closing the window (its button, the bar, the overview)
    # never pulls the guest's power; stop is QMP cont + system_powerdown.
    local display_arg=$display
    if [ "$display" = gtk ] || [ "$display" = sdl ]; then
        if [ "$gpu" = gl ]; then display_arg="$display,gl=on"; else display_arg="$display,gl=off"; fi
        display_arg="$display_arg,window-close=off"
    fi

    # The window tag: QEMU's title is "QEMU (TAG)" (GTK) or "QEMU (TAG-N)" (SDL).
    # Brackets never occur in an app name, so one VM's tag never prefixes another's.
    vm_cmd=("$qemu" -name "locachy-vm[$name]" -machine "$machine" -cpu "$cpu_arg" -smp "$cpus" -m "$mem")
    if [ "$vm_need_vfs" = 1 ]; then
        vm_cmd+=(-object "memory-backend-memfd,id=mem,size=${mem}M,share=on")
    fi
    if [ "$uefi" = 1 ]; then
        local ovmf_out
        ovmf_out=$(vm_ovmf_pair "$name" "$state_dir") || exit 1
        code=${ovmf_out%%$'\n'*}
        vars_fd=${ovmf_out#*$'\n'}
        vm_cmd+=(-drive "if=pflash,format=raw,unit=0,readonly=on,file=$code"
                 -drive "if=pflash,format=raw,unit=1,file=$vars_fd")
    fi
    case $bus in
    virtio)
        vm_cmd+=(-object iothread,id=io0
                 -drive "file=$disk_path,format=$disk_fmt,if=none,id=hd0,cache=none,aio=$aio,discard=unmap"
                 -device "virtio-blk-pci,drive=hd0,iothread=io0") ;;
    nvme)
        vm_cmd+=(-drive "file=$disk_path,format=$disk_fmt,if=none,id=hd0,cache=none,aio=$aio,discard=unmap"
                 -device "nvme,drive=hd0,serial=locachy-$name") ;;
    sata)
        vm_cmd+=(-drive "file=$disk_path,format=$disk_fmt,if=none,id=hd0,cache=none,aio=$aio,discard=unmap"
                 -device "ide-hd,drive=hd0,bus=ide.0") ;;
    esac
    # Each port of q35's AHCI controller (ide.0 to ide.5) takes one device:
    # the SATA disk, the installer and the virtio-win CD get one each.
    if [ -n "$iso" ]; then
        if [ "$iso_boot" = 1 ]; then
            vm_cmd+=(-drive "file=$iso,media=cdrom,readonly=on,if=none,id=cd0" -device "ide-cd,drive=cd0,bus=ide.1,bootindex=1")
        else
            vm_cmd+=(-drive "file=$iso,media=cdrom,readonly=on,if=none,id=cd0" -device "ide-cd,drive=cd0,bus=ide.1")
        fi
    fi
    if [ -n "$virtio_iso" ]; then
        vm_cmd+=(-drive "file=$virtio_iso,media=cdrom,readonly=on,if=none,id=cd1" -device "ide-cd,drive=cd1,bus=ide.2")
    fi
    if [ "$display" != none ]; then
        if [ "$gpu" = gl ]; then
            vm_cmd+=(-device virtio-vga-gl)
        else
            vm_cmd+=(-device virtio-vga)
        fi
    fi
    if [ "$display" != none ] || [ -n "$seed" ]; then
        vm_cmd+=(-device qemu-xhci,id=xhci)
    fi
    [ "$display" = none ] || vm_cmd+=(-device usb-tablet,bus=xhci.0)
    if [ -n "$seed" ]; then
        vm_cmd+=(-drive "file=$seed,format=raw,readonly=on,if=none,id=drv0" -device "usb-storage,drive=drv0,bus=xhci.0,removable=on")
    fi
    vm_cmd+=(-display "$display_arg" -qmp "unix:$qmp_sock,server=on,wait=off")
    if [ "$want_net" = 1 ]; then
        local nic_dev=virtio-net-pci
        [ "$nic" = e1000e ] && nic_dev=e1000e
        vm_cmd+=(-nic "user,model=$nic_dev")
    else
        vm_cmd+=(-nic none)
    fi
    if [ "$audio" = 1 ]; then
        vm_cmd+=(-audiodev pa,id=snd0 -device ich9-intel-hda -device hda-duplex,audiodev=snd0)
    fi
    if [ "$vm_need_tpm" = 1 ]; then
        vm_cmd+=(-chardev "socket,id=chrtpm,path=$state_dir/swtpm.sock"
                 -tpmdev emulator,id=tpm0,chardev=chrtpm -device tpm-tis,tpmdev=tpm0)
    fi
    if [ "$vm_need_vfs" = 1 ]; then
        vm_cmd+=(-chardev "socket,id=vfs0,path=$state_dir/vfs-home.sock"
                 -device vhost-user-fs-pci,queue-size=1024,chardev=vfs0,tag=home)
    fi
}

conf_value() {
    if [ "${APP_CONFIG_NAME:-}" = "$1" ]; then
        [ -z "${APP_CONF[$2]:-}" ] || printf '%s\n' "${APP_CONF[$2]}"
        return 0
    fi
    local _line _val=
    [ -r "$CONT_CONF/$1.conf" ] || return 0
    while IFS= read -r _line || [ -n "$_line" ]; do
        _line=${_line#"${_line%%[![:space:]]*}"}
        case $_line in
        "$2=\""*\"*)
            _val=${_line#"$2=\""}
            _val=${_val%%\"*}
            ;;
        esac
    done <"$CONT_CONF/$1.conf"
    [ -z "$_val" ] || printf '%s\n' "$_val"
}

# Short configuration transactions run below control.lock. Every decision of
# one build/start then uses the same complete snapshot, never per-key rereads.
config_action() {
    python3 -I - "$(dirname "$(readlink -f "$0")")" "$@" <<'PY'
import importlib.util
import os
import sys
for base in (sys.argv[1], "/usr/local/lib/locachy"):
    path = os.path.join(base, "locachy_config.py")
    if os.path.isfile(path):
        spec = importlib.util.spec_from_file_location("locachy_config", path)
        config = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(config)
        break
else:
    raise RuntimeError("locachy_config.py is not installed")
action, path, *args = sys.argv[2:]
if action == "snapshot":
    # The bytes leave the callback first: nothing is written to the pipe while
    # the configuration lock is held, so no reader can wait on it.
    seen = []

    def read(original):
        if original is None:
            raise FileNotFoundError(path)
        seen.append(bytes(original))
        return config.UNCHANGED
    config.transaction(path, read)
    sys.stdout.write(seen[0].decode("utf-8"))
elif action == "set":
    config.update(path, [(args[i], args[i + 1]) for i in range(0, len(args), 2)])
elif action == "remove":
    config.remove(path) # False: it was not there, which is no error
else:
    raise ValueError("invalid app configuration operation")
PY
}

# Installed build/rollback/remove are fixed jobs. A job or offline root runs
# inline below; a queued caller never holds app/config locks while waiting.
route_app_job() { # KIND NAME [--data]
    local status=0
    python3 -I - "$(dirname "$(readlink -f "$0")")" "$@" <<'PY' || status=$?
import importlib.util
import os
import sys
for base in (sys.argv[1], "/usr/local/lib/locachy"):
    path = os.path.join(base, "locachy_jobs.py")
    if os.path.isfile(path):
        spec = importlib.util.spec_from_file_location("locachy_jobs", path)
        jobs = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(jobs)
        break
else:
    sys.exit("locachy-app: locachy_jobs.py is not installed")
try:
    mode = jobs.execution_mode()
    if mode in ("job", "offline"):
        sys.exit(100)
    sys.exit(jobs.submit(sys.argv[2], sys.argv[3:]))
except RuntimeError as e:
    # The service answered: a refusal (its reason as it says it), not a fallback.
    if str(e).startswith("job service: "):
        sys.exit(f"locachy-app: {sys.argv[2]}: refused: {str(e)[len('job service: '):]}")
    sys.exit(f"locachy-app: {sys.argv[2]}: {e}; not run outside the job queue")
except OSError as e:
    # The service being unavailable is a failure, never a direct fallback.
    sys.exit(f"locachy-app: {sys.argv[2]}: {e}; not run outside the job queue")
PY
    [ "$status" = 100 ] && return 0
    exit "$status"
}

load_config_snapshot() {
    # No configuration: as before, every key is empty. One that is there is
    # read whole under the shared configuration lock (same TARGET.lock as
    # locachy_config.py / base/rc.c), then parsed once into APP_CONF.
    APP_CONFIG_NAME=$1
    APP_CONFIG_SNAPSHOT=
    APP_CONF=()
    local _parent _conf _lock _cfd _err _rc _line _trimmed
    if [ ! -e "$CONT_CONF/$1.conf" ] && [ ! -L "$CONT_CONF/$1.conf" ]; then
        return 0
    fi
    if [ -L "$CONT_CONF" ]; then
        _parent=$(cd -P -- "$CONT_CONF" 2>/dev/null && pwd) || die "$1: cannot read its configuration"
    else
        _parent=$CONT_CONF
    fi
    _conf="$_parent/$1.conf"
    _lock="$_conf.lock"
    if command -v flock >/dev/null 2>&1 && [ ! -L "$_lock" ]; then
        if [ -e "$_lock" ] && [ ! -f "$_lock" ]; then
            APP_CONFIG_SNAPSHOT=$(config_action snapshot "$_conf") || die "$1: cannot read its configuration"
        elif { exec {_err}>&2 2>/dev/null; exec {_cfd}>>"$_lock"; _rc=$?; exec 2>&"$_err" {_err}>&-; [ "$_rc" -eq 0 ]; }; then
            flock -s "$_cfd"
            if [ -L "$_conf" ]; then
                exec {_cfd}>&-
                die "$1: cannot read its configuration"
            elif [ ! -e "$_conf" ]; then
                exec {_cfd}>&-
                return 0
            elif [ ! -f "$_conf" ] || [ ! -r "$_conf" ]; then
                exec {_cfd}>&-
                die "$1: cannot read its configuration"
            fi
            # read -d '' succeeds only when it stops at a NUL byte; the end of
            # the file returns 1. A NUL is refused, as locachy_config.py does:
            # a truncated configuration must never drop keys such as tor="1".
            if IFS= read -r -d '' APP_CONFIG_SNAPSHOT <"$_conf"; then
                exec {_cfd}>&-
                die "$1: cannot read its configuration"
            fi
            exec {_cfd}>&-
        else
            APP_CONFIG_SNAPSHOT=$(config_action snapshot "$_conf") || die "$1: cannot read its configuration"
        fi
    else
        APP_CONFIG_SNAPSHOT=$(config_action snapshot "$_conf") || die "$1: cannot read its configuration"
    fi
    while IFS= read -r _line || [ -n "$_line" ]; do
        _trimmed=${_line#"${_line%%[![:space:]]*}"}
        if [[ "$_trimmed" =~ ^([A-Za-z0-9_]+)=\"([^\"]*)\" ]]; then
            APP_CONF[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
        fi
    done <<<"$APP_CONFIG_SNAPSHOT"
}

rc_has_key() { # KEY
    local _line
    [ -r "$RC_CONF" ] || return 1
    while IFS= read -r _line || [ -n "$_line" ]; do
        _line=${_line#"${_line%%[![:space:]]*}"}
        case $_line in
        "$1="*) return 0 ;;
        esac
    done <"$RC_CONF"
    return 1
}

rc_key_value() { # KEY
    local _line _val=
    [ -r "$RC_CONF" ] || return 0
    while IFS= read -r _line || [ -n "$_line" ]; do
        _line=${_line#"${_line%%[![:space:]]*}"}
        case $_line in
        "$1=\""*\"*)
            _val=${_line#"$1=\""}
            _val=${_val%%\"*}
            ;;
        esac
    done <"$RC_CONF"
    [ -z "$_val" ] || printf '%s\n' "$_val"
}

# KEY="VALUE" in NAME's configuration, in place of its line (VALUE: no quote,
# no newline).
conf_set() {
    local name="$1"; shift
    mkdir -p "$CONT_CONF"
    config_action set "$CONT_CONF/$name.conf" "$@"
    [ "${APP_CONFIG_NAME:-}" = "$name" ] && load_config_snapshot "$name" || true
}

# NAME's command and arguments, into the array saved_cmd.
saved_command() {
    read -r -a saved_cmd <<<"$(conf_value "$1" command) $(conf_value "$1" arguments)" || true
    [ "${#saved_cmd[@]}" -gt 0 ] || die "$1 has no command (command= in $CONT_CONF/$1.conf)"
    # Compatibility with the shipped system-Tor-only recipe. Strip only its
    # exact environment prefix, in memory: user configuration is not rewritten.
    if [ "$(conf_value "$1" package)" = tor-browser-bin ] &&
       [ "${#saved_cmd[@]}" -ge 6 ] &&
       [ "${saved_cmd[0]}" = /usr/bin/env ] &&
       [ "${saved_cmd[1]}" = MOZ_APP_REMOTINGNAME=tor-browser ] &&
       [ "${saved_cmd[2]}" = TOR_PROVIDER=none ] &&
       [ "${saved_cmd[3]}" = TOR_SOCKS_HOST=127.0.0.1 ] &&
       [ "${saved_cmd[4]}" = TOR_SOCKS_PORT=9050 ] &&
       [ "${saved_cmd[5]}" = /usr/bin/tor-browser ]; then
        saved_cmd=(/usr/bin/env MOZ_APP_REMOTINGNAME=tor-browser /usr/bin/tor-browser "${saved_cmd[@]:6}")
    fi
}

# Old and new host recipes use the package executable. Add its palette at
# launch, without changing the recipe or matching commands by basename.
managed_foot_command() { # NAME EXECUTABLE
    [ "$2" = /usr/bin/foot ] && [ -x "$FOOT_WRAPPER" ] && is_host "$1" &&
        [ "$(conf_value "$1" command)" = /usr/bin/foot ]
}

# Only the known Tor Browser package/wrapper has a bundled tor. tor="1"
# remains system-Tor-only for every other application; it grants no bypass.
tor_browser_launch() { # COMMAND...
    [ "${1:-}" = /usr/bin/tor-browser ] ||
        { [ "${1:-}" = /usr/bin/env ] && [ "${2:-}" = MOZ_APP_REMOTINGNAME=tor-browser ] &&
          [ "${3:-}" = /usr/bin/tor-browser ]; }
}

own_tor_supported() { # NAME
    [ "$(conf_value "$1" package)" = tor-browser-bin ] || return 1
    local saved_cmd=()
    saved_command "$1"
    tor_browser_launch "${saved_cmd[@]}"
}

# NAME's packages: its package and extras, into the array packages.
saved_packages() {
    read -r -a packages <<<"$(conf_value "$1" package) $(conf_value "$1" extras)" || true
}

# Why DIR (of NAME's directories) cannot be given to a container whose user
# has the home UHOME; nothing if it can.
directory_refused() { # DIR UHOME
    local d=${1%/} rel shared
    case "$d" in
    "$2"/?*) ;;
    *) printf '%s is not in %s\n' "$1" "$2"; return ;;
    esac
    [ -d "$d" ] || { printf '%s is not a directory\n' "$1"; return; }
    # No link, . or .. on the way: it is where it says.
    [ "$(realpath -e -- "$d")" = "$d" ] || { printf '%s goes through a link\n' "$1"; return; }
    rel=${d#"$2"/}
    case "${rel%%/*}" in
    Drives) printf '%s is in Drives, which it has already (as a whole: a drive in it could not be ejected)\n' "$1"; return ;;
    esac
    for shared in $USER_DIRS; do
        [ "${rel%%/*}" != "$shared" ] || { printf '%s is in %s, which it has already\n' "$1" "$shared"; return; }
    done
}

valid_name() {
    [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$ ]]
}

check_name() {
    valid_name "$1" || die "invalid app name (use 1-64 letters, digits, dots, underscores or hyphens; start with a letter or digit)"
    # window-PROGRAM-N: process 1's native windows (root host programs);
    # labwc and the document service tell them by that name.
    [[ "$1" != window-* ]] || die "invalid app name: names beginning with window- are the native windows'"
}

cg_path() {
    printf '%s/app_%s\n' "$CGROUP_BASE" "$1"
}

cg_event() {
    local key value
    [ -r "$1/cgroup.events" ] || return 1
    while read -r key value; do
        if [ "$key" = "$2" ]; then
            printf '%s\n' "$value"
            return 0
        fi
    done <"$1/cgroup.events"
    return 1
}

is_running() {
    [ "$(cg_event "$(cg_path "$1")" populated || true)" = 1 ]
}

is_frozen() {
    [ "$(cg_event "$(cg_path "$1")" frozen || true)" = 1 ]
}

# Build/rollback publication. upper, work and built cannot be renamed as one
# unit, so a durable generation.state is written before the first visible
# rename. Recovery is idempotent: build rolls forward from complete *.new
# stages; rollback compares recorded inodes, so a crash between an exchange
# and the next state write is never guessed. Start refuses pending state.
generation_tool() { # build|rollback|recover CBASE
    python3 -I - "$@" <<'PY'
import ctypes
import os
import shutil
import sys

op, cbase = sys.argv[1:3]
state = os.path.join(cbase, "generation.state")
libc = ctypes.CDLL(None, use_errno=True)


def p(name):
    return os.path.join(cbase, name)


def exists(name):
    return os.path.lexists(p(name))


def ino(name):
    try:
        return str(os.lstat(p(name)).st_ino)
    except FileNotFoundError:
        return "-"


def sync_dir(full=False):
    fd = os.open(cbase, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        if full and libc.syncfs(fd) != 0:
            error = ctypes.get_errno()
            raise OSError(error, os.strerror(error), cbase)
        os.fsync(fd)
    finally:
        os.close(fd)


def write_state(text):
    tmp = state + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, text.encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, state)
    sync_dir()


def remove(name):
    path = p(name)
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    elif os.path.lexists(path):
        os.unlink(path)


def exchange(a, b):
    if libc.renameat2(-100, os.fsencode(p(a)), -100, os.fsencode(p(b)), 2) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error), p(a))


def done():
    os.unlink(state)
    sync_dir()


def finish_build():
    for part in ("upper", "work", "built"):
        if exists(part + ".new"):
            if exists(part):
                if exists(part + ".old"):
                    raise RuntimeError(f"{part}: current and old generations both exist")
                os.rename(p(part), p(part + ".old"))
            os.rename(p(part + ".new"), p(part))
    if not all(exists(part) for part in ("upper", "work", "built")):
        raise RuntimeError("the pending build is incomplete")
    sync_dir()
    for part in ("upper", "built"):
        if exists(part + ".old"):
            remove(part + ".prev")
            os.rename(p(part + ".old"), p(part + ".prev"))
    remove("work.old")
    sync_dir()
    done()


def finish_rollback(upper, upper_prev, built, built_prev):
    current = (ino("upper"), ino("upper.prev"))
    if current == (upper, upper_prev):
        if upper == "-":
            os.rename(p("upper.prev"), p("upper"))
        else:
            exchange("upper", "upper.prev")
    elif ino("upper") != upper_prev:
        raise RuntimeError("upper does not match the pending rollback")
    current = (ino("built"), ino("built.prev"))
    if current == (built, built_prev) and current != (built_prev, built):
        if built != "-" and built_prev != "-":
            exchange("built", "built.prev")
        elif built != "-":
            os.rename(p("built"), p("built.prev"))
        else:
            os.rename(p("built.prev"), p("built"))
    elif current != (built_prev, built):
        raise RuntimeError("build record does not match the pending rollback")
    remove("work")
    os.mkdir(p("work"), 0o700)
    sync_dir()
    done()


def recover():
    try:
        with open(state, encoding="ascii") as f:
            fields = f.read().split()
    except FileNotFoundError:
        return
    if fields == ["build"]:
        finish_build()
    elif len(fields) == 5 and fields[0] == "rollback":
        finish_rollback(*fields[1:])
    else:
        raise RuntimeError("unknown pending generation state")


if op == "recover":
    recover()
elif op == "build":
    recover()
    if not all(exists(part + ".new") for part in ("upper", "work", "built")):
        raise RuntimeError("the new build is incomplete")
    sync_dir(full=True)
    write_state("build\n")
    finish_build()
elif op == "rollback":
    recover()
    if not os.path.isdir(p("upper.prev")):
        raise RuntimeError("no previous build")
    write_state(f"rollback {ino('upper')} {ino('upper.prev')} {ino('built')} {ino('built.prev')}\n")
    with open(state, encoding="ascii") as f:
        finish_rollback(*f.read().split()[1:])
else:
    raise ValueError("unknown generation operation")
PY
}

# cgroup.events accounts for the entire subtree, even with no direct procs.
# Sixty 50ms polls bound each kernel transition to approximately three seconds;
# an optional fourth argument sets a custom poll count (e.g. 160 = ~8 s).
wait_event() {
    local cg="$1" key="$2" expected="$3" polls="${4:-60}" i
    for ((i = 0; i < polls; ++i)); do
        [ "$(cg_event "$cg" "$key" || true)" = "$expected" ] && return 0
        sleep 0.05
    done
    [ "$(cg_event "$cg" "$key" || true)" = "$expected" ]
}

bytes_of() {
    local value=0
    if [ -r "$1" ]; then
        read -r value <"$1" || value=0
    fi
    [[ "$value" =~ ^[0-9]+$ ]] || value=0
    printf '%s\n' "$value"
}

mib_of() {
    bytes_of "$1" | awk '{printf "%.1f", $1 / 1048576}'
}

# One short control/start/install lock; never held for an app's lifetime, so
# freeze/stop remain possible. flock comes from the existing util-linux tools.
lock_app() {
    command -v flock >/dev/null 2>&1 || die "flock is required"
    mkdir -p -m 0700 "$APP_RUNTIME/$1"
    exec {APP_LOCK_FD}>"$APP_RUNTIME/$1/control.lock"
    flock -x "$APP_LOCK_FD"
}

unlock_app() {
    flock -u "$APP_LOCK_FD"
    exec {APP_LOCK_FD}>&-
}

# The memory of a frozen container going out to swap (do_freeze), stopped:
# the container runs again, or goes.
stop_reclaim() {
    local pid=
    if [ -r "$APP_RUNTIME/$1/reclaim.pid" ]; then
        read -r pid <"$APP_RUNTIME/$1/reclaim.pid" || true
        [[ "$pid" =~ ^[1-9][0-9]*$ ]] && kill "$pid" 2>/dev/null || true
        rm -f "$APP_RUNTIME/$1/reclaim.pid"
    fi
}
do_resume() {
    local name="$1" cg qmp_sock paused_file
    cg=$(cg_path "$name")
    is_running "$name" || die "$name is not running"
    stop_reclaim "$name"
    printf '0\n' >"$cg/cgroup.freeze"
    wait_event "$cg" frozen 0 || die "timed out resuming $name"
    is_running "$name" || die "$name exited while resuming"
    if is_vm "$name"; then
        qmp_sock=$(vm_qmp_sock "$name")
        paused_file=$(vm_paused_file "$name")
        if [ -e "$paused_file" ]; then
            if [ -S "$qmp_sock" ]; then
                vm_qmp "$qmp_sock" cont || die "$name: QMP cont failed while resuming"
            fi
            rm -f "$paused_file"
        fi
    fi
}

do_freeze() {
    local name="$1" cg bytes clipboard=$CLIPBOARD mode qmp_sock paused_file qmp_paused=0
    cg=$(cg_path "$name")
    is_running "$name" || die "$name is not running"
    if is_vm "$name"; then
        mode=$(vm_freeze_mode "$name")
        if [ "$mode" = none ]; then
            return 0
        fi
        is_frozen "$name" && return 0
        qmp_sock=$(vm_qmp_sock "$name")
        paused_file=$(vm_paused_file "$name")
        # Sync clipboard before pausing vCPUs, then pause QEMU cleanly via QMP
        # BEFORE freezing the cgroup so guest virtual clocks and virtio queues
        # halt at a clean boundary and zero host wakeups occur while frozen.
        if [ -x "$clipboard" ]; then
            "$clipboard" sync >/dev/null 2>&1 || true
        fi
        if [ -S "$qmp_sock" ]; then
            vm_qmp "$qmp_sock" stop || die "$name: QMP stop failed; not frozen"
            : >"$paused_file"
            qmp_paused=1
        fi
        # The compositor gates the cgroup through the clipboard handover, as for
        # containers. Failing that, the VM is resumed rather than frozen unguarded.
        if [ ! -x "$clipboard" ] || ! "$clipboard" freeze "$cg"; then
            if [ "$qmp_paused" = 1 ]; then
                vm_qmp "$qmp_sock" cont 2>/dev/null || true
                rm -f "$paused_file"
            fi
            die "clipboard handover failed; $name was not frozen"
        fi
        is_running "$name" || die "$name exited while freezing"
        return 0
    fi
    is_frozen "$name" && return 0
    # The operation runs outside app_NAME, not in process 1. Its pending job
    # keeps the shared display active until the clipboard owns all bytes.
    [ -x "$clipboard" ] || die "clipboard service is not installed; $name was not frozen"
    # The compositor gates this cgroup before capture and keeps it gated
    # until the kernel reports thaw. No cross-client sync guesswork.
    "$clipboard" freeze "$cg" || die "clipboard handover failed; $name was not frozen"
    is_running "$name" || die "$name exited while freezing"
    bytes=$(bytes_of "$cg/memory.current")
    if [ "$bytes" -gt 0 ] && [ -w "$cg/memory.reclaim" ]; then
        # Its memory out to swap, in the background: frozen it is already, and
        # gigabytes take longer to write than process 1 waits for a freeze.
        # Best effort (EAGAIN may mean only part); a resume stops it.
        stop_reclaim "$name"
        (
            exec {APP_LOCK_FD}>&-
            { printf '%s\n' "$bytes" >"$cg/memory.reclaim"; } 2>/dev/null || true
            rm -f "$APP_RUNTIME/$name/reclaim.pid"
        ) </dev/null >/dev/null 2>&1 &
        printf '%s\n' "$!" >"$APP_RUNTIME/$name/reclaim.pid"
    fi
}

request_term() {
    local name="$1" pid= ticks= stat_line fields cg
    cg=$(cg_path "$name")
    if [ -r "$APP_RUNTIME/$name/reaper.pid" ]; then
        read -r pid ticks <"$APP_RUNTIME/$name/reaper.pid" || true
    fi
    # Verify cgroup and start time rather than trusting a reusable host PID.
    if [[ "$pid" =~ ^[1-9][0-9]*$ ]] && [[ "$ticks" =~ ^[0-9]+$ ]] &&
       { { [ "$CGROUP_BASE" = /sys/fs/cgroup ] && grep -qxF "0::/app_$name" "/proc/$pid/cgroup" 2>/dev/null; } ||
         { [ "$CGROUP_BASE" != /sys/fs/cgroup ] && grep -qxF "$pid" "$cg/cgroup.procs" 2>/dev/null; }; } &&
       { read -r stat_line <"/proc/$pid/stat"; } 2>/dev/null; then
        fields=${stat_line##*) }
        read -r -a fields <<<"$fields"
        if [ "${fields[19]:-}" = "$ticks" ]; then
            kill -TERM "$pid" 2>/dev/null || true
        fi
    fi
}

do_stop() {
    local name="$1" cg qmp_sock paused_file
    cg=$(cg_path "$name")
    stop_reclaim "$name"
    if is_running "$name"; then
        [ -w "$cg/cgroup.kill" ] || die "cgroup.kill is required to stop $name safely"
        # A frozen PID 1 must run before it can process TERM. cgroup.kill
        # below also covers frozen descendants and separate sessions.
        printf '0\n' >"$cg/cgroup.freeze"
        # Stopping remains possible if the source or clipboard service is
        # broken; warn rather than keeping an unwanted application alive.
        if [ -x "$CLIPBOARD" ]; then
            "$CLIPBOARD" sync >/dev/null ||
                printf 'locachy-app: %s: clipboard was not saved before stopping\n' "$name" >&2
        fi
        if is_vm "$name"; then
            wait_event "$cg" frozen 0 || true
            qmp_sock=$(vm_qmp_sock "$name")
            paused_file=$(vm_paused_file "$name")
            if [ -e "$paused_file" ]; then
                if [ -S "$qmp_sock" ]; then
                    vm_qmp "$qmp_sock" cont 2>/dev/null || true
                fi
                rm -f "$paused_file"
            fi
            # Graceful ACPI power button via QMP so Windows/Linux guests flush
            # disks and run shutdown hooks (up to ~8 s), then SIGTERM so the
            # launcher's finally block tears down dm-linear/loop/swtpm cleanly.
            if [ -S "$qmp_sock" ]; then
                vm_qmp "$qmp_sock" system_powerdown 2>/dev/null || true
                wait_event "$cg" populated 0 160 || true
            fi
            if is_running "$name"; then
                request_term "$name"
                wait_event "$cg" populated 0 60 || true
            fi
            if is_running "$name"; then
                printf '1\n' >"$cg/cgroup.kill"
                wait_event "$cg" populated 0 || die "timed out stopping $name after cgroup.kill"
            fi
        else
            # Ask open Wayland windows to close cleanly first so browsers flush
            # cookies and storage to disk before falling back to SIGTERM.
            if [ -x /usr/local/lib/locachy/labwc-control ] && [ -S "$RUNTIME_DIR/locachy-control.sock" ] &&
               /usr/local/lib/locachy/labwc-control --close "$name" 2>/dev/null; then
                wait_event "$cg" populated 0 || true
            fi
            if is_running "$name"; then
                request_term "$name"
                # Allow up to three seconds for the reaper and launcher to exit.
                wait_event "$cg" populated 0 || true
                printf '1\n' >"$cg/cgroup.kill"
                wait_event "$cg" populated 0 || die "timed out stopping $name after cgroup.kill"
            fi
        fi
    fi
    rm -f "$APP_RUNTIME/$name/reaper.pid" "$APP_RUNTIME/$name/tor-mode" "$APP_RUNTIME/$name.ready" \
          "$APP_RUNTIME/$name/vm-paused" "$(vm_qmp_sock "$name")" "$VM_STATE/$name/swtpm.sock" "$VM_STATE/$name/vfs-home.sock"
    if [ "$(conf_value "$name" tor)" = 1 ]; then
        "$TOR_ENFORCE" app-remove "$name" || die "$name: cannot remove its Tor firewall"
        rm -f "$APP_RUNTIME/$name/tor-firewall"
    elif [ -e "$APP_RUNTIME/$name/tor-firewall" ] && [ -x "$TOR_ENFORCE" ]; then
        "$TOR_ENFORCE" app-remove "$name" && rm -f "$APP_RUNTIME/$name/tor-firewall" || true
    fi
    # No host mounts to unmount: the private mount namespace dies with the
    # subtree. Leave upper, work and data untouched.
}

# Run COMMAND... TARGET in the running container NAME as its programs run:
# its namespaces and root, the user, the environment its reaper was given,
# its cgroup (so freezing and stopping include it). In the background: a
# program that is not single-instance keeps its window.
do_open_running() { # NAME TARGET COMMAND...
    local name=$1 target=$2 pid= ticks= kv uid= gid= home=/ nnp=
    shift 2
    if is_vm "$name"; then
        # A VM is a single-instance machine: never spawn a second QEMU on its disk.
        is_frozen "$name" && do_resume "$name"
        return 0
    fi
    if [ "$(conf_value "$name" network)" = 1 ] && [ "$(conf_value "$name" tor)" = 1 ]; then
        local tor_mode=system
        [ ! -r "$APP_RUNTIME/$name/tor-mode" ] || IFS= read -r tor_mode <"$APP_RUNTIME/$name/tor-mode" || tor_mode=system
        if [ "$tor_mode" = own ]; then
            ! rc_has_key service_tor && ! "$TOR_ENFORCE" loaded ||
                die "$name is running with its own Tor while full-system Tor is on: stop $name first"
        else
            rc_has_key service_tor ||
                die "$name requires full-system Tor: turn Tor on in settings first"
            "$TOR_ENFORCE" loaded ||
                die "$name requires full-system Tor and its firewall is not loaded"
        fi
    fi
    if [ -r "$APP_RUNTIME/$name/reaper.pid" ]; then
        read -r pid ticks <"$APP_RUNTIME/$name/reaper.pid" || true
    fi
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] && grep -qxF "0::/app_$name" "/proc/$pid/cgroup" 2>/dev/null ||
        die "the reaper of $name is not running"
    local env=()
    while IFS= read -r -d '' kv; do
        case "$kv" in
        LOCACHY_APP_UID=*) uid=${kv#*=} ;;
        LOCACHY_APP_GID=*) gid=${kv#*=} ;;
        LOCACHY_APP_NO_NEW_PRIVS=1) nnp=--no-new-privs ;;
        HOME=*) home=${kv#*=}; env+=("$kv") ;;
        LOCACHY_*) ;;
        *) env+=("$kv") ;;
        esac
    done <"/proc/$pid/environ"
    [ -n "$uid" ] && [ -n "$gid" ] || die "cannot tell the user of $name"
    if [ -z "$nnp" ] && managed_foot_command "$name" "${1:-}"; then
        set -- "$FOOT_WRAPPER" "${@:2}"
    fi
    (
        exec {APP_LOCK_FD}>&- # the program may outlive this command: not the lock
        printf '%s\n' "$BASHPID" >"$(cg_path "$name")/cgroup.procs"
        exec nsenter --target "$pid" --mount --pid --net --root --wd -- \
            setpriv --reuid="$uid" --regid="$gid" --clear-groups $nnp -- \
            env -i -C "$home" "${env[@]}" "$@" ${target:+"$target"}
    ) </dev/null >>"$APP_RUNTIME/$name.log" 2>&1 &
}

# The container built anew from its configuration (package, extras): a fresh upper
# over the host root (upper.new), with the repositories' packages (pacman, in
# it) and the AUR's (built by locachy-build into /var/cache/locachy-pkgs);
# what the host has comes from the host. The programs of its AUR packages
# (ELF files with a program interpreter: not the libraries, some of which are
# optional plugins, as Edge's Qt shims) are checked for the libraries they
# need: an AUR package whose program misses one is built again, once.
# Only then does it take the place of the old upper, which is kept as
# upper.prev (locachy-app rollback). Its home (data) is not touched.
do_build() {
    local name="$1" attempt cbase="$CONT_BASE/$1" pkg_cache=/var/cache/locachy-pkgs
    local packages repo_pkgs=() aur_pkgs=() p missing command
    if [ "$(conf_value "$name" vm)" = 1 ]; then
        die "$name is a VM app: it has no container package build"
    fi
    if is_host "$name"; then
        # The same store build action installs a recipe with real-system
        # access on the host. The configuration grants that access; packages
        # must be registered leaves so later reconciliation keeps them.
        mkdir -p "$CONT_BASE" "$cbase"
        chmod 0700 "$CONT_BASE"
        rm -f "$cbase/built" "$cbase/built.new"
        saved_packages "$name"
        [ "${#packages[@]}" -gt 0 ] || die "$name has no package (package= in $CONT_CONF/$name.conf)"
        locachy-pkg install "${packages[@]}" || die "$name: package installation failed; not built"
        command=$(conf_value "$name" command)
        [ -n "$command" ] && [ -x "$command" ] || die "$name: $command is not installed after its packages; not built"
        printf 'date="%s"\npackages="%s"\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${packages[*]}" >"$cbase/built.new"
        mv -f "$cbase/built.new" "$cbase/built"
        printf 'locachy-app: %s built: real-system packages installed\n' "$name"
        return 0
    fi
    saved_packages "$name"
    [ "${#packages[@]}" -gt 0 ] || die "$name has no package (package= in $CONT_CONF/$name.conf)"
    for p in "${packages[@]}"; do
        if pacman -Sp "$p" >/dev/null 2>&1; then
            repo_pkgs+=("$p")
        else
            aur_pkgs+=("$p")
        fi
    done
    mkdir -p "$CONT_BASE" "$cbase/merged" "$pkg_cache"
    chmod 0700 "$CONT_BASE"
    generation_tool recover "$cbase" || die "$name: cannot recover its interrupted generation"
    [ ! -L "$cbase/data" ] || die "$name: $cbase/data is a symbolic link"
    mkdir -p "$cbase/data"
    [ -d /sys/module/overlay ] || grep -qw overlay /proc/filesystems 2>/dev/null || modprobe overlay 2>/dev/null || true

    # AUR packages not built yet.
    local unbuilt=()
    for p in "${aur_pkgs[@]}"; do
        /usr/local/bin/locachy-build --files / "$p" >/dev/null 2>&1 || unbuilt+=("$p")
    done
    [ "${#unbuilt[@]}" -eq 0 ] || /usr/local/bin/locachy-build "${unbuilt[@]}"

    local net_prefix=() build_rc f base dst tmp
    [ -e /run/netns/locachy-net ] && net_prefix=(ip netns exec locachy-net)
    install -d -m 0755 /var/cache/pacman/pkg
    for attempt in 1 2; do
        rm -rf "$cbase/upper.new" "$cbase/work.new" "$cbase/missing" "$cbase/pkg-cache"
        mkdir -p "$cbase/upper.new" "$cbase/work.new" "$cbase/pkg-cache"
        chmod 0755 "$cbase/pkg-cache"
        build_rc=0
        "${net_prefix[@]}" unshare --mount --propagation private bash -euc '
            cbase=$1; n_repo=$2; shift 2
            root=$cbase/merged
            mount -t overlay overlay -o "lowerdir=/,upperdir=$cbase/upper.new,workdir=$cbase/work.new" "$root"
            # Package installation needs proc and basic devices, not the host
            # runtime sockets, input devices, disks or DRM card nodes.
            mkdir -p "$root"/{dev,proc,sys,run,tmp,var/lib/locachy}
            mount -t proc proc "$root/proc" -o nosuid,noexec,nodev
            mount -t sysfs sys "$root/sys" -o nosuid,noexec,nodev,ro
            mount -t tmpfs run "$root/run" -o mode=0755,nosuid,nodev
            mount -t tmpfs tmp "$root/tmp" -o mode=1777,nosuid,nodev
            mount -t tmpfs hidden "$root/var/lib/locachy" -o mode=0755,nosuid,nodev,size=1m
            mount -t tmpfs dev "$root/dev" -o mode=0755,nosuid,nodev
            for d in null zero full random urandom tty; do
                [ -e "/dev/$d" ] || continue
                touch "$root/dev/$d"
                mount --bind "/dev/$d" "$root/dev/$d"
            done
            mkdir -p "$root/dev/pts" "$root/dev/shm"
            mount -t devpts devpts "$root/dev/pts" -o mode=0620,gid=5,ptmxmode=0666
            mount -t tmpfs shm "$root/dev/shm" -o mode=1777,nosuid,nodev
            ln -sf pts/ptmx "$root/dev/ptmx"
            ln -sf /proc/self/fd "$root/dev/fd"
            ln -sf /proc/self/fd/0 "$root/dev/stdin"
            ln -sf /proc/self/fd/1 "$root/dev/stdout"
            ln -sf /proc/self/fd/2 "$root/dev/stderr"
            # Concurrent container builds read the shared host package cache
            # read-only and download only uncached packages into their own
            # private directory; completed archives are promoted below.
            mkdir -p "$root/var/cache/pacman/pkg" "$root/var/cache/locachy-pkgs" "$root/run/locachy-pkg-cache"
            mount --bind -o ro /var/cache/pacman/pkg "$root/var/cache/pacman/pkg"
            mount --bind "$cbase/pkg-cache" "$root/run/locachy-pkg-cache"
            mount --bind /var/cache/locachy-pkgs "$root/var/cache/locachy-pkgs"
            if [ -f /etc/netns/locachy-net/resolv.conf ]; then
                cp -f /etc/netns/locachy-net/resolv.conf "$root/etc/resolv.conf" 2>/dev/null || true
            fi
            in_build="setpriv --bounding-set=-mknod,-sys_rawio,-sys_module,-sys_boot -- chroot $root"
            cache_args=(--cachedir /var/cache/pacman/pkg --cachedir /run/locachy-pkg-cache)
            if [ "$n_repo" -gt 0 ]; then
                $in_build pacman -S --needed --noconfirm --asexplicit "${cache_args[@]}" "${@:1:$n_repo}"
                shift "$n_repo"
            fi
            if [ $# -gt 0 ]; then
                mapfile -t files < <(/usr/local/bin/locachy-build --files "$root" "$@")
                $in_build pacman -U --needed --noconfirm --asdeps "${cache_args[@]}" "${files[@]}"
                $in_build pacman -D --asexplicit "$@" >/dev/null
                # The libraries its AUR programs need (the host may have moved
                # on since they were built): "PACKAGE LIBRARY" for each missing.
                for p in $(for f in "${files[@]}"; do bsdtar -xOf "$f" .PKGINFO | sed -n "s/^pkgname = //p"; done); do
                    chroot "$root" pacman -Qlq "$p" | while read -r f; do
                        [ -f "$root$f" ] && [ ! -L "$root$f" ] || continue
                        [ "$(head -c 4 "$root$f" | od -An -c | tr -d " ")" = 177ELF ] || continue
                        readelf -lW "$root$f" 2>/dev/null | grep -q "program interpreter" || continue
                        chroot "$root" ldd "$f" 2>/dev/null | sed -n "s/^[[:space:]]*\([^ ]*\) => not found.*/$p \1/p"
                    done
                done | sort -u >"$cbase/missing"
            fi
        ' bash "$cbase" "${#repo_pkgs[@]}" "${repo_pkgs[@]}" "${aur_pkgs[@]}" || build_rc=$?
        if [ "$build_rc" -eq 0 ]; then
            # Promote signatures before archives so concurrent readers never see
            # a newly cached package before its signature is in place.
            for f in "$cbase/pkg-cache"/*.pkg.tar.*.sig "$cbase/pkg-cache"/*.pkg.tar.*; do
                [ -f "$f" ] && [ ! -L "$f" ] || continue
                case "$f" in
                *.part*|*.tmp) continue ;;
                esac
                base=${f##*/}
                dst="/var/cache/pacman/pkg/$base"
                [ ! -e "$dst" ] || continue
                tmp="/var/cache/pacman/pkg/.locachy-cache.$$.$base"
                if install -m 0644 -o root -g root "$f" "$tmp" 2>/dev/null; then
                    ln "$tmp" "$dst" 2>/dev/null || { [ -e "$dst" ] || mv -n "$tmp" "$dst" 2>/dev/null || true; }
                fi
                rm -f "$tmp"
            done
        fi
        rm -rf "$cbase/pkg-cache"
        [ "$build_rc" -eq 0 ] || return "$build_rc"
        [ -s "$cbase/missing" ] || break
        missing=$(cut -d" " -f1 "$cbase/missing" | sort -u | tr '\n' ' ')
        printf 'locachy-app: %s: libraries missing: %s\n' "$name" "$(tr '\n' ',' <"$cbase/missing")" >&2
        if [ "$attempt" != 1 ]; then
            rm -rf "$cbase/upper.new" "$cbase/work.new"
            die "$name: still missing libraries after building $missing again; its old upper is kept"
        fi
        # shellcheck disable=SC2086
        /usr/local/bin/locachy-build -r $missing
    done
    rm -f "$cbase/missing"
    {
        printf 'date="%s"\n' "$(date +%F\ %T)"
        printf 'packages="%s"\n' "${packages[*]}"
        printf 'host="%s"\n' "$(pacman -Q | sha256sum | cut -c1-16)"
    } >"$cbase/built.new"
    generation_tool build "$cbase" || die "$name: cannot publish its new build"
    command=$(conf_value "$name" command)
    if [ -z "$command" ] || { [ ! -x "$cbase/upper$command" ] && [ ! -x "$command" ]; }; then
        local first_line found_cmd found_args
        first_line=$(/usr/local/bin/locachy-pkg commands "$name" 2>/dev/null | head -n 1 || true)
        IFS=$'\t' read -r found_cmd found_args _ <<<"$first_line" || true
        if [ -n "${found_cmd:-}" ]; then
            if [ -z "$(conf_value "$name" arguments)" ] && [ -n "${found_args:-}" ]; then
                conf_set "$name" command "$found_cmd" arguments "$found_args"
            else
                conf_set "$name" command "$found_cmd"
            fi
            printf 'locachy-app: %s: command set to %s from its package\n' "$name" "$found_cmd"
        fi
    fi
    printf 'locachy-app: %s built: %s (the previous one is upper.prev)\n' "$name" "${packages[*]}"
}

# The previous upper back (upper.prev), the current one kept in its place.
do_rollback() {
    local cbase="$CONT_BASE/$1"
    if is_vm "$1"; then
        die "$1 is a VM app: it has no container package build"
    fi
    generation_tool rollback "$cbase" || die "$1: cannot roll back its build"
    printf 'locachy-app: %s rolled back (the other one is upper.prev)\n' "$1"
}

# The container gone: its configuration, its builds; its home only if asked.
do_remove() {
    local name="$1" cbase="$CONT_BASE/$1" was_vm=0
    is_vm "$name" && was_vm=1
    if [ "$(conf_value "$name" tor)" = 1 ]; then
        "$TOR_ENFORCE" app-remove "$name" || die "$name: cannot remove its Tor firewall"
        rm -f "$APP_RUNTIME/$name/tor-firewall"
    elif [ -e "$APP_RUNTIME/$name/tor-firewall" ] && [ -x "$TOR_ENFORCE" ]; then
        "$TOR_ENFORCE" app-remove "$name" && rm -f "$APP_RUNTIME/$name/tor-firewall" || true
    fi
    [ ! -e "$CONT_CONF/$name.conf" ] && [ ! -L "$CONT_CONF/$name.conf" ] ||
        config_action remove "$CONT_CONF/$name.conf" ||
        die "$name: $CONT_CONF/$name.conf is not a regular file: nothing removed; remove it by hand"
    if [ "$was_vm" = 1 ]; then
        # Remove the VM's managed state (overlay, OVMF vars, TPM state) and
        # runtime bookkeeping; never touch user-supplied vm_base/vm_disk images
        # or Maintenance Windows partitions.
        rm -rf "$APP_RUNTIME/$name" "$APP_RUNTIME/$name.ready" "$APP_RUNTIME/$name.log" "$VM_STATE/$name"
        rmdir "$(cg_path "$name")" 2>/dev/null || true
        printf 'locachy-app: %s removed (user disk images and Maintenance Windows partitions are kept)\n' "$name"
        return 0
    fi
    if [ "${2:-}" = --data ]; then
        rm -rf "$cbase"
    elif [ -d "$cbase" ]; then
        find "$cbase" -mindepth 1 -maxdepth 1 ! -name data -exec rm -rf {} +
    fi
    rmdir "$(cg_path "$name")" 2>/dev/null || true
    printf 'locachy-app: %s removed%s\n' "$name" "$([ "${2:-}" = --data ] && echo ", its home too" || echo "; its home is kept in $cbase/data")"
}

# PKG... added to the container's extras, and the container built anew.
do_install() {
    local name="$1"; shift
    if is_vm "$name"; then
        die "$name is a VM app: it has no container package build"
    fi
    [ $# -gt 0 ] || { echo "usage: locachy-app install NAME PKG..." >&2; exit 2; }
    local extras
    extras=$(printf '%s\n' $(conf_value "$name" extras) "$@" | sort -u | tr '\n' ' ')
    conf_set "$name" extras "${extras% }"
    do_build "$name"
}

do_list() {
    local machine="${1:-}" d name cg state mark
    local names=()
    for d in "$CONT_CONF"/*.conf; do
        [ -f "$d" ] || continue
        name=${d##*/}
        name=${name%.conf}
        valid_name "$name" && names+=("$name")
    done
    for d in "$CGROUP_BASE"/app_*; do
        [ -d "$d" ] || continue
        name=${d##*/app_}
        valid_name "$name" && names+=("$name")
    done
    [ "${#names[@]}" -gt 0 ] || return 0
    while IFS= read -r name; do
        cg=$(cg_path "$name")
        state=closed; mark=' '
        if is_running "$name"; then
            state=running; mark='*'
            if is_frozen "$name"; then
                state=frozen; mark='~'
            fi
        fi
        if [ "$machine" = --machine ]; then
            printf '%s\t%s\t%s\t%s\n' "$name" "$state" \
                "$(bytes_of "$cg/memory.current")" "$(bytes_of "$cg/memory.swap.current")"
        elif [ "$state" = closed ]; then
            printf '[ ] %-14s closed\n' "$name"
        else
            printf '[%s] %-14s %-8s (%s MiB RAM, %s MiB swap)\n' "$mark" "$name" "$state" \
                "$(mib_of "$cg/memory.current")" "$(mib_of "$cg/memory.swap.current")"
        fi
    done < <(printf '%s\n' "${names[@]}" | sort -u)
}

# Screen sharing for containers that may capture (screencast="1", camera="1"
# or host="1"): xdg-desktop-portal-wlr on the container's bus and on wayland-0
# (slurp asks which screen; Screenshot is denied on the bus). In the
# container's cgroup: frozen and stopped with it.
start_screencast() {
    local name=$1 bus="$APP_RUNTIME/$1/bus/bus" backend=/usr/lib/xdg-desktop-portal-wlr
    is_host "$name" || [ "$(conf_value "$name" screencast)" = 1 ] || [ "$(conf_value "$name" camera)" = 1 ] || return 0
    [ -x "$backend" ] && [ -S "$bus" ] && [ -S "$RUNTIME_DIR/wayland-0" ] && [ -S "$RUNTIME_DIR/pipewire-0" ] || return 0
    (
        exec {APP_LOCK_FD}>&-
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR="$RUNTIME_DIR"
        exec setpriv --no-new-privs -- "$backend"
    ) </dev/null >>"$APP_RUNTIME/$name.log" 2>&1 &
}

# The launcher's line "ready" on FD, while PID lives, for at most six seconds.
# A read that times out keeps what it had of the line (bash saves partial
# input), so the line is put together across reads. A line written just
# before the launcher ended is still in the FIFO. ready_why: timeout, ended
# (PID gone first) or line (something else written).
wait_ready() { # FD PID
    local fd=$1 pid=$2 line= part= attempt
    ready_why=timeout
    for ((attempt = 0; attempt < 120; ++attempt)); do
        part=
        if IFS= read -r -t 0.05 -u "$fd" part; then
            line+=$part
            [ "$line" = ready ] && return 0
            ready_why=line
            return 1
        fi
        line+=$part
        if ! kill -0 "$pid" 2>/dev/null; then
            part=
            if IFS= read -r -t 0.05 -u "$fd" part; then
                line+=$part
                [ "$line" = ready ] && return 0
                ready_why=line
                return 1
            fi
            ready_why=ended
            return 1
        fi
    done
    return 1
}

# The cameras a container with camera="1" has: the ordinary capture cameras
# and their media controller nodes, as locachy-face-camera tells them, never
# the face unlock camera nor an infrared one; none when it cannot tell. Lines
# "NAME MAJOR MINOR" of the host /dev as it is now.
camera_nodes() {
    local node major minor
    [ -x "$FACE_CAMERA" ] || return 0
    while read -r node; do
        [[ "$node" =~ ^/dev/(video|media)[0-9]+$ ]] && [ -c "$node" ] && [ ! -L "$node" ] || continue
        read -r major minor < <(stat -c "%t %T" "$node" 2>/dev/null) || continue
        printf '%s %d %d\n' "${node#/dev/}" "$((16#$major))" "$((16#$minor))"
    done < <(timeout 10 "$FACE_CAMERA" ordinary 2>/dev/null || true)
}

# The cameras of the host now, in each running container with camera="1":
# its /dev made to have the ordinary ones (camera_nodes; a node of its own
# for each, the user's), no more. udev runs it as cameras come and go
# (91-locachy-cameras.rules), locachy-face-camera when face unlock gets a
# camera.
do_cameras() {
    local conf name pid ticks node major minor nodes=() uid gid
    IFS=: read -r _ _ uid gid _ <<<"$(getent passwd "$APP_UID" || true)"
    [ -n "${uid:-}" ] || return 0
    while read -r node major minor; do
        nodes+=("$node" "$major" "$minor")
    done < <(camera_nodes)
    for conf in "$CONT_CONF"/*.conf; do
        [ -f "$conf" ] || continue
        name=$(basename "$conf" .conf)
        [ "$(conf_value "$name" camera)" = 1 ] && ! is_host "$name" && ! is_vm "$name" && is_running "$name" || continue
        pid=
        read -r pid ticks <"$APP_RUNTIME/$name/reaper.pid" 2>/dev/null || continue
        [[ "$pid" =~ ^[1-9][0-9]*$ ]] && grep -qxF "0::/app_$name" "/proc/$pid/cgroup" 2>/dev/null || continue
        nsenter --target "$pid" --mount --root -- /bin/bash -c '
            uid=$1; gid=$2; shift 2
            declare -A want=()
            while [ $# -ge 3 ]; do
                want[$1]="$2 $3"
                if [ ! -c "/dev/$1" ] || [ "$(stat -c "%t %T" "/dev/$1" | { read -r a b; echo "$((16#$a)) $((16#$b))"; })" != "$2 $3" ]; then
                    rm -f "/dev/$1"
                    mknod -m 0600 "/dev/$1" c "$2" "$3"
                    chown "$uid:$gid" "/dev/$1"
                fi
                shift 3
            done
            for node in /dev/video* /dev/media*; do
                [ -e "$node" ] || continue
                [ -n "${want[${node##*/}]:-}" ] || rm -f "$node"
            done
        ' bash "$uid" "$gid" "${nodes[@]}" || printf 'locachy-app: cameras: %s not updated\n' "$name" >&2
    done
}

# --- A container's document view (locachy-docs, tools/DOCUMENTS.md) ---

# The views mount (DOCS_VIEWS) is there: locachy-docs --attach made it. The
# mount table says so; nothing is looked up in it: an attached view is the
# user's FUSE mount (no allow_other), and root's stat of it fails.
docs_views_mounted() {
    awk -v p="$DOCS_VIEWS" '$5 == p { found = 1 } END { exit !found }' /proc/self/mountinfo
}

# docs_bind NAME RUN UID GID, as root in the container's mount namespace
# (its mounts slaves of the host's): RUN/doc is the directory DOCS_VIEWS/NAME
# of the views mount, bound as a slave of it, not the view attached on it
# now. What the service attaches on that directory later (docs_reattach,
# its start again) and each detach reach RUN/doc; a copy of the view attached
# now would stay, dead, once the service started again. The directory is
# found in a bind of the views mount alone, without the views on it, under
# the service's lock (no attach in between). Status 1: no view.
docs_bind() {
    local bare="$2/.docs-views" lock status=1
    mkdir -m 0700 "$bare" || return 1
    exec {lock}>>"$DOCS_DIR/lock" || { rmdir "$bare"; return 1; }
    flock -x "$lock"
    if mount --bind "$DOCS_VIEWS" "$bare"; then
        if [ -d "$bare/$1" ] && [ ! -L "$bare/$1" ] && install -d -o "$3" -g "$4" -m 0700 "$2/doc" &&
            mount --bind "$bare/$1" "$2/doc"; then
            if mount --make-slave "$2/doc"; then
                status=0
            else
                umount "$2/doc"
            fi
        fi
        umount "$bare"
    fi
    exec {lock}>&-
    rmdir "$bare"
    return "$status"
}

# docs_reattach NAME: NAME's view attached again once its start is over (its
# control lock is free again): the container bound the bare directory, which
# only an attach after that fills. In the background, forked before the
# launcher enters app_NAME: the service answers no container's process.
docs_reattach() {
    (
        [ -z "${APP_LOCK_FD:-}" ] || exec {APP_LOCK_FD}>&-
        [ -z "${READY_FD:-}" ] || exec {READY_FD}>&-
        exec {lock}>"$APP_RUNTIME/$1/control.lock"
        flock -x "$lock"
        if is_running "$1"; then
            "$DOCS_TOOL" --attach "$1" || true
        fi
    ) </dev/null &
}

# docs_select NAME: the document view NAME gets when it starts. --attach makes
# the views mount and NAME's directory on it, and attaches the portal's view
# for NAME when the service runs. docs_name is NAME when the views mount is
# there (docs_bind decides what the container gets); the view is attached
# again once the start is over (docs_reattach). Asked of the mount table, not
# of the view: root cannot stat an attached view (the user's FUSE mount).
docs_select() {
    docs_name=
    [ -x "$DOCS_TOOL" ] || return 0
    "$DOCS_TOOL" --attach "$1" || true
    if docs_views_mounted; then
        docs_name=$1
        docs_reattach "$1"
    fi
}

operation=start
want_net=0
case "${1:-}" in
run|start) shift ;;
resume|freeze|stop|kill|install|-S|build|rollback|remove|open|again|new) operation=$1; shift ;;
cameras)
    [ $# -eq 1 ] || die 'usage: locachy-app cameras'
    do_cameras
    exit 0
    ;;
list|status)
    shift
    [ $# -eq 0 ] || { [ $# -eq 1 ] && [ "$1" = --machine ]; } || die 'usage: locachy-app list [--machine]'
    do_list "${1:-}"
    exit 0
    ;;
esac
want_own_tor=0
while [ $# -gt 0 ]; do
    case "$1" in
    -n)
        [ "$operation" = start ] || break
        want_net=1
        shift
        ;;
    --own-tor)
        case "$operation" in
        start|open|new) want_own_tor=1; shift ;;
        *) die "--own-tor is only for start, open or new" ;;
        esac
        ;;
    *) break ;;
    esac
done
name="${1:-}"
[ -n "$name" ] || die 'usage: locachy-app run|start|resume|freeze|stop|install NAME [ARG...]'
check_name "$name"
shift
if [ "$operation" = open ]; then
    [ $# -eq 1 ] && [ -n "$1" ] || die "usage: locachy-app open NAME TARGET"
elif [ "$operation" = remove ]; then
    [ $# -eq 0 ] || { [ $# -eq 1 ] && [ "$1" = --data ]; } || die "usage: locachy-app remove NAME [--data]"
elif [ "$operation" != start ] && [ "$operation" != install ] && [ "$operation" != -S ]; then
    [ $# -eq 0 ] || die "usage: locachy-app $operation NAME"
fi
case "$operation" in
build)
    # The kind follows the configuration as it is now (read as the snapshot
    # below will read it): a host program's build is a host package
    # transaction (app-host-build, in the package domain), any other a
    # container's own build (app-build). The service checks the same at acceptance.
    load_config_snapshot "$name"
    is_vm "$name" && die "$name is a VM app: it has no container package build"
    kind=app-build
    [ "$(conf_value "$name" host)" = 1 ] && kind=app-host-build
    route_app_job "$kind" "$name" "$@" ;;
rollback)
    load_config_snapshot "$name"
    is_vm "$name" && die "$name is a VM app: it has no container package build"
    route_app_job "app-$operation" "$name" "$@" ;;
remove) route_app_job "app-$operation" "$name" "$@" ;;
esac
lock_app "$name"
load_config_snapshot "$name"
# Explicit consent applies only to the supported bundled browser, including
# start/open/new fast paths on a running instance. It never changes its mode.
if [ "$want_own_tor" = 1 ]; then
    { [ "$want_net" = 1 ] || [ "$(conf_value "$name" network)" = 1 ]; } &&
        [ "$(conf_value "$name" tor)" = 1 ] ||
        die "$name does not use Tor (tor=\"1\" with network=\"1\"): --own-tor does not apply"
    own_tor_supported "$name" ||
        die "$name has no supported bundled Tor: --own-tor is only for tor-browser-bin with /usr/bin/tor-browser"
fi
case "$operation" in
resume) do_resume "$name"; exit 0 ;;
freeze) do_freeze "$name"; exit 0 ;;
stop|kill) do_stop "$name"; exit 0 ;;
install|-S)
    is_vm "$name" && die "$name is a VM app: it has no container package build"
    is_host "$name" && die "$name is a host program: its packages are the host's (locachy-pkg install)"
    is_running "$name" && die "stop $name before installing packages"
    do_install "$name" "$@"
    exit 0
    ;;
build|rollback)
    is_vm "$name" && die "$name is a VM app: it has no container package build"
    [ "$operation" = rollback ] && is_host "$name" && die "$name is a host program: it has no build to roll back"
    is_running "$name" && die "stop $name before it is built or rolled back"
    "do_$operation" "$name"
    exit 0
    ;;
remove)
    is_running "$name" && die "stop $name before it is removed"
    do_remove "$name" "$@"
    exit 0
    ;;
again)
    if is_vm "$name"; then
        is_running "$name" || die "$name is not running"
        is_frozen "$name" && do_resume "$name"
        exit 0
    fi
    # Its own command once more, in the running container: asked first by
    # locachy-bar, since a program that runs more than once starts a second
    # copy rather than showing its window.
    saved_command "$name"
    is_running "$name" || die "$name is not running"
    is_frozen "$name" && do_resume "$name"
    do_open_running "$name" "" "${saved_cmd[@]}"
    exit 0
    ;;
new)
    # A window of it, as the shared display's terminal key asks: its command
    # once more in it if it runs (a terminal: another one), else it starts.
    exec >>"$APP_RUNTIME/$name.log" 2>&1
    if is_vm "$name"; then
        if is_running "$name"; then
            is_frozen "$name" && do_resume "$name"
            exit 0
        fi
        operation=start
    else
        saved_command "$name"
        if is_running "$name"; then
            is_frozen "$name" && do_resume "$name"
            do_open_running "$name" "" "${saved_cmd[@]}"
            exit 0
        fi
        operation=start
    fi
    ;;
open)
    # The container's own command with TARGET (a path or URL): run in the
    # container if it runs (a single-instance program hands it to its
    # window), else the container starts with it, below.
    target=$1
    if is_vm "$name"; then
        if is_running "$name"; then
            is_frozen "$name" && do_resume "$name"
            exit 0
        fi
        set --
        operation=start
    else
        saved_command "$name"
        if is_running "$name"; then
            is_frozen "$name" && do_resume "$name"
            do_open_running "$name" "$target" "${saved_cmd[@]}"
            exit 0
        fi
        set -- "${saved_cmd[@]}" "$target"
        operation=start
    fi
    ;;
esac

if is_running "$name"; then
    if is_vm "$name" && is_frozen "$name"; then
        do_resume "$name"
        exit 0
    fi
    printf 'locachy-app: %s is already running; window activation is not requested\n' "$name" >&2
    exit 0
fi

# locachy-0 is the compositor's socket for containers (labwc-control): it
# hides the privileged interfaces; wayland-0 is for host programs only.
shared_wayland=${LOCACHY_WAYLAND_DISPLAY:-locachy-0}
[[ "$shared_wayland" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,107}$ ]] || die 'invalid LOCACHY_WAYLAND_DISPLAY socket name'
[ "$shared_wayland" != bus ] || die 'Wayland socket name conflicts with the session bus'
[ -S "$RUNTIME_DIR/$shared_wayland" ] || die "Wayland socket is not available: $RUNTIME_DIR/$shared_wayland"

if is_vm "$name"; then
    [ -x "$APP_INIT" ] || die "container reaper is not installed: $APP_INIT"
    for tool in unshare mount mkfifo; do
        command -v "$tool" >/dev/null 2>&1 || die "$tool is required"
    done
    if [ "$want_net" = 1 ] && [ -f "$CONT_CONF/$name.conf" ]; then
        conf_set "$name" network 1
    elif [ "$(conf_value "$name" network)" = 1 ]; then
        want_net=1
    fi
    vm_kind=$(conf_value "$name" vm_kind)
    vm_check_keys "$name"
    vm_drop=()
    vm_run_as_user=0
    if [ "$vm_kind" != winmaint ]; then
        vm_set_drop
        [ "${#vm_drop[@]}" -gt 0 ] && vm_run_as_user=1
    fi
    # Every VM keeps its own state directory (owned by uid 1000 when dropped)
    # so QEMU/swtpm/virtiofsd can create sockets there even when unprivileged.
    vm_sdir=$(vm_state_dir "$name") || exit 1
    qmp_sock=$(vm_qmp_sock "$name")
    if [ $# -eq 0 ]; then
        vm_command "$name" "$qmp_sock" "$want_net"
        set -- "${vm_cmd[@]}"
    fi
    cg=$(cg_path "$name")
    mkdir -p "$cg"
    chmod 0755 "$cg"
    [ -w "$cg/cgroup.freeze" ] && [ -w "$cg/cgroup.kill" ] || die 'a writable cgroup v2 freezer and cgroup.kill are required'
    # Fail closed, as containers do: on locachy-net when it exists, else a
    # private namespace with loopback only (never the host network).
    net_prefix=()
    net_args=(--net)
    if [ "$want_net" = 1 ] && [ -e /run/netns/locachy-net ]; then
        net_prefix=(nsenter --net=/run/netns/locachy-net)
        net_args=()
    fi
    if [ "$want_net" = 1 ] && rc_has_key service_clash && [ "$(rc_key_value clash_mode)" = proxy ]; then
        export http_proxy=http://127.0.0.1:7890 https_proxy=http://127.0.0.1:7890 all_proxy=socks5://127.0.0.1:7890
        export no_proxy=localhost,127.0.0.1,::1,.local,.ts.net
        export HTTP_PROXY=$http_proxy HTTPS_PROXY=$https_proxy ALL_PROXY=$all_proxy NO_PROXY=$no_proxy
    fi
    vm_uid=0; vm_gid=0; vm_uhome=/root
    if [ "$vm_run_as_user" = 1 ]; then
        IFS=: read -r _ _ vm_uid vm_gid _ vm_uhome _ <<<"$(getent passwd "$APP_UID" || true)"
        [ -n "$vm_uid" ] && [ -n "$vm_gid" ] || die "there is no user with uid $APP_UID: create it with locachy-setup"
    fi
    if [ "$vm_kind" = compute ] && [ "$vm_run_as_user" = 1 ]; then
        # locachy-compute runs as uid 1000 and keeps this VM's run directory
        # (/run/locachy/compute/vm-NAME) there; the name was checked above.
        compute_vname=$(conf_value "$name" vm_name)
        [ -n "$compute_vname" ] || compute_vname=$name
        install -d -m 0711 /run/locachy/compute
        install -d -o "$vm_uid" -g "$vm_gid" -m 0700 "/run/locachy/compute/vm-$compute_vname"
    fi
    vm_audio_pw=
    vm_audio_pulse=
    if [ -S "$PULSE_SOCKETS/native" ]; then
        vm_audio_pulse="unix:$PULSE_SOCKETS/native"
    elif [ "$vm_run_as_user" = 0 ] && [ -S "$RUNTIME_DIR/pulse/native" ]; then
        vm_audio_pulse="unix:$RUNTIME_DIR/pulse/native"
    fi
    if [ -S "$PIPEWIRE_SOCKETS/pipewire-0" ]; then
        vm_audio_pw="$PIPEWIRE_SOCKETS/pipewire-0"
    elif [ "$vm_run_as_user" = 0 ] && [ -S "$RUNTIME_DIR/pipewire-0" ]; then
        vm_audio_pw="$RUNTIME_DIR/pipewire-0"
    fi
    ready_dir=$(mktemp -d "$APP_RUNTIME/$name/.start.XXXXXXXX")
    trap 'rm -f "$ready_dir/ready"; rmdir "$ready_dir" 2>/dev/null || true' EXIT
    mkfifo -m 0600 "$ready_dir/ready"
    exec {READY_FD}<>"$ready_dir/ready"
    rm -f "$ready_dir/ready"
    rmdir "$ready_dir"
    trap - EXIT
    rm -f "$APP_RUNTIME/$name/reaper.pid" "$APP_RUNTIME/$name/tor-mode" "$APP_RUNTIME/$name.ready" \
          "$APP_RUNTIME/$name/vm-paused" "$qmp_sock" "$vm_sdir/swtpm.sock" "$vm_sdir/vfs-home.sock"
    caller_cg=$CGROUP_BASE
    while IFS= read -r _cg_line; do
        case $_cg_line in 0::*) caller_cg="$CGROUP_BASE${_cg_line#0::}"; break ;; esac
    done </proc/self/cgroup 2>/dev/null || true
    printf '0\n' >"$cg/cgroup.freeze"
    printf '%s\n' "$$" >"$cg/cgroup.procs"
    # Helpers (swtpm, virtiofsd) start AFTER entering app_NAME so freeze and
    # stop cover them alongside QEMU, and run under the same uid/group drop.
    # The trap comes first: a helper that fails or times out (die) stops the
    # ones already started, and app_NAME is left without processes.
    trap 'vm_helper_stop' EXIT
    if [ "$vm_need_tpm" = 1 ]; then
        tpm_state="$vm_sdir/swtpm"
        if [ "$vm_run_as_user" = 1 ]; then
            install -d -o "$vm_uid" -g "$vm_gid" -m 0700 "$tpm_state"
        else
            mkdir -p -m 0700 "$tpm_state"
        fi
        ${vm_drop[@]+"${vm_drop[@]}"} "${LOCACHY_SWTPM:-swtpm}" socket --tpm2 \
            --tpmstate "dir=$tpm_state" --ctrl "type=unixio,path=$vm_sdir/swtpm.sock" \
            </dev/null >>"$APP_RUNTIME/$name.log" 2>&1 {APP_LOCK_FD}>&- {READY_FD}>&- &
        vm_helpers+=("$!")
        vm_wait_socket "$name" "$!" "$vm_sdir/swtpm.sock"
    fi
    if [ "$vm_need_vfs" = 1 ]; then
        vfs_bin=$(vm_virtiofsd_bin) || die "$name: virtiofsd is not installed"
        ${vm_drop[@]+"${vm_drop[@]}"} "$vfs_bin" --socket-path="$vm_sdir/vfs-home.sock" \
            --shared-dir="$vm_vfs_dir" --sandbox=namespace --cache=auto \
            </dev/null >>"$APP_RUNTIME/$name.log" 2>&1 {APP_LOCK_FD}>&- {READY_FD}>&- &
        vm_helpers+=("$!")
        vm_wait_socket "$name" "$!" "$vm_sdir/vfs-home.sock"
    fi
    "${net_prefix[@]}" unshare --mount --pid --fork --kill-child --propagation slave "${net_args[@]}" bash -euc '
        display=$1; init=$2; ready_fd=$3; host_runtime=$4; state_dir=$5; qmp_sock=$6
        pulse_srv=$7; pw_sock=$8; rc_conf=$9; cg_procs=${10}; want_net=${11}
        run_user=${12}; uid=${13}; gid=${14}; uhome=${15}; vm_sdir=${16}
        pw_sockets=${17}; pulse_sockets=${18}; shift 18
        host_pid=; start_ticks=
        while read -r key value rest; do
            if [ "$key" = Pid: ]; then host_pid=$value; break; fi
        done </proc/self/status
        read -r stat_line </proc/self/stat
        stat_fields=${stat_line##*) }
        read -r -a stat_fields <<<"$stat_fields"
        start_ticks=${stat_fields[19]}
        [ -n "$host_pid" ] && [ -n "$start_ticks" ] || { printf "locachy-app: cannot read reaper identity\n" >&2; exit 125; }
        printf "%s %s\n" "$host_pid" "$start_ticks" >"$state_dir/reaper.pid"
        if [ -n "$cg_procs" ]; then
            printf "%s\n" "$host_pid" >>"$cg_procs" 2>/dev/null || true
        fi
        ip link set lo up 2>/dev/null || true
        if [ "$want_net" = 1 ] && [ -f /etc/netns/locachy-net/resolv.conf ]; then
            mount --bind -o ro /etc/netns/locachy-net/resolv.conf /etc/resolv.conf 2>/dev/null || true
        fi
        if [ "$run_user" = 1 ]; then
            # Project only the display socket (and restricted sound) into a
            # tmpfs owned by uid 1000 so unprivileged QEMU never needs access
            # to root'\''s 0700 /run/user/0.
            vm_run="$vm_sdir/run"
            install -d -o "$uid" -g "$gid" -m 0700 "$vm_run"
            mount -t tmpfs -o "mode=0700,uid=$uid,gid=$gid,nosuid,nodev" vmrun "$vm_run"
            chmod 0666 "$host_runtime/$display" 2>/dev/null || true
            touch "$vm_run/$display"
            mount --bind "$host_runtime/$display" "$vm_run/$display"
            if [ -d "$pulse_sockets" ]; then
                install -d -o "$uid" -g "$gid" -m 0700 "$vm_run/pulse"
                mount --bind -o ro "$pulse_sockets" "$vm_run/pulse"
                pulse_srv="unix:$vm_run/pulse/native"
            fi
            if [ -d "$pw_sockets" ]; then
                install -d -o "$uid" -g "$gid" -m 0700 "$vm_run/pipewire"
                mount --bind -o ro "$pw_sockets" "$vm_run/pipewire"
                pw_sock="$vm_run/pipewire/pipewire-0"
            fi
            export XDG_RUNTIME_DIR="$vm_run"
            export HOME="$uhome"
        else
            export XDG_RUNTIME_DIR="$host_runtime"
        fi
        export LOCACHY_APP_READY_FD="$ready_fd"
        export LOCACHY_VM_QMP_SOCK="$qmp_sock"
        export WAYLAND_DISPLAY="$display"
        export GDK_BACKEND="wayland"
        export SDL_VIDEODRIVER="wayland"
        unset WAYLAND_SOCKET DISPLAY XAUTHORITY SEATD_SOCK LOCACHY_APP_UID LOCACHY_APP_GID LOCACHY_APP_NO_NEW_PRIVS
        if [ -n "$pulse_srv" ]; then
            export PULSE_SERVER="$pulse_srv"
        fi
        if [ -n "$pw_sock" ]; then
            export PIPEWIRE_REMOTE="$pw_sock"
        fi
        sys_lang=
        if [ -r "$rc_conf" ]; then
            while IFS= read -r _rcline || [ -n "$_rcline" ]; do
                _rcline=${_rcline#"${_rcline%%[![:space:]]*}"}
                case $_rcline in
                language=\"*\"*)
                    sys_lang=${_rcline#language=\"}
                    sys_lang=${sys_lang%%\"*}
                    ;;
                esac
            done <"$rc_conf"
        fi
        if [ -n "$sys_lang" ]; then
            export LANG="$sys_lang"
            export LANGUAGE="${sys_lang%%.*}:en_US"
        fi
        exec "$init" "$@"
    ' bash "$shared_wayland" "$APP_INIT" "$READY_FD" "$RUNTIME_DIR" "$APP_RUNTIME/$name" "$qmp_sock" \
        "$vm_audio_pulse" "$vm_audio_pw" "$RC_CONF" "$([ "$CGROUP_BASE" != /sys/fs/cgroup ] && printf '%s/cgroup.procs' "$cg" || true)" \
        "$want_net" "$vm_run_as_user" "$vm_uid" "$vm_gid" "$vm_uhome" "$vm_sdir" "$PIPEWIRE_SOCKETS" "$PULSE_SOCKETS" \
        ${vm_drop[@]+"${vm_drop[@]}"} "$@" {APP_LOCK_FD}>&- &
    launcher=$!
    ready_why=
    if ! wait_ready "$READY_FD" "$launcher"; then
        exec {READY_FD}>&-
        case $ready_why in
        ended)
            status=0
            wait "$launcher" || status=$?
            printf 'locachy-app: %s ended before it was ready (status %s)\n' "$name" "$status" >&2 ;;
        line) printf 'locachy-app: %s wrote a malformed readiness line\n' "$name" >&2 ;;
        *) printf 'locachy-app: %s failed to initialize within six seconds\n' "$name" >&2 ;;
        esac
        vm_helper_stop
        [ ! -w "$caller_cg/cgroup.procs" ] || printf '%s\n' "$$" >"$caller_cg/cgroup.procs" 2>/dev/null || true
        printf '1\n' >"$cg/cgroup.kill"
        wait_event "$cg" populated 0 || true
        rm -f "$APP_RUNTIME/$name/reaper.pid" "$APP_RUNTIME/$name/vm-paused" "$qmp_sock" \
              "$vm_sdir/swtpm.sock" "$vm_sdir/vfs-home.sock"
        exit 125
    fi
    exec {READY_FD}>&-
    touch "$APP_RUNTIME/$name.ready"
    unlock_app
    status=0
    wait "$launcher" || status=$?
    vm_helper_stop
    rm -f "$APP_RUNTIME/$name.ready" "$APP_RUNTIME/$name/reaper.pid" "$APP_RUNTIME/$name/vm-paused" "$qmp_sock" \
          "$vm_sdir/swtpm.sock" "$vm_sdir/vfs-home.sock"
    [ ! -w "$caller_cg/cgroup.procs" ] || printf '%s\n' "$$" >"$caller_cg/cgroup.procs" 2>/dev/null || true
    exit "$status"
fi
# The shared Xwayland display, for a program whose configuration asks for it
# (x11="1"), as labwc's xinitrc published it once the user may connect; never
# inherited from a caller or guessed as :0. None: Wayland only. A program
# that asks for it does not start without it: nothing of it runs, so nothing
# it would save from a start without its display (fre:ac its window size,
# from a screen of none) is left behind.
x11_display=
if [ "$(conf_value "$name" x11)" = 1 ]; then
    [ ! -r "$RUNTIME_DIR/locachy-x11-display" ] || IFS= read -r x11_display <"$RUNTIME_DIR/locachy-x11-display" || true
    [ -n "$x11_display" ] || die "$name: it asks for X11 (x11=\"1\") and there is no shared X11 display: not started"
    [[ "$x11_display" =~ ^:[0-9]{1,5}$ ]] || die 'invalid shared X11 display'
    [ -S "/tmp/.X11-unix/X${x11_display#:}" ] ||
        die "$name: it asks for X11 (x11=\"1\") and the shared X11 socket is not there (Xwayland starting again): not started"
fi
# Tor container (tor="1" on the network): with full-system Tor on, it runs over
# the system Tor SocksPort under a per-cgroup firewall; with full-system Tor
# off, it starts only when --own-tor was explicitly confirmed so it runs its
# own bundled user-space Tor daemon.
want_tor=0
tor_mode=
if { [ "$want_net" = 1 ] || [ "$(conf_value "$name" network)" = 1 ]; } && [ "$(conf_value "$name" tor)" = 1 ]; then
    if rc_has_key service_tor; then
        [ "$want_own_tor" != 1 ] ||
            die "$name: full-system Tor is on; do not pass --own-tor (Tor over Tor); not started"
        "$TOR_ENFORCE" loaded ||
            die "$name requires full-system Tor and its firewall is not loaded; not started"
        want_tor=1
        tor_mode=system
    elif "$TOR_ENFORCE" loaded; then
        die "$name: full-system Tor firewall is still loaded while service_tor is off; not started"
    elif [ "$want_own_tor" = 1 ]; then
        own_tor_supported "$name" ||
            die "$name has no supported bundled Tor: --own-tor is only for tor-browser-bin with /usr/bin/tor-browser; not started"
        tor_mode=own
    elif own_tor_supported "$name"; then
        die "$name: full-system Tor is off; turn Tor on in settings, or pass --own-tor to run Tor Browser own user-space Tor without the host Tor firewall; not started"
    else
        die "$name requires full-system Tor: turn Tor on in settings first; not started"
    fi
elif [ "$want_own_tor" = 1 ]; then
    die "$name does not use Tor (tor=\"1\" with network=\"1\"): --own-tor does not apply"
fi
[ -x "$APP_INIT" ] || die "container reaper is not installed: $APP_INIT"
for tool in unshare chroot mount mkfifo; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is required"
done
cbase="$CONT_BASE/$name"
cg=$(cg_path "$name")
host=0
is_host "$name" && host=1
mkdir -p "$CONT_BASE"
chmod 0700 "$CONT_BASE"
if [ "$host" != 1 ]; then
    [ ! -L "$cbase" ] && [ ! -L "$cbase/data" ] || die "$name: its state directory has a symbolic link"
    # Never an empty upper over the host root in place of a build: a pending
    # publication, or a built container without its upper, is refused.
    [ ! -e "$cbase/generation.state" ] ||
        die "$name: its last build or rollback was interrupted: build or roll it back again"
    [ -d "$cbase/upper" ] || die "$name is not built (no upper): build it first"
    mkdir -p "$cbase/work" "$cbase/merged" "$cbase/data"
fi
# Its cgroup open to read, as process 1 makes the windows' (init/apps.c), not
# 0700 by this script's umask: the document server, the user's, watches its
# cgroup.events. Only root writes a cgroup's files.
mkdir -p "$cg"
chmod 0755 "$cg"
[ -w "$cg/cgroup.freeze" ] && [ -w "$cg/cgroup.kill" ] || die 'a writable cgroup v2 freezer and cgroup.kill are required'
[ -d /sys/module/overlay ] || grep -qw overlay /proc/filesystems 2>/dev/null || modprobe overlay 2>/dev/null || true

# Programs in containers run as the user (made by locachy-setup), whose home
# holds the files shared by every container and the host.
passwd_entry=$(getent passwd "$APP_UID" || true)
IFS=: read -r user _ uid gid _ uhome _ <<<"$passwd_entry"
[ -n "${uid:-}" ] || die "there is no user with uid $APP_UID: create it with locachy-setup"
case "$uhome" in
/home/?*) ;;
*) die "the home of $user is $uhome, not under /home: fix it (usermod -d /home/$user -m $user)" ;;
esac
_need_home=0
_need_udirs=()
_check_dirs=()
if [ -d "$uhome" ] && [ ! -L "$uhome" ]; then
    _check_dirs+=("$uhome")
else
    _need_home=1
fi
for d in $USER_DIRS; do
    if [ -d "$uhome/$d" ] && [ ! -L "$uhome/$d" ]; then
        _check_dirs+=("$uhome/$d")
    else
        _need_udirs+=("$uhome/$d")
    fi
done
if [ "${#_check_dirs[@]}" -gt 0 ]; then
    _stat_lines=()
    mapfile -t _stat_lines < <(stat -c '%u:%g %a' "${_check_dirs[@]}" 2>/dev/null || true)
    if [ "${#_stat_lines[@]}" -ne "${#_check_dirs[@]}" ]; then
        _need_home=1
        _need_udirs=()
        for d in $USER_DIRS; do _need_udirs+=("$uhome/$d"); done
    else
        for _idx in "${!_check_dirs[@]}"; do
            _path=${_check_dirs[$_idx]}
            read -r _ug _mode <<<"${_stat_lines[$_idx]}"
            if [ "$_path" = "$uhome" ]; then
                [ "$_ug" = "$uid:$gid" ] && [ "$_mode" = 700 ] || _need_home=1
            else
                [ "$_ug" = "$uid:$gid" ] || _need_udirs+=("$_path")
            fi
        done
    fi
fi
[ "$_need_home" = 0 ] || install -d -o "$uid" -g "$gid" -m 0700 "$uhome"
[ "${#_need_udirs[@]}" -eq 0 ] || install -d -o "$uid" -g "$gid" "${_need_udirs[@]}"
if [ "$host" = 1 ]; then
    # Mount points of its namespace, empty on the host.
    install -d -o "$uid" -g "$gid" -m 0700 "/run/user/$uid"
    [ -d /run/locachy-bus ] || mkdir -p /run/locachy-bus
fi

if [ "$want_net" = 1 ] && [ -f "$CONT_CONF/$name.conf" ]; then
    conf_set "$name" network 1
elif [ "$(conf_value "$name" network)" = 1 ]; then
    want_net=1
fi
if [ $# -eq 0 ]; then
    saved_command "$name"
    set -- "${saved_cmd[@]}"
fi
if managed_foot_command "$name" "${1:-}"; then
    set -- "$FOOT_WRAPPER" "${@:2}"
fi
if [ "$tor_mode" = own ]; then
    tor_browser_launch "$@" || die "$name: --own-tor cannot run an alternative command; not started"
fi
# Its directories (of the home), refused before anything is started.
IFS=: read -r -a directories <<<"$(conf_value "$name" directories)" || true
for d in "${directories[@]}"; do
    [ -n "$d" ] || continue
    why=$(directory_refused "$d" "$uhome")
    [ -z "$why" ] || die "$name cannot have $d: $why (directories= in $CONT_CONF/$name.conf)"
done

net_prefix=()
net_args=(--net)
if [ "$want_net" = 1 ] && [ -e /run/netns/locachy-net ]; then
    net_prefix=(nsenter --net=/run/netns/locachy-net)
    net_args=()
fi
# The Clash proxy with only its port (clash-client, clash_mode="proxy"): a
# container on the network is told of it; its programs that honour these use it.
if [ "$want_net" = 1 ] && [ -z "$tor_mode" ] && rc_has_key service_clash &&
    [ "$(rc_key_value clash_mode)" = proxy ]; then
    export http_proxy=http://127.0.0.1:7890 https_proxy=http://127.0.0.1:7890 all_proxy=socks5://127.0.0.1:7890
    export no_proxy=localhost,127.0.0.1,::1,.local,.ts.net
    export HTTP_PROXY=$http_proxy HTTPS_PROXY=$https_proxy ALL_PROXY=$all_proxy NO_PROXY=$no_proxy
fi
unset TOR_PROVIDER TOR_SKIP_LAUNCH TOR_TRANSPROXY TOR_SOCKS_IPC_PATH TOR_SOCKS_HOST TOR_SOCKS_PORT \
      TOR_CONTROL_IPC_PATH TOR_CONTROL_HOST TOR_CONTROL_PORT TOR_CONTROL_PASSWD TOR_CONTROL_COOKIE_AUTH_FILE \
      TOR_FORCE_NET_CONFIG TOR_CONFIGURE_ONLY
if [ "$tor_mode" = system ]; then
    export TOR_PROVIDER=none TOR_SOCKS_HOST=127.0.0.1 TOR_SOCKS_PORT=9050
elif [ "$tor_mode" = own ]; then
    export TOR_SOCKS_HOST=127.0.0.1 TOR_SOCKS_PORT=9150
fi

# Keep the lock only until C PID 1 is ready (or setup fails). The FIFO FD
# survives exec/unshare/chroot but is closed before the app's exec. Its path
# is private host bookkeeping, not a bind-mounted host runtime directory.
ready_dir=$(mktemp -d "$APP_RUNTIME/$name/.start.XXXXXXXX")
trap 'rm -f "$ready_dir/ready"; rmdir "$ready_dir" 2>/dev/null || true' EXIT
mkfifo -m 0600 "$ready_dir/ready"
exec {READY_FD}<>"$ready_dir/ready"
# Only the inherited descriptor is needed; leave no files on forced stop.
rm -f "$ready_dir/ready"
rmdir "$ready_dir"
trap - EXIT
rm -f "$APP_RUNTIME/$name/reaper.pid" "$APP_RUNTIME/$name/tor-mode" "$APP_RUNTIME/$name.ready"
# Its cameras (camera="1", a container: a host program has the host's /dev).
cameras=
if [ "$host" != 1 ] && [ "$(conf_value "$name" camera)" = 1 ]; then
    cameras=$(camera_nodes)
fi
# Its document view: DOCS_VIEWS/NAME on the shared views mount (made by
# --attach, which attaches the portal's view for it if the document service
# runs; the service attaches it itself when it starts later). The container
# binds the directory (docs_bind); its view is attached again after the start
# (docs_reattach). Asked before this script enters the cgroup: the service
# answers no container's process. Without it, the container gets no view,
# and nothing dropped on it is readable.
docs_select "$name"

# Move the launcher itself before ANY namespace child is forked. From here
# every helper, unshare parent, PID 1 and descendant inherits app_NAME.
# An empty cgroup can retain a previous freeze request after forced teardown.
caller_cg=$CGROUP_BASE
while IFS= read -r _cg_line; do
    case $_cg_line in 0::*) caller_cg="$CGROUP_BASE${_cg_line#0::}"; break ;; esac
done </proc/self/cgroup 2>/dev/null || true
printf '0\n' >"$cg/cgroup.freeze"
printf '%s\n' "$$" >"$cg/cgroup.procs"
if [ "$want_tor" = 1 ]; then
    cg_relative=
    while IFS= read -r _cg_line; do
        case $_cg_line in 0::*) cg_relative=${_cg_line#0::}; break ;; esac
    done </proc/self/cgroup
    "$TOR_ENFORCE" app-load "$name" "$cg_relative" ||
        die "$name: cannot load its Tor-only firewall; not started"
    : >"$APP_RUNTIME/$name/tor-firewall"
elif [ -e "$APP_RUNTIME/$name/tor-firewall" ] && [ -x "$TOR_ENFORCE" ]; then
    "$TOR_ENFORCE" app-remove "$name" && rm -f "$APP_RUNTIME/$name/tor-firewall" || true
fi
if [ -n "$tor_mode" ]; then
    printf '%s\n' "$tor_mode" >"$APP_RUNTIME/$name/tor-mode"
    if [ "$tor_mode" = own ] && [ -w /dev/kmsg ]; then
        printf '<5>locachy-app: %s: starting with its own user-space Tor (full-system Tor is off)\n' "$name" >/dev/kmsg 2>/dev/null || true
    fi
fi
# Slave: the shared mounts of the host, ~/Drives (the drives service) and
# the document views (locachy-docs), pass their mounts on to the container
# as they come and go; nothing passes back.
"${net_prefix[@]}" unshare --mount --pid --fork --kill-child --propagation slave "${net_args[@]}" bash -euc '
    cbase=$1; want_net=$2; display=$3; init=$4; ready_fd=$5; host_runtime=$6; state_dir=$7
    user=$8; uid=$9; gid=${10}; uhome=${11}; USER_DIRS=${12}; directories=${13}; host=${14}; cameras=${15}; x11_display=${16}
    pw_sockets=${17}; pulse_sockets=${18}; docs_name=${19}; docs_dir=${20}; docs_bind_fn=${21}; shift 21
    # Record host PID before mounting the namespace-local /proc. This bash
    # becomes the C reaper via exec, so its host PID stays unchanged.
    host_pid=; start_ticks=
    while read -r key value rest; do
        if [ "$key" = Pid: ]; then host_pid=$value; break; fi
    done </proc/self/status
    read -r stat_line </proc/self/stat
    stat_fields=${stat_line##*) }
    read -r -a stat_fields <<<"$stat_fields"
    start_ticks=${stat_fields[19]}
    [ -n "$host_pid" ] && [ -n "$start_ticks" ] || { printf "locachy-app: cannot read reaper identity\n" >&2; exit 125; }
    printf "%s %s\n" "$host_pid" "$start_ticks" >"$state_dir/reaper.pid"
    ip link set lo up 2>/dev/null || true
    # Its sound (sound RUN): the directories of the restricted sockets of the
    # servers, read-only in RUN/locachy-sound, and the paths of a session
    # (RUN/pipewire-0, RUN/pulse/native) linked to the sockets in them. A
    # server started again makes its socket anew in the same directory, so
    # the programs running here reach it again. Nothing without the servers.
    sound() {
        [ -d "$pw_sockets" ] || [ -d "$pulse_sockets" ] || return 0
        install -d -o "$uid" -g "$gid" -m 0700 "$1/locachy-sound"
        if [ -d "$pw_sockets" ]; then
            install -d -m 0755 "$1/locachy-sound/pipewire"
            mount --bind -o ro "$pw_sockets" "$1/locachy-sound/pipewire"
            ln -s locachy-sound/pipewire/pipewire-0 "$1/pipewire-0"
            chown -h "$uid:$gid" "$1/pipewire-0"
        fi
        if [ -d "$pulse_sockets" ]; then
            install -d -m 0755 "$1/locachy-sound/pulse"
            mount --bind -o ro "$pulse_sockets" "$1/locachy-sound/pulse"
            install -d -o "$uid" -g "$gid" -m 0700 "$1/pulse"
            ln -s ../locachy-sound/pulse/native "$1/pulse/native"
            chown -h "$uid:$gid" "$1/pulse/native"
        fi
    }
    # Its document view (doc_view RUN, locachy-docs) at RUN/doc: the view
    # directory of the host bound as a slave (docs_bind), so that the view
    # attached there after this, and again after the document service started
    # again, is the one it sees. It shows only the documents dropped on this
    # container.
    doc_view() {
        [ -n "$docs_name" ] || return 0
        DOCS_DIR=$docs_dir
        DOCS_VIEWS=$docs_dir/views
        eval "$docs_bind_fn"
        docs_bind "$docs_name" "$1" "$uid" "$gid" ||
            printf "locachy-app: %s: no document view\n" "$docs_name" >&2
    }
    if [ "$host" = 1 ]; then
        # A host program (host="1"): the real root and home, hidden by nothing
        # but file permissions. Of its own it has /proc (its PID namespace), a
        # runtime directory with the display, sound and its bus, and the
        # resolver of the network.
        mount -t proc proc /proc -o nosuid,noexec,nodev
        touch "$host_runtime/$display"
        chmod 0666 "$host_runtime/$display"
        run=/run/user/$uid
        mount -t tmpfs -o "mode=0700,uid=$uid,gid=$gid,nosuid,nodev" runtime "$run"
        # Host programs have their own /run mount namespace. Project the
        # read-only appearance snapshot there too, so new processes and the
        # private bus use the same path as isolated containers.
        appearance=/run/locachy/appearance
        [ ! -L "$appearance" ] || { printf "locachy-app: appearance directory is a link\n" >&2; exit 125; }
        install -d -m 0755 "$appearance" /run/locachy-appearance
        mount --bind -o ro,nosuid,nodev,noexec "$appearance" /run/locachy-appearance
        mount --make-private /run/locachy-appearance
        export LOCACHY_APPEARANCE_DIR=/run/locachy-appearance
        export XDG_CONFIG_DIRS="/usr/local/share/locachy/container-config:${XDG_CONFIG_DIRS:-/etc/xdg}"
        export XDG_DATA_DIRS="/usr/local/share/locachy/container-data:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
        touch "$run/$display"
        mount --bind "$host_runtime/$display" "$run/$display"
        unset DBUS_SESSION_BUS_ADDRESS
        # Its sound: the restricted sockets, as a container has them.
        sound "$run"
        [ ! -d "$pulse_sockets" ] || export PULSE_SERVER="unix:$run/pulse/native"
        # Its document view, as a container has it; the document service
        # itself out of sight (any peer of its bus may grant any document).
        doc_view "$run"
        [ ! -d "$docs_dir" ] || mount -t tmpfs -o mode=0755,size=4k,nosuid,nodev,noexec hidden "$docs_dir"
        bus_dir="$state_dir/bus"
        rm -rf "$bus_dir"
        install -d -o "$uid" -g "$gid" -m 0700 "$bus_dir"
        mount --bind "$bus_dir" /run/locachy-bus
        tray_bar=0
        [ -S "$host_runtime/locachy-bar.sock" ] && tray_bar=1
        if [ "$want_net" = 1 ] && [ -f /etc/netns/locachy-net/resolv.conf ]; then
            mount --bind -o ro /etc/netns/locachy-net/resolv.conf /etc/resolv.conf
        fi
        cd "$uhome"
        app_init=$init
        # The LOCachy xdg-open first: it hands paths and URLs to locachy-bar.
        path=/usr/local/lib/locachy/host-bin:/usr/local/sbin:/usr/local/bin:/usr/bin
    else
        # nosuid: setuid programs of the host (sudo, su) give no root in here;
        # with no_new_privs (app-init) nothing the container runs gains rights.
        mount -t overlay overlay -o "lowerdir=/,upperdir=$cbase/upper,workdir=$cbase/work,nosuid,nodev" "$cbase/merged"
        nnp=--no-new-privs
        export LOCACHY_APP_NO_NEW_PRIVS=1

        umask 022
        chmod 0755 "$cbase" "$cbase/upper" "$cbase/merged"
        mkdir -p "$cbase/merged"/{dev,proc,sys,tmp,run,etc}
        # The user as on the host: its passwd and group lines replace any with the
        # same name or id in the container (whose packages may have added other
        # users). Skip rewriting when the exact entry is already present with no
        # conflicting id or name. The host files are never written.
        set_entry() { # FILE ID LINE
            local f=$1 id=$2 line=$3 name=${3%%:*} cur found=0 conflict=0 f1 f3 rest
            if [ -f "$f" ]; then
                while IFS= read -r cur || [ -n "$cur" ]; do
                    if [ "$cur" = "$line" ]; then
                        found=1
                    else
                        f1=${cur%%:*}
                        rest=${cur#*:}
                        rest=${rest#*:}
                        f3=${rest%%:*}
                        if [ "$f1" = "$name" ] || [ "$f3" = "$id" ]; then
                            conflict=1
                            break
                        fi
                    fi
                done <"$f"
                if [ "$found" = 1 ] && [ "$conflict" = 0 ]; then
                    return 0
                fi
            fi
            { [ ! -f "$f" ] || awk -F: -v id="$id" -v n="$name" "\$3 != id && \$1 != n" "$f"
              printf "%s\n" "$line"; } >"$f.new"
            mv "$f.new" "$f"
        }
        set_entry "$cbase/merged/etc/passwd" "$uid" "$(getent passwd "$uid")"
        set_entry "$cbase/merged/etc/group" "$gid" "$(getent group "$gid")"
        [ ! -L "$cbase/data" ] || { printf "locachy-app: %s/data is a link\n" "$cbase" >&2; exit 125; }
        chown -h "$uid:$gid" "$cbase/data"
        chmod 0700 "$cbase/data"
        touch "$host_runtime/$display"
        chmod 0666 "$host_runtime/$display"
        mount -t proc proc "$cbase/merged/proc" -o nosuid,noexec,nodev
        mount -t sysfs sys "$cbase/merged/sys" -o nosuid,noexec,nodev,ro
        mount -t tmpfs tmp "$cbase/merged/tmp" -o mode=1777,nosuid,nodev
        # X11 through the filesystem socket (the abstract one stays in the
        # host network namespace), no TCP: this shared display only.
        if [ -n "$x11_display" ]; then
            install -d -m 1777 "$cbase/merged/tmp/.X11-unix"
            xsocket="/tmp/.X11-unix/X${x11_display#:}"
            touch "$cbase/merged$xsocket"
            mount --bind -o ro "$xsocket" "$cbase/merged$xsocket"
        fi
        mount -t tmpfs run "$cbase/merged/run" -o mode=0755,nosuid,nodev
        # Bind the dedicated directory, not the file: the host replaces the
        # snapshot atomically. Keep even later submounts out of this bind.
        appearance=/run/locachy/appearance
        [ ! -L "$appearance" ] || { printf "locachy-app: appearance directory is a link\n" >&2; exit 125; }
        install -d -m 0755 "$appearance" "$cbase/merged/run/locachy-appearance"
        mount --bind -o ro,nosuid,nodev,noexec "$appearance" "$cbase/merged/run/locachy-appearance"
        mount --make-private "$cbase/merged/run/locachy-appearance"
        # Containers read only the host appearance snapshot from this read-only directory.
        export LOCACHY_APPEARANCE_DIR=/run/locachy-appearance
        export XDG_CONFIG_DIRS="/usr/local/share/locachy/container-config:${XDG_CONFIG_DIRS:-/etc/xdg}"
        export XDG_DATA_DIRS="/usr/local/share/locachy/container-data:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
        # No session bus of root (it gets one of its own, below). Its sound
        # is the restricted sockets, at the paths of a session of its own
        # (pipewire-0, pulse/native).
        run="$cbase/merged/run/user/$uid"
        mkdir -p -m 0700 "$run"
        touch "$run/$display"
        mount --bind "$host_runtime/$display" "$run/$display"
        unset DBUS_SESSION_BUS_ADDRESS
        chown -R "$uid:$gid" "$run"
        sound "$run"
        [ ! -d "$pulse_sockets" ] || export PULSE_SERVER="unix:/run/user/$uid/pulse/native"
        doc_view "$run"
