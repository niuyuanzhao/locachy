        # words the input method has learned, the logs.
        mount -t tmpfs -o mode=0755,nosuid,nodev,size=1m hidden "$cbase/merged/var/lib/locachy"
        if [ -d "$cbase/merged/var/log/locachy" ]; then
            mount -t tmpfs -o mode=0755,nosuid,nodev,size=1m hidden "$cbase/merged/var/log/locachy"
        fi
        if [ -d /usr/share/fonts ]; then
            mkdir -p "$cbase/merged/usr/share/fonts"
            mount --bind -o ro /usr/share/fonts "$cbase/merged/usr/share/fonts"
        fi
        if [ -d /var/cache/fontconfig ]; then
            mkdir -p "$cbase/merged/var/cache/fontconfig"
            mount --bind -o ro /var/cache/fontconfig "$cbase/merged/var/cache/fontconfig"
        fi
        # The resolver file of the namespace itself, read-only: openresolv rewrites it
        # in place, so a new network or the MagicDNS of Tailscale reaches a
        # running container.
        if [ "$want_net" = 1 ] && [ -f /etc/netns/locachy-net/resolv.conf ]; then
            rm -f "$cbase/merged/etc/resolv.conf"
            touch "$cbase/merged/etc/resolv.conf"
            mount --bind -o ro /etc/netns/locachy-net/resolv.conf "$cbase/merged/etc/resolv.conf"
        fi

        mount -t tmpfs dev "$cbase/merged/dev" -o mode=0755,nosuid
        for d in null zero full random urandom tty; do
            [ -e "/dev/$d" ] || continue
            touch "$cbase/merged/dev/$d"
            mount --bind "/dev/$d" "$cbase/merged/dev/$d"
        done
        mkdir -p "$cbase/merged/dev/pts" "$cbase/merged/dev/shm" "$cbase/merged/dev/dri"
        mount -t devpts devpts "$cbase/merged/dev/pts" -o mode=0620,gid=5,ptmxmode=0666
        mount -t tmpfs shm "$cbase/merged/dev/shm" -o mode=1777,nosuid,nodev
        ln -sf pts/ptmx "$cbase/merged/dev/ptmx"
