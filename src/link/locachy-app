        # over user-writable paths): stale Chromium singleton files gone,
        # user-dirs and GSettings keyfile made when absent.
        setpriv --reuid="$uid" --regid="$gid" --clear-groups --no-new-privs -- sh -euc '\''
            uhome=$1; USER_DIRS=$2
            rm -f "$uhome"/.config/*/SingletonLock "$uhome"/.config/*/SingletonSocket \
                  "$uhome"/.config/*/SingletonCookie 2>/dev/null || true
            if [ ! -e "$uhome/.config/user-dirs.dirs" ] && [ ! -L "$uhome/.config/user-dirs.dirs" ]; then
                mkdir -p "$uhome/.config"
                for d in $USER_DIRS; do
                    key=$(printf "%s" "$d" | tr a-z A-Z)
                    [ "$key" = DOWNLOADS ] && key=DOWNLOAD
                    printf "XDG_%s_DIR=\"\$HOME/%s\"\n" "$key" "$d"
                done >"$uhome/.config/user-dirs.dirs"
            fi
