def env_path(var, default):
    val = os.environ.get(var, "").strip()
    return Path(val) if val else Path(default)


def root_path():
    return env_path("LOCACHY_NVIDIA_ROOT", "/")


def rc_path():
    return env_path("LOCACHY_NVIDIA_RC", root_path() / "etc/locachy/rc.conf")


def machines_dir():
    return env_path("LOCACHY_MACHINES_DIR", root_path() / "usr/local/share/locachy/machines")


def manifest_path():
    return env_path("LOCACHY_NVIDIA_MANIFEST", root_path() / "etc/locachy/packages")


def local_db_path():
    return env_path("LOCACHY_NVIDIA_LOCAL_DB", root_path() / "var/lib/pacman/local")


def sys_pci_path():
    return env_path("LOCACHY_NVIDIA_SYS_PCI", "/sys/bus/pci/devices")


def sys_module_path():
    return env_path("LOCACHY_NVIDIA_SYS_MODULE", "/sys/module/nvidia")


def pci_ids_path():
    raw = os.environ.get("LOCACHY_NVIDIA_PCI_IDS", "").strip()
    if raw:
        return Path(raw)
    root = root_path()
    candidates = [
        root / "usr/share/hwdata/pci.ids",
        Path("/usr/share/hwdata/pci.ids"),
        Path("/usr/share/misc/pci.ids"),
    ]
    for p in candidates:
        if p.is_file():
            return p
    return candidates[0]


def dmi_chassis_type_path():
    return env_path("LOCACHY_NVIDIA_DMI_CHASSIS", "/sys/class/dmi/id/chassis_type")


def boot_cmd_path():
    return os.environ.get("LOCACHY_NVIDIA_BOOT", "/usr/local/bin/locachy-boot")


def pkg_cmd_path():
    return os.environ.get("LOCACHY_NVIDIA_PKG", "/usr/local/bin/locachy-pkg")


def power_cmd_path():
    return os.environ.get("LOCACHY_NVIDIA_POWER", "/usr/local/bin/locachy-gpu-power")


def read_rc_file_value(path, key):
    if not path.is_file():
        return ""
    found = ""
    pat = re.compile(rf"^\s*{re.escape(key)}=\"([^\"]*)\"\s*(?:#.*)?$")
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        m = pat.match(line)
        if m:
            found = m.group(1)
    return found


def read_rc_layered(key):
    rc = rc_path()
    direct = read_rc_file_value(rc, key)
    if direct != "":
        return direct
    mach = read_rc_file_value(rc, "machine")
    if mach and MACHINE_RE.fullmatch(mach):
        return read_rc_file_value(machines_dir() / f"{mach}.conf", key)
    return ""


def write_rc_key(key, value):
    rc = rc_path()
    rc.parent.mkdir(parents=True, exist_ok=True)
    lines = rc.read_text(encoding="utf-8", errors="replace").splitlines() if rc.is_file() else []
    pat = re.compile(rf"^\s*{re.escape(key)}=")
    out = []
    replaced = False
    for line in lines:
        if pat.match(line):
            if value is not None and not replaced:
                out.append(f'{key}="{value}"')
                replaced = True
            continue
        out.append(line)
    if value is not None and not replaced:
        out.append(f'{key}="{value}"')
    tmp = rc.with_name(rc.name + f".tmp.{os.getpid()}")
    tmp.write_text("\n".join(out) + ("\n" if out else ""), encoding="utf-8")
    os.chmod(tmp, 0o644)
    os.replace(tmp, rc)


def load_manifest_names():
    mf = manifest_path()
    if not mf.is_file():
        return set()
    names = set()
    for line in mf.read_text(encoding="utf-8", errors="replace").splitlines():
        code = line.split("#", 1)[0].strip()
        if code:
            names.update(code.split())
    return names


def update_manifest(add=(), remove=()):
    mf = manifest_path()
    if not mf.is_file() and not add:
        return
    mf.parent.mkdir(parents=True, exist_ok=True)
    lines = mf.read_text(encoding="utf-8", errors="replace").splitlines() if mf.is_file() else []
    remove_set = set(remove)
    existing = set()
    kept = []
    for line in lines:
        code = line.split("#", 1)[0].strip()
        if not code:
            kept.append(line)
            continue
        words = [w for w in code.split() if w not in remove_set]
        if not words:
            continue
        if len(words) == len(code.split()):
            kept.append(line)
        else:
            kept.append(" ".join(words))
        existing.update(words)
    missing = [p for p in add if p not in existing]
    if missing:
        kept.append("# NVIDIA DKMS driver (locachy-nvidia)")
        kept.extend(missing)
    tmp = mf.with_name(mf.name + f".tmp.{os.getpid()}")
    tmp.write_text("\n".join(kept) + ("\n" if kept else ""), encoding="utf-8")
    os.chmod(tmp, 0o644)
    os.replace(tmp, mf)


def installed_pkg_version(name):
    db = local_db_path()
    if not db.is_dir():
        return ""
    for desc in db.glob(f"{name}-*/desc"):
        lines = desc.read_text(encoding="utf-8", errors="replace").splitlines()
        pkg_name = ""
        pkg_ver = ""
        for i, line in enumerate(lines):
            if line == "%NAME%" and i + 1 < len(lines):
                pkg_name = lines[i + 1].strip()
            elif line == "%VERSION%" and i + 1 < len(lines):
                pkg_ver = lines[i + 1].strip()
        if pkg_name == name:
            return pkg_ver
    return ""


def normalize_pci_hex4(raw):
    text = (raw or "").strip().lower()
    if text.startswith("0x"):
        text = text[2:]
    if not re.fullmatch(r"[0-9a-f]{1,4}", text):
        return ""
    return text.zfill(4)


def load_nvidia_pci_ids(path=None):
    """Parse vendor 10de (NVIDIA) device names from pci.ids."""
    p = Path(path) if path is not None else pci_ids_path()
    if not p.is_file():
        return {}
    mapping = {}
    in_nvidia = False
    try:
        with p.open("r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if not line or line[0] in ("#", "\n", "\r"):
                    continue
                if line[0] == "C" and line.startswith("C "):
                    if in_nvidia:
                        break
                    continue
                if line[0] != "\t":
                    if in_nvidia:
                        break
                    vm = PCI_VENDOR_LINE_RE.match(line)
                    if vm and vm.group(1).lower() == "10de":
                        in_nvidia = True
                    continue
                if not in_nvidia or line.startswith("\t\t"):
                    continue
                dm = PCI_DEV_LINE_RE.match(line)
                if dm:
                    mapping[dm.group(1).lower()] = dm.group(2).strip()
    except OSError:
        return {}
    return mapping


def lspci_nvidia_names():
    """Fallback device description lookup via `lspci -nn -d 10de:` when pci.ids is absent."""
    if os.environ.get("LOCACHY_NVIDIA_NO_LSPCI") == "1":
        return {}
    if not shutil.which("lspci"):
        return {}
    try:
        res = subprocess.run(
            ["lspci", "-nn", "-d", "10de:"],
            capture_output=True,
            text=True,
            env=dict(os.environ, LC_ALL="C"),
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return {}
    if res.returncode != 0:
        return {}
    names = {}
    for line in (res.stdout or "").splitlines():
        m = LSPCI_DEV_RE.search(line)
        if not m:
            continue
        dev_id = m.group(1).lower()
        body = line
        if ": " in body:
            body = body.split(": ", 1)[1]
        body = re.sub(r"^NVIDIA\s+Corporation\s+", "", body, flags=re.I)
        body = re.sub(r"\s*\[10de:[0-9a-fA-F]{4}\].*$", "", body).strip()
        if body:
            names[dev_id] = body
    return names


def is_laptop_chassis():
    p = dmi_chassis_type_path()
    try:
        val = int(p.read_text(encoding="utf-8", errors="replace").strip())
        return val in LAPTOP_CHASSIS_TYPES
    except (OSError, ValueError):
        return False


def classify_nvidia_gpu(device_id, name="", laptop_chassis=None):
    """Classify one NVIDIA PCI device according to the Arch Wiki NVIDIA family table."""
    dev_hex = normalize_pci_hex4(device_id)
    desc = (name or "").strip()
    if laptop_chassis is None:
        laptop_chassis = is_laptop_chassis()

    family = "unknown"
    codename = ""
    for fam, pat in CODENAME_FAMILY_RULES:
        m = pat.search(desc)
        if m:
            family = fam
            codename = m.group(0)
            break
    if family == "unknown" and desc:
        for fam, pat in NAME_FAMILY_RULES:
            if pat.search(desc):
                family = fam
                break

    ampere_laptop = False
    if family == "ampere":
        if re.search(r"\bGA\d+[A-Z]*M\b", desc) or re.search(r"\b(?:Laptop|Mobile)\b", desc, re.I) or laptop_chassis:
            ampere_laptop = True

    note = ""
    reason = ""
    if family == "blackwell":
        supported = ["open"]
        recommended = "open"
        reason = "Blackwell/Hopper requires open kernel modules (580xx unsupported)"
    elif family in ("ada", "ampere", "turing"):
        supported = ["open", "580xx"]
        recommended = "open"
        reason = f"{family.capitalize()} defaults to open kernel modules (Arch Wiki)"
        if ampere_laptop:
            note = (
                "Ampere laptop GPU: on some Ampere laptops GSP-RM causes complete failure (ArchWiki); "
                "if this machine is affected, switch manually to 580xx with GSP off."
            )
    elif family in ("volta", "pascal", "maxwell"):
        supported = ["580xx"]
        recommended = "580xx"
        reason = f"{family.capitalize()} lacks GSP and requires legacy 580xx"
    elif family in ("kepler", "fermi", "tesla", "curie", "legacy"):
        supported = []
        recommended = "off"
        reason = f"{family.capitalize()} is unsupported by open and 580xx"
        note = "legacy unsupported by open/580xx; use nouveau or AUR 470xx/390xx"
    else:
        supported = ["open", "580xx"]
        recommended = "open"
        reason = f"unknown NVIDIA PCI ID (0x{dev_hex or '????'}); defaulting to open kernel modules"

    return {
        "family": family,
        "codename": codename,
        "name": desc,
        "supported_branches": supported,
        "recommended_branch": recommended,
        "recommend_reason": reason,
        "ampere_laptop_gsp_note": ampere_laptop,
        "note": note,
    }


def detect_nvidia_gpus():
    gpus = []
    pci = sys_pci_path()
    if not pci.is_dir():
        return gpus

    pci_names = load_nvidia_pci_ids()
    lspci_names = None
    laptop = is_laptop_chassis()

    for dev in sorted(pci.iterdir()):
        bdf = dev.name.lower()
        if not PCI_BDF_RE.fullmatch(bdf):
            continue
        try:
            vendor = (dev / "vendor").read_text(encoding="utf-8").strip().lower()
            device = (dev / "device").read_text(encoding="utf-8").strip().lower()
            cls = (dev / "class").read_text(encoding="utf-8").strip().lower()
        except OSError:
            continue
        if vendor != "0x10de" or not cls.startswith("0x03"):
            continue
        driver = ""
        drv_link = dev / "driver"
        if drv_link.is_symlink():
            driver = os.path.basename(os.readlink(drv_link))
        dev_hex = normalize_pci_hex4(device)
        name = pci_names.get(dev_hex, "")
        if not name and not pci_names:
            if lspci_names is None:
                lspci_names = lspci_nvidia_names()
            name = lspci_names.get(dev_hex, "")
        info = classify_nvidia_gpu(dev_hex, name=name, laptop_chassis=laptop)
        gpus.append({
            "bdf": bdf,
            "vendor": vendor,
            "device": f"0x{dev_hex}" if dev_hex else device,
            "class": cls,
            "driver": driver,
            **info,
        })
    return gpus


def summarize_gpu_recommendation(gpus):
    """Aggregate per-GPU family classification into one system recommendation."""
    if not gpus:
        return {
            "recommended_branch": "off",
            "supported_branches": [],
            "recommend_reason": "no NVIDIA GPU detected",
            "gpu_family": "none",
            "gpu_name": "",
            "ampere_laptop_gsp_note": False,
            "conflict": "",
            "notes": [],
        }

    notes = []
    for g in gpus:
        if g.get("note") and g["note"] not in notes:
            notes.append(g["note"])
    ampere_note = any(g.get("ampere_laptop_gsp_note") for g in gpus)

    families = []
    for g in gpus:
        f = g.get("family") or "unknown"
        if f not in families:
            families.append(f)
    gpu_family = families[0] if len(families) == 1 else ",".join(families)

    names = [g.get("name") or g.get("device") or g.get("bdf") for g in gpus]
    gpu_name = "; ".join(n for n in names if n)

    common = None
    for g in gpus:
        s = set(g.get("supported_branches") or ())
        common = s if common is None else (common & s)
    supported = [b for b in CONCRETE_BRANCHES if b in (common or set())]

    legacy_gpus = [g for g in gpus if not g.get("supported_branches")]
    if legacy_gpus and len(legacy_gpus) == len(gpus):
        return {
            "recommended_branch": "off",
            "supported_branches": [],
            "recommend_reason": legacy_gpus[0].get("recommend_reason") or "legacy NVIDIA GPU unsupported by open/580xx",
            "gpu_family": gpu_family,
            "gpu_name": gpu_name,
            "ampere_laptop_gsp_note": ampere_note,
            "conflict": "",
            "notes": notes,
        }

    if not supported:
        # Multi-GPU conflict: e.g. Blackwell (open-only) + Pascal/Maxwell (580xx-only), or supported + legacy.
        parts = [f"{g['bdf']} ({g['family']}: {'/'.join(g['supported_branches']) or 'unsupported'})" for g in gpus]
        conflict = "multi-GPU branch conflict: no single NVIDIA driver branch supports all detected GPUs: " + ", ".join(parts)
        return {
            "recommended_branch": "off",
            "supported_branches": [],
            "recommend_reason": conflict,
            "gpu_family": gpu_family,
            "gpu_name": gpu_name,
            "ampere_laptop_gsp_note": ampere_note,
            "conflict": conflict,
            "notes": notes,
        }

    if len(supported) == 1:
        only = supported[0]
        reasons = [g.get("recommend_reason") for g in gpus if g.get("supported_branches") == [only] and g.get("recommend_reason")]
        reason = reasons[0] if reasons else f"detected GPU family requires {only}"
        return {
            "recommended_branch": only,
            "supported_branches": supported,
            "recommend_reason": reason,
            "gpu_family": gpu_family,
            "gpu_name": gpu_name,
            "ampere_laptop_gsp_note": ampere_note,
            "conflict": "",
            "notes": notes,
        }

    # Both open and 580xx are supported by all detected GPUs: Arch Wiki default is open
    # even when gpu-unlock is active (Zagitta/gpu-unlock #135: GSP does not block unlock;
    # 595's NVreg_GpuInitOnProbe lazy-init regression was fixed in branch 615+).
    rec = "open"
    reason = gpus[0].get("recommend_reason") or "Arch Wiki default for Turing+ GPUs (open)"
    return {
        "recommended_branch": rec,
        "supported_branches": supported,
        "recommend_reason": reason,
        "gpu_family": gpu_family,
        "gpu_name": gpu_name,
        "ampere_laptop_gsp_note": ampere_note,
        "conflict": "",
        "notes": notes,
    }


def detect_installed_branch():
    has_open = bool(installed_pkg_version("nvidia-open-dkms") or installed_pkg_version("nvidia-utils"))
    has_580 = bool(installed_pkg_version("nvidia-580xx-dkms") or installed_pkg_version("nvidia-580xx-utils"))
    if has_open and has_580:
        return "mixed"
    if has_open:
        return "open"
    if has_580:
        return "580xx"
    return "off"


def configured_branch():
    raw = (read_rc_layered("nvidia_driver") or "").strip().lower()
    if raw in BRANCHES:
        return raw
    inst = detect_installed_branch()
    return inst if inst in CONCRETE_BRANCHES else "off"


def effective_branch(cfg=None, inst=None, rec=None):
    """Concrete driver branch ('open', '580xx', or 'off') for drop-in / GSP evaluation."""
    if cfg is None:
        cfg = configured_branch()
    if inst is None:
        inst = detect_installed_branch()
    if cfg in CONCRETE_BRANCHES:
        return cfg
    if cfg == "auto":
        if inst in CONCRETE_BRANCHES:
            return inst
        if rec in CONCRETE_BRANCHES:
            return rec
        return "off"
    return inst if inst in CONCRETE_BRANCHES else "off"


def configured_gsp_policy():
    raw = (read_rc_layered("nvidia_gsp") or "").strip().lower()
    if raw in ("0", "off"):
        return "off"
    if raw in ("1", "on"):
        return "on"
    return "auto"


def gpu_unlock_is_active():
    raw = (read_rc_layered("gpu_unlock_targets") or "").strip().lower()
    return bool(raw and raw not in ("off", "0"))


def should_disable_gsp(branch, gsp_policy, unlock_active):
    """Only proprietary 580xx honors NVreg_EnableGpuFirmware=0; open requires GSP."""
    if branch != "580xx":
        return False
    if gsp_policy == "off":
        return True
    if gsp_policy == "on":
        return False
    return bool(unlock_active)


def render_modprobe_dropin(branch, gsp_policy, unlock_active):
    if branch not in CONCRETE_BRANCHES:
        return None
    lines = [
        f"# Managed by locachy-nvidia (branch: {branch}, gsp: {gsp_policy})",
        "blacklist nouveau",
        "options nouveau modeset=0",
        "options nvidia-drm modeset=1",
        "softdep nvidia post: nvidia-uvm",
    ]
    if branch == "580xx":
        if should_disable_gsp(branch, gsp_policy, unlock_active):
            lines.append("options nvidia NVreg_EnableGpuFirmware=0")
        elif gsp_policy == "on":
            lines.append("options nvidia NVreg_EnableGpuFirmware=1")
    return "\n".join(lines) + "\n"


def write_dropin(branch, gsp_policy=None, unlock_active=None):
    if gsp_policy is None:
        gsp_policy = configured_gsp_policy()
    if unlock_active is None:
        unlock_active = gpu_unlock_is_active()
    mp = root_path() / "etc/modprobe.d" / MODPROBE_NAME
    text = render_modprobe_dropin(branch, gsp_policy, unlock_active)
    if text is None:
        try:
            mp.unlink()
        except FileNotFoundError:
            pass
        return False
    mp.parent.mkdir(parents=True, exist_ok=True)
    tmp = mp.with_name(mp.name + f".tmp.{os.getpid()}")
    tmp.write_text(text, encoding="utf-8")
    os.chmod(tmp, 0o644)
    os.replace(tmp, mp)
    return True


def netns_prefix():
    if os.environ.get("LOCACHY_NVIDIA_NO_NETNS") == "1":
        return []
    if os.path.exists("/run/netns/locachy-net"):
        return ["ip", "netns", "exec", "locachy-net"]
    return []


def inherited_domain_fds():
    try:
        want = os.stat(DOMAIN_LOCK_PATH)
    except OSError:
        return ()
    found = []
    try:
        names = os.listdir("/proc/self/fd")
    except OSError:
        return ()
    for name in names:
        try:
            fd = int(name)
            if fd <= 2 or fcntl.fcntl(fd, fcntl.F_GETFD) & fcntl.FD_CLOEXEC:
                continue
            got = os.fstat(fd)
        except (OSError, ValueError):
            continue
        if stat.S_ISREG(got.st_mode) and (got.st_dev, got.st_ino) == (want.st_dev, want.st_ino):
            found.append(fd)
    return tuple(found)


def run_cmd(cmd, check=True, **kwargs):
    print("+", " ".join(str(c) for c in cmd), flush=True)
    return subprocess.run(cmd, check=check, **kwargs)


def run_domain_cmd(cmd, check=True, **kwargs):
    fds = inherited_domain_fds()
    if fds:
        kwargs["pass_fds"] = fds
    return run_cmd(cmd, check=check, **kwargs)


def pacman_has_package(pkg_name):
    res = subprocess.run(
        ["pacman", "-Sp", "--", pkg_name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=dict(os.environ, LC_ALL="C"),
    )
    return res.returncode == 0


def package_needs_multilib(pkg_name):
    res = subprocess.run(
        ["pacman", "-Si", "--", pkg_name],
        capture_output=True,
        text=True,
        env=dict(os.environ, LC_ALL="C"),
    )
    if res.returncode != 0:
        return False
    for line in (res.stdout or "").splitlines():
        if line.startswith("Depends On") and " : " in line:
            deps = line.split(" : ", 1)[1].split()
            if any(d.startswith("lib32-") for d in deps):
                return True
    return False


def loaded_driver_info():
    mod_dir = sys_module_path()
    if not mod_dir.is_dir():
        return "", ""
    ver = ""
    try:
        ver = (mod_dir / "version").read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        pass
    return "nvidia", ver


def sync_nvidia_powerd():
    power = power_cmd_path()
    if not power or not os.path.exists(power):
        return
    want = (read_rc_layered("nvidia_powerd") or "").strip()
    if want == "1":
        run_domain_cmd([power, "nvidia-powerd", "on"], check=False)


def run_boot_rebuild():
    boot = boot_cmd_path()
    if boot and os.path.exists(boot):
        run_domain_cmd([boot])


def status_dict():
    unlock_on = gpu_unlock_is_active()
    gpus = detect_nvidia_gpus()
    summary = summarize_gpu_recommendation(gpus)
    inst = detect_installed_branch()
    cfg = configured_branch()
    gsp = configured_gsp_policy()
    active_branch = effective_branch(cfg=cfg, inst=inst, rec=summary["recommended_branch"])
    gsp_off = should_disable_gsp(active_branch, gsp, unlock_on)

    dkms_pkg = ""
    utils_pkg = ""
    if inst == "open":
        dkms_pkg, utils_pkg = BRANCH_PACKAGES["open"]
    elif inst == "580xx":
        dkms_pkg, utils_pkg = BRANCH_PACKAGES["580xx"]
    dkms_ver = installed_pkg_version(dkms_pkg) if dkms_pkg else ""
    utils_ver = installed_pkg_version(utils_pkg) if utils_pkg else ""

    boot_k = read_rc_layered("boot_kernel") or "linux-cachyos-bore"
    headers_inst = bool(installed_pkg_version(f"{boot_k}-headers"))
    dkms_tool_inst = bool(installed_pkg_version("dkms"))

    loaded_mod, loaded_ver = loaded_driver_info()
    if not loaded_mod:
        for g in gpus:
            if g.get("driver"):
                loaded_mod = g["driver"]
                break

    # gpu-unlock note: shown while the branch is open, or open is what auto would install.
    unlock_note = ""
    if unlock_on and active_branch != "580xx" and (active_branch == "open" or summary["recommended_branch"] == "open"):
        unlock_note = UNLOCK_OPEN_ADVISORY
    advisories = []
    if summary["conflict"]:
        advisories.append(summary["conflict"])
    if unlock_note:
        advisories.append(unlock_note)
    if active_branch != "580xx":
        advisories.extend(n for n in summary["notes"] if n not in advisories)

    mp_file = root_path() / "etc/modprobe.d" / MODPROBE_NAME
    return {
        "configured_branch": cfg,
        "installed_branch": inst,
        "recommended_branch": summary["recommended_branch"],
        "supported_branches": summary["supported_branches"],
        "recommend_reason": summary["recommend_reason"],
        "gpu_family": summary["gpu_family"],
        "gpu_name": summary["gpu_name"],
        "ampere_laptop_gsp_note": summary["ampere_laptop_gsp_note"],
        "gpu_conflict": summary["conflict"],
        "gpu_notes": summary["notes"],
        "dkms_package": dkms_pkg,
        "dkms_version": dkms_ver,
        "utils_package": utils_pkg,
        "utils_version": utils_ver,
        "boot_kernel": boot_k,
        "kernel_headers_installed": headers_inst,
        "dkms_installed": dkms_tool_inst,
        "gsp_policy": gsp,
        "gsp_disabled_configured": gsp_off,
        "gpu_unlock_active": unlock_on,
        "gpu_unlock_advisory": unlock_note,
        "advisories": advisories,
        "modprobe_configured": mp_file.is_file(),
        "loaded_driver": loaded_mod or "none",
        "loaded_version": loaded_ver,
        "nvidia_gpus": gpus,
        "branches": list(BRANCHES),
    }


def sanitize_tsv(val):
    return str(val or "").replace("\t", " ").replace("\n", " ").replace("\r", " ")


def cmd_status(args):
    data = status_dict()
    if args.json:
        print(json.dumps(data, indent=2, sort_keys=True))
        return 0
    if args.tsv:
        print(f"configured\t{sanitize_tsv(data['configured_branch'])}")
        print(f"installed\t{sanitize_tsv(data['installed_branch'])}")
        print(f"recommended\t{sanitize_tsv(data['recommended_branch'])}")
        print(f"supported\t{sanitize_tsv(','.join(data['supported_branches']))}")
        print(f"gpu_family\t{sanitize_tsv(data['gpu_family'])}")
        print(f"dkms_version\t{sanitize_tsv(data['dkms_version'])}")
        print(f"utils_version\t{sanitize_tsv(data['utils_version'])}")
        print(f"gsp_policy\t{sanitize_tsv(data['gsp_policy'])}")
        print(f"gsp_disabled\t{1 if data['gsp_disabled_configured'] else 0}")
        print(f"gpu_unlock\t{1 if data['gpu_unlock_active'] else 0}")
        print(f"ampere_laptop_note\t{1 if data['ampere_laptop_gsp_note'] else 0}")
        print(f"gpu_count\t{len(data['nvidia_gpus'])}")
        print(f"loaded\t{sanitize_tsv(data['loaded_driver'])}")
        print(f"loaded_version\t{sanitize_tsv(data['loaded_version'])}")
        print(f"gpu_name\t{sanitize_tsv(data['gpu_name'])}")
        print(f"recommend_reason\t{sanitize_tsv(data['recommend_reason'])}")
        return 0
    print(f"configured_branch: {data['configured_branch']}")
    print(f"installed_branch: {data['installed_branch']}"
          + (f" ({data['dkms_package']} {data['dkms_version']})" if data["dkms_version"] else ""))
    print(f"recommended_branch: {data['recommended_branch']}"
          + (f" ({data['recommend_reason']})" if data["recommend_reason"] else ""))
    print(f"supported_branches: {', '.join(data['supported_branches']) or 'none'}")
    print(f"gpu_family: {data['gpu_family']}" + (f" ({data['gpu_name']})" if data["gpu_name"] else ""))
    print(f"gsp_policy: {data['gsp_policy']} (NVreg_EnableGpuFirmware=0: {'yes' if data['gsp_disabled_configured'] else 'no'})")
    print(f"loaded_driver: {data['loaded_driver']}"
          + (f" ({data['loaded_version']})" if data["loaded_version"] else ""))
    gpu_desc = ", ".join(
        f"{g['bdf']}({g['device']} {g['family']}" + (f": {g['name']}" if g.get("name") else "") + ")"
        for g in data["nvidia_gpus"]
    )
    print(f"nvidia_gpus: {gpu_desc or 'none'}")
    for adv in data["advisories"]:
        print(f"advisory: {adv}")
    return 0


def validate_branch_for_hardware(requested_branch, gpus, summary, force=False):
    """Ensure requested manual branch is supported by detected NVIDIA hardware."""
    if force or not gpus:
        return
    supported = summary["supported_branches"]
    if requested_branch in supported:
        return
    if summary["conflict"]:
        raise RuntimeError(f"{summary['conflict']} (pass --force to override)")
    if not supported:
        note = summary["notes"][0] if summary["notes"] else "legacy GPU unsupported by open/580xx"
        raise RuntimeError(
            f"detected NVIDIA GPU ({summary['gpu_family']}: {summary['gpu_name'] or 'unknown'}) is not supported "
            f"by branch {requested_branch!r}: {note} (pass --force to override)"
        )
    rec = summary["recommended_branch"]
    raise RuntimeError(
        f"NVIDIA driver branch {requested_branch!r} does not support detected {summary['gpu_family']} GPU "
        f"({summary['gpu_name'] or 'unknown'}); supported: {', '.join(supported)} "
        f"(recommended: {rec}; pass --force to override)"
    )


def resolve_auto_branch(gpus, summary):
    """Resolve `set auto` to a concrete branch ('open' or '580xx'), checking repo availability."""
    if not gpus:
        raise RuntimeError(
            "no NVIDIA GPU detected; cannot auto-select a driver branch (use 'locachy-nvidia set off' or pass an explicit branch with --force)"
        )
    if summary["conflict"]:
        raise RuntimeError(summary["conflict"])
    supported = summary["supported_branches"]
    rec = summary["recommended_branch"]
    if rec not in CONCRETE_BRANCHES or not supported:
        note = summary["notes"][0] if summary["notes"] else summary["recommend_reason"]
        raise RuntimeError(
            f"detected NVIDIA GPU ({summary['gpu_family']}: {summary['gpu_name'] or 'unknown'}) is unsupported by "
            f"Arch/CachyOS open and 580xx DKMS branches ({note}); use 'locachy-nvidia set off'"
        )
    # Prefer the hardware-recommended branch when its packages exist in enabled repos;
    # otherwise fall back to another hardware-supported branch if available.
    ordered = [rec] + [b for b in supported if b != rec]
    for candidate in ordered:
        pkgs = BRANCH_PACKAGES[candidate]
        if not all(pacman_has_package(p) for p in pkgs):
            continue
        if candidate == "580xx" and read_rc_layered("repo_multilib") == "0" and package_needs_multilib("nvidia-580xx-utils"):
            continue
        if candidate != rec:
            print(f"locachy-nvidia: recommended {rec} is not in enabled repositories; using {candidate}", flush=True)
        return candidate
    return rec


def cmd_set(args):
    requested = args.branch
    force = bool(getattr(args, "force", False))
    if requested not in BRANCHES:
        raise ValueError(f"unsupported NVIDIA driver branch: {requested!r} (expected one of {', '.join(BRANCHES)})")

    pkg = pkg_cmd_path()
    has_pkg = bool(pkg and os.path.exists(pkg))

    if requested == "off":
        write_dropin("off")
        write_rc_key("nvidia_driver", "off")
        manifest_names = load_manifest_names()
        to_remove = [p for p in ALL_DRIVER_PACKAGES if p in manifest_names or installed_pkg_version(p)]
        if to_remove:
            if has_pkg:
                run_domain_cmd([pkg, "remove", *to_remove])
            else:
                update_manifest(remove=to_remove)
                inst_rem = [p for p in to_remove if installed_pkg_version(p)]
                if inst_rem:
                    run_cmd(["pacman", "-Rns", "--noconfirm", *inst_rem], check=False)
        sync_nvidia_powerd()
        run_boot_rebuild()
        print("locachy-nvidia: NVIDIA driver removed and boot image rebuilt", flush=True)
        return 0

    gpus = detect_nvidia_gpus()
    summary = summarize_gpu_recommendation(gpus)

    if requested == "auto":
        install_branch = resolve_auto_branch(gpus, summary)
        rc_branch = "auto"
    else:
        validate_branch_for_hardware(requested, gpus, summary, force=force)
        install_branch = requested
        rc_branch = requested

    target_pkgs = list(BRANCH_PACKAGES[install_branch])
    opposite_pkgs = [p for p in ALL_DRIVER_PACKAGES if p not in target_pkgs]

    # Pre-flight check before touching any installed driver.
    missing_repo = [p for p in target_pkgs if not pacman_has_package(p)]
    if missing_repo:
        raise RuntimeError(
            f"NVIDIA driver branch {install_branch!r} packages not found in enabled repositories: {', '.join(missing_repo)}"
        )
    if install_branch == "580xx" and read_rc_layered("repo_multilib") == "0" and package_needs_multilib("nvidia-580xx-utils"):
        raise RuntimeError(
            "nvidia-580xx-utils requires lib32-* dependencies from [multilib]; "
            "enable Multilib in Settings -> System -> Software Sources first"
        )

    # DKMS always needs active kernel headers and dkms.
    if has_pkg:
        run_domain_cmd([pkg, "kernel", "headers", "on"])
        if not installed_pkg_version("dkms") or "dkms" not in load_manifest_names():
            run_domain_cmd([pkg, "install", "dkms"])

    opposite_installed = [p for p in opposite_pkgs if installed_pkg_version(p)]
    if opposite_installed:
        # Atomically replace conflicting NVIDIA driver branch (--ask 4 = confirm conflict removal)
        # so reverse dependencies (vulkan-driver, CUDA consumers) are never broken mid-switch.
        net = netns_prefix()
        run_cmd([*net, "pacman", "-S", "--needed", "--noconfirm", "--ask", "4", *target_pkgs])
        update_manifest(add=[*target_pkgs, "dkms"], remove=opposite_pkgs)
        if has_pkg:
            run_domain_cmd([pkg, "sync"])
    else:
        update_manifest(remove=opposite_pkgs)
        if has_pkg:
            run_domain_cmd([pkg, "install", *target_pkgs])
        else:
            net = netns_prefix()
            run_cmd([*net, "pacman", "-S", "--needed", "--noconfirm", *target_pkgs])
            update_manifest(add=[*target_pkgs, "dkms"])

    write_rc_key("nvidia_driver", rc_branch)
    if not read_rc_file_value(rc_path(), "nvidia_gsp"):
        write_rc_key("nvidia_gsp", "auto")
    write_dropin(install_branch)
    sync_nvidia_powerd()
    run_boot_rebuild()
    if rc_branch == "auto":
        print(
            f"locachy-nvidia: auto-selected branch={install_branch} for {summary['gpu_family']} "
            f"({', '.join(target_pkgs)}) and rebuilt boot image",
            flush=True,
        )
    else:
        print(
            f"locachy-nvidia: installed branch={install_branch} ({', '.join(target_pkgs)}) and rebuilt boot image",
            flush=True,
        )
    return 0


def cmd_gsp(args):
    mode = args.mode
    if mode not in GSP_MODES:
        raise ValueError(f"unsupported GSP mode: {mode!r} (expected one of {', '.join(GSP_MODES)})")
    write_rc_key("nvidia_gsp", mode)
    branch = effective_branch()
    if branch in CONCRETE_BRANCHES:
        write_dropin(branch, gsp_policy=mode)
    run_boot_rebuild()
    print(f"locachy-nvidia: nvidia_gsp set to {mode} (active branch: {branch})", flush=True)
    return 0


def cmd_sync_dropin(_args):
    branch = effective_branch()
    write_dropin(branch)
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="locachy-nvidia", description="Manage Arch/CachyOS DKMS NVIDIA drivers on LOCachy.")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp_st = sub.add_parser("status", help="Show installed/configured NVIDIA driver branch, GPU family, GSP state, and GPUs")
    sp_st.add_argument("--json", action="store_true")
    sp_st.add_argument("--tsv", action="store_true")
    sp_st.set_defaults(func=cmd_status)

    sp_set = sub.add_parser("set", help="Install/switch NVIDIA DKMS driver branch (auto, open, 580xx) or remove (off)")
    sp_set.add_argument("branch", choices=BRANCHES)
    sp_set.add_argument("--force", action="store_true", help="Override GPU family compatibility validation")
    sp_set.set_defaults(func=cmd_set)

    sp_gsp = sub.add_parser("gsp", help="Configure NVIDIA GSP firmware policy (auto, off, on; off applies to 580xx)")
    sp_gsp.add_argument("mode", choices=GSP_MODES)
    sp_gsp.set_defaults(func=cmd_gsp)

    sp_sync = sub.add_parser("sync-dropin", help="Rewrite /etc/modprobe.d/40-locachy-nvidia.conf from current rc.conf")
    sp_sync.set_defaults(func=cmd_sync_dropin)

    args = p.parse_args(argv)
    try:
        return args.func(args)
    except Exception as exc:
        print(f"locachy-nvidia: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
