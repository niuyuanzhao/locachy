BRANCHES = ("auto", "open", "580xx", "off")
CONCRETE_BRANCHES = ("open", "580xx")
GSP_MODES = ("auto", "off", "on")

BRANCH_PACKAGES = {
    "open": ("nvidia-open-dkms", "nvidia-utils"),
    "580xx": ("nvidia-580xx-dkms", "nvidia-580xx-utils"),
}
ALL_DRIVER_PACKAGES = (
    "nvidia-open-dkms",
    "nvidia-utils",
    "nvidia-580xx-dkms",
    "nvidia-580xx-utils",
    "nvidia-dkms",
)

PCI_BDF_RE = re.compile(r"^[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7]$")
MACHINE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$")
PCI_DEV_LINE_RE = re.compile(r"^\t([0-9a-fA-F]{4})[ \t]+(.+?)\s*$")
PCI_VENDOR_LINE_RE = re.compile(r"^([0-9a-fA-F]{4})[ \t]+")
LSPCI_DEV_RE = re.compile(r"\[10de:([0-9a-fA-F]{4})\]")

# Arch Wiki NVIDIA GPU codename -> family classification (ordered newest -> oldest).
# Codename prefixes come from /usr/share/hwdata/pci.ids NVIDIA (10de) descriptions.
CODENAME_FAMILY_RULES = (
    # Blackwell / Hopper and newer: open kernel modules only (580xx does not support Blackwell).
    ("blackwell", re.compile(r"\b(?:GB\d+[A-Z0-9-]*|GH\d+[A-Z0-9-]*)\b")),
    # Ada Lovelace / Ampere / Turing: supported by both open and 580xx.
    ("ada", re.compile(r"\bAD\d+[A-Z0-9-]*\b")),
    ("ampere", re.compile(r"\bGA\d+[A-Z0-9-]*\b")),
    ("turing", re.compile(r"\bTU\d+[A-Z0-9-]*\b")),
    # Volta / Pascal / Maxwell: proprietary 580xx only (no GSP -> unsupported by open).
    ("volta", re.compile(r"\bGV\d+[A-Z0-9-]*\b")),
    ("pascal", re.compile(r"\bGP\d+[A-Z0-9-]*\b")),
    ("maxwell", re.compile(r"\bGM\d+[A-Z0-9-]*\b")),
    # Kepler / Fermi / Tesla / Curie: unsupported by open and 580xx.
    ("kepler", re.compile(r"\bGK\d+[A-Z0-9-]*\b")),
    ("fermi", re.compile(r"\bGF\d+[A-Z0-9-]*\b")),
    ("tesla", re.compile(r"\b(?:G8[046]|G9[2468]|GT2\d+)[A-Z0-9-]*\b|\b(?:ION|C7[79]|MCP7[79]|MCP89)\b")),
    ("curie", re.compile(r"\b(?:G7\d+|NV4\d+)[A-Z0-9-]*\b|\b(?:C51|C6[178]|MCP6[178])\b")),
    ("legacy", re.compile(r"\bNV[0-3]\d[A-Z0-9-]*\b")),
)

# Product-name fallback when a pci.ids description omits the chip codename.
NAME_FAMILY_RULES = (
    ("blackwell", re.compile(r"\b(?:RTX\s*50\d{2}|RTX\s+PRO\s+\d+\s+Blackwell|B[12]00)\b", re.I)),
    ("ada", re.compile(r"\b(?:RTX\s*40\d{2}|RTX\s+\d+\s+Ada|L40S?|L4)\b", re.I)),
    ("ampere", re.compile(r"\b(?:RTX\s*30\d{2}|RTX\s+A\d{3,4}|A100|A40|A30|A16|A10G?|A2)\b", re.I)),
    ("turing", re.compile(r"\b(?:RTX\s*20\d{2}|GTX\s*16\d{2}|T[456]00|T1[02]00|T2000|Quadro\s+RTX|Tesla\s+T4)\b", re.I)),
    ("volta", re.compile(r"\b(?:TITAN\s+V|Quadro\s+GV100|Tesla\s+V100)\b", re.I)),
    ("pascal", re.compile(r"\b(?:GTX\s*10\d{2}|GT\s*10\d{2}|MX[1234]50|MX130|MX230|MX330|TITAN\s+X(?:p)?|Quadro\s+P\d+|Tesla\s+P\d+)\b", re.I)),
    ("maxwell", re.compile(r"\b(?:GTX\s*(?:9\d{2}|750|745|860M|850M)|GT\s*9\d{2}M?|MX110|Quadro\s+M\d+|Tesla\s+M\d+)\b", re.I)),
    ("kepler", re.compile(r"\b(?:GTX\s*(?:6\d{2}|7[678]\d|TITAN(?:\s+Black|\s+Z)?)|GT\s*(?:6[34]0|7[1234]0)|Quadro\s+K\d+|Tesla\s+K\d+)\b", re.I)),
    ("fermi", re.compile(r"\b(?:GTX\s*(?:4\d{2}|5\d{2})|GT\s*(?:4\d{2}|5\d{2}|6[12]0)|Quadro\s+[2456]000|Tesla\s+[CM]20\d{2})\b", re.I)),
)

# DMI chassis_type values corresponding to portable/laptop form factors (SMBIOS 3.x).
LAPTOP_CHASSIS_TYPES = frozenset({8, 9, 10, 11, 14, 30, 31, 32})

