#!/bin/sh
# Ask process 1 (init) for a clean power-off (SIGUSR2 -> shutdown_request). A
# system job that runs (tools/JOBS.md) is waited for first; -f/--force powers
# off without waiting: systemd's immediate power-off signal, SIGRTMIN+14,
# by number (48: glibc's SIGRTMIN is 34), still ending everything cleanly.
set -eu
if [ "$(id -u)" -ne 0 ]; then
    exec sudo /usr/local/bin/poweroff "$@"
fi
case "$*" in
    '')
        active=""
        for ev in /sys/fs/cgroup/locachy-jobs/job-*/cgroup.events; do
            [ -r "$ev" ] || continue
            if grep -qx 'populated 1' "$ev" 2>/dev/null; then
                jid=${ev#/sys/fs/cgroup/locachy-jobs/job-}
                jid=${jid%/cgroup.events}
                kind=$(sed -n 's/^kind=//p' "/run/locachy/jobs/$jid.state" 2>/dev/null | head -n 1)
                active="job $jid${kind:+ ($kind)}"
                break
            fi
        done
        if [ -n "$active" ]; then
            echo "poweroff: queued; init will wait for $active to finish (use poweroff --force to power off now)." >&2
        else
            echo "poweroff: requested." >&2
        fi
        exec kill -USR2 1
        ;;
    -f | --force)
        echo "poweroff: immediate power off requested." >&2
        exec kill -s 48 1
        ;;
    *) echo 'usage: poweroff [--force]' >&2; exit 2 ;;
esac
