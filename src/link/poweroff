#!/bin/sh
# Ask process 1 (init) for a clean power-off (SIGUSR2 -> shutdown_request). A
# system job that runs (tools/JOBS.md) is waited for first; -f/--force powers
# off without waiting: systemd's immediate power-off signal, SIGRTMIN+14,
# by number (48: glibc's SIGRTMIN is 34), still ending everything cleanly.
set -eu
if [ "$(id -u)" -ne 0 ]; then
    exec sudo /usr/local/bin/poweroff "$@"
fi
case "$*" in
    '') exec kill -USR2 1 ;;
    -f | --force) exec kill -s 48 1 ;;
    *) echo 'usage: poweroff [--force]' >&2; exit 2 ;;
esac
