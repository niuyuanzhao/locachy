# linux/rtnetlink.h: RTMGRP_LINK | RTMGRP_IPV4_IFADDR | RTMGRP_IPV6_IFADDR.
ADDR_EVENTS = 0x1 | 0x10 | 0x100
USER_RE = re.compile(r"^[a-z_][a-z0-9_-]*[$]?$")
IFNAME_RE = re.compile(r"^[A-Za-z0-9._:+-]{1,15}$")
KEY_TYPE_PREFIXES = ("ssh-", "ecdsa-sha2-", "sk-ssh-", "sk-ecdsa-sha2-")
KEY_TYPE_RE = re.compile(r"^[a-z0-9@._-]+$")
KEY_BODY_RE = re.compile(r"^[A-Za-z0-9+/=]+$")
RC_LINE_RE = re.compile(r'^[ \t]*([A-Za-z0-9_]+)="([^"\n]*)"[ \t]*(?:#.*)?$')
EXCLUDED_LAN_IFACES = frozenset(("lo", DEVICE, "mihomo"))
PENDING_MAX_BYTES = 65536
RECEIVE_TOKEN_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
RECEIVE_TOKEN_LEN = 6
RECEIVE_DEFAULT_TIMEOUT = 120
RECEIVE_MAX_TIMEOUT = 600
RECEIVE_MAX_HEADERS = 8192
RECEIVE_MAX_BODY = 4096
RECEIVE_MAX_FAILURES = 5
RECEIVE_CONN_TIMEOUT = 5.0
PR_SET_NO_NEW_PRIVS = 38


def log(message):
    print(f"tailnet-ssh-client: {message}", file=sys.stderr, flush=True)


def owned(info, kind, forbidden):
    return (kind(info.st_mode) and info.st_uid == info.st_gid == 0
            and not info.st_mode & forbidden)


def trusted_dir(path):
    return owned(path.lstat(), stat.S_ISDIR, 0o022)


def valid_user(user):
    return (bool(user) and len(user) <= 32 and not user.startswith(".")
            and "/" not in user and user != "root"
            and USER_RE.fullmatch(user) is not None)


def read_rc(path=None):
    rc_path = RC if path is None else Path(path)
    values = {}
    try:
        text = rc_path.read_text(encoding="utf-8", errors="replace")
    except FileNotFoundError:
        text = ""
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        match = RC_LINE_RE.match(line)
        if match:
            values[match.group(1)] = match.group(2)

    listen = values.get("ssh_listen", "tailscale")
    if listen not in ("tailscale", "lan"):
        listen = "tailscale"

    port = PORT
    raw_port = values.get("ssh_port", "")
    if raw_port.isascii() and raw_port.isdecimal():
        parsed = int(raw_port)
        if 1 <= parsed <= 65535:
            port = parsed

    password_auth = values.get("ssh_password") == "1"
    return listen, port, password_auth


def ensure_dirs():
    if not trusted_dir(BASE.parent):
        raise RuntimeError(f"unsafe SSH configuration parent: {BASE.parent}")
    # The unprivileged key lookup must be able to traverse both directories.
    for directory in (BASE, KEYS):
        try:
            directory.mkdir(mode=0o700)
        except FileExistsError:
            pass
        else:
            directory.chmod(0o755)
        if not trusted_dir(directory):
            raise RuntimeError(f"unsafe SSH configuration directory: {directory}")


def ensure_host_key():
    ensure_dirs()
    try:
        info = HOST_KEY.lstat()
    except FileNotFoundError:
        if os.path.lexists(HOST_PUBLIC_KEY):
            raise RuntimeError(f"public key exists without its SSH host private key: {HOST_KEY}")
        # Generate on the installed node, not at build time. Generate in a
        # private staging directory and publish the private key atomically.
        with tempfile.TemporaryDirectory(prefix=".key-", dir=BASE) as staging:
            private = Path(staging) / HOST_KEY.name
            checked("ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", str(private),
                    stdin=subprocess.DEVNULL)
            info = private.lstat()
            if not owned(info, stat.S_ISREG, 0o177):
                raise RuntimeError(f"ssh-keygen created an unsafe host key: {private}")
            os.link(private, HOST_KEY)
    if not owned(info, stat.S_ISREG, 0o177):
        raise RuntimeError(f"unsafe SSH host key: {HOST_KEY}")


def _fingerprint_pubkey(pubkey_line):
    proc = checked("ssh-keygen", "-l", "-E", "sha256", "-f", "-",
                   input=pubkey_line + "\n", stdout=subprocess.PIPE,
                   stderr=subprocess.PIPE, text=True)
    lines = [line.strip() for line in proc.stdout.splitlines() if line.strip()]
    if len(lines) != 1:
        raise ValueError("expected a single public key")
    parts = lines[0].split()
    if len(parts) < 3 or not parts[1].startswith("SHA256:"):
        raise ValueError("unrecognized ssh-keygen fingerprint output")
    return parts[1]


def _parse_pubkey_line(line, allow_tab=False):
    for ch in line:
        code = ord(ch)
        if code == 0x7f or (code < 0x20 and not (allow_tab and ch == "\t")):
            raise ValueError("SSH public key contains control characters")
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        raise ValueError("empty SSH public key")
    tokens = stripped.split(None, 2)
    if len(tokens) < 2:
        raise ValueError("malformed SSH public key")
    key_type, key_body = tokens[0], tokens[1]
    if (not key_type.startswith(KEY_TYPE_PREFIXES)
            or KEY_TYPE_RE.fullmatch(key_type) is None
            or KEY_BODY_RE.fullmatch(key_body) is None):
        raise ValueError("unsupported or malformed SSH public key")
    fingerprint = _fingerprint_pubkey(stripped)
    comment = tokens[2].replace("\t", " ") if len(tokens) > 2 else ""
    canonical = f"{key_type} {key_body} {comment}" if comment else f"{key_type} {key_body}"
    return {
        "line": canonical,
        "type": key_type,
        "body": key_body,
        "fingerprint": fingerprint,
        "comment": comment,
    }


def _read_user_keys_raw(user):
    if not valid_user(user):
        raise ValueError(f"invalid SSH user: {user!r}")
    try:
        if not all(map(trusted_dir, (BASE.parent, BASE, KEYS))):
            raise RuntimeError(f"unsafe SSH key directories under {BASE}")
    except FileNotFoundError:
        return None
    try:
        fd = os.open(KEYS / user, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, "rb") as source:
        if not owned(os.fstat(fd), stat.S_ISREG, 0o022):
            raise RuntimeError(f"unsafe SSH authorized_keys file: {KEYS / user}")
        return source.read().decode("utf-8", errors="replace")


def _write_user_keys_atomic(user, lines):
    target = KEYS / user
    if os.path.lexists(target):
        info = target.lstat()
        if not owned(info, stat.S_ISREG, 0o022):
            raise RuntimeError(f"unsafe SSH authorized_keys file: {target}")
    if not lines:
        try:
            target.unlink()
        except FileNotFoundError:
            pass
        return
    fd, tmp_name = tempfile.mkstemp(prefix=f".{user}.", dir=KEYS)
    try:
        with os.fdopen(fd, "wb") as out:
            payload = "".join(line + "\n" for line in lines).encode("utf-8")
            out.write(payload)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(tmp_name, 0o644)
        os.replace(tmp_name, target)
    except BaseException:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass
        raise


def keys_list(user):
    raw = _read_user_keys_raw(user)
    if raw is None:
        return []
    entries = []
    for raw_line in raw.splitlines():
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        try:
            parsed = _parse_pubkey_line(stripped, allow_tab=True)
        except (ValueError, subprocess.SubprocessError):
            continue
        entries.append(parsed)
    return entries


def keys_add(user, raw_input):
    if not valid_user(user):
        raise ValueError(f"invalid SSH user: {user!r}")
    if raw_input.endswith("\r\n"):
        raw_input = raw_input[:-2]
    elif raw_input.endswith(("\n", "\r")):
        raw_input = raw_input[:-1]
    if "\n" in raw_input or "\r" in raw_input:
        raise ValueError("multiple lines are not allowed when adding an SSH key")
    parsed = _parse_pubkey_line(raw_input)
    ensure_dirs()
    existing = keys_list(user)
    for entry in existing:
        if entry["type"] == parsed["type"] and entry["body"] == parsed["body"]:
            return entry["fingerprint"]
    lines = [entry["line"] for entry in existing]
    lines.append(parsed["line"])
    _write_user_keys_atomic(user, lines)
    return parsed["fingerprint"]


def keys_add_file(user, file_path):
    if not valid_user(user):
        raise ValueError(f"invalid SSH user: {user!r}")
    if not file_path:
        raise ValueError("empty SSH public key file path")
    fd = os.open(file_path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise ValueError(f"SSH public key path is not a regular file: {file_path}")
        if info.st_size > PENDING_MAX_BYTES:
            raise ValueError("SSH public key file is too large")
        chunks = []
        total = 0
        while True:
            chunk = os.read(fd, min(8192, PENDING_MAX_BYTES + 1 - total))
            if not chunk:
                break
            total += len(chunk)
            if total > PENDING_MAX_BYTES:
                raise ValueError("SSH public key file is too large")
            chunks.append(chunk)
    finally:
        os.close(fd)
    try:
        text = b"".join(chunks).decode("utf-8")
    except UnicodeDecodeError as exc:
        raise ValueError("SSH public key file is not valid UTF-8") from exc
    key_lines = [line.strip() for line in text.splitlines() if line.strip() and not line.strip().startswith("#")]
    if len(key_lines) != 1:
        raise ValueError("SSH public key file must contain exactly one public key")
    return keys_add(user, key_lines[0])


def keys_remove(user, index):
    if not valid_user(user):
        raise ValueError(f"invalid SSH user: {user!r}")
    if not isinstance(index, int) or index < 1:
        raise ValueError("SSH key index must be a positive integer")
    ensure_dirs()
    existing = keys_list(user)
    if index > len(existing):
        raise ValueError(f"SSH key index out of range: {index}")
    remaining = [entry["line"] for i, entry in enumerate(existing, start=1) if i != index]
    _write_user_keys_atomic(user, remaining)


def _safe_read_user_file(home_dir, rel_parts, allowed_uids, max_bytes=PENDING_MAX_BYTES):
    """Walk directory components with O_DIRECTORY|O_NOFOLLOW and read a regular file safely."""
    home = os.path.normpath(str(home_dir))
    if not os.path.isabs(home):
        return None
    home_parts = [part for part in home.split(os.sep) if part]
    parts = home_parts + list(rel_parts)
    if not parts:
        return None
    check_dir_from = max(0, len(home_parts) - 1)
    dir_fd = -1
    file_fd = -1
    try:
        dir_fd = os.open(os.sep, os.O_RDONLY | os.O_DIRECTORY)
        for idx, comp in enumerate(parts[:-1]):
            next_fd = os.open(comp, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dir_fd)
            os.close(dir_fd)
            dir_fd = next_fd
            if idx >= check_dir_from:
                dinfo = os.fstat(dir_fd)
                if dinfo.st_uid not in allowed_uids or bool(dinfo.st_mode & 0o002):
                    return None
        file_fd = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
        info = os.fstat(file_fd)
        if (not stat.S_ISREG(info.st_mode)
                or info.st_uid not in allowed_uids
                or bool(info.st_mode & 0o002)
                or info.st_size > max_bytes):
            return None
        chunks = []
        total = 0
        while True:
            chunk = os.read(file_fd, min(8192, max_bytes + 1 - total))
            if not chunk:
                break
            total += len(chunk)
            if total > max_bytes:
                return None
            chunks.append(chunk)
        return b"".join(chunks).decode("utf-8", errors="replace")
    except OSError:
        return None
    finally:
        if file_fd >= 0:
            os.close(file_fd)
        if dir_fd >= 0:
            os.close(dir_fd)


def keys_pending(user):
    if not valid_user(user):
        raise ValueError(f"invalid SSH user: {user!r}")
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        return []
    raw = _safe_read_user_file(pw.pw_dir, (".ssh", "authorized_keys"), {pw.pw_uid, 0})
    if raw is None:
        return []
    seen = set()
    try:
        for entry in keys_list(user):
            seen.add((entry["type"], entry["body"]))
    except (OSError, RuntimeError):
        pass
    pending = []
    for raw_line in raw.splitlines():
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        try:
            parsed = _parse_pubkey_line(stripped, allow_tab=True)
        except (ValueError, subprocess.SubprocessError):
            continue
        ident = (parsed["type"], parsed["body"])
        if ident in seen:
            continue
        seen.add(ident)
        pending.append(parsed)
    return pending


def _format_host_port(addr, port):
    host = str(addr) if addr.version == 4 else f"[{addr}]"
    return f"{host}:{port}"


def enroll_filter_rules(bound=()):
    lines = [
        f"flush set inet {FILTER_TABLE} ssh_enroll_v4\n",
        f"flush set inet {FILTER_TABLE} ssh_enroll_v6\n",
    ]
    v4 = []
    v6 = []
    for ifname, addr, port in bound:
        if ifname in (DEVICE, "lo"):
            continue
        if IFNAME_RE.fullmatch(ifname) is None:
            raise ValueError(f"unsafe interface name: {ifname!r}")
        _check_port(port)
        elem = f'"{ifname}" . {addr} . {port}'
        if addr.version == 4:
            v4.append(elem)
        else:
            v6.append(elem)
    if v4:
        lines.append(f"add element inet {FILTER_TABLE} ssh_enroll_v4 {{ {', '.join(v4)} }}\n")
    if v6:
        lines.append(f"add element inet {FILTER_TABLE} ssh_enroll_v6 {{ {', '.join(v6)} }}\n")
    return "".join(lines)


def _enroll_sets_exist():
    for name in ("ssh_enroll_v4", "ssh_enroll_v6"):
        try:
            proc = subprocess.run(("nft", "list", "set", "inet", FILTER_TABLE, name),
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                  timeout=5, check=False)
        except OSError:
            return False
        if proc.returncode != 0:
            return False
    return True


def enroll_firewall(bound=()):
    if _enroll_sets_exist():
        checked("nft", "-f", "-", input=enroll_filter_rules(bound), text=True)


def _select_receive_url(bound_sockets, token):
    # Prefer tailscale0 IPv4, then any IPv4, then tailscale0 IPv6, then any IPv6.
    ranked = sorted(
        bound_sockets,
        key=lambda item: (
            0 if item[0] == DEVICE and item[1].version == 4 else
            1 if item[1].version == 4 else
            2 if item[0] == DEVICE else 3,
            item[0],
            int(item[1]),
        ),
    )
    _ifname, addr, port, _sock = ranked[0]
    return f"http://{_format_host_port(addr, port)}/{token}"


def _receive_bind_targets(listen_mode):
    override = os.environ.get("LOCACHY_SSH_BIND_ADDR", "").strip()
    if override:
        targets = []
        for raw in override.split(","):
            raw = raw.strip()
            if not raw:
                continue
            addr = ipaddress.ip_address(raw)
            if addr.is_unspecified or addr.is_multicast:
                raise ValueError(f"unsafe bind address for SSH key receive: {addr}")
            if os.geteuid() != 0 and not addr.is_loopback:
                raise RuntimeError("non-loopback SSH key receive requires root privileges")
            targets.append(("lo" if addr.is_loopback else DEVICE, addr))
        return tuple(targets)
    return addresses(listen_mode)


def _drop_worker_privileges():
    if os.geteuid() == 0:
        try:
            os.setgroups([])
        except OSError:
            pass
        os.setgid(65534)
        os.setuid(65534)
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        prctl = libc.prctl
        prctl.argtypes = [ctypes.c_int, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong]
        prctl.restype = ctypes.c_int
        prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0)
    except (OSError, AttributeError):
        pass


def _http_reply(conn, status, body):
    data = body.encode("utf-8")
    payload = (
        f"HTTP/1.1 {status}\r\n"
        f"Content-Type: text/plain; charset=utf-8\r\n"
        f"Content-Length: {len(data)}\r\n"
        f"Connection: close\r\n\r\n"
    ).encode("ascii") + data
    try:
        conn.sendall(payload)
    except OSError:
        pass


def _read_http_request(conn, expected_path):
    conn.settimeout(RECEIVE_CONN_TIMEOUT)
    buf = bytearray()
    header_end = -1
    while header_end < 0:
        chunk = conn.recv(4096)
        if not chunk:
            return None, "400 Bad Request", "Incomplete HTTP request.\n"
        buf.extend(chunk)
        header_end = buf.find(b"\r\n\r\n")
        if header_end < 0 and len(buf) > RECEIVE_MAX_HEADERS:
            return None, "431 Request Header Fields Too Large", "Request headers too large.\n"
    if header_end > RECEIVE_MAX_HEADERS:
        return None, "431 Request Header Fields Too Large", "Request headers too large.\n"

    head_bytes = bytes(buf[:header_end])
    body_buf = bytearray(buf[header_end + 4:])
    try:
        head_lines = head_bytes.decode("iso-8859-1").split("\r\n")
    except UnicodeDecodeError:
        return None, "400 Bad Request", "Invalid HTTP headers.\n"
    if not head_lines:
        return None, "400 Bad Request", "Empty HTTP request.\n"
    req_parts = head_lines[0].split(" ")
    if len(req_parts) != 3 or not req_parts[2].startswith("HTTP/1."):
        return None, "400 Bad Request", "Malformed HTTP request line.\n"
    method, target, _version = req_parts
    headers = {}
    for line in head_lines[1:]:
        if ":" not in line:
            return None, "400 Bad Request", "Malformed HTTP header.\n"
        name, value = line.split(":", 1)
        lname = name.strip().lower()
        val = value.strip()
        if lname == "content-length" and lname in headers:
            return None, "400 Bad Request", "Duplicate Content-Length header.\n"
        headers[lname] = val

    if method not in ("PUT", "POST"):
        return None, "405 Method Not Allowed", "Use PUT or POST.\n"

    req_path = target.split("?", 1)[0]
    if not hmac.compare_digest(req_path, expected_path):
        return None, "403 Forbidden", "Invalid token.\n"

    if "transfer-encoding" in headers:
        return None, "411 Length Required", "Chunked transfer encoding is not supported.\n"
    raw_len = headers.get("content-length")
    if raw_len is None or not (raw_len.isascii() and raw_len.isdecimal()):
        return None, "411 Length Required", "Content-Length header is required.\n"
    content_length = int(raw_len)
    if content_length > RECEIVE_MAX_BODY:
        return None, "413 Payload Too Large", "Public key payload exceeds 4096 bytes.\n"

    expect = headers.get("expect", "").lower()
    if "100-continue" in expect and len(body_buf) < content_length:
        try:
            conn.sendall(b"HTTP/1.1 100 Continue\r\n\r\n")
        except OSError:
            return None, None, None

    while len(body_buf) < content_length:
        chunk = conn.recv(min(4096, content_length - len(body_buf)))
        if not chunk:
            return None, "400 Bad Request", "Incomplete request body.\n"
        body_buf.extend(chunk)
    body = bytes(body_buf[:content_length])
    return (method, target, body), None, None


def _receive_worker(listeners, token, to_parent_fd, from_parent_fd, deadline):
    _drop_worker_privileges()
    failures = 0
    expected_path = "/" + token
    try:
        with os.fdopen(to_parent_fd, "w", encoding="utf-8", buffering=1) as to_parent, \
                os.fdopen(from_parent_fd, "r", encoding="utf-8") as from_parent:
            while failures < RECEIVE_MAX_FAILURES:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return
                try:
                    ready, _, _ = select.select(listeners, [], [], min(remaining, 0.5))
                except InterruptedError:
                    continue
                except OSError:
                    return
                for sock in ready:
                    try:
                        conn, peer = sock.accept()
                    except OSError:
                        continue
                    peer_ip = peer[0]
                    with conn:
                        try:
                            req, err_status, err_body = _read_http_request(conn, expected_path)
                        except (socket.timeout, OSError):
                            failures += 1
                            if failures >= RECEIVE_MAX_FAILURES:
                                return
                            continue
                        if req is None:
                            if err_status:
                                _http_reply(conn, err_status, err_body)
                            failures += 1
                            if failures >= RECEIVE_MAX_FAILURES:
                                return
                            continue
                        _method, _target, body_bytes = req
                        try:
                            body_text = body_bytes.decode("utf-8")
                        except UnicodeDecodeError:
                            _http_reply(conn, "400 Bad Request", "Invalid UTF-8 public key.\n")
                            failures += 1
                            if failures >= RECEIVE_MAX_FAILURES:
                                return
                            continue
                        msg = json.dumps({"peer_ip": peer_ip, "body": body_text}) + "\n"
                        try:
                            to_parent.write(msg)
                            to_parent.flush()
                            reply_line = from_parent.readline()
                        except OSError:
                            return
                        if not reply_line:
                            return
                        reply = json.loads(reply_line)
                        _http_reply(conn, reply["status"], reply["body"])
                        if reply.get("accepted"):
                            return
                        failures += 1
                        if failures >= RECEIVE_MAX_FAILURES:
                            return
    finally:
        for sock in listeners:
            try:
                sock.close()
            except OSError:
                pass


def _parse_received_pubkey(raw_body):
    lines = [line.strip() for line in raw_body.splitlines() if line.strip() and not line.strip().startswith("#")]
    if len(lines) != 1:
        raise ValueError("expected exactly one SSH public key")
    return _parse_pubkey_line(lines[0], allow_tab=True)


def receive_key(user, timeout=RECEIVE_DEFAULT_TIMEOUT):
    if not valid_user(user):
        raise ValueError(f"invalid SSH user: {user!r}")
    if not isinstance(timeout, int) or isinstance(timeout, bool) or not 1 <= timeout <= RECEIVE_MAX_TIMEOUT:
        raise ValueError(f"invalid receive timeout: {timeout!r}")

    listen_mode, _port, _password_auth = read_rc()
    targets = _receive_bind_targets(listen_mode)
    if not targets:
        raise RuntimeError(f"no listen addresses available for SSH key receive ({listen_mode})")
    use_enroll_fw = listen_mode == "lan" and os.environ.get("LOCACHY_SSH_NO_NETNS") != "1"

    bound_sockets = []
    seen_addrs = set()
    try:
        for ifname, addr in targets:
            if addr in seen_addrs:
                continue
            family = socket.AF_INET if addr.version == 4 else socket.AF_INET6
            sock = socket.socket(family, socket.SOCK_STREAM)
            try:
                sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                if family == socket.AF_INET6:
                    sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
                sock.bind((str(addr), 0))
                sock.listen(4)
                port = sock.getsockname()[1]
                bound_sockets.append((ifname, addr, port, sock))
                seen_addrs.add(addr)
            except OSError:
                sock.close()
                if not bound_sockets and addr == targets[-1][1]:
                    raise
        if not bound_sockets:
            raise RuntimeError("failed to bind any SSH key receive socket")

        token = "".join(secrets.choice(RECEIVE_TOKEN_ALPHABET) for _ in range(RECEIVE_TOKEN_LEN))
        enroll_tuples = tuple((ifname, addr, port) for ifname, addr, port, _sock in bound_sockets)
        if use_enroll_fw:
            enroll_firewall(enroll_tuples)

        p2c_r, p2c_w = os.pipe()
        c2p_r, c2p_w = os.pipe()
        deadline = time.monotonic() + timeout
        sys.stdout.flush()
        sys.stderr.flush()
        try:
            pid = os.fork()
        except OSError:
            for fd in (p2c_r, p2c_w, c2p_r, c2p_w):
                os.close(fd)
            raise
        if pid == 0:
            signal.signal(signal.SIGTERM, signal.SIG_DFL)
            signal.signal(signal.SIGINT, signal.SIG_DFL)
            os.close(p2c_w)
            os.close(c2p_r)
            listeners = [sock for _ifname, _addr, _port, sock in bound_sockets]
            try:
                _receive_worker(listeners, token, c2p_w, p2c_r, deadline)
            finally:
                os._exit(0)

        os.close(p2c_r)
        os.close(c2p_w)
        for _ifname, _addr, _port, sock in bound_sockets:
            sock.close()
        bound_sockets.clear()

        url = _select_receive_url([(ifname, addr, port, None) for ifname, addr, port in enroll_tuples], token)
        print(f"READY\t{url}\t{timeout}", flush=True)

        interrupted = False

        def _on_stop(_signum, _frame):
            nonlocal interrupted
            interrupted = True

        old_term = signal.signal(signal.SIGTERM, _on_stop)
        old_int = signal.signal(signal.SIGINT, _on_stop)
        try:
            with os.fdopen(c2p_r, "r", encoding="utf-8") as from_child, \
                    os.fdopen(p2c_w, "w", encoding="utf-8", buffering=1) as to_child:
                while not interrupted:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        return 124
                    try:
                        ready, _, _ = select.select([from_child], [], [], min(remaining, 0.1))
                    except InterruptedError:
                        continue
                    if not ready:
                        done_pid, _status = os.waitpid(pid, os.WNOHANG)
                        if done_pid == pid:
                            pid = -1
                            return 124 if time.monotonic() >= deadline else 1
                        continue
                    line = from_child.readline()
                    if not line:
                        return 124 if time.monotonic() >= deadline else 1
                    req = json.loads(line)
                    peer_ip = str(req.get("peer_ip", "")).replace("\t", " ").replace("\n", " ")
                    raw_body = req.get("body", "")
                    try:
                        parsed = _parse_received_pubkey(raw_body)
                    except (ValueError, subprocess.SubprocessError) as exc:
                        reply = {
                            "accepted": False,
                            "status": "400 Bad Request",
                            "body": f"Invalid SSH public key: {exc}\n",
                        }
                        to_child.write(json.dumps(reply) + "\n")
                        to_child.flush()
                        continue
                    reply = {
                        "accepted": True,
                        "status": "200 OK",
                        "body": f"Received {parsed['fingerprint']} — confirm on LOCachy screen.\n",
                    }
                    try:
                        to_child.write(json.dumps(reply) + "\n")
                        to_child.flush()
                    except OSError:
                        pass
                    # Wait briefly for the worker to flush its HTTP 200 reply before tearing down.
                    flush_deadline = time.monotonic() + 1.0
                    while time.monotonic() < flush_deadline:
                        try:
                            done_pid, _status = os.waitpid(pid, os.WNOHANG)
                        except ChildProcessError:
                            pid = -1
                            break
                        if done_pid == pid:
                            pid = -1
                            break
                        time.sleep(0.01)
                    print(
                        f"KEY\t{peer_ip}\t{parsed['type']}\t{parsed['fingerprint']}"
                        f"\t{parsed['comment']}\t{parsed['line']}",
                        flush=True,
                    )
                    return 0
                return 130
        finally:
            signal.signal(signal.SIGTERM, old_term)
            signal.signal(signal.SIGINT, old_int)
            if pid > 0:
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                wait_deadline = time.monotonic() + 2.0
                while True:
                    try:
                        done_pid, _status = os.waitpid(pid, os.WNOHANG)
                    except ChildProcessError:
                        break
                    if done_pid == pid:
                        break
                    if time.monotonic() >= wait_deadline:
                        try:
                            os.kill(pid, signal.SIGKILL)
                        except ProcessLookupError:
                            pass
                        try:
                            os.waitpid(pid, 0)
                        except ChildProcessError:
                            pass
                        break
                    time.sleep(0.02)
    finally:
        for _ifname, _addr, _port, sock in bound_sockets:
            try:
                sock.close()
            except OSError:
                pass
        if use_enroll_fw:
            try:
                enroll_firewall(())
            except (OSError, subprocess.SubprocessError):
                pass


def host_key_fingerprint():
    try:
        if not all(map(trusted_dir, (BASE.parent, BASE))):
            raise RuntimeError(f"unsafe SSH configuration directories under {BASE}")
        info = HOST_KEY.lstat()
    except FileNotFoundError:
        return ""
    if not owned(info, stat.S_ISREG, 0o177):
        raise RuntimeError(f"unsafe SSH host key: {HOST_KEY}")
    pub = checked("ssh-keygen", "-y", "-f", str(HOST_KEY),
                  stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                  stderr=subprocess.PIPE, text=True).stdout.strip()
    return _fingerprint_pubkey(pub)


def host_key_regen(notify=True):
    ensure_dirs()
    if os.path.lexists(HOST_KEY) and not stat.S_ISREG(HOST_KEY.lstat().st_mode):
        raise RuntimeError(f"unsafe SSH host key path: {HOST_KEY}")
    with tempfile.TemporaryDirectory(prefix=".key-", dir=BASE) as staging:
        private = Path(staging) / HOST_KEY.name
        checked("ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", str(private),
                stdin=subprocess.DEVNULL)
        os.chmod(private, 0o600)
        info = private.lstat()
        if not owned(info, stat.S_ISREG, 0o177):
            raise RuntimeError(f"ssh-keygen created an unsafe host key: {private}")
        os.replace(private, HOST_KEY)
    try:
        HOST_PUBLIC_KEY.unlink()
    except FileNotFoundError:
        pass
    fp = host_key_fingerprint()
    if notify:
        signal_reload()
    return fp


def _pid_is_supervisor(pid):
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return False
    args = [part.decode("utf-8", errors="replace") for part in cmdline.split(b"\0") if part]
    if not args:
        return False
    return (any(os.path.basename(arg) == os.path.basename(CLIENT) for arg in args)
            and "--serve" in args)


def signal_reload():
    try:
        if not owned(RUN.lstat(), stat.S_ISDIR, 0o077):
            return False
        fd = os.open(PIDFILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        with os.fdopen(fd, "r", encoding="utf-8", errors="replace") as f:
            if not owned(os.fstat(f.fileno()), stat.S_ISREG, 0o177):
                return False
            raw = f.read().strip()
    except OSError:
        return False
    if not (raw.isascii() and raw.isdecimal()):
        return False
    pid = int(raw)
    if pid <= 1 or not _pid_is_supervisor(pid):
        return False
    try:
        os.kill(pid, signal.SIGHUP)
        return True
    except ProcessLookupError:
        return False


def authorized_keys(user, uid):
    # OpenSSH runs this as nobody. Only regular local accounts, and only the
    # explicitly enrolled file; never fall back to a user's own authorized_keys.
    if (not valid_user(user) or not (uid.isascii() and uid.isdecimal())
            or not 1000 <= int(uid) <= 60000):
        return
    try:
        if not all(map(trusted_dir, (BASE.parent, BASE, KEYS))):
            return
        fd = os.open(KEYS / user, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as source:
            if owned(os.fstat(fd), stat.S_ISREG, 0o022):
                shutil.copyfileobj(source, sys.stdout.buffer)
    except OSError:
        pass  # No enrollment, inaccessible file, or unsafe path: no keys.


def checked(*argv, **kwargs):
    return subprocess.run(argv, check=True, timeout=5, **kwargs)


def iface_driver(ifname):
    drv = Path(f"/sys/class/net/{ifname}/device/driver")
    try:
        return os.path.basename(os.path.realpath(drv)) if drv.exists() else ""
    except OSError:
        return ""


def addresses(listen_mode="tailscale"):
    # Dump all links so a normal missing device is not confused with an ip
    # failure. Do not infer our addresses from the host routing table or DNS.
    links = json.loads(checked("ip", "-j", "address", "show", stdout=subprocess.PIPE).stdout)
    result = set()
    for link in links:
        ifname = link.get("ifname", "")
        if not ifname or IFNAME_RE.fullmatch(ifname) is None or "UP" not in link.get("flags", ()):
            continue
        is_tailscale = ifname == DEVICE
        if not is_tailscale:
            if listen_mode != "lan":
                continue
            if ifname in EXCLUDED_LAN_IFACES or iface_driver(ifname) == "thunderbolt-net":
                continue
        for info in link.get("addr_info", ()):
            if info.get("scope") != "global" or any(
                info.get(flag) or flag in info.get("flags", ())
                for flag in ("tentative", "dadfailed")
            ):
                continue
            try:
                addr = ipaddress.ip_address(info["local"])
            except (KeyError, ValueError):
                continue
            if is_tailscale:
                if any(addr in prefix for prefix in PREFIXES):
                    result.add((ifname, addr))
            else:
                if (not addr.is_loopback and not addr.is_multicast
                        and not addr.is_link_local and not addr.is_unspecified):
                    result.add((ifname, addr))
    return tuple(sorted(result, key=lambda item: (item[0], item[1].version, int(item[1]))))


def _check_port(port):
    if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
        raise ValueError(f"invalid SSH port: {port!r}")


def firewall_rules(bound=(), port=PORT):
    _check_port(port)
    # Linux is a weak host: even an exact ListenAddress can be reached via
    # another interface. Reject there (including lo) before sshd starts. A
    # separate table survives network-client's atomic rebuild of its own table.
    text = f"destroy table inet {TABLE}\n"
    if bound:
        rules = []
        for ifname, addr in bound:
            if IFNAME_RE.fullmatch(ifname) is None:
                raise ValueError(f"unsafe interface name: {ifname!r}")
            family = "ip" if addr.version == 4 else "ip6"
            rules.append(f'  iifname != "{ifname}" {family} daddr {addr} tcp dport {port} drop\n')
        text += (f"table inet {TABLE} {{\n chain input {{\n"
                 "  type filter hook input priority filter; policy accept;\n"
                 + "".join(rules) + " }\n}\n")
    return text


def filter_sync_rules(bound=(), port=PORT):
    _check_port(port)
    lines = [
        f"flush set inet {FILTER_TABLE} ssh_lan_v4\n",
        f"flush set inet {FILTER_TABLE} ssh_lan_v6\n",
    ]
    v4 = []
    v6 = []
    for ifname, addr in bound:
        if ifname == DEVICE:
            continue
        if IFNAME_RE.fullmatch(ifname) is None:
            raise ValueError(f"unsafe interface name: {ifname!r}")
        elem = f'"{ifname}" . {addr} . {port}'
        if addr.version == 4:
            v4.append(elem)
        else:
            v6.append(elem)
    if v4:
        lines.append(f"add element inet {FILTER_TABLE} ssh_lan_v4 {{ {', '.join(v4)} }}\n")
    if v6:
        lines.append(f"add element inet {FILTER_TABLE} ssh_lan_v6 {{ {', '.join(v6)} }}\n")
    return "".join(lines)


def _filter_sets_exist():
    for name in ("ssh_lan_v4", "ssh_lan_v6"):
        proc = subprocess.run(("nft", "list", "set", "inet", FILTER_TABLE, name),
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=5, check=False)
        if proc.returncode != 0:
            return False
    return True


def firewall(bound=(), port=PORT):
    checked("nft", "-f", "-", input=firewall_rules(bound, port), text=True)
    if _filter_sets_exist():
        checked("nft", "-f", "-", input=filter_sync_rules(bound, port), text=True)


def ssh_config(bound, port=PORT, password_auth=False):
    if not bound:
        raise ValueError("refusing to configure OpenSSH without a listen address")
    _check_port(port)
    seen = set()
    listen_lines = []
    for _ifname, addr in bound:
        if addr in seen:
            continue
        seen.add(addr)
        host = str(addr) if addr.version == 4 else f"[{addr}]"
        listen_lines.append(f"ListenAddress {host}:{port}\n")
    if password_auth:
        auth_block = (
            "UsePAM yes\n"
            "PasswordAuthentication yes\n"
        )
    else:
        auth_block = (
            "UsePAM no\n"
            "PasswordAuthentication no\n"
            "AuthenticationMethods publickey\n"
        )
    return "".join(listen_lines) + f"""Port {port}
HostKey {HOST_KEY}
PidFile none
PermitRootLogin no
{auth_block}KbdInteractiveAuthentication no
PermitEmptyPasswords no
PubkeyAuthentication yes
HostbasedAuthentication no
GSSAPIAuthentication no
AuthorizedKeysFile none
AuthorizedKeysCommand {CLIENT} --authorized-keys %u %U
AuthorizedKeysCommandUser nobody
StrictModes yes
AllowTcpForwarding local
AllowStreamLocalForwarding no
AllowAgentForwarding no
GatewayPorts no
X11Forwarding no
PermitTunnel no
PermitUserRC no
PermitUserEnvironment no
UseDNS no
LogLevel VERBOSE
Subsystem sftp internal-sftp
"""


def drain(server):
    # OpenSSH PTYs and ordinary commands can setsid(), so a process-group
    # signal is insufficient, even when process 1 stops the service itself.
    if server is not None and server.poll() is None:
        server.terminate()
    (GROUP / "cgroup.kill").write_text("1\n")
    if server is not None:
        server.wait(timeout=5)
    deadline = time.monotonic() + 5
    while "populated 0" not in (GROUP / "cgroup.events").read_text().splitlines():
        if time.monotonic() >= deadline:
            raise RuntimeError("SSH cgroup did not drain; keeping its firewall in place")
        time.sleep(0.05)


def attach():
    # Called in the child, before exec and before it can fork any sessions.
    (GROUP / "cgroup.procs").write_text(str(os.getpid()) + "\n")


def identity(path):
    try:
        info = path.stat()
        return info.st_dev, info.st_ino
    except FileNotFoundError:
        return None


def _file_sig(path):
    try:
        info = path.stat()
        return info.st_dev, info.st_ino, info.st_mtime_ns, info.st_size
    except FileNotFoundError:
        return None


def _write_pidfile():
    fd, tmp_name = tempfile.mkstemp(prefix=".pid.", dir=RUN)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            os.fchmod(out.fileno(), 0o600)
            out.write(f"{os.getpid()}\n")
        os.replace(tmp_name, PIDFILE)
    except BaseException:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass
        raise


def _drain_pipe(fd):
    while True:
        try:
            data = os.read(fd, 4096)
            if not data:
                return
        except BlockingIOError:
            return


def serve():
    net_id = identity(NS)
    resolv_id = identity(RESOLVER)
    if not net_id or net_id != identity(Path("/proc/self/ns/net")) or not resolv_id:
        raise RuntimeError("not in locachy-net with its resolver")
    if not stat.S_ISREG(RESOLVER.lstat().st_mode):
        raise RuntimeError("locachy-net resolver is not a regular file")

    RUN.mkdir(mode=0o700, exist_ok=True)
    if not owned(RUN.lstat(), stat.S_ISDIR, 0o077):
        raise RuntimeError(f"unsafe runtime directory: {RUN}")
    with (RUN / "lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("another SSH supervisor already holds the service lock") from None
        supervise(net_id, resolv_id)


def supervise(net_id, resolv_id):
    global reloading
    GROUP.mkdir(exist_ok=True)
    drain(None)  # An interrupted supervisor may have left old sessions behind.
    firewall()
    server = None
    pidfd = None
    _write_pidfile()
    try:
        ensure_host_key()
        # This mount namespace has inherited the real host cgroup filesystem;
        # unlike ip netns exec, we never remount sysfs. The resolver bind does
        # not propagate to the host and follows openresolv's in-place writes.
        checked("mount", "--bind", str(RESOLVER), "/etc/resolv.conf")
        active = None
        last_rc_sig = None
        last_host_key_id = None
        sync_fw = False
        with open_netlink() as events:
            # Subscribe before the first snapshot, to avoid missing late addresses.
            pending = True
            log(f"waiting for listen addresses ({DEVICE})")
            while not stopping and net_id == identity(NS) and resolv_id == identity(RESOLVER):
                if pending:
                    reloading = False
                    last_rc_sig = _file_sig(RC)
                    listen_mode, port, password_auth = read_rc()
                    current_bound = addresses(listen_mode)
                    last_host_key_id = identity(HOST_KEY)
                    desired = (current_bound, port, password_auth, last_host_key_id)
                    if desired != active:
                        if server is not None:
                            drain(server)
                            os.close(pidfd)
                            pidfd = server = None
                        firewall(current_bound, port)
                        active = desired
                        if current_bound and not stopping:
                            ensure_host_key()
                            last_host_key_id = identity(HOST_KEY)
                            active = (current_bound, port, password_auth, last_host_key_id)
                            CONFIG.write_text(ssh_config(current_bound, port=port, password_auth=password_auth))
                            checked(SSHD, "-t", "-f", str(CONFIG))
                            server = subprocess.Popen((SSHD, "-D", "-e", "-f", str(CONFIG)),
                                                      preexec_fn=attach)
                            pidfd = os.pidfd_open(server.pid)
                        else:
                            CONFIG.unlink(missing_ok=True)
                    elif sync_fw:
                        firewall(current_bound, port)
                    pending = False
                    sync_fw = False
                ready, _, _ = select.select([wake_read, events] + ([] if pidfd is None else [pidfd]),
                                             [], [], 10)
                if wake_read in ready:
                    _drain_pipe(wake_read)
                    if stopping:
                        break
                    if reloading:
                        pending = True
                        sync_fw = True
                if pidfd is not None and pidfd in ready:
                    raise RuntimeError(f"OpenSSH listener exited ({server.wait()})")
                if events in ready:
                    try:
                        events.recv(65536)
                    except OSError as exc:
                        if exc.errno != errno.ENOBUFS:
                            raise
                    pending = True  # Reconcile after a notification or queue overflow.
                if not ready:
                    # Reconcile rc.conf and host key changes periodically without idle spawns.
                    if _file_sig(RC) != last_rc_sig or identity(HOST_KEY) != last_host_key_id:
                        pending = True
    finally:
        if pidfd is not None:
            os.close(pidfd)
        drain(server)
        firewall()
        CONFIG.unlink(missing_ok=True)
        PIDFILE.unlink(missing_ok=True)
        GROUP.rmdir()


def open_netlink():
    events = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, socket.NETLINK_ROUTE)
    events.bind((0, ADDR_EVENTS))
    return events


stopping = False
reloading = False


def stop(_signum, _frame):
    global stopping
    stopping = True


def reload_handler(_signum, _frame):
    global reloading
    reloading = True


def _need_netns_reexec():
    if os.environ.get("LOCACHY_SSH_NO_NETNS") == "1":
        return False
    net_id = identity(NS)
    if not net_id:
        raise RuntimeError(f"network namespace not available: {NS}")
    return net_id != identity(Path("/proc/self/ns/net"))


def _parse_receive_args(argv):
    if len(argv) < 2 or argv[0] != "--receive-key":
        raise ValueError("usage: --receive-key USER [--timeout SECS]")
    user = argv[1]
    timeout = RECEIVE_DEFAULT_TIMEOUT
    rest = argv[2:]
    if len(rest) == 2 and rest[0] == "--timeout":
        if not (rest[1].isascii() and rest[1].isdecimal()):
            raise ValueError(f"invalid receive timeout: {rest[1]!r}")
        timeout = int(rest[1])
    elif rest:
        raise ValueError("usage: --receive-key USER [--timeout SECS]")
    if not valid_user(user):
        raise ValueError(f"invalid SSH user: {user!r}")
    if not 1 <= timeout <= RECEIVE_MAX_TIMEOUT:
        raise ValueError(f"invalid receive timeout: {timeout!r}")
    return user, timeout


def main(argv):
    if len(argv) == 3 and argv[0] == "--authorized-keys":
        authorized_keys(argv[1], argv[2])
        return 0
    if len(argv) == 2 and argv[0] == "--keys-list":
        for idx, entry in enumerate(keys_list(argv[1]), start=1):
            print(f"{idx}\t{entry['type']}\t{entry['fingerprint']}\t{entry['comment']}")
        return 0
    if len(argv) == 2 and argv[0] == "--keys-pending":
        for idx, entry in enumerate(keys_pending(argv[1]), start=1):
            print(f"{idx}\t{entry['type']}\t{entry['fingerprint']}\t{entry['comment']}\t{entry['line']}")
        return 0
    if len(argv) == 1 and argv[0] == "--host-key-fingerprint":
        fp = host_key_fingerprint()
        if fp:
            print(fp)
        return 0
    if os.geteuid() != 0 and not (
        os.environ.get("LOCACHY_SSH_NO_NETNS") == "1"
        and os.environ.get("LOCACHY_SSH_BIND_ADDR", "").strip()
    ):
        raise RuntimeError("this operation requires root privileges")
    os.umask(0o077)
    if len(argv) >= 2 and argv[0] == "--receive-key":
        user, timeout = _parse_receive_args(argv)
        if _need_netns_reexec():
            exe = os.path.abspath(sys.argv[0]) if sys.argv and sys.argv[0] else CLIENT
            os.execvp("nsenter", ("nsenter", f"--net={NS}", "--", exe, "--receive-key",
                                  user, "--timeout", str(timeout)))
        return receive_key(user, timeout=timeout)
    if os.geteuid() != 0:
        raise RuntimeError("this operation requires root privileges")
    if len(argv) in (2, 3) and argv[0] == "--keys-add":
        if len(argv) == 3:
            fp = keys_add_file(argv[1], argv[2])
        else:
            raw_key = sys.stdin.read(65537)
            if len(raw_key) > 65536:
                raise ValueError("SSH public key input is too large")
            fp = keys_add(argv[1], raw_key)
        print(fp)
        return 0
    if len(argv) == 3 and argv[0] == "--keys-remove":
        if not (argv[2].isascii() and argv[2].isdecimal()):
            raise ValueError(f"invalid SSH key index: {argv[2]!r}")
        keys_remove(argv[1], int(argv[2]))
        return 0
    if len(argv) == 1 and argv[0] == "--host-key-regen":
        print(host_key_regen())
        return 0
    if len(argv) == 1 and argv[0] == "--reload":
        signal_reload()
        return 0
    if argv not in ([], ["--serve"]):
        raise RuntimeError("run as root from process 1's service_tailnet_ssh")
    if not argv:
        # Do not start anything on the host while the network service is late.
        while not NS.exists() or not RESOLVER.is_file():
            time.sleep(1)
        os.execvp("nsenter", ("nsenter", f"--net={NS}", "--", "unshare", "--mount",
                             "--propagation", "slave", "--", CLIENT, "--serve"))
    global wake_read
    wake_read, wake_write = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)
    signal.set_wakeup_fd(wake_write)
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, stop)
    signal.signal(signal.SIGHUP, reload_handler)
    serve()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as exc:
        log(exc)
        sys.exit(1)
