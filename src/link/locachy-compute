sys_pivot = 155 if os.uname().machine in ("x86_64", "amd64") else 41
MNT_DETACH = 2
PR_SET_NO_NEW_PRIVS = 38


def is_static_elf(path: str) -> bool:
    # A static ELF has no PT_INTERP and runs inside any guest distro rootfs.
    try:
        with open(path, "rb") as fh:
            ehdr = fh.read(64)
            if len(ehdr) < 64 or ehdr[:4] != b"\x7fELF" or ehdr[4] != 2:
                return False
            e_phoff = struct.unpack_from("<Q", ehdr, 32)[0]
            e_phentsize, e_phnum = struct.unpack_from("<HH", ehdr, 54)
            fh.seek(e_phoff)
            for _ in range(e_phnum):
                phdr = fh.read(e_phentsize)
                if len(phdr) < 4:
                    break
                if struct.unpack_from("<I", phdr, 0)[0] == 3:  # PT_INTERP
                    return False
            return True
    except OSError:
        return False


exec_app_init = False
if use_init:
    exec_app_init = is_static_elf(os.path.join(merged, "run/locachy-app-init"))

os.chdir(merged)
if libc.syscall(ctypes.c_long(sys_pivot), ctypes.c_char_p(b"."), ctypes.c_char_p(b".")) != 0:
    e = ctypes.get_errno()
    raise OSError(e, f"pivot_root failed: {os.strerror(e)}")
if libc.umount2(ctypes.c_char_p(b"."), MNT_DETACH) != 0:
    e = ctypes.get_errno()
    raise OSError(e, f"umount2 old root failed: {os.strerror(e)}")
os.chdir("/")
if os.path.isdir(workdir):
    os.chdir(workdir)

if exec_app_init:
    os.environ["LOCACHY_APP_READY_FD"] = str(ready_fd)
    os.execvp("/run/locachy-app-init", ["/run/locachy-app-init", *cmd])

# Foreign rootfs with a dynamic host app-init: use the same close-on-exec
# handshake with the workload and let PID namespace teardown reap stragglers.
exec_r, exec_w = os.pipe()
watched = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT)
mask = signal.pthread_sigmask(signal.SIG_BLOCK, watched)
pid = os.fork()
if pid == 0:
    os.close(exec_r)
    os.close(ready_fd)
    signal.pthread_sigmask(signal.SIG_SETMASK, mask)
    try:
        if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
            e = ctypes.get_errno()
            raise OSError(e, os.strerror(e))
        os.execvp(cmd[0], cmd)
    except (OSError, ValueError) as exc:
        print(f"locachy-compute: cannot execute {cmd[0]!r}: {exc}", file=sys.stderr)
        os.write(exec_w, b"error")
        os._exit(127 if isinstance(exc, FileNotFoundError) else 126)

os.close(exec_w)

def _fwd(signum, _frame):
    try:
        os.kill(pid, signum)
    except ProcessLookupError:
        pass

for sig in watched:
    signal.signal(sig, _fwd)
signal.pthread_sigmask(signal.SIG_SETMASK, mask)
if not os.read(exec_r, 1):
    os.write(ready_fd, b"ready\n")
os.close(exec_r)
os.close(ready_fd)

while True:
    wpid, status = os.waitpid(-1, 0)
    if wpid == pid:
        rc = os.waitstatus_to_exitcode(status)
        sys.exit(rc if rc >= 0 else 128 - rc)
' "$merged" "$workdir" "$use_init" "$ready_fd" "$@"
"""


def _job_cgroup_create(cg: Path, spec: dict) -> Path | None:
    try:
        cg.parent.mkdir(parents=True, exist_ok=True)
        cg.mkdir()
    except FileExistsError as exc:
        raise ComputeError(f"job cgroup already exists: {cg}") from exc
    except OSError as exc:
        if os.environ.get("LOCACHY_COMPUTE_ALLOW_NO_CGROUP") == "1":
            return None
        raise ComputeError(f"cannot create job cgroup {cg}: {exc}") from exc
    try:
        if not (cg / "cgroup.kill").is_file() or not (cg / "cgroup.procs").is_file():
            if os.environ.get("LOCACHY_COMPUTE_ALLOW_NO_CGROUP") == "1":
                cg.rmdir()
                return None
            raise ComputeError(f"not a cgroup v2 job directory: {cg}")
        for key, node in (("memory", "memory.max"), ("cpu", "cpu.max")):
            if spec[key] and (cg / node).exists():
                (cg / node).write_text(spec[key] + "\n", encoding="utf-8")
    except Exception:
        cg.rmdir()
        raise
    return cg


def _job_cgroup_cleanup(cg: Path) -> None:
    (cg / "cgroup.kill").write_text("1\n", encoding="utf-8")
    deadline = time.monotonic() + 2.0
    while True:
        try:
            cg.rmdir()
            return
        except OSError:
            if time.monotonic() >= deadline:
                raise
            time.sleep(0.05)


def _job_log_tail(path: Path) -> str:
    try:
        with path.open("rb") as log:
            log.seek(max(0, log.seek(0, os.SEEK_END) - 4096))
            return log.read().decode("utf-8", errors="replace").strip()
    except FileNotFoundError:
        return ""


def _supervise_job(spec: dict, reply=None) -> dict:
    """Own the record, child and cgroup until the final status has been committed."""
    rec = spec["record"]
    jid = rec["job_id"]
    path, log_path = Path(spec["path"]), Path(rec["log"])
    proc = None
    payload_fd = None
    cg = None
    stop_requested = False
    ready = False

    def send(sig: int) -> None:
        if payload_fd is not None:
            try:
                signal.pidfd_send_signal(payload_fd, sig)
            except ProcessLookupError:
                pass

    def request_stop(_sig, _frame) -> None:
        nonlocal stop_requested
        if not stop_requested:
            stop_requested = True
            if payload_fd is not None:
                send(signal.SIGTERM)
                signal.alarm(2)

    # This runs only in a single-purpose CLI process (never in an HTTP worker).
    for sig in (signal.SIGUSR1, signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, request_stop)
    signal.signal(signal.SIGALRM, lambda _sig, _frame: send(signal.SIGKILL))
    owner_fd = os.pidfd_open(os.getpid())
    try:
        info = os.fstat(owner_fd)
        rec["supervisor"] = {
            "pid": os.getpid(),
            "identity": [*_job_pid_identity(os.getpid()), info.st_dev, info.st_ino],
        }
    finally:
        os.close(owner_fd)
    try:
        _atomic_write_json(path, rec, exclusive=True)
    except FileExistsError as exc:
        raise ComputeError(f"job already exists: {jid}") from exc

    try:
        with open(log_path, "xb", opener=lambda p, flags: os.open(p, flags, 0o600)) as log:
            cg = _job_cgroup_create(Path(spec["cgroup"]), spec)
            if cg is not None:
                rec["cgroup"] = str(cg)
                if reply is not None:
                    # setsid covers terminal hangups; migrate out of the submitting
                    # service/session cgroup as well. Stay outside the payload cgroup.
                    supervisors = cg.parent / "supervisors"
                    try:
                        supervisors.mkdir(exist_ok=True)
                        (supervisors / "cgroup.procs").write_text(f"{os.getpid()}\n", encoding="utf-8")
                    except OSError as exc:
                        raise ComputeError(f"cannot enter independent supervisor cgroup {supervisors}: {exc}") from exc
            for sub in ("upper", "work", "merged"):
                (Path(spec["env_dir"]) / sub).mkdir(exist_ok=True)
            if stop_requested:
                raise ComputeError("stop requested before launch")

            def enter_cgroup() -> None:
                # Popen waits for exec, so the launcher cannot start before joining.
                try:
                    (cg / "cgroup.procs").write_text(f"{os.getpid()}\n", encoding="utf-8")
                except OSError as exc:
                    os.write(2, f"locachy-compute: cannot enter job cgroup {cg}: {exc}\n".encode())
                    raise

            ready_r, ready_w = os.pipe()
            try:
                try:
                    proc = subprocess.Popen(
                        [*spec["argv"], str(ready_w), *rec["command"]],
                        stdin=subprocess.DEVNULL if reply is not None else None,
                        stdout=log if reply is not None else subprocess.PIPE,
                        stderr=subprocess.STDOUT, env=spec["env"], pass_fds=(ready_w,),
                        preexec_fn=enter_cgroup if cg is not None else None,
                    )
                finally:
                    os.close(ready_w)
                rec["pid"] = proc.pid
                # Popen has not waited yet, so the PID still belongs to our child.
                payload_fd = os.pidfd_open(proc.pid)
                if stop_requested:
                    send(signal.SIGTERM)
                    signal.alarm(2)
                if proc.stdout is not None:
                    # The foreground output pipe must also be drained during startup.
                    output = proc.stdout
                else:
                    output = None
                with selectors.DefaultSelector() as sel:
                    sel.register(ready_r, selectors.EVENT_READ, "ready")
                    if output is not None:
                        sel.register(output, selectors.EVENT_READ, "output")
                    deadline = time.monotonic() + _JOB_START_TIMEOUT
                    while sel.get_map():
                        timeout = None if ready else max(0.0, deadline - time.monotonic())
                        events = sel.select(timeout)
                        if not ready and (not events or time.monotonic() >= deadline):
                            raise ComputeError("timed out before the container command started")
                        for key, _ in events:
                            chunk = os.read(key.fd, 65536)
                            if key.data == "ready":
                                sel.unregister(ready_r)
                                if chunk == b"ready\n":
                                    ready = True
                                    rec["state"] = "running"
                                    _atomic_write_json(path, rec)
                                    if reply is not None:
                                        reply(rec)
                                else:
                                    # No start marker means setup/exec failed, not a
                                    # successful launch followed by a nonzero exit.
                                    remaining = max(0.0, deadline - time.monotonic())
                                    try:
                                        proc.wait(timeout=remaining)
                                    except subprocess.TimeoutExpired as exc:
                                        raise ComputeError("launcher closed readiness before reporting startup") from exc
                                    raise ComputeError(f"container command did not start (launcher exit {proc.returncode})")
                            elif chunk:
                                log.write(chunk)
                                log.flush()
                                sys.stdout.buffer.write(chunk)
                                sys.stdout.buffer.flush()
                            else:
                                sel.unregister(key.fd)
                proc.wait()
            finally:
                os.close(ready_r)
                if proc is not None and proc.stdout is not None:
                    proc.stdout.close()
    except (ComputeError, OSError, subprocess.SubprocessError) as exc:
        if not ready:
            detail = _job_log_tail(log_path)
            rec["launch_error"] = f"job {jid}: {exc}" + (f"\n{detail}" if detail else "")
        else:
            rec["supervisor_error"] = f"job {jid}: {exc}"
    finally:
        if proc is not None:
            if proc.returncode is None:
                if payload_fd is not None:
                    send(signal.SIGKILL)
                else:
                    proc.kill()  # unreaped direct child, not a PID from disk
                proc.wait()
            rec["exit_code"] = proc.returncode
        signal.alarm(0)
        if payload_fd is not None:
            fd, payload_fd = payload_fd, None
            os.close(fd)
        if cg is not None:
            try:
                _job_cgroup_cleanup(cg)
            except OSError as exc:
                rec["cleanup_error"] = f"cannot remove job cgroup {cg}: {exc}"
        rec["state"] = "stopped" if stop_requested else "succeeded" if ready and rec["exit_code"] == 0 else "failed"
        rec["ended_at"] = _utc_now()
        _atomic_write_json(path, rec)
    return rec


def _job_supervisor_main() -> int:
    # The private request/reply pipes disappear once launch is acknowledged.
    # Losing the submitter after its complete request does not cancel the job.
    reply_fd = os.dup(sys.stdout.fileno())
    os.close(sys.stdout.fileno())

    def reply(payload: dict) -> None:
        nonlocal reply_fd
        if reply_fd < 0:
            return
        fd, reply_fd = reply_fd, -1
        try:
            pending = memoryview((json.dumps(payload) + "\n").encode("utf-8"))
            while pending:
                pending = pending[os.write(fd, pending):]
        except BrokenPipeError:
            pass
        finally:
            os.close(fd)

    try:
        spec = json.load(sys.stdin)
        sys.stdin.close()
        rec = _supervise_job(spec, reply)
        if "launch_error" in rec:
            reply({"error": rec["launch_error"]})
    except (ComputeError, OSError, ValueError) as exc:
        reply({"error": str(exc)})
        return 1
    return 0


def _prepare_container_launch(
    env_name: str,
    *,
    gpu_override: bool | None = None,
    net_override: str | None = None,
    extra_mounts: list[str] | None = None,
    extra_volumes: list[str] | None = None,
    workdir_override: str | None = None,
    extra_env: list[str] | None = None,
    memory_override: str | None = None,
    cpu_override: str | None = None,
    preserve_term: bool = False,
) -> dict:
    meta = env_load(env_name)
    edir = _env_dir(env_name)
    lower = compute_base() / "images" / meta["image"] / "rootfs"
    if not lower.is_dir():
        raise ComputeError(f"base image rootfs missing: {lower}")

    rc_vals = read_rc_conf()
    want_gpu = meta.get("gpu", False) if gpu_override is None else gpu_override
    if rc_vals.get("compute_gpu") == "0":
        want_gpu = False
    net_mode = meta.get("net", "locachy-net") if net_override is None else net_override
    if net_mode not in ("locachy-net", "none"):
        raise ComputeError(f"invalid network mode: {net_mode!r}")

    mounts = list(meta.get("mounts", []))
    for spec in extra_mounts or []:
        mounts.append(parse_mount_spec(spec))
    # Re-validate persisted mounts on every launch.
    mounts = [parse_mount_spec(f"{m['host']}:{m['target']}:{m['mode']}") for m in mounts]
    # Re-validate persisted and per-run --volume bindings (role & mounted state).
    for vol_rec in meta.get("volumes", []):
        resolved = resolve_volume_mount_spec(f"{vol_rec['name']}:{vol_rec['target']}:{vol_rec['mode']}")
        mounts.append({"host": resolved["host"], "target": resolved["target"], "mode": resolved["mode"]})
    for vspec in extra_volumes or []:
        resolved = resolve_volume_mount_spec(vspec)
        mounts.append({"host": resolved["host"], "target": resolved["target"], "mode": resolved["mode"]})
    mounts_tsv = "\n".join(f"{m['host']}\t{m['target']}\t{m['mode']}" for m in mounts)

    memory_max = memory_override if memory_override is not None else meta.get("memory_max", "")
    cpu_max = cpu_override if cpu_override is not None else meta.get("cpu_max", "")
    if memory_max and not MEM_RE.match(memory_max):
        raise ComputeError(f"invalid memory limit: {memory_max!r}")
    if cpu_max and not CPU_RE.match(cpu_max):
        raise ComputeError(f"invalid cpu limit: {cpu_max!r}")
    workdir = workdir_override if workdir_override is not None else meta.get("workdir", "/")
    if not os.path.isabs(workdir):
        raise ComputeError(f"workdir must be absolute: {workdir!r}")

    run_env = {"PATH": os.environ.get("PATH", "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")}
    if preserve_term:
        run_env["TERM"] = os.environ.get("TERM") or "xterm-256color"
    for k, v in meta.get("env", {}).items():
        run_env[k] = v
    for item in extra_env or []:
        if "=" not in item:
            raise ComputeError(f"invalid --env entry: {item!r}")
        k, v = item.split("=", 1)
        run_env[k] = v

    unshare_cmd = ["unshare", "--mount", "--pid", "--fork", "--kill-child", "--forward-signals", "--propagation", "slave"]
    net_prefix: list[str] = []
    if net_mode == "none":
        unshare_cmd.append("--net")
    elif net_mode == "locachy-net":
        # A job started from outside locachy-net (the CLI on the host) enters it;
        # the service already runs there (compute-client) and inherits it.
        ns_path = Path("/run/netns/locachy-net")
        if ns_path.exists() and os.stat(ns_path).st_ino != os.stat("/proc/self/ns/net").st_ino:
            net_prefix = ["nsenter", f"--net={ns_path}", "--"]

    init_bin = str(app_init_path()) if app_init_path().is_file() and os.access(app_init_path(), os.X_OK) else ""
    full_cmd = [
        *net_prefix,
        *unshare_cmd,
        "bash",
        "-c",
        CONTAINER_INNER_SCRIPT,
        "locachy-compute-inner",
        str(lower),
        str(edir / "upper"),
        str(edir / "work"),
        str(edir / "merged"),
        workdir,
        "1" if net_mode != "none" else "0",
        "1" if want_gpu else "0",
        init_bin,
        mounts_tsv if mounts_tsv else "[]",
    ]
    return {
        "meta": meta,
        "env_dir": edir,
        "want_gpu": bool(want_gpu),
        "net_mode": net_mode,
        "memory_max": memory_max,
        "cpu_max": cpu_max,
        "argv": full_cmd,
        "env": run_env,
    }


def run_container(
    env_name: str,
    command: list[str],
    *,
    gpu_override: bool | None = None,
    net_override: str | None = None,
    extra_mounts: list[str] | None = None,
    extra_volumes: list[str] | None = None,
    workdir_override: str | None = None,
    extra_env: list[str] | None = None,
    memory_override: str | None = None,
    cpu_override: str | None = None,
    job_id: str | None = None,
    detach: bool = False,
) -> dict:
    if not command:
        raise ComputeError("a command is required to run inside the compute container")
    launch = _prepare_container_launch(
        env_name,
        gpu_override=gpu_override,
        net_override=net_override,
        extra_mounts=extra_mounts,
        extra_volumes=extra_volumes,
        workdir_override=workdir_override,
        extra_env=extra_env,
        memory_override=memory_override,
        cpu_override=cpu_override,
        preserve_term=False,
    )
    meta = launch["meta"]
    jid = validate_name(job_id, "job id") if job_id else f"j{int(time.time())}-{uuid.uuid4().hex}"
    spec = {
        "record": {
            "version": 1,
            "job_id": jid,
            "env": env_name,
            "image": meta["image"],
            "command": command,
            "gpu": launch["want_gpu"],
            "net": launch["net_mode"],
            "cgroup": "",
            "log": str(_job_log_file(jid)),
            "state": "starting",
            "started_at": _utc_now(),
            "ended_at": "",
            "exit_code": None,
            "pid": 0,
        },
        "path": str(_job_file(jid)),
        "cgroup": str(cgroup_root() / f"job-{jid}"),
        "memory": launch["memory_max"],
        "cpu": launch["cpu_max"],
        "env_dir": str(launch["env_dir"]),
        "argv": launch["argv"],
        "env": launch["env"],
    }

    if detach:
        # A supervisor is deliberately independent of the caller's terminal and
        # cgroup. It owns the record and stays alive until the child is reaped.
        proc = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "_supervise-job"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        assert proc.stdin is not None and proc.stdout is not None
        proc.stdin.write(json.dumps(spec).encode("utf-8"))
        proc.stdin.close()
        try:
            with selectors.DefaultSelector() as sel:
                sel.register(proc.stdout, selectors.EVENT_READ)
                if not sel.select(_JOB_START_TIMEOUT + 5):
                    proc.terminate()
                    raise ComputeError(f"job {jid} supervisor did not report startup; check job status")
            reply = proc.stdout.readline()
        finally:
            proc.stdout.close()
        if not reply:
            proc.wait()
            raise ComputeError(f"job {jid} supervisor exited ({proc.returncode}) before reporting startup")
        result = json.loads(reply)
        if "error" in result:
            raise ComputeError(result["error"])
        return result

    return _supervise_job(spec)


def shell_container(
    env_name: str,
    command: list[str] | None = None,
    *,
    gpu_override: bool | None = None,
    net_override: str | None = None,
    extra_mounts: list[str] | None = None,
    extra_volumes: list[str] | None = None,
    workdir_override: str | None = None,
    extra_env: list[str] | None = None,
    memory_override: str | None = None,
    cpu_override: str | None = None,
) -> int:
    """Attach an interactive shell (or command) directly to the caller's TTY inside a compute container."""
    launch = _prepare_container_launch(
        env_name,
        gpu_override=gpu_override,
        net_override=net_override,
        extra_mounts=extra_mounts,
        extra_volumes=extra_volumes,
        workdir_override=workdir_override,
        extra_env=extra_env,
        memory_override=memory_override,
        cpu_override=cpu_override,
        preserve_term=True,
    )
    shell_cmd = (
        list(command)
        if command
        else ["/bin/sh", "-c", "if [ -x /bin/bash ]; then exec /bin/bash; else exec /bin/sh; fi"]
    )
    edir: Path = launch["env_dir"]
    for sub in ("upper", "work", "merged"):
        (edir / sub).mkdir(exist_ok=True)

    sid = f"s{int(time.time())}-{uuid.uuid4().hex[:12]}"
    cg_spec = {"memory": launch["memory_max"], "cpu": launch["cpu_max"]}
    cg: Path | None = None
    proc: subprocess.Popen | None = None
    previous: dict[int, object] = {}
    ready_r = -1
    ready_w = -1

    def enter_cgroup() -> None:
        if cg is None:
            return
        try:
            (cg / "cgroup.procs").write_text(f"{os.getpid()}\n", encoding="utf-8")
        except OSError as exc:
            os.write(2, f"locachy-compute: cannot enter shell cgroup {cg}: {exc}\n".encode())
            raise

    def _forward(signum, _frame) -> None:
        if proc is not None and proc.poll() is None:
            try:
                proc.send_signal(signum)
            except OSError:
                pass

    def _ignore_sig(_signum, _frame) -> None:
        return

    try:
        cg = _job_cgroup_create(cgroup_root() / f"shell-{sid}", cg_spec)
        ready_r, ready_w = os.pipe()
        is_tty = sys.stdin.isatty()
        forwarded_sigs = [signal.SIGTERM, signal.SIGHUP, signal.SIGWINCH]
        if not is_tty:
            forwarded_sigs.append(signal.SIGINT)
        previous = {sig: signal.signal(sig, _forward) for sig in forwarded_sigs}
        if is_tty:
            # Use a Python no-op handler instead of SIG_IGN so children always
            # reset SIGINT to SIG_DFL across execve.
            previous[signal.SIGINT] = signal.signal(signal.SIGINT, _ignore_sig)
        try:
            proc = subprocess.Popen(
                [*launch["argv"], str(ready_w), *shell_cmd],
                stdin=None,
                stdout=None,
                stderr=None,
                env=launch["env"],
                pass_fds=(ready_w,),
                preexec_fn=enter_cgroup if cg is not None else None,
            )
        finally:
            os.close(ready_w)
            ready_w = -1

        # Wait for the container readiness handshake without disturbing TTY fds.
        with selectors.DefaultSelector() as sel:
            sel.register(ready_r, selectors.EVENT_READ)
            deadline = time.monotonic() + _JOB_START_TIMEOUT
            chunk = b""
            while True:
                remaining = max(0.0, deadline - time.monotonic())
                events = sel.select(remaining)
                if not events:
                    raise ComputeError("timed out before the container shell started")
                data = os.read(ready_r, 64)
                if not data:
                    break
                chunk += data
                if chunk == b"ready\n" or not b"ready\n".startswith(chunk):
                    break
        os.close(ready_r)
        ready_r = -1

        rc = proc.wait()
        if chunk != b"ready\n" and rc == 0:
            raise ComputeError("container shell did not report startup")
        return rc if rc >= 0 else 128 - rc
    finally:
        if ready_w >= 0:
            os.close(ready_w)
        if ready_r >= 0:
            os.close(ready_r)
        for sig, old in previous.items():
            signal.signal(sig, old)
        if proc is not None and proc.poll() is None:
            try:
                proc.kill()
                proc.wait(timeout=5)
            except (OSError, subprocess.SubprocessError):
                pass
        if cg is not None:
            try:
                _job_cgroup_cleanup(cg)
            except OSError:
                pass


# ---- KVM micro-VM backend ----

def _vm_dir(name: str) -> Path:
    validate_name(name, "vm name")
    return compute_base() / "vms" / name


def _vm_run_dir(name: str) -> Path:
    validate_name(name, "vm name")
    return compute_run() / f"vm-{name}"


def vm_load(name: str) -> dict:
    path = _vm_dir(name) / "vm.json"
    if not path.is_file():
        raise ComputeError(f"compute VM not found: {name}")
    return json.loads(path.read_text(encoding="utf-8"))


def vm_list() -> list[dict]:
    vdir = compute_base() / "vms"
    if not vdir.is_dir():
        return []
    out = []
    for entry in sorted(vdir.iterdir()):
        meta_path = entry / "vm.json"
        if not meta_path.is_file():
            continue
        try:
            rec = json.loads(meta_path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        rec["running"] = _vm_is_running(rec["name"])
        out.append(rec)
    return out


def _vm_pid_path(name: str) -> Path:
    return _vm_run_dir(name) / "qemu.pid"


def _vm_is_running(name: str) -> bool:
    pfile = _vm_pid_path(name)
    if not pfile.is_file():
        return False
    try:
        pid = int(pfile.read_text(encoding="utf-8").strip())
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        return False


def _create_qcow2_overlay(base_disk: Path, overlay_path: Path) -> None:
    qemu_img = shutil.which("qemu-img")
    if not qemu_img:
        raise ComputeError("qemu-img is required for KVM micro-VM overlays")
    if overlay_path.exists():
        overlay_path.unlink()
    proc = subprocess.run(
        [qemu_img, "create", "-f", "qcow2", "-b", str(base_disk), "-F", "qcow2", str(overlay_path)],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    if proc.returncode != 0:
        raise ComputeError(f"qemu-img overlay creation failed: {proc.stderr.strip()}")


VM_DISPLAYS = ("none", "gtk", "sdl")
VM_FREEZE = ("qmp", "none")
VIRTIOFSD_CANDIDATES = (
    "/usr/lib/virtiofsd",
    "/usr/libexec/virtiofsd",
    "/usr/bin/virtiofsd",
)


def _parse_vm_share_spec(raw: str) -> dict[str, str]:
    """Parse HOST_DIR:TAG[:ro|rw] for VM directory shares."""
    parts = raw.split(":")
    if len(parts) not in (2, 3):
        raise ComputeError(f"invalid --share {raw!r}; expected HOST_DIR:TAG[:ro|rw]")
    hdir, tag = parts[0], parts[1]
    mode = parts[2] if len(parts) == 3 and parts[2] else "rw"
    if mode not in ("ro", "rw"):
        raise ComputeError(f"invalid --share mode {mode!r}; expected ro or rw")
    m = parse_mount_spec(f"{hdir}:/share/{tag}:{mode}")
    validate_name(tag, "share tag")
    if not os.path.isdir(m["host"]):
        raise ComputeError(f"share path must be a directory: {m['host']}")
    return {"host": m["host"], "tag": tag, "mode": mode}


def _parse_vm_volume_spec(raw: str) -> dict[str, str]:
    """Parse NAME[:TAG[:ro|rw]] for VM storage volume shares."""
    parts = raw.split(":")
    if len(parts) not in (1, 2, 3):
        raise ComputeError(f"invalid --volume {raw!r}; expected NAME[:TAG[:ro|rw]]")
    vname = parts[0]
    tag = parts[1] if len(parts) >= 2 and parts[1] else vname
    mode = parts[2] if len(parts) == 3 and parts[2] else "rw"
    if mode not in ("ro", "rw"):
        raise ComputeError(f"invalid --volume mode {mode!r}; expected ro or rw")
    validate_name(tag, "share tag")
    res = resolve_volume_mount_spec(vname)
    return {"name": res["volume"], "tag": tag, "mode": mode}


def find_virtiofsd() -> str:
    """Locate the Rust virtiofsd binary (LOCACHY_VIRTIOFSD override, PATH, or /usr/lib/virtiofsd)."""
    override = os.environ.get("LOCACHY_VIRTIOFSD", "").strip()
    if override:
        if os.path.isfile(override) and os.access(override, os.X_OK):
            return override
        found = shutil.which(override)
        if found:
            return found
        raise ComputeError(f"LOCACHY_VIRTIOFSD not executable: {override!r}")
    found = shutil.which("virtiofsd")
    if found:
        return found
    for cand in VIRTIOFSD_CANDIDATES:
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    raise ComputeError(
        "virtiofsd is required for VM shares; install the virtiofsd package"
    )


def virtiofsd_build_argv(share: dict[str, str], sock_path: Path, *, binary: str | None = None) -> list[str]:
    """Build Rust virtiofsd command line (works both as root and as unprivileged uid)."""
    vfs_bin = binary or find_virtiofsd()
    sock = _vm_sock_path(str(sock_path), "virtiofs socket")
    sandbox = os.environ.get("LOCACHY_VIRTIOFSD_SANDBOX", "namespace").strip() or "namespace"
    if sandbox not in ("namespace", "chroot", "none"):
        raise ComputeError(f"invalid LOCACHY_VIRTIOFSD_SANDBOX: {sandbox!r}")
    argv = [
        vfs_bin,
        f"--socket-path={sock}",
        f"--shared-dir={share['host']}",
        f"--sandbox={sandbox}",
        "--cache=auto",
    ]
    if share.get("mode") == "ro":
        argv.append("--readonly")
    return argv


def _vm_sock_path(path: str, label: str = "socket") -> str:
    # QEMU splits -qmp/-chardev options on commas, and UNIX sun_path is limited to 108 bytes.
    if not os.path.isabs(path) or not re.fullmatch(r"/[A-Za-z0-9._/-]+", path) or len(path) > 100:
        raise ComputeError(f"invalid {label} path {path!r}: absolute, [A-Za-z0-9._/-], at most 100 bytes")
    return path


def _vm_qmp_path(path: str) -> str:
    return _vm_sock_path(path, "QMP socket")


def _vm_used_ssh_ports() -> dict[int, str]:
    used: dict[int, str] = {}
    for vm in vm_list():
        try:
            port = int(vm.get("ssh_port") or 0)
        except (TypeError, ValueError):
            port = 0
        if port > 0:
            used[port] = vm["name"]
    return used


def _vm_resolve_ssh_port(net: str, ssh_port: int | None) -> int:
    if ssh_port is None:
        if net != "user":
            return 0
        used = _vm_used_ssh_ports()
        for candidate in range(VM_SSH_PORT_MIN, VM_SSH_PORT_MAX + 1):
            if candidate not in used:
                return candidate
        raise ComputeError(
            f"no free VM SSH port left in {VM_SSH_PORT_MIN}..{VM_SSH_PORT_MAX}; pass --ssh-port explicitly"
        )
    port = int(ssh_port)
    if port == 0:
        return 0
    if port < 0:
        raise ComputeError("--ssh-port must be 0 or between 1024 and 65535")
    if net != "user":
        raise ComputeError("--ssh-port requires --net user")
    if port < 1024 or port > 65535:
        raise ComputeError("--ssh-port must be 0 or between 1024 and 65535")
    used = _vm_used_ssh_ports()
    if port in used:
        raise ComputeError(f"SSH port {port} is already assigned to VM {used[port]!r}")
    return port


def vm_create(
    name: str,
    base_disk: str,
    *,
    memory_mb: int = 2048,
    cpus: int = 2,
    shares: list[str] | None = None,
    volumes: list[str] | None = None,
    cloud_init: str = "",
    net: str = "user",
    ssh_port: int | None = None,
    ssh_user: str = "",
) -> dict:
    validate_name(name, "vm name")
    if memory_mb < 256 or memory_mb > 1048576:
        raise ComputeError("memory_mb must be between 256 and 1048576")
    if cpus < 1 or cpus > 256:
        raise ComputeError("cpus must be between 1 and 256")
    if net not in ("user", "none"):
        raise ComputeError("vm network must be 'user' or 'none'")
    ssh_user_clean = validate_ssh_user(ssh_user)
    resolved_ssh_port = _vm_resolve_ssh_port(net, ssh_port)
    base_path = Path(base_disk)
    if not base_path.is_file():
        raise ComputeError(f"base qcow2 disk does not exist: {base_disk}")
    base_real = base_path.resolve()

    parsed_shares: list[dict[str, str]] = []
    seen_tags: set[str] = set()
    for raw in shares or []:
        entry = _parse_vm_share_spec(raw)
        if entry["tag"] in seen_tags:
            raise ComputeError(f"duplicate share tag: {entry['tag']}")
        seen_tags.add(entry["tag"])
        parsed_shares.append(entry)

    parsed_volumes: list[dict[str, str]] = []
    for raw in volumes or []:
        entry = _parse_vm_volume_spec(raw)
        if entry["tag"] in seen_tags:
            raise ComputeError(f"duplicate share tag: {entry['tag']}")
        seen_tags.add(entry["tag"])
        parsed_volumes.append(entry)

    ci_real = ""
    if cloud_init:
        ci_p = Path(cloud_init)
        if not ci_p.is_file():
            raise ComputeError(f"cloud-init image not found: {cloud_init}")
        ci_real = str(ci_p.resolve())

    vdir = _vm_dir(name)
    if vdir.exists():
        raise ComputeError(f"compute VM already exists: {name}")
    vdir.mkdir(parents=True, mode=0o700)
    overlay = vdir / "overlay.qcow2"
    _create_qcow2_overlay(base_real, overlay)
    meta = {
        "version": 1,
        "name": name,
        "base_disk": str(base_real),
        "overlay_disk": str(overlay),
        "memory_mb": int(memory_mb),
        "cpus": int(cpus),
        "shares": parsed_shares,
        "volumes": parsed_volumes,
        "cloud_init": ci_real,
        "net": net,
        "ssh_port": resolved_ssh_port,
        "ssh_user": ssh_user_clean,
        "created_at": _utc_now(),
        "reset_at": _utc_now(),
    }
    _atomic_write_json(vdir / "vm.json", meta, 0o600)
    for owned in (vdir, overlay, vdir / "vm.json"):
        _own_for_app(owned)
    return meta


def _vm_display(value: str) -> str:
    if value not in VM_DISPLAYS:
        raise ComputeError(f"invalid VM display {value!r}; expected none, gtk, or sdl")
    return value


def _vm_aio() -> str:
    """Block I/O engine for the VM's disk: io_uring by default (LOCACHY_COMPUTE_AIO=threads when the host forbids it)."""
    aio = os.environ.get("LOCACHY_COMPUTE_AIO", "io_uring").strip() or "io_uring"
    if aio not in ("io_uring", "threads"):
        raise ComputeError(f"invalid LOCACHY_COMPUTE_AIO {aio!r}; expected io_uring or threads")
    return aio


def _vm_vfs_sock_path(rdir: Path, idx: int) -> Path:
    return Path(_vm_sock_path(str(rdir / f"vfs-{idx}.sock"), "virtiofs socket"))


def vm_build_argv(
    meta: dict,
    *,
    kvm: bool | None = None,
    display: str = "none",
    qmp_sock: str | None = None,
) -> list[str]:
    qemu = shutil.which("qemu-system-x86_64") or "/usr/bin/qemu-system-x86_64"
    if kvm is None:
        # LOCACHY_COMPUTE_KVM=0 forces TCG (tests in namespaces without /dev/kvm access).
        kvm = os.environ.get("LOCACHY_COMPUTE_KVM", "") != "0" and os.path.exists("/dev/kvm")
    use_kvm = kvm
    display = _vm_display(display)
    rdir = _vm_run_dir(meta["name"])
    qmp = _vm_qmp_path(qmp_sock) if qmp_sock else _vm_qmp_path(str(rdir / "qmp.sock"))

    all_shares = [
        {"host": s["host"], "tag": s["tag"], "mode": s.get("mode", "rw")}
        for s in meta.get("shares", [])
    ]
    for vol in meta.get("volumes", []):
        res = resolve_volume_mount_spec(vol["name"])
        all_shares.append({"host": res["host"], "tag": vol["tag"], "mode": vol.get("mode", "rw")})

    # virtiofs is the only share transport: guest RAM is a shared memfd when any share exists.
    machine = "q35" + (",accel=kvm" if use_kvm else ",accel=tcg")
    if all_shares:
        machine += ",memory-backend=mem"

    # The window tag: QEMU's title is "QEMU (TAG)" (GTK) or "QEMU (TAG-N)" (SDL), and the
    # desktop names a VM app's window by it (base/open.c). Brackets never occur in a VM
    # name, so one VM's tag never starts another's.
    argv = [
        qemu,
        "-name",
        f"locachy-compute[{meta['name']}]",
        *(["-enable-kvm"] if use_kvm else []),
        "-machine",
        machine,
        "-cpu",
        "host" if use_kvm else "max",
        "-smp",
        str(meta["cpus"]),
        "-m",
        str(meta["memory_mb"]),
    ]
    if all_shares:
        argv.extend([
            "-object",
            f"memory-backend-memfd,id=mem,size={int(meta['memory_mb'])}M,share=on",
        ])
    # window-close=off: closing the window (its button, the bar, the overview) never
    # pulls the guest's power; QEMU's default quits on any close request.
    argv.extend([
        "-display",
        display if display == "none" else f"{display},window-close=off",
        "-serial",
        f"unix:{rdir / 'serial.sock'},server=on,wait=off",
        "-monitor",
        f"unix:{rdir / 'monitor.sock'},server=on,wait=off",
        "-pidfile",
        str(rdir / "qemu.pid"),
        "-object",
        "iothread,id=iothread0",
        "-drive",
        f"file={meta['overlay_disk']},format=qcow2,if=none,id=hd0,cache=none,aio={_vm_aio()},discard=unmap",
        "-device",
        "virtio-blk-pci,drive=hd0,iothread=iothread0",
    ])
    if display != "none":
        # A window: a virtio GPU, keyboard-less USB pointer, and the QEMU display backend.
        argv.extend(["-device", "virtio-vga", "-device", "qemu-xhci", "-device", "usb-tablet"])
    argv.extend(["-qmp", f"unix:{qmp},server=on,wait=off"])
    if meta.get("cloud_init"):
        argv.extend(["-drive", f"file={meta['cloud_init']},format=raw,media=cdrom,readonly=on"])
    if meta.get("net") == "user":
        ssh_port = int(meta.get("ssh_port") or 0)
        if ssh_port > 0:
            if ssh_port < 1024 or ssh_port > 65535:
                raise ComputeError(f"invalid VM ssh_port: {ssh_port}")
            argv.extend(["-nic", f"user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:{ssh_port}-:22"])
        else:
            argv.extend(["-nic", "user,model=virtio-net-pci"])
    else:
        argv.extend(["-nic", "none"])
    for idx, share in enumerate(all_shares):
        sock_path = _vm_vfs_sock_path(rdir, idx)
        argv.extend(
            [
                "-chardev",
                f"socket,id=vfs{idx},path={sock_path}",
                "-device",
                f"vhost-user-fs-pci,queue-size=1024,chardev=vfs{idx},tag={share['tag']}",
            ]
        )
    return argv


def _stop_virtiofs_daemons(procs: list[subprocess.Popen], sock_paths: list[Path]) -> None:
    for proc in procs:
        if proc.poll() is None:
            try:
                proc.terminate()
            except OSError:
                pass
    deadline = time.monotonic() + 2.0
    for proc in procs:
        remaining = max(0.0, deadline - time.monotonic())
        if proc.poll() is None:
            try:
                proc.wait(timeout=remaining)
            except subprocess.TimeoutExpired:
                try:
                    proc.kill()
                    proc.wait(timeout=2.0)
                except (OSError, subprocess.TimeoutExpired):
                    pass
    for sp in sock_paths:
        try:
            sp.unlink(missing_ok=True)
        except OSError:
            pass


def _start_virtiofs_daemons(
    resolved_meta: dict,
    rdir: Path,
    *,
    enter_cg=None,
    detach: bool = False,
) -> tuple[list[subprocess.Popen], list[Path]]:
    """Spawn one virtiofsd per share and wait for each socket to appear."""
    shares = resolved_meta.get("shares", [])
    if not shares:
        return [], []
    vfs_bin = find_virtiofsd()
    procs: list[subprocess.Popen] = []
    socks: list[Path] = []
    try:
        for idx, share in enumerate(shares):
            sock_path = _vm_vfs_sock_path(rdir, idx)
            sock_path.unlink(missing_ok=True)
            argv = virtiofsd_build_argv(share, sock_path, binary=vfs_bin)
            log_path = rdir / f"virtiofsd-{idx}.log"
            with open(log_path, "wb") as log_fh:
                proc = subprocess.Popen(
                    argv,
                    stdin=subprocess.DEVNULL,
                    stdout=log_fh,
                    stderr=subprocess.STDOUT,
                    preexec_fn=enter_cg,
                    start_new_session=detach,
                )
            procs.append(proc)
            socks.append(sock_path)
            deadline = time.monotonic() + 5.0
            while time.monotonic() < deadline:
                if sock_path.exists():
                    break
                if proc.poll() is not None:
                    err = log_path.read_text(encoding="utf-8", errors="replace").strip()
                    raise ComputeError(
                        f"virtiofsd for share {share['tag']!r} exited ({proc.returncode}): {err}"
                    )
                time.sleep(0.05)
            if not sock_path.exists():
                err = log_path.read_text(encoding="utf-8", errors="replace").strip()
                raise ComputeError(
                    f"virtiofsd socket did not appear for share {share['tag']!r}: {sock_path}"
                    + (f" ({err})" if err else "")
                )
        return procs, socks
    except Exception:
        _stop_virtiofs_daemons(procs, socks)
        raise


def _stop_virtiofs_pids_file(rdir: Path) -> None:
    pfile = rdir / "virtiofsd.pids"
    if pfile.is_file():
        for line in pfile.read_text(encoding="utf-8", errors="replace").splitlines():
            if not line.strip().isdigit():
                continue
            pid = int(line.strip())
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                continue
            deadline = time.monotonic() + 2.0
            while time.monotonic() < deadline:
                try:
                    os.kill(pid, 0)
                    time.sleep(0.05)
                except OSError:
                    break
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        pfile.unlink(missing_ok=True)
    for sock in rdir.glob("vfs-*.sock"):
        sock.unlink(missing_ok=True)


def vm_start(name: str) -> dict:
    meta = vm_load(name)
    if _vm_is_running(name):
        raise ComputeError(f"VM {name} is already running")
    if not shutil.which("qemu-system-x86_64"):
        raise ComputeError("qemu-system-x86_64 is not installed")
    rdir = _vm_run_dir(name)
    rdir.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(rdir, 0o700)
    cg = _cgroup_prepare(f"vm-{name}")
    resolved = _vm_resolve_shares(meta)
    argv = vm_build_argv(resolved)

    def _enter_cg() -> None:
        if cg is not None and (cg / "cgroup.procs").exists():
            try:
                (cg / "cgroup.procs").write_text(f"{os.getpid()}\n", encoding="utf-8")
            except OSError:
                pass

    vfs_procs, vfs_socks = _start_virtiofs_daemons(resolved, rdir, enter_cg=_enter_cg, detach=True)
    if vfs_procs:
        (rdir / "virtiofsd.pids").write_text(
            "".join(f"{p.pid}\n" for p in vfs_procs), encoding="utf-8"
        )

    log_path = rdir / "qemu.log"
    try:
        with open(log_path, "wb") as log_fh:
            proc = subprocess.Popen(
                argv,
                stdin=subprocess.DEVNULL,
                stdout=log_fh,
                stderr=subprocess.STDOUT,
                preexec_fn=_enter_cg,
                start_new_session=True,
            )
        time.sleep(0.2)
        if proc.poll() is not None:
            err = log_path.read_text(encoding="utf-8", errors="replace").strip()
            raise ComputeError(f"VM {name} exited immediately ({proc.returncode}): {err}")
    except Exception:
        _stop_virtiofs_daemons(vfs_procs, vfs_socks)
        (rdir / "virtiofsd.pids").unlink(missing_ok=True)
        raise
    return {"name": name, "pid": proc.pid, "serial_sock": str(rdir / "serial.sock"), "cgroup": str(cg or "")}


def vm_stop(name: str) -> dict:
    vm_load(name)
    rdir = _vm_run_dir(name)
    pfile = _vm_pid_path(name)
    if pfile.is_file():
        try:
            pid = int(pfile.read_text(encoding="utf-8").strip())
            os.kill(pid, signal.SIGTERM)
            deadline = time.monotonic() + 3.0
            while time.monotonic() < deadline:
                try:
                    os.kill(pid, 0)
                    time.sleep(0.05)
                except OSError:
                    break
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        except (OSError, ValueError):
            pass
        pfile.unlink(missing_ok=True)
    _stop_virtiofs_pids_file(rdir)
    _cgroup_kill_and_remove(f"vm-{name}")
    return {"name": name, "running": False}


def _app_uid() -> int:
    raw = os.environ.get("LOCACHY_COMPUTE_APP_UID", "1000").strip()
    if not raw.isdigit():
        raise ComputeError(f"LOCACHY_COMPUTE_APP_UID must be a number: {raw!r}")
    return int(raw)


def _is_real_host_root() -> bool:
    """True when running as real init_user_ns root (not an unprivileged user namespace)."""
    if os.geteuid() != 0:
        return False
    try:
        for ln in Path("/proc/self/uid_map").read_text(encoding="utf-8").splitlines():
            parts = ln.split()
            if len(parts) == 3 and parts[0] == "0" and parts[1] == "0":
                return True
        return False
    except OSError:
        return True


def _own_for_app(path: Path) -> None:
    """Real root hands a VM's files to the uid its QEMU runs as (locachy-app: uid 1000)."""
    if os.geteuid() == 0 and (_is_real_host_root() or os.environ.get("LOCACHY_COMPUTE_APP_UID")):
        os.chown(path, _app_uid(), -1)


def _vm_resolve_shares(meta: dict) -> dict:
    """Volume shares are re-checked on every start: an unmounted or re-roled volume fails closed."""
    out = dict(meta)
    shares = [
        {"host": s["host"], "tag": s["tag"], "mode": s.get("mode", "rw")}
        for s in meta.get("shares", [])
    ]
    for vol in meta.get("volumes", []):
        res = resolve_volume_mount_spec(vol["name"])
        shares.append({"host": res["host"], "tag": vol["tag"], "mode": vol.get("mode", "rw")})
    out["shares"] = shares
    out["volumes"] = []
    return out


def _vm_run_argv(meta: dict, display: str, qmp_sock: str | None) -> list[str]:
    return vm_build_argv(_vm_resolve_shares(meta), display=display, qmp_sock=qmp_sock or None)


def vm_run(name: str, *, display: str = "none", qmp_sock: str = "") -> int:
    """Run a VM in the foreground until it ends; returns QEMU's exit status.

    locachy-app starts this inside the app's own cgroup (app_NAME), so nothing
    here detaches or joins a cgroup. Any virtiofsd daemons for the VM's shares
    are spawned as children (inheriting app_NAME), kept alive until QEMU exits
    so guest writes flush, and reaped on exit. SIGTERM and SIGINT are forwarded
    to QEMU, which powers the guest off. No root is needed on this path: the run
    directory, the overlay and vm.json must belong to (or be writable by) the
    uid that runs this command (LOCACHY_COMPUTE_APP_UID, 1000 by default).
    """
    meta = vm_load(name)
    if not shutil.which("qemu-system-x86_64"):
        raise ComputeError("qemu-system-x86_64 is not installed")
    rdir = _vm_run_dir(name)
    try:
        rdir.mkdir(parents=True, mode=0o700, exist_ok=True)
    except OSError as exc:
        raise ComputeError(f"VM run directory {rdir} cannot be created by uid {os.geteuid()}: {exc}") from exc
    if os.stat(rdir).st_uid != os.geteuid():
        raise ComputeError(f"VM run directory {rdir} is not owned by uid {os.geteuid()}")
    os.chmod(rdir, 0o700)
    if _vm_is_running(name):
        raise ComputeError(f"VM {name} is already running")
    resolved = _vm_resolve_shares(meta)
    argv = vm_build_argv(resolved, display=display, qmp_sock=qmp_sock or None)
    vfs_procs, vfs_socks = _start_virtiofs_daemons(resolved, rdir, detach=False)
    pfile = _vm_pid_path(name)
    previous: dict[int, object] = {}
    proc_box: list[subprocess.Popen | None] = [None]
    pending_stop = [False]

    def _forward(_signum, _frame) -> None:
        p = proc_box[0]
        if p is None:
            pending_stop[0] = True
            return
        try:
            p.send_signal(signal.SIGTERM)
        except OSError:
            pass

    try:
        # Install signal forwarding before spawning QEMU so an early SIGTERM
        # never kills the wrapper before it can forward and clean up virtiofsd.
        previous = {sig: signal.signal(sig, _forward) for sig in (signal.SIGTERM, signal.SIGINT)}
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL)
        proc_box[0] = proc
        pfile.write_text(f"{proc.pid}\n", encoding="utf-8")
        if pending_stop[0]:
            try:
                proc.send_signal(signal.SIGTERM)
            except OSError:
                pass
        rc = proc.wait()
    finally:
        for sig, old in previous.items():
            signal.signal(sig, old)
        pfile.unlink(missing_ok=True)
        _stop_virtiofs_daemons(vfs_procs, vfs_socks)
    return rc if rc >= 0 else 128 - rc


def _containers_dir() -> Path:
    return _abs_env("LOCACHY_CONTAINERS_DIR", "/etc/locachy/containers")


def vm_export_app(
    name: str,
    *,
    app_name: str = "",
    display: str = "gtk",
    freeze: str = "qmp",
    network: bool = False,
) -> dict:
    """Write /etc/locachy/containers/APP.conf so a compute VM appears in Home as an app."""
    vm_load(name)
    app = app_name or f"vm-{name}"
    validate_name(app, "app name")
    if display not in ("gtk", "sdl"):
        raise ComputeError("an app needs a window: --display must be gtk or sdl")
    if freeze not in VM_FREEZE:
        raise ComputeError(f"invalid --freeze {freeze!r}; expected qmp or none")
    conf = {
        "vm": "1",
        "vm_kind": "compute",
        "vm_name": name,
        "vm_display": display,
        "vm_freeze": freeze,
        "network": "1" if network else "0",
    }
    cdir = _containers_dir()
    cdir.mkdir(parents=True, exist_ok=True)
    text = "# Written by locachy-compute vm export-app: a compute VM shown in Home.\n"
    text += "".join(f'{key}="{value}"\n' for key, value in conf.items())
    path = cdir / f"{app}.conf"
    _atomic_write_json_text(path, text, 0o644)
    return {"app": app, "path": str(path), **conf}


def vm_reset(name: str) -> dict:
    meta = vm_load(name)
    if _vm_is_running(name):
        vm_stop(name)
    overlay = Path(meta["overlay_disk"])
    _create_qcow2_overlay(Path(meta["base_disk"]), overlay)
    _own_for_app(overlay)
    meta["reset_at"] = _utc_now()
    _atomic_write_json(_vm_dir(name) / "vm.json", meta, 0o600)
    _own_for_app(_vm_dir(name) / "vm.json")
    return meta


def vm_remove(name: str) -> None:
    vm_load(name)
    if _vm_is_running(name):
        vm_stop(name)
    shutil.rmtree(_vm_dir(name))
    rdir = _vm_run_dir(name)
    if rdir.exists():
        shutil.rmtree(rdir, ignore_errors=True)


def _write_all(fd: int, data: bytes) -> None:
    view = memoryview(data)
    while view:
        written = os.write(fd, view)
        view = view[written:]


def _vm_console_attach(name: str) -> int:
    sock_path = _vm_run_dir(name) / "serial.sock"
    if not sock_path.exists():
        raise ComputeError(f"VM {name!r} serial console socket not found: {sock_path}")
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(str(sock_path))
    except OSError as exc:
        sock.close()
        raise ComputeError(f"cannot connect to VM {name!r} serial console ({sock_path}): {exc}") from exc

    stdin_fd = sys.stdin.fileno()
    stdout_fd = sys.stdout.fileno()
    is_tty = sys.stdin.isatty()
    old_tty = None
    print(f"Connected to VM '{name}' serial console (press Ctrl+] to detach).", file=sys.stderr, flush=True)
    try:
        if is_tty:
            old_tty = termios.tcgetattr(stdin_fd)
            tty.setraw(stdin_fd)
        sock_fd = sock.fileno()
        while True:
            readable, _, _ = select.select([stdin_fd, sock_fd], [], [])
            if stdin_fd in readable:
                data = os.read(stdin_fd, 4096)
                if not data:
                    break
                detach_idx = data.find(b"\x1d")
                payload = data[:detach_idx] if detach_idx >= 0 else data
                if payload:
                    try:
                        sock.sendall(payload)
                    except (BrokenPipeError, ConnectionResetError):
                        break
                if detach_idx >= 0:
                    break
            if sock_fd in readable:
                try:
                    data = sock.recv(4096)
                except ConnectionResetError:
                    break
                if not data:
                    break
                _write_all(stdout_fd, data)
    finally:
        if old_tty is not None:
            termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_tty)
            print("", file=sys.stderr, flush=True)
        sock.close()
    return 0


def shell_vm(
    name: str,
    command: list[str] | None = None,
    *,
    console: bool = False,
    user: str = "",
    identity: str = "",
) -> int:
    """Connect interactively to a running micro-VM via SSH over loopback or serial console."""
    meta = vm_load(name)
    if not _vm_is_running(name):
        raise ComputeError(f"VM {name!r} is not running; start it with 'locachy-compute vm start {name}'")
    if console:
        if command:
            raise ComputeError("cannot pass a command with --console; serial console is interactive")
        return _vm_console_attach(name)
    ssh_port = int(meta.get("ssh_port") or 0)
    if meta.get("net") != "user" or ssh_port <= 0:
        raise ComputeError(
            f"VM {name!r} has no SSH port forwarding (net={meta.get('net')!r}, ssh_port={ssh_port}); "
            "use --console or recreate the VM with --net user --ssh-port <port>"
        )
    ssh_bin = shutil.which("ssh")
    if not ssh_bin:
        raise ComputeError("ssh client is not installed")
    ssh_user = validate_ssh_user(user) if user else validate_ssh_user(str(meta.get("ssh_user") or ""))
    argv = [ssh_bin, "-p", str(ssh_port)]
    if ssh_user:
        argv.extend(["-l", ssh_user])
    if identity:
        argv.extend(["-i", identity])
    argv.append("127.0.0.1")
    if command:
        argv.extend(command)
    proc = subprocess.run(argv, check=False)
    return proc.returncode


def resolve_shell_kind(name: str, kind: str = "auto") -> str:
    validate_name(name, "target name")
    if kind not in ("auto", "env", "vm"):
        raise ComputeError(f"invalid shell target kind: {kind!r}")
    has_env = (_env_dir(name) / "env.json").is_file()
    has_vm = (_vm_dir(name) / "vm.json").is_file()
    if kind == "env":
        if not has_env:
            raise ComputeError(f"compute env not found: {name}")
        return "env"
    if kind == "vm":
        if not has_vm:
            raise ComputeError(f"compute VM not found: {name}")
        return "vm"
    if has_env and has_vm:
        raise ComputeError(f"{name!r} matches both a compute env and a VM; specify --kind env or --kind vm")
    if has_env:
        return "env"
    if has_vm:
        return "vm"
    raise ComputeError(f"no compute env or VM found named {name!r}")


# ---- OpenSSH ProxyJump Config Generator ----

def _ip4_addrs_from_cmd(argv: list[str]) -> tuple[str, str]:
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=10, check=False)
    except OSError:
        return "", ""
    if proc.returncode != 0:
        return "", ""
    try:
        links = json.loads(proc.stdout)
    except ValueError:
        return "", ""
    ts_ip = ""
    lan_ip = ""
    for link in links:
        ifname = link.get("ifname", "")
        if ifname == "lo":
            continue
        for addr in link.get("addr_info", []):
            if addr.get("family") != "inet" or addr.get("tentative"):
                continue
            local = addr.get("local", "")
            if not local:
                continue
            try:
                ip_obj = ipaddress.IPv4Address(local)
            except ValueError:
                continue
            if ip_obj.is_loopback or ip_obj.is_link_local or ip_obj.is_unspecified:
                continue
            if addr.get("scope") not in (None, "", "global"):
                continue
            if ifname == "tailscale0":
                if not ts_ip:
                    ts_ip = local
            elif not lan_ip:
                lan_ip = local
    return ts_ip, lan_ip


def _detect_ssh_host() -> str:
    ts_ip, lan_ip = _ip4_addrs_from_cmd(["ip", "-j", "-4", "addr", "show"])
    if ts_ip:
        return ts_ip
    ns_path = Path("/run/netns/locachy-net")
    try:
        if ns_path.exists() and os.stat(ns_path).st_ino != os.stat("/proc/self/ns/net").st_ino:
            ns_ts, ns_lan = _ip4_addrs_from_cmd(["nsenter", f"--net={ns_path}", "--", "ip", "-j", "-4", "addr", "show"])
            if ns_ts:
                return ns_ts
            if not lan_ip and ns_lan:
                lan_ip = ns_lan
    except OSError:
        pass
    return lan_ip or "<node-ip>"


def _detect_ssh_user() -> str:
    sudo_user = os.environ.get("SUDO_USER", "").strip()
    if sudo_user:
        try:
            return validate_ssh_user(sudo_user)
        except ComputeError:
            pass
    try:
        pw = pwd.getpwuid(_app_uid())
        if pw.pw_name:
            return validate_ssh_user(pw.pw_name)
    except (KeyError, ComputeError):
        pass
    env_user = os.environ.get("USER", "").strip()
    if env_user:
        try:
            return validate_ssh_user(env_user)
        except ComputeError:
            pass
    return "user"


def _detect_ssh_port() -> int:
    raw = read_rc_conf().get("ssh_port", "").strip()
    if raw.isdigit():
        port = int(raw)
        if 1 <= port <= 65535:
            return port
    return 22


def _detect_ssh_prefix() -> str:
    raw = socket.gethostname().split(".", 1)[0]
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "-", raw).strip(".-")[:64]
    if cleaned and NAME_RE.match(cleaned) and cleaned not in (".", ".."):
        return cleaned
    return "locachy"


def ssh_config_generate(
    *,
    host: str = "",
    user: str = "",
    port: int | None = None,
    prefix: str = "",
    no_sudo: bool = False,
) -> dict:
    resolved_host = host.strip() if host else _detect_ssh_host()
    if resolved_host != "<node-ip>" and not re.fullmatch(r"[A-Za-z0-9._:\[\]%-]+", resolved_host):
        raise ComputeError(f"invalid --host value: {resolved_host!r}")
    resolved_user = validate_ssh_user(user.strip()) if user else _detect_ssh_user()
    if not resolved_user:
        resolved_user = "user"
    resolved_port = _detect_ssh_port() if port is None else int(port)
    if resolved_port < 1 or resolved_port > 65535:
        raise ComputeError(f"invalid SSH port: {resolved_port}")
    resolved_prefix = validate_name(prefix.strip(), "ssh-config prefix") if prefix else _detect_ssh_prefix()

    blocks: list[str] = [
        "# Generated by locachy-compute ssh-config",
        f"# Append to ~/.ssh/config or save under ~/.ssh/config.d/locachy-{resolved_prefix}.conf",
        "",
        "\n".join([
            f"Host {resolved_prefix}",
            f"    HostName {resolved_host}",
            f"    User {resolved_user}",
            f"    Port {resolved_port}",
        ]),
    ]

    envs_out: list[dict] = []
    for env_rec in env_list():
        ename = env_rec["name"]
        alias = f"{resolved_prefix}-{ename}"
        shell_part = f"locachy-compute shell {shlex.quote(ename)}"
        remote_cmd = shell_part if no_sudo else f"sudo {shell_part}"
        blocks.append(
            "\n".join([
                f"Host {alias}",
                f"    HostName {resolved_host}",
                f"    User {resolved_user}",
                f"    Port {resolved_port}",
                "    RequestTTY yes",
                f"    RemoteCommand {remote_cmd}",
            ])
        )
        envs_out.append({
            "name": ename,
            "host_alias": alias,
            "hostname": resolved_host,
            "user": resolved_user,
            "port": resolved_port,
            "remote_command": remote_cmd,
        })

    vms_out: list[dict] = []
    for vm_rec in vm_list():
        try:
            vm_port = int(vm_rec.get("ssh_port") or 0)
        except (TypeError, ValueError):
            vm_port = 0
        if vm_port <= 0:
            continue
        vname = vm_rec["name"]
        alias = f"{resolved_prefix}-{vname}"
        vm_user = validate_ssh_user(str(vm_rec.get("ssh_user") or ""))
        lines = [
            f"Host {alias}",
            "    HostName 127.0.0.1",
            f"    Port {vm_port}",
        ]
        if vm_user:
            lines.append(f"    User {vm_user}")
        lines.append(f"    ProxyJump {resolved_prefix}")
        blocks.append("\n".join(lines))
        entry = {
            "name": vname,
            "host_alias": alias,
            "hostname": "127.0.0.1",
            "port": vm_port,
            "proxy_jump": resolved_prefix,
        }
        if vm_user:
            entry["user"] = vm_user
        vms_out.append(entry)

    header = "\n".join(blocks[:3])
    body = "\n\n".join(blocks[3:])
    config_text = f"{header}\n{body}\n"
    return {
        "prefix": resolved_prefix,
        "jump": {
            "host_alias": resolved_prefix,
            "hostname": resolved_host,
            "user": resolved_user,
            "port": resolved_port,
        },
        "envs": envs_out,
        "vms": vms_out,
        "config": config_text,
    }


# ---- mTLS HTTPS Control Plane ----

class _PeerSSLContextCache:
    """Rebuilds the TLS 1.3 mTLS server SSLContext whenever paired peers change."""

    def __init__(self, base: Path):
        self.base = base
        self._lock = threading.Lock()
        self._stamp: tuple | None = None
        self._ctx: ssl.SSLContext | None = None

    def _compute_stamp(self) -> tuple:
        host_cert = self.base / "host-cert.pem"
        host_key = self.base / "host-key.pem"
        pdir = self.base / "peers"
        entries = []
        if pdir.is_dir():
            for entry in sorted(pdir.glob("*.json")):
                try:
                    st = entry.stat()
                    entries.append((entry.name, st.st_mtime_ns, st.st_size))
                except OSError:
                    pass
        try:
            hc = host_cert.stat().st_mtime_ns
            hk = host_key.stat().st_mtime_ns
        except OSError:
            hc = hk = 0
        return (hc, hk, tuple(entries))

    def get_context(self) -> ssl.SSLContext | None:
        with self._lock:
            stamp = self._compute_stamp()
            if self._ctx is not None and stamp == self._stamp:
                return self._ctx
            host = peers_mod.load_host(self.base)
            if not host:
                self._ctx = None
                self._stamp = stamp
                return None
            compute_peers = peers_mod.list_peers(self.base, scope="compute")
            cadata_parts = [p["client_cert_pem"].strip() for p in compute_peers if p.get("client_cert_pem")]
            if not cadata_parts:
                # Fail closed: 0 paired compute peers -> refuse every TLS handshake.
                self._ctx = None
                self._stamp = stamp
                return None
            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
            ctx.minimum_version = ssl.TLSVersion.TLSv1_3
            ctx.load_cert_chain(certfile=host["host_cert"], keyfile=host["host_key"])
            ctx.verify_mode = ssl.CERT_REQUIRED
            # Self-signed leaf peer certificates are pinned directly in the trust store.
            ctx.verify_flags &= ~ssl.VERIFY_X509_STRICT
            ctx.load_verify_locations(cadata="\n".join(cadata_parts) + "\n")
            self._ctx = ctx
            self._stamp = stamp
            return ctx


class _ComputeHTTPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, bind_addr: tuple, family: int, ssl_cache: _PeerSSLContextCache, peers_base: Path):
        self.address_family = family
        self.ssl_cache = ssl_cache
        self.peers_base = peers_base
        self.server_name = str(bind_addr[0])
        self.server_port = int(bind_addr[1])
        super().__init__(bind_addr, _ComputeHandler, bind_and_activate=False)
        if family == socket.AF_INET6:
            self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
        self.server_bind()
        self.server_activate()

    def get_request(self):
        newsock, fromaddr = self.socket.accept()
        ctx = self.ssl_cache.get_context()
        if ctx is None:
            newsock.close()
            raise ssl.SSLError("no paired compute peers configured")
        newsock.settimeout(15.0)
        try:
            tls_sock = ctx.wrap_socket(newsock, server_side=True)
        except Exception:
            newsock.close()
            raise
        tls_sock.settimeout(30.0)
        return tls_sock, fromaddr


def _node_health(peers_base: Path) -> dict:
    host = peers_mod.load_host(peers_base) or {}
    gpus = discover_gpu_resources()
    mem_kb = 0
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            if line.startswith("MemTotal:"):
                mem_kb = int(line.split()[1])
                break
    except OSError:
        pass
    jobs = job_list()
    return {
        "hostname": socket.gethostname(),
        "host_id": host.get("host_id", ""),
        "cpus": os.cpu_count() or 1,
        "memory_kb": mem_kb,
        "gpu_devices": gpus["devices"],
        "gpu_nvidia_libs": len(gpus["nvidia_libs"]),
        "active_jobs": sum(1 for j in jobs if j.get("state") in _JOB_ACTIVE),
        "envs": len(env_list()),
        "vms": len(vm_list()),
        "storage_volume": configured_compute_storage_volume(),
        "compute_base": str(compute_base()),
    }


class _ComputeHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, format: str, *args) -> None:
        return

    def _send_json(self, status: int, payload: dict | list) -> None:
        body = (json.dumps(payload, sort_keys=True) + "\n").encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)

    def _authenticate(self) -> dict | None:
        if not isinstance(self.connection, ssl.SSLSocket):
            self._send_json(403, {"error": "TLS required"})
            return None
        cert_der = self.connection.getpeercert(binary_form=True)
        peer = peers_mod.verify_compute_peer_cert(cert_der or b"", self.server.peers_base)
        if peer is None:
            self._send_json(403, {"error": "peer not paired or revoked"})
            return None
        return peer

    def _read_json_body(self) -> dict:
        length = int(self.headers.get("Content-Length", "0") or "0")
        if length == 0:
            return {}
        if length < 0 or length > 1024 * 1024:
            raise ComputeError("request body too large")
        raw = self.rfile.read(length)
        data = json.loads(raw.decode("utf-8"))
        if not isinstance(data, dict):
            raise ComputeError("JSON object expected")
        return data

    def do_GET(self) -> None:
        peer = self._authenticate()
        if peer is None:
            return
        parsed = urllib.parse.urlparse(self.path)
        parts = [p for p in parsed.path.split("/") if p]
        try:
            if parts == ["v1", "health"]:
                info = _node_health(self.server.peers_base)
                info["peer_id"] = peer["peer_id"]
                info["peer_name"] = peer["name"]
                self._send_json(200, info)
            elif parts == ["v1", "envs"]:
                self._send_json(200, {"envs": env_list()})
            elif parts == ["v1", "jobs"]:
                self._send_json(200, {"jobs": job_list()})
            elif len(parts) == 3 and parts[:2] == ["v1", "jobs"]:
                self._send_json(200, job_load(parts[2]))
            elif len(parts) == 4 and parts[:2] == ["v1", "jobs"] and parts[3] == "log":
                job_load(parts[2])
                lpath = _job_log_file(parts[2])
                text = lpath.read_text(encoding="utf-8", errors="replace") if lpath.is_file() else ""
                self._send_json(200, {"job_id": parts[2], "log": text})
            elif parts == ["v1", "vms"]:
                self._send_json(200, {"vms": vm_list()})
            else:
                self._send_json(404, {"error": "not found"})
        except ComputeError as exc:
            self._send_json(400, {"error": str(exc)})

    def do_POST(self) -> None:
        peer = self._authenticate()
        if peer is None:
            return
        parsed = urllib.parse.urlparse(self.path)
        parts = [p for p in parsed.path.split("/") if p]
        try:
            body = self._read_json_body()
            if len(parts) == 4 and parts[:2] == ["v1", "envs"] and parts[3] == "reset":
                self._send_json(200, env_reset(parts[2]))
            elif parts == ["v1", "jobs"]:
                env_name = str(body.get("env", ""))
                cmd = body.get("command")
                if not isinstance(cmd, list) or not cmd or not all(isinstance(x, str) for x in cmd):
                    raise ComputeError("'command' must be a non-empty string list")
                # Host mounts and storage volumes are the node operator's
                # (locachy-compute env create), never a remote peer's choice.
                if body.get("mounts") or body.get("volumes"):
                    raise ComputeError("mounts and volumes are set on the env by the node operator, not per job")
                rec = run_container(
                    env_name,
                    cmd,
                    gpu_override=body.get("gpu"),
                    net_override=body.get("net"),
                    workdir_override=body.get("workdir"),
                    extra_env=body.get("env_vars"),
                    memory_override=body.get("memory_max"),
                    cpu_override=body.get("cpu_max"),
                    detach=True,
                )
                self._send_json(202, rec)
            elif len(parts) == 4 and parts[:2] == ["v1", "jobs"] and parts[3] == "stop":
                self._send_json(200, job_stop(parts[2]))
            elif len(parts) == 4 and parts[:2] == ["v1", "vms"] and parts[3] == "start":
                self._send_json(200, vm_start(parts[2]))
            elif len(parts) == 4 and parts[:2] == ["v1", "vms"] and parts[3] == "stop":
                self._send_json(200, vm_stop(parts[2]))
            elif len(parts) == 4 and parts[:2] == ["v1", "vms"] and parts[3] == "reset":
                self._send_json(200, vm_reset(parts[2]))
            else:
                self._send_json(404, {"error": "not found"})
        except (ComputeError, ValueError) as exc:
            self._send_json(400, {"error": str(exc)})


def _iface_driver(ifname: str) -> str:
    drv = Path(f"/sys/class/net/{ifname}/device/driver")
    try:
        return os.path.basename(os.path.realpath(drv)) if drv.exists() else ""
    except OSError:
        return ""


def discover_bind_endpoints(port: int, bind_tb: bool, tb_ifaces_override: list[str] | None = None) -> list[tuple[int, tuple]]:
    """Return strictly scoped (family, sockaddr) bind endpoints:
    tailscale0 addresses + optional thunderbolt-net fe80::%scope link-local.
    Never returns 0.0.0.0 or ::.
    """
    proc = subprocess.run(["ip", "-j", "addr", "show"], capture_output=True, text=True, timeout=10, check=False)
    if proc.returncode != 0:
        return []
    try:
        links = json.loads(proc.stdout)
    except ValueError:
        return []
    endpoints: list[tuple[int, tuple]] = []
    tb_allow = set(tb_ifaces_override or [])
    for link in links:
        ifname = link.get("ifname", "")
        ifindex = int(link.get("ifindex", 0) or 0)
        is_ts = ifname == "tailscale0"
        is_tb = bind_tb and (ifname in tb_allow or _iface_driver(ifname) == "thunderbolt-net")
        if not is_ts and not is_tb:
            continue
        for addr in link.get("addr_info", []):
            fam = addr.get("family")
            local = addr.get("local", "")
            if not local or addr.get("tentative"):
                continue
            if is_ts:
                if fam == "inet":
                    endpoints.append((socket.AF_INET, (local, port)))
                elif fam == "inet6" and not local.startswith("fe80:"):
                    endpoints.append((socket.AF_INET6, (local, port, 0, 0)))
            elif is_tb and fam == "inet6":
                try:
                    ip_obj = ipaddress.IPv6Address(local)
                except ValueError:
                    continue
                if ip_obj.is_link_local and ifindex > 0:
                    endpoints.append((socket.AF_INET6, (local, port, 0, ifindex)))
    return endpoints


def _parse_explicit_bind(spec: str, port: int, allow_loopback: bool) -> tuple[int, tuple]:
    if spec in ("0.0.0.0", "::", "*"):
        raise ComputeError("refusing wildcard bind address (0.0.0.0 / ::)")
    if "%" in spec:
        ip_part, zone = spec.split("%", 1)
        ip_obj = ipaddress.IPv6Address(ip_part)
        scope_id = int(zone) if zone.isdigit() else socket.if_nametoindex(zone)
        return (socket.AF_INET6, (str(ip_obj), port, 0, scope_id))
    ip_obj = ipaddress.ip_address(spec)
    if ip_obj.is_loopback and not allow_loopback:
        raise ComputeError("loopback bind requires --allow-loopback-test")
    if isinstance(ip_obj, ipaddress.IPv6Address):
        return (socket.AF_INET6, (str(ip_obj), port, 0, 0))
    return (socket.AF_INET, (str(ip_obj), port))


def serve_daemon(
    *,
    port: int = DEFAULT_PORT,
    explicit_binds: list[str] | None = None,
    bind_tb: bool = False,
    allow_loopback: bool = False,
    tb_ifaces_override: list[str] | None = None,
    ready_file: str | None = None,
) -> int:
    pbase = peers_dir()
    peers_mod.init_host(pbase)
    cg = _cgroup_prepare("service")
    if cg is not None and (cg / "cgroup.procs").exists():
        try:
            (cg / "cgroup.procs").write_text(f"{os.getpid()}\n", encoding="utf-8")
        except OSError:
            pass

    cache = _PeerSSLContextCache(pbase)
    stop_event = threading.Event()

    def _on_signal(_signum, _frame) -> None:
        stop_event.set()

    signal.signal(signal.SIGTERM, _on_signal)
    signal.signal(signal.SIGINT, _on_signal)

    servers: dict[tuple, tuple[_ComputeHTTPServer, threading.Thread]] = {}

    def sync_listeners() -> None:
        if explicit_binds:
            desired = [_parse_explicit_bind(b, port, allow_loopback) for b in explicit_binds]
        else:
            desired = discover_bind_endpoints(port, bind_tb=bind_tb, tb_ifaces_override=tb_ifaces_override)
        desired_keys = set(desired)
        for key in list(servers.keys()):
            if key not in desired_keys:
                srv, _ = servers.pop(key)
                try:
                    srv.shutdown()
                    srv.server_close()
                except OSError:
                    pass
        for key in desired:
            if key in servers:
                continue
            fam, addr = key
            try:
                srv = _ComputeHTTPServer(addr, fam, cache, pbase)
            except OSError as exc:
                print(f"locachy-compute: cannot bind {addr}: {exc}", file=sys.stderr, flush=True)
                continue
            th = threading.Thread(target=srv.serve_forever, kwargs={"poll_interval": 0.25}, daemon=True)
            th.start()
            servers[key] = (srv, th)

    sync_listeners()
    if ready_file:
        bound_info = [{"family": fam, "address": list(addr)} for fam, addr in servers.keys()]
        _atomic_write_json(Path(ready_file), {"pid": os.getpid(), "bound": bound_info}, 0o600)

    try:
        while not stop_event.is_set():
            stop_event.wait(2.0)
            if not stop_event.is_set() and not explicit_binds:
                sync_listeners()
    finally:
        for srv, _ in servers.values():
            try:
                srv.shutdown()
                srv.server_close()
            except OSError:
                pass
    return 0


# ---- mTLS Remote Client ----

class _PinnedHTTPSConnection(http.client.HTTPSConnection):
    def __init__(self, host: str, port: int, *, context: ssl.SSLContext, expected_sha256: str, scope_id: int = 0, timeout: float = 15.0):
        super().__init__(host, port=port, timeout=timeout, context=context)
        self._expected_sha256 = expected_sha256
        self._scope_id = scope_id

    def connect(self) -> None:
        if self._scope_id:
            raw = socket.socket(socket.AF_INET6, socket.SOCK_STREAM)
            raw.settimeout(self.timeout)
            raw.connect((self.host, self.port, 0, self._scope_id))
        else:
            raw = socket.create_connection((self.host, self.port), self.timeout)
        self.sock = self._context.wrap_socket(raw, server_hostname=None)
        der = self.sock.getpeercert(binary_form=True)
        if not der:
            self.sock.close()
            raise ComputeError("server provided no TLS certificate")
        actual = hashlib.sha256(der).hexdigest()
        if actual != self._expected_sha256:
            self.sock.close()
            raise ComputeError(f"host certificate fingerprint mismatch: {actual} != {self._expected_sha256}")


def remote_request(creds_dir: Path, host: str, port: int, method: str, path: str, body: dict | None = None, scope_iface: str = "") -> tuple[int, dict]:
    meta = json.loads((creds_dir / "peer.json").read_text(encoding="utf-8"))
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_3
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_REQUIRED
    ctx.verify_flags &= ~ssl.VERIFY_X509_STRICT
    ctx.load_verify_locations(cafile=str(creds_dir / "host-cert.pem"))
    ctx.load_cert_chain(certfile=str(creds_dir / "client-cert.pem"), keyfile=str(creds_dir / "client-key.pem"))

    scope_id = 0
    connect_host = host
    if "%" in host:
        connect_host, zone = host.split("%", 1)
        scope_id = int(zone) if zone.isdigit() else socket.if_nametoindex(zone)
    elif scope_iface:
        scope_id = int(scope_iface) if scope_iface.isdigit() else socket.if_nametoindex(scope_iface)

    conn = _PinnedHTTPSConnection(
        connect_host,
        port,
        context=ctx,
        expected_sha256=meta["host_cert_sha256"],
        scope_id=scope_id,
    )
    try:
        headers = {}
        payload = None
        if body is not None:
            payload = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
            headers["Content-Length"] = str(len(payload))
        conn.request(method, path, body=payload, headers=headers)
        resp = conn.getresponse()
        raw = resp.read().decode("utf-8", errors="replace")
        try:
            parsed = json.loads(raw) if raw.strip() else {}
        except ValueError:
            parsed = {"raw": raw}
        return resp.status, parsed
    finally:
        conn.close()


