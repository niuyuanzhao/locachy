def _load_peers_module():
    here = Path(__file__).resolve().parent
    for directory in (here, Path("/usr/local/lib/locachy")):
        candidate = directory / "locachy_peers.py"
        if candidate.is_file():
            spec = importlib.util.spec_from_file_location("locachy_peers", candidate)
            if spec and spec.loader:
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
                return mod
    sys.exit("locachy-compute: locachy_peers.py is not installed")


def _load_storage_module():
    here = Path(__file__).resolve().parent
    for directory in (here, Path("/usr/local/lib/locachy")):
        candidate = directory / "locachy_storage.py"
        if candidate.is_file():
            spec = importlib.util.spec_from_file_location("locachy_storage", candidate)
            if spec and spec.loader:
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
                return mod
    return None


peers_mod = _load_peers_module()
storage_mod = _load_storage_module()


class ComputeError(RuntimeError):
    """Raised on invalid compute state, policy violation, or runtime failure."""


def _abs_env(name: str, default: str) -> Path:
    val = os.environ.get(name, default)
    if not val or not os.path.isabs(val):
        raise ComputeError(f"{name} must be an absolute path: {val!r}")
    return Path(val)


def configured_compute_storage_volume() -> str:
    """Return configured rc.conf compute_storage volume name, or '' if unset."""
    if os.environ.get("LOCACHY_COMPUTE_BASE"):
        return ""
    val = read_rc_conf().get("compute_storage", "").strip()
    if val in ("", "none", "off"):
        return ""
    return val


def compute_base() -> Path:
    explicit = os.environ.get("LOCACHY_COMPUTE_BASE", "").strip()
    if explicit:
        if not os.path.isabs(explicit):
            raise ComputeError(f"LOCACHY_COMPUTE_BASE must be an absolute path: {explicit!r}")
        return Path(explicit)
    vol_name = configured_compute_storage_volume()
    if vol_name:
        if storage_mod is None:
            raise ComputeError("compute_storage is configured but locachy_storage.py is not installed")
        try:
            _, mp = storage_mod.resolve_compute_volume(vol_name, require_mounted=True)
        except storage_mod.StorageError as exc:
            raise ComputeError(f"compute_storage volume {vol_name!r} unavailable: {exc}") from exc
        base = mp / "locachy-compute"
        for sub in ("images", "envs", "jobs", "vms", "data"):
            (base / sub).mkdir(parents=True, exist_ok=True)
        return base
    return Path("/var/lib/locachy/compute")


def compute_run() -> Path:
    return _abs_env("LOCACHY_COMPUTE_RUN", "/run/locachy/compute")


def cgroup_root() -> Path:
    return _abs_env("LOCACHY_COMPUTE_CGROUP", "/sys/fs/cgroup/locachy-compute")


def rc_conf_path() -> Path:
    return _abs_env("LOCACHY_COMPUTE_RC", "/etc/locachy/rc.conf")


def app_init_path() -> Path:
    return _abs_env("LOCACHY_COMPUTE_APP_INIT", "/usr/local/lib/locachy/app-init")


def peers_dir() -> Path:
    return peers_mod.peers_dir_path()


def read_rc_conf() -> dict[str, str]:
    path = rc_conf_path()
    if not path.is_file():
        return {}
    text = path.read_text(encoding="utf-8", errors="replace")
    return dict(re.findall(r'^[ \t]*([A-Za-z0-9_]+)="([^"\n]*)"', text, re.MULTILINE))


def validate_name(name: str, kind: str = "name") -> str:
    if not NAME_RE.match(name) or name in (".", ".."):
        raise ComputeError(f"invalid {kind}: {name!r}")
    return name


def validate_ssh_user(user: str) -> str:
    if not user:
        return ""
    if not SSH_USER_RE.match(user) or user in (".", "..") or user.startswith("-"):
        raise ComputeError(f"invalid SSH user: {user!r}")
    return user


def _utc_now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _atomic_write_json(path: Path, obj: dict, mode: int = 0o600, *, exclusive: bool = False) -> None:
    _atomic_write_json_text(path, json.dumps(obj, indent=2, sort_keys=True) + "\n", mode, exclusive=exclusive)


def _atomic_write_json_text(path: Path, text: str, mode: int = 0o600, *, exclusive: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        if exclusive:
            os.link(tmp, path)
        else:
            os.replace(tmp, path)
            tmp = ""
    finally:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def parse_mount_spec(spec: str) -> dict[str, str]:
    """Parse HOST:CONTAINER[:ro|:rw] and enforce host-path safety policy.

    Allows secondary NVMe / data directories outside /home/USER (e.g. /mnt/...,
    /data/..., /srv/storage/<vol> for shared/compute volumes, or
    <compute base>/data/...) while refusing host '/', data-only storage volumes,
    and sensitive LOCachy control/peer directories.
    """
    parts = spec.split(":")
    if len(parts) not in (2, 3):
        raise ComputeError(f"invalid mount spec {spec!r}; expected HOST:CONTAINER[:ro|:rw]")
    host_raw, cont_raw = parts[0], parts[1]
    mode = parts[2] if len(parts) == 3 else "rw"
    if mode not in ("ro", "rw"):
        raise ComputeError(f"invalid mount mode {mode!r}; expected ro or rw")
    if not os.path.isabs(host_raw) or not os.path.isabs(cont_raw):
        raise ComputeError(f"mount paths must be absolute: {spec!r}")
    host_real = os.path.realpath(host_raw)
    cont_norm = os.path.normpath(cont_raw)
    if host_real == "/" or cont_norm == "/":
        raise ComputeError(f"refusing to mount root filesystem: {spec!r}")
    if ".." in cont_norm.split("/"):
        raise ComputeError(f"invalid container mount target: {cont_raw!r}")
    for forbidden in (*FORBIDDEN_HOST_MOUNT_ROOTS, str(peers_dir()), str(compute_base()), str(compute_run())):
        freal = os.path.realpath(forbidden)
        if host_real == freal or host_real.startswith(freal + "/"):
            # Exception: <compute base>/data/... is the explicit data area of the node.
            allowed_data = os.path.realpath(str(compute_base() / "data"))
            if host_real == allowed_data or host_real.startswith(allowed_data + "/"):
                continue
            raise ComputeError(f"refusing sensitive host mount path: {host_real}")
    if storage_mod is not None:
        sroot = os.path.realpath(str(storage_mod.storage_root_path()))
        if host_real == sroot:
            raise ComputeError(f"refusing to mount storage root directly: {host_real}")
        if host_real.startswith(sroot + "/"):
            rel = host_real[len(sroot) + 1 :]
            vol_name = rel.split("/", 1)[0]
            try:
                vol = storage_mod.get_volume(vol_name)
            except storage_mod.StorageError:
                vol = None
            if vol is not None and vol["role"] not in ("shared", "compute"):
                raise ComputeError(
                    f"refusing to mount data-only storage volume {vol_name!r} (role={vol['role']!r})"
                )
    if not os.path.exists(host_real):
        raise ComputeError(f"host mount path does not exist: {host_real}")
    return {"host": host_real, "target": cont_norm, "mode": mode}


def resolve_volume_mount_spec(spec: str) -> dict[str, str]:
    """Parse NAME[:CONTAINER_PATH[:ro|rw]] and enforce storage volume role & mount state."""
    if storage_mod is None:
        raise ComputeError("locachy_storage.py is not installed; --volume is unavailable")
    try:
        parsed = storage_mod.parse_compute_volume_spec(spec)
        _, mp = storage_mod.resolve_compute_volume(parsed["name"], require_mounted=True)
    except storage_mod.StorageError as exc:
        raise ComputeError(str(exc)) from exc
    host_real = os.path.realpath(str(mp))
    if not os.path.isdir(host_real):
        raise ComputeError(f"storage volume {parsed['name']!r} mountpoint does not exist: {host_real}")
    return {
        "volume": parsed["name"],
        "host": host_real,
        "target": parsed["target"],
        "mode": parsed["mode"],
    }


def _storage_summary() -> dict:
    vol_name = configured_compute_storage_volume()
    info = {
        "storage_volume": vol_name,
        "compute_base": str(compute_base()),
        "available_volumes": [],
    }
    if storage_mod is not None:
        try:
            cfg = storage_mod.load_config()
            for vol in cfg["volumes"]:
                if vol["role"] in ("shared", "compute"):
                    mp = storage_mod.volume_mountpoint(vol["name"])
                    info["available_volumes"].append(
                        {
                            "name": vol["name"],
                            "role": vol["role"],
                            "mountpoint": str(mp),
                            "mounted": storage_mod.is_mountpoint(mp),
                        }
                    )
        except storage_mod.StorageError:
            pass
    return info


def _compute_daemon_running() -> bool:
    """Return True if a `locachy-compute serve` process is running on this host."""
    try:
        entries = os.listdir("/proc")
    except OSError:
        return False
    me = os.getpid()
    for ent in entries:
        if not ent.isdigit():
            continue
        pid = int(ent)
        if pid == me:
            continue
        try:
            raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        except OSError:
            continue
        if not raw:
            continue
        parts = [p.decode("utf-8", errors="replace") for p in raw.split(b"\x00") if p]
        if any(os.path.basename(p) == "locachy-compute" for p in parts) and "serve" in parts:
            return True
    return False


def _tsv_clean(value: object, max_len: int = 160) -> str:
    s = str(value if value is not None else "")
    s = s.replace("\t", " ").replace("\r", " ").replace("\n", " ").strip()
    return s[:max_len]


def node_status() -> dict:
    """Return full live Compute Node state without failing if compute_storage is unmounted."""
    rc_vals = read_rc_conf()
    service_enabled = bool(rc_vals.get("service_compute", "").strip())
    raw_port = rc_vals.get("compute_port", "").strip()
    port = int(raw_port) if raw_port.isdigit() and 1 <= int(raw_port) <= 65535 else DEFAULT_PORT
    bind_tb = rc_vals.get("compute_bind_tb", "").strip() == "1"
    gpu_enabled = rc_vals.get("compute_gpu", "1").strip() != "0"
    vol_name = configured_compute_storage_volume()

    storage_mounted = True
    storage_base = ""
    storage_free = 0
    storage_total = 0
    storage_error = ""
    images: list[dict] = []
    envs: list[dict] = []
    jobs: list[dict] = []
    vms: list[dict] = []

    try:
        base = compute_base()
        storage_base = str(base)
        if base.exists():
            sv = os.statvfs(base)
            storage_free = int(sv.f_bavail) * int(sv.f_frsize)
            storage_total = int(sv.f_blocks) * int(sv.f_frsize)
        images = image_list()
        envs = env_list()
        jobs = job_list()
        vms = vm_list()
    except ComputeError as exc:
        storage_mounted = False
        storage_error = str(exc)

    gpu_info = discover_gpu_resources()
    nvidia_ver = ""
    try:
        vpath = Path("/sys/module/nvidia/version")
        if vpath.is_file():
            nvidia_ver = vpath.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        pass

    paired_peers = -1
    try:
        paired_peers = len(peers_mod.list_peers(peers_dir(), scope="compute"))
    except (OSError, peers_mod.PeerStoreError):
        pass

    return {
        "service_enabled": service_enabled,
        "daemon_running": _compute_daemon_running(),
        "port": port,
        "bind_tb": bind_tb,
        "gpu_enabled": gpu_enabled,
        "storage": {
            "volume": vol_name,
            "mounted": storage_mounted,
            "base": storage_base,
            "free_bytes": storage_free,
            "total_bytes": storage_total,
            "error": storage_error,
        },
        "gpu": {
            "devices": len(gpu_info.get("devices", [])),
            "nvidia_libs": len(gpu_info.get("nvidia_libs", [])),
            "nvidia_version": nvidia_ver,
        },
        "paired_peers": paired_peers,
        "ssh": {
            "host": _detect_ssh_host(),
            "user": _detect_ssh_user(),
            "port": _detect_ssh_port(),
            "prefix": _detect_ssh_prefix(),
        },
        "counts": {
            "images": len(images),
            "envs": len(envs),
            "jobs_running": sum(1 for j in jobs if j.get("state") == "running"),
            "jobs_total": len(jobs),
            "vms_running": sum(1 for v in vms if v.get("running")),
            "vms_total": len(vms),
        },
        "images": images,
        "envs": envs,
        "jobs": jobs,
        "vms": vms,
    }


def discover_gpu_resources() -> dict[str, list[str]]:
    """Detect host GPU device nodes and host NVIDIA user-space driver libs."""
    devices: list[str] = []
    for pattern in (
        "/dev/nvidiactl",
        "/dev/nvidia-modeset",
        "/dev/nvidia-uvm",
        "/dev/nvidia-uvm-tools",
    ):
        if os.path.exists(pattern):
            devices.append(pattern)
    dev_dir = Path("/dev")
    if dev_dir.is_dir():
        for entry in sorted(dev_dir.iterdir()):
            if re.match(r"^nvidia[0-9]+$", entry.name):
                devices.append(str(entry))
    caps_dir = Path("/dev/nvidia-caps")
    if caps_dir.is_dir():
        for entry in sorted(caps_dir.iterdir()):
            devices.append(str(entry))
    dri_dir = Path("/dev/dri")
    if dri_dir.is_dir():
        for entry in sorted(dri_dir.iterdir()):
            if entry.name.startswith("renderD"):
                devices.append(str(entry))

    libs: list[str] = []
    seen_names: set[str] = set()
    for libdir in (Path("/usr/lib"), Path("/usr/lib64"), Path("/usr/lib/x86_64-linux-gnu")):
        if not libdir.is_dir():
            continue
        for pat in NVIDIA_LIB_PATTERNS:
            for item in sorted(libdir.glob(pat)):
                if item.name in seen_names:
                    continue
                if item.is_file() or item.is_symlink():
                    seen_names.add(item.name)
                    libs.append(str(item))
    return {"devices": devices, "nvidia_libs": libs}


def _safe_extract_tar(tf: tarfile.TarFile, dest: Path) -> None:
    dest_real = os.path.realpath(dest)
    for member in tf.getmembers():
        name = member.name.lstrip("/")
        if not name or name in (".", "./"):
            continue
        norm = os.path.normpath(name)
        if norm.startswith("..") or os.path.isabs(norm):
            raise ComputeError(f"unsafe path in tarball: {member.name!r}")
        base = os.path.basename(norm)
        parent = Path(dest_real) / os.path.dirname(norm)
        if base == ".wh..wh..opq":
            if parent.is_dir():
                for child in list(parent.iterdir()):
                    if child.is_dir() and not child.is_symlink():
                        shutil.rmtree(child)
                    else:
                        child.unlink(missing_ok=True)
            continue
        if base.startswith(".wh."):
            victim = parent / base[4:]
            if victim.is_dir() and not victim.is_symlink():
                shutil.rmtree(victim)
            else:
                victim.unlink(missing_ok=True)
            continue
        target = Path(dest_real) / norm
        if member.issym():
            target.parent.mkdir(parents=True, exist_ok=True)
            if target.exists() or target.is_symlink():
                if target.is_dir() and not target.is_symlink():
                    shutil.rmtree(target)
                else:
                    target.unlink()
            os.symlink(member.linkname, target)
            continue
        if member.islnk():
            link_norm = os.path.normpath(member.linkname.lstrip("/"))
            if link_norm.startswith(".."):
                raise ComputeError(f"unsafe hardlink in tarball: {member.linkname!r}")
            src = Path(dest_real) / link_norm
            target.parent.mkdir(parents=True, exist_ok=True)
            if target.exists() or target.is_symlink():
                target.unlink()
            if src.exists():
                os.link(src, target)
            continue
        if member.isdev():
            # Never materialize device nodes from untrusted tarballs; runtime builds /dev.
            continue
        if member.isdir():
            target.mkdir(parents=True, exist_ok=True)
            try:
                os.chmod(target, member.mode & 0o7777)
            except OSError:
                pass
            continue
        if member.isfile():
            target.parent.mkdir(parents=True, exist_ok=True)
            if target.exists() or target.is_symlink():
                if target.is_dir() and not target.is_symlink():
                    shutil.rmtree(target)
                else:
                    target.unlink()
            src_fh = tf.extractfile(member)
            if src_fh is not None:
                with src_fh, open(target, "wb") as out_fh:
                    shutil.copyfileobj(src_fh, out_fh)
                try:
                    os.chmod(target, member.mode & 0o7777)
                except OSError:
                    pass


def _extract_tar_path(tar_path: Path, dest: Path) -> None:
    name = tar_path.name.lower()
    if name.endswith(".tar.zst") or name.endswith(".zst"):
        zstd = shutil.which("zstd") or shutil.which("unzstd")
        if not zstd:
            raise ComputeError("zstd is required to extract .tar.zst images")
        proc = subprocess.Popen([zstd, "-dc", str(tar_path)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        assert proc.stdout is not None
        try:
            with tarfile.open(fileobj=proc.stdout, mode="r|*") as tf:
                _safe_extract_tar(tf, dest)
        finally:
            _, err = proc.communicate()
            if proc.returncode != 0:
                raise ComputeError(f"zstd extract failed: {err.decode('utf-8', 'replace').strip()}")
        return
    with tarfile.open(tar_path, mode="r:*") as tf:
        names = tf.getnames()
        if "manifest.json" in names and any(n.endswith(".tar") or "/layer.tar" in n for n in names):
            # Docker/OCI save tarball: unpack layers in manifest order
            with tempfile.TemporaryDirectory(prefix="locachy-oci-") as tmp:
                tf.extractall(tmp, filter="data")
                manifest = json.loads((Path(tmp) / "manifest.json").read_text(encoding="utf-8"))
                if not isinstance(manifest, list) or not manifest:
                    raise ComputeError("empty OCI/Docker manifest.json")
                for layer in manifest[0].get("Layers", []):
                    layer_path = Path(tmp) / layer
                    if not layer_path.is_file():
                        raise ComputeError(f"missing image layer: {layer}")
                    with tarfile.open(layer_path, mode="r:*") as ltf:
                        _safe_extract_tar(ltf, dest)
            return
        _safe_extract_tar(tf, dest)


def image_import(name: str, source: str) -> dict:
    validate_name(name, "image name")
    src = Path(source)
    if not src.exists():
        raise ComputeError(f"image source does not exist: {source}")
    img_dir = compute_base() / "images" / name
    if img_dir.exists():
        raise ComputeError(f"image already exists: {name}")
    img_dir.parent.mkdir(parents=True, exist_ok=True)
    stage: Path | None = Path(tempfile.mkdtemp(prefix=f".img-{name}-", dir=img_dir.parent))
    assert stage is not None
    rootfs = stage / "rootfs"
    rootfs.mkdir(mode=0o755)
    try:
        if src.is_dir():
            shutil.copytree(src, rootfs, symlinks=True, dirs_exist_ok=True)
        else:
            _extract_tar_path(src, rootfs)
        meta = {
            "version": 1,
            "name": name,
            "source": str(src.resolve()),
            "imported_at": _utc_now(),
        }
        _atomic_write_json(stage / "image.json", meta, 0o644)
        os.rename(stage, img_dir)
        stage = None
        return meta
    finally:
        # Only the failed staging directory is removed (never a path derived
        # from a moved or empty value).
        if stage is not None and stage.exists():
            shutil.rmtree(stage, ignore_errors=True)


def image_list() -> list[dict]:
    idir = compute_base() / "images"
    if not idir.is_dir():
        return []
    out = []
    for entry in sorted(idir.iterdir()):
        meta_path = entry / "image.json"
        if meta_path.is_file():
            try:
                out.append(json.loads(meta_path.read_text(encoding="utf-8")))
            except (OSError, ValueError):
                pass
    return out


def image_remove(name: str) -> None:
    validate_name(name, "image name")
    for env in env_list():
        if env.get("image") == name:
            raise ComputeError(f"image {name} is still used by env {env['name']}")
    img_dir = compute_base() / "images" / name
    if not img_dir.is_dir():
        raise ComputeError(f"image not found: {name}")
    shutil.rmtree(img_dir)


def _env_dir(name: str) -> Path:
    validate_name(name, "env name")
    return compute_base() / "envs" / name


def env_load(name: str) -> dict:
    path = _env_dir(name) / "env.json"
    if not path.is_file():
        raise ComputeError(f"compute env not found: {name}")
    return json.loads(path.read_text(encoding="utf-8"))


def env_list() -> list[dict]:
    edir = compute_base() / "envs"
    if not edir.is_dir():
        return []
    out = []
    for entry in sorted(edir.iterdir()):
        meta = entry / "env.json"
        if meta.is_file():
            try:
                out.append(json.loads(meta.read_text(encoding="utf-8")))
            except (OSError, ValueError):
                pass
    return out


def env_create(
    name: str,
    image: str,
    *,
    gpu: bool = False,
    net: str = "locachy-net",
    mounts: list[str] | None = None,
    volumes: list[str] | None = None,
    memory_max: str = "",
    cpu_max: str = "",
    workdir: str = "/",
    env_vars: list[str] | None = None,
) -> dict:
    validate_name(name, "env name")
    validate_name(image, "image name")
    if net not in ("locachy-net", "none"):
        raise ComputeError(f"invalid network mode: {net!r}")
    if memory_max and not MEM_RE.match(memory_max):
        raise ComputeError(f"invalid memory limit: {memory_max!r}")
    if cpu_max and not CPU_RE.match(cpu_max):
        raise ComputeError(f"invalid cpu limit: {cpu_max!r}")
    img_rootfs = compute_base() / "images" / image / "rootfs"
    if not img_rootfs.is_dir():
        raise ComputeError(f"base image not found: {image}")
    parsed_mounts = [parse_mount_spec(m) for m in (mounts or [])]
    parsed_volumes = [resolve_volume_mount_spec(v) for v in (volumes or [])]
    env_map: dict[str, str] = {}
    for item in env_vars or []:
        if "=" not in item:
            raise ComputeError(f"invalid --env entry {item!r}; expected KEY=VALUE")
        k, v = item.split("=", 1)
        if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", k):
            raise ComputeError(f"invalid env key: {k!r}")
        env_map[k] = v

    edir = _env_dir(name)
    if edir.exists():
        raise ComputeError(f"compute env already exists: {name}")
    for sub in ("upper", "work", "merged"):
        (edir / sub).mkdir(parents=True, mode=0o755)
    meta = {
        "version": 1,
        "name": name,
        "image": image,
        "created_at": _utc_now(),
        "reset_at": _utc_now(),
        "gpu": bool(gpu),
        "net": net,
        "mounts": parsed_mounts,
        "volumes": [
            {"name": v["volume"], "target": v["target"], "mode": v["mode"]}
            for v in parsed_volumes
        ],
        "memory_max": memory_max,
        "cpu_max": cpu_max,
        "workdir": workdir if os.path.isabs(workdir) else "/",
        "env": env_map,
    }
    _atomic_write_json(edir / "env.json", meta, 0o644)
    return meta


def _cgroup_prepare(group_name: str, memory_max: str = "", cpu_max: str = "") -> Path | None:
    """Create /sys/fs/cgroup/locachy-compute/<group_name> when cgroup v2 is writable.
    On a real root host this is always required; inside unprivileged test
    namespaces without a delegated cgroup, set LOCACHY_COMPUTE_ALLOW_NO_CGROUP=1
    to allow fallback."""
    root = cgroup_root()
    try:
        root.mkdir(parents=True, exist_ok=True)
        cg = root / group_name
        cg.mkdir(exist_ok=True)
        if memory_max and (cg / "memory.max").exists():
            (cg / "memory.max").write_text(memory_max + "\n", encoding="utf-8")
        if cpu_max and (cg / "cpu.max").exists():
            (cg / "cpu.max").write_text(cpu_max + "\n", encoding="utf-8")
        return cg
    except OSError as exc:
        if os.environ.get("LOCACHY_COMPUTE_ALLOW_NO_CGROUP") == "1":
            return None
        raise ComputeError(f"cannot create cgroup {root / group_name}: {exc}") from exc



def _cgroup_kill_and_remove(group_name: str) -> None:
    cg = cgroup_root() / group_name
    if not cg.is_dir():
        return
    kill_file = cg / "cgroup.kill"
    if kill_file.exists():
        try:
            kill_file.write_text("1\n", encoding="utf-8")
        except OSError:
            pass
    procs_file = cg / "cgroup.procs"
    if procs_file.exists():
        try:
            for line in procs_file.read_text(encoding="utf-8").splitlines():
                if line.strip().isdigit():
                    try:
                        os.kill(int(line.strip()), signal.SIGKILL)
                    except OSError:
                        pass
        except OSError:
            pass
    for _ in range(20):
        try:
            cg.rmdir()
            return
        except OSError:
            time.sleep(0.05)


def _job_file(job_id: str) -> Path:
    validate_name(job_id, "job id")
    return compute_base() / "jobs" / f"{job_id}.json"


def _job_log_file(job_id: str) -> Path:
    validate_name(job_id, "job id")
    return compute_base() / "jobs" / f"{job_id}.log"


_JOB_ACTIVE = ("starting", "running")
_JOB_START_TIMEOUT = 10.0


def _job_pid_identity(pid: int) -> list[str]:
    # /proc/<pid>/stat field 22; the process name can contain spaces and parentheses.
    fields = Path(f"/proc/{pid}/stat").read_text(errors="replace").rsplit(")", 1)[1].split()
    boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    return [boot, fields[19]]


def _job_owner_fd(rec: dict) -> int | None:
    owner = rec.get("supervisor") or {}
    pid = owner.get("pid", 0)
    if not isinstance(pid, int) or pid <= 0:
        return None
    fd = -1
    try:
        # Open first so PID reuse during or after verification cannot redirect a signal.
        fd = os.pidfd_open(pid)
        info = os.fstat(fd)
        if owner.get("identity") != [*_job_pid_identity(pid), info.st_dev, info.st_ino]:
            return None
        poller = select.poll()
        poller.register(fd, select.POLLIN)
        if poller.poll(0):  # Includes an exited supervisor not yet reaped by its parent.
            return None
        result, fd = fd, -1
        return result
    except (FileNotFoundError, ProcessLookupError):
        return None
    finally:
        if fd >= 0:
            os.close(fd)


def _job_read(path: Path) -> dict:
    rec = json.loads(path.read_text(encoding="utf-8"))
    if rec.get("state") not in _JOB_ACTIVE:
        return rec
    fd = _job_owner_fd(rec)
    if fd is not None:
        os.close(fd)
        return rec
    # The supervisor may have committed the result while status opened the older record.
    rec = json.loads(path.read_text(encoding="utf-8"))
    if rec.get("state") in _JOB_ACTIVE:
        rec["state"] = "exited"
    return rec


def job_list() -> list[dict]:
    jdir = compute_base() / "jobs"
    if not jdir.is_dir():
        return []
    items = []
    for entry in sorted(jdir.glob("*.json")):
        try:
            items.append(_job_read(entry))
        except (OSError, ValueError):
            continue
    return items


def job_load(job_id: str) -> dict:
    path = _job_file(job_id)
    if not path.is_file():
        raise ComputeError(f"job not found: {job_id}")
    return _job_read(path)


def job_stop(job_id: str) -> dict:
    rec = job_load(job_id)
    if rec["state"] not in _JOB_ACTIVE:
        if rec["state"] == "exited":
            raise ComputeError(f"cannot stop job {job_id}: no verifiable supervisor")
        return rec
    fd = _job_owner_fd(rec)
    if fd is not None:
        try:
            try:
                signal.pidfd_send_signal(fd, signal.SIGUSR1)
            except ProcessLookupError:
                pass
        finally:
            os.close(fd)
    deadline = time.monotonic() + _JOB_START_TIMEOUT + 4.0
    while time.monotonic() < deadline:
        rec = job_load(job_id)
        if rec["state"] not in _JOB_ACTIVE:
            if rec["state"] == "exited":
                raise ComputeError(f"cannot confirm stop for job {job_id}: supervisor disappeared")
            if rec.get("cleanup_error"):
                raise ComputeError(rec["cleanup_error"])
            return rec
        time.sleep(0.05)
    raise ComputeError(f"timed out waiting for job {job_id} to stop")


def env_reset(name: str) -> dict:
    """Instantly wipe OverlayFS upper/work while keeping base rootfs & host data intact."""
    meta = env_load(name)
    for job in job_list():
        if job.get("env") == name and job.get("state") in _JOB_ACTIVE:
            job_stop(job["job_id"])
    edir = _env_dir(name)
    for sub in ("upper", "work"):
        target = edir / sub
        if target.exists():
            shutil.rmtree(target)
        target.mkdir(mode=0o755)
    (edir / "merged").mkdir(exist_ok=True, mode=0o755)
    meta["reset_at"] = _utc_now()
    _atomic_write_json(edir / "env.json", meta, 0o644)
    return meta


def env_remove(name: str) -> None:
    env_load(name)
    for job in job_list():
        if job.get("env") == name and job.get("state") in _JOB_ACTIVE:
            job_stop(job["job_id"])
    shutil.rmtree(_env_dir(name))


