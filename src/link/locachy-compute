def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="locachy-compute", description="LOCachy headless compute node CLI.")
    sub = p.add_subparsers(dest="cmd", required=True)

    # image
    p_img = sub.add_parser("image", help="Manage read-only base rootfs images")
    sub_img = p_img.add_subparsers(dest="img_cmd", required=True)
    sp = sub_img.add_parser("import", help="Import rootfs directory, tarball, or OCI/Docker save tar")
    sp.add_argument("name")
    sp.add_argument("source")
    sp = sub_img.add_parser("list", help="List imported images")
    sp.add_argument("--json", action="store_true")
    sp = sub_img.add_parser("remove", help="Remove an unused image")
    sp.add_argument("name")

    # env
    p_env = sub.add_parser("env", help="Manage OverlayFS compute environments")
    sub_env = p_env.add_subparsers(dest="env_cmd", required=True)
    sp = sub_env.add_parser("create", help="Create a compute environment over a base image")
    sp.add_argument("name")
    sp.add_argument("--image", required=True)
    sp.add_argument("--gpu", action="store_true")
    sp.add_argument("--net", choices=("locachy-net", "none"), default="locachy-net")
    sp.add_argument("--mount", action="append", default=[])
    sp.add_argument("--volume", action="append", default=[], help="Storage volume NAME[:CONTAINER_PATH[:ro|rw]]")
    sp.add_argument("--memory", default="")
    sp.add_argument("--cpu", default="")
    sp.add_argument("--workdir", default="/")
    sp.add_argument("--env", action="append", default=[])
    sp = sub_env.add_parser("list", help="List compute environments")
    sp.add_argument("--json", action="store_true")
    sp = sub_env.add_parser("reset", help="Wipe OverlayFS upper/work while preserving base rootfs & data")
    sp.add_argument("name")
    sp = sub_env.add_parser("remove", help="Remove a compute environment")
    sp.add_argument("name")

    # run
    sp = sub.add_parser("run", help="Run a command in a native compute container")
    sp.add_argument("env_name")
    sp.add_argument("--gpu", dest="gpu", action="store_true", default=None)
    sp.add_argument("--no-gpu", dest="gpu", action="store_false")
    sp.add_argument("--net", choices=("locachy-net", "none"), default=None)
    sp.add_argument("--mount", action="append", default=[])
    sp.add_argument("--volume", action="append", default=[], help="Storage volume NAME[:CONTAINER_PATH[:ro|rw]]")
    sp.add_argument("--workdir", default=None)
    sp.add_argument("--env", action="append", default=[])
    sp.add_argument("--memory", default=None)
    sp.add_argument("--cpu", default=None)
    sp.add_argument("--job-id", default=None)
    sp.add_argument("--detach", action="store_true")
    sp.add_argument("command", nargs="*")

    # shell
    sp = sub.add_parser("shell", help="Open an interactive shell in a compute container or micro-VM")
    sp.add_argument("name")
    sp.add_argument("--kind", choices=("auto", "env", "vm"), default="auto")
    sp.add_argument("--gpu", dest="gpu", action="store_true", default=None)
    sp.add_argument("--no-gpu", dest="gpu", action="store_false")
    sp.add_argument("--net", choices=("locachy-net", "none"), default=None)
    sp.add_argument("--mount", action="append", default=[])
    sp.add_argument("--volume", action="append", default=[], help="Storage volume NAME[:CONTAINER_PATH[:ro|rw]]")
    sp.add_argument("--workdir", default=None)
    sp.add_argument("--env", action="append", default=[])
    sp.add_argument("--memory", default=None)
    sp.add_argument("--cpu", default=None)
    sp.add_argument("--console", action="store_true", help="Attach to VM serial Unix socket instead of SSH")
    sp.add_argument("-u", "--user", default="", help="SSH user override for VM shell")
    sp.add_argument("-i", "--identity", default="", help="SSH identity key path override for VM shell")
    sp.add_argument("command", nargs="*")

    # ssh-config
    sp = sub.add_parser("ssh-config", help="Generate OpenSSH ProxyJump config for this node, containers, and VMs")
    sp.add_argument("--host", default="", help="Host address or DNS name (default: tailscale0 or LAN IPv4)")
    sp.add_argument("--user", default="", help="SSH login user on the compute host")
    sp.add_argument("--port", type=int, default=None, help="SSH port on the compute host (default: rc.conf ssh_port or 22)")
    sp.add_argument("--prefix", default="", help="Host alias prefix (default: local hostname)")
    sp.add_argument("--no-sudo", action="store_true", help="Omit sudo from container RemoteCommand")
    sp.add_argument("--json", action="store_true")

    # job
    p_job = sub.add_parser("job", help="Inspect or stop compute jobs")
    sub_job = p_job.add_subparsers(dest="job_cmd", required=True)
    sp = sub_job.add_parser("list")
    sp.add_argument("--json", action="store_true")
    sp = sub_job.add_parser("status")
    sp.add_argument("job_id")
    sp.add_argument("--json", action="store_true")
    sp = sub_job.add_parser("log")
    sp.add_argument("job_id")
    sp = sub_job.add_parser("stop")
    sp.add_argument("job_id")

    # vm
    p_vm = sub.add_parser("vm", help="Manage optional KVM micro-VMs")
    sub_vm = p_vm.add_subparsers(dest="vm_cmd", required=True)
    sp = sub_vm.add_parser("create")
    sp.add_argument("name")
    sp.add_argument("--disk", required=True, help="Read-only base qcow2 image")
    sp.add_argument("--memory-mb", type=int, default=2048)
    sp.add_argument("--cpus", type=int, default=2)
    sp.add_argument("--share", action="append", default=[], help="HOST_DIR:TAG[:ro|rw] directory share")
    sp.add_argument("--volume", action="append", default=[], help="Storage volume NAME[:TAG[:ro|rw]] (role shared or compute)")
    sp.add_argument("--cloud-init", default="")
    sp.add_argument("--net", choices=("user", "none"), default="user")
    sp.add_argument(
        "--ssh-port",
        type=int,
        default=None,
        help="Loopback TCP port forwarded to guest :22 (0 disables; default auto-allocates 2222..2999 for --net user)",
    )
    sp.add_argument("--ssh-user", default="", help="Default SSH login username for this VM")
    sp = sub_vm.add_parser("cmd", help="Print the QEMU argv for a VM")
    sp.add_argument("name")
    sp.add_argument("--display", default="none", choices=VM_DISPLAYS)
    sp.add_argument("--qmp-sock", default="", help="Absolute QMP socket path (default: the run directory's qmp.sock)")
    sp.add_argument("--json", action="store_true")
    sp = sub_vm.add_parser("run", help="Run a VM in the foreground (locachy-app starts it in the app's cgroup)")
    sp.add_argument("name")
    sp.add_argument("--display", default="none", choices=VM_DISPLAYS)
    sp.add_argument("--qmp-sock", default="")
    sp = sub_vm.add_parser("export-app", help="Write /etc/locachy/containers/APP.conf so Home shows the VM")
    sp.add_argument("name")
    sp.add_argument("--app-name", default="", help="App name (default vm-NAME)")
    sp.add_argument("--display", default="gtk", choices=("gtk", "sdl"))
    sp.add_argument("--freeze", default="qmp", choices=VM_FREEZE)
    sp.add_argument("--network", default="0", choices=("0", "1"))
    sp = sub_vm.add_parser("list")
    sp.add_argument("--json", action="store_true")
    sp = sub_vm.add_parser("start")
    sp.add_argument("name")
    sp = sub_vm.add_parser("stop")
    sp.add_argument("name")
    sp = sub_vm.add_parser("reset")
    sp.add_argument("name")
    sp = sub_vm.add_parser("remove")
    sp.add_argument("name")

    # status
    sp = sub.add_parser("status", help="Show live compute node status, storage, GPU, and inventory")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--tsv", action="store_true")

    # gpu
    sp = sub.add_parser("gpu-probe", help="Show detected GPU devices and NVIDIA libraries")
    sp.add_argument("--json", action="store_true")

    # storage
    sp = sub.add_parser("storage", help="Show active compute_storage volume, compute base, and bindable volumes")
    sp.add_argument("--json", action="store_true")

    # serve
    sp = sub.add_parser("serve", help="Run mTLS HTTPS compute control plane")
    sp.add_argument("--port", type=int, default=DEFAULT_PORT)
    sp.add_argument("--bind", action="append", default=[], help="Explicit bind address (no wildcards)")
    sp.add_argument("--bind-tb", action="store_true", help="Also bind thunderbolt-net fe80:: link-local")
    sp.add_argument("--tb-iface", action="append", default=[], help="Explicit interface treated as TB (testing)")
    sp.add_argument("--allow-loopback-test", action="store_true", help="Allow 127.0.0.1/::1 bind for tests")
    sp.add_argument("--ready-file", default=None, help="Write JSON readiness marker once bound")

    # remote
    p_rem = sub.add_parser("remote", help="Talk to a remote LOCachy compute node via mTLS")
    p_rem.add_argument("--creds-dir", required=True)
    p_rem.add_argument("--host", required=True)
    p_rem.add_argument("--port", type=int, default=DEFAULT_PORT)
    p_rem.add_argument("--scope-iface", default="")
    sub_rem = p_rem.add_subparsers(dest="rem_cmd", required=True)
    sub_rem.add_parser("health")
    sub_rem.add_parser("envs")
    sp = sub_rem.add_parser("reset")
    sp.add_argument("env_name")
    sub_rem.add_parser("jobs")
    sp = sub_rem.add_parser("run")
    sp.add_argument("env_name")
    sp.add_argument("command", nargs=argparse.REMAINDER)
    sp = sub_rem.add_parser("job-status")
    sp.add_argument("job_id")
    sp = sub_rem.add_parser("job-log")
    sp.add_argument("job_id")
    sp = sub_rem.add_parser("job-stop")
    sp.add_argument("job_id")
    sub_rem.add_parser("vms")
    sp = sub_rem.add_parser("vm-start")
    sp.add_argument("vm_name")
    sp = sub_rem.add_parser("vm-stop")
    sp.add_argument("vm_name")

    return p


def _parse_cli(parser: argparse.ArgumentParser, argv: list[str] | None) -> argparse.Namespace:
    """`run ENV [options] -- COMMAND` and `shell TARGET [options] -- COMMAND`:
    everything after the first '--' is the command to execute.

    argparse's REMAINDER positional would take the options that follow the
    target name, so the split happens before parsing.
    """
    tokens = list(sys.argv[1:] if argv is None else argv)
    if tokens[:1] in (["run"], ["shell"]) and "--" in tokens[1:]:
        cut = tokens.index("--", 1)
        args = parser.parse_args(tokens[:cut])
        args.command = tokens[cut + 1 :]
        return args
    return parser.parse_args(tokens)


def main(argv: list[str] | None = None) -> int:
    if (sys.argv[1:] if argv is None else argv) == ["_supervise-job"]:
        return _job_supervisor_main()
    parser = build_parser()
    args = _parse_cli(parser, argv)
    try:
        if args.cmd == "image":
            if args.img_cmd == "import":
                meta = image_import(args.name, args.source)
                print(json.dumps(meta, sort_keys=True))
            elif args.img_cmd == "list":
                items = image_list()
                if args.json:
                    print(json.dumps(items, indent=2, sort_keys=True))
                else:
                    for it in items:
                        print(f"{it['name']}\t{it.get('imported_at', '')}\t{it.get('source', '')}")
            elif args.img_cmd == "remove":
                image_remove(args.name)
            return 0

        if args.cmd == "env":
            if args.env_cmd == "create":
                meta = env_create(
                    args.name,
                    args.image,
                    gpu=args.gpu,
                    net=args.net,
                    mounts=args.mount,
                    volumes=args.volume,
                    memory_max=args.memory,
                    cpu_max=args.cpu,
                    workdir=args.workdir,
                    env_vars=args.env,
                )
                print(json.dumps(meta, sort_keys=True))
            elif args.env_cmd == "list":
                items = env_list()
                if args.json:
                    print(json.dumps(items, indent=2, sort_keys=True))
                else:
                    for it in items:
                        print(f"{it['name']}\t{it['image']}\tgpu={int(it['gpu'])}\tnet={it['net']}")
            elif args.env_cmd == "reset":
                meta = env_reset(args.name)
                print(json.dumps(meta, sort_keys=True))
            elif args.env_cmd == "remove":
                env_remove(args.name)
            return 0

        if args.cmd == "run":
            cmd = list(args.command)
            if cmd and cmd[0] == "--":
                cmd = cmd[1:]
            rec = run_container(
                args.env_name,
                cmd,
                gpu_override=args.gpu,
                net_override=args.net,
                extra_mounts=args.mount,
                extra_volumes=args.volume,
                workdir_override=args.workdir,
                extra_env=args.env,
                memory_override=args.memory,
                cpu_override=args.cpu,
                job_id=args.job_id,
                detach=args.detach,
            )
            if args.detach:
                print(json.dumps(rec, sort_keys=True))
                return 0
            if rec.get("launch_error"):
                print(f"locachy-compute: {rec['launch_error']}", file=sys.stderr)
            if rec.get("supervisor_error"):
                print(f"locachy-compute: {rec['supervisor_error']}", file=sys.stderr)
            if rec.get("cleanup_error"):
                print(f"locachy-compute: {rec['cleanup_error']}", file=sys.stderr)
            rc = rec["exit_code"]
            if rc is None or (rc == 0 and rec["state"] == "failed"):
                return 1
            return rc if rc >= 0 else 128 - rc

        if args.cmd == "shell":
            cmd = list(args.command)
            if cmd and cmd[0] == "--":
                cmd = cmd[1:]
            kind = resolve_shell_kind(args.name, args.kind)
            if kind == "env":
                if args.console or args.user or args.identity:
                    raise ComputeError("--console, --user and --identity apply to VM shells only")
                return shell_container(
                    args.name,
                    cmd or None,
                    gpu_override=args.gpu,
                    net_override=args.net,
                    extra_mounts=args.mount,
                    extra_volumes=args.volume,
                    workdir_override=args.workdir,
                    extra_env=args.env,
                    memory_override=args.memory,
                    cpu_override=args.cpu,
                )
            if args.gpu is not None or args.net is not None or args.mount or args.volume or args.workdir is not None \
                    or args.env or args.memory is not None or args.cpu is not None:
                raise ComputeError("container options (--gpu, --net, --mount, --volume, --workdir, --env, --memory, --cpu) apply to env shells only")
            return shell_vm(
                args.name,
                cmd or None,
                console=args.console,
                user=args.user,
                identity=args.identity,
            )

        if args.cmd == "ssh-config":
            cfg = ssh_config_generate(
                host=args.host,
                user=args.user,
                port=args.port,
                prefix=args.prefix,
                no_sudo=args.no_sudo,
            )
            if args.json:
                print(json.dumps(cfg, indent=2, sort_keys=True))
            else:
                sys.stdout.write(cfg["config"])
            return 0

        if args.cmd == "job":
            if args.job_cmd == "list":
                items = job_list()
                if args.json:
                    print(json.dumps(items, indent=2, sort_keys=True))
                else:
                    for it in items:
                        print(f"{it['job_id']}\t{it['env']}\t{it['state']}\texit={it.get('exit_code')}")
            elif args.job_cmd == "status":
                rec = job_load(args.job_id)
                print(json.dumps(rec, indent=2 if args.json else None, sort_keys=True))
            elif args.job_cmd == "log":
                job_load(args.job_id)
                lpath = _job_log_file(args.job_id)
                if lpath.is_file():
                    sys.stdout.write(lpath.read_text(encoding="utf-8", errors="replace"))
            elif args.job_cmd == "stop":
                print(json.dumps(job_stop(args.job_id), sort_keys=True))
            return 0

        if args.cmd == "vm":
            if args.vm_cmd == "create":
                meta = vm_create(
                    args.name,
                    args.disk,
                    memory_mb=args.memory_mb,
                    cpus=args.cpus,
                    shares=args.share,
                    volumes=args.volume,
                    cloud_init=args.cloud_init,
                    net=args.net,
                    ssh_port=args.ssh_port,
                    ssh_user=args.ssh_user,
                )
                print(json.dumps(meta, sort_keys=True))
            elif args.vm_cmd == "cmd":
                argv_out = _vm_run_argv(vm_load(args.name), args.display, args.qmp_sock)
                if args.json:
                    print(json.dumps(argv_out))
                else:
                    print(" ".join(shlex.quote(a) for a in argv_out))
            elif args.vm_cmd == "run":
                return vm_run(args.name, display=args.display, qmp_sock=args.qmp_sock)
            elif args.vm_cmd == "export-app":
                print(json.dumps(
                    vm_export_app(
                        args.name,
                        app_name=args.app_name,
                        display=args.display,
                        freeze=args.freeze,
                        network=args.network == "1",
                    ),
                    sort_keys=True,
                ))
            elif args.vm_cmd == "list":
                items = vm_list()
                if args.json:
                    print(json.dumps(items, indent=2, sort_keys=True))
                else:
                    for it in items:
                        ssh_port = int(it.get("ssh_port") or 0)
                        ssh_suffix = f"\tssh=127.0.0.1:{ssh_port}" if ssh_port > 0 else ""
                        print(f"{it['name']}\t{'running' if it['running'] else 'stopped'}\t{it['memory_mb']}M\t{it['cpus']}cpu{ssh_suffix}")
            elif args.vm_cmd == "start":
                print(json.dumps(vm_start(args.name), sort_keys=True))
            elif args.vm_cmd == "stop":
                print(json.dumps(vm_stop(args.name), sort_keys=True))
            elif args.vm_cmd == "reset":
                print(json.dumps(vm_reset(args.name), sort_keys=True))
            elif args.vm_cmd == "remove":
                vm_remove(args.name)
            return 0

        if args.cmd == "status":
            st_info = node_status()
            if args.json:
                print(json.dumps(st_info, indent=2, sort_keys=True))
            elif args.tsv:
                stor = st_info["storage"]
                gpu = st_info["gpu"]
                ssh = st_info["ssh"]
                for k, v in (
                    ("service_enabled", int(st_info["service_enabled"])),
                    ("daemon_running", int(st_info["daemon_running"])),
                    ("port", st_info["port"]),
                    ("bind_tb", int(st_info["bind_tb"])),
                    ("gpu_enabled", int(st_info["gpu_enabled"])),
                    ("storage_volume", stor["volume"]),
                    ("storage_mounted", int(stor["mounted"])),
                    ("storage_base", stor["base"]),
                    ("storage_free", stor["free_bytes"]),
                    ("storage_total", stor["total_bytes"]),
                    ("storage_error", stor["error"]),
                    ("gpu_devices", gpu["devices"]),
                    ("gpu_libs", gpu["nvidia_libs"]),
                    ("nvidia_version", gpu["nvidia_version"]),
                    ("paired_peers", st_info["paired_peers"]),
                    ("ssh_host", ssh["host"]),
                    ("ssh_user", ssh["user"]),
                    ("ssh_port", ssh["port"]),
                    ("ssh_prefix", ssh["prefix"]),
                ):
                    print(f"meta\t{k}\t{_tsv_clean(v, 240)}")
                for it in st_info["images"]:
                    print(f"image\t{_tsv_clean(it.get('name', ''), 64)}\t{_tsv_clean(it.get('imported_at', ''), 32)}\t{_tsv_clean(it.get('source', ''), 160)}")
                for it in st_info["envs"]:
                    print(f"env\t{_tsv_clean(it.get('name', ''), 64)}\t{_tsv_clean(it.get('image', ''), 64)}\t{int(bool(it.get('gpu')))}\t{_tsv_clean(it.get('net', 'none'), 24)}")
                for it in st_info["jobs"]:
                    cmd_txt = " ".join(str(x) for x in (it.get("command") or []))
                    ec = "" if it.get("exit_code") is None else str(it.get("exit_code"))
                    print(f"job\t{_tsv_clean(it.get('job_id', ''), 64)}\t{_tsv_clean(it.get('env', ''), 64)}\t{_tsv_clean(it.get('state', ''), 24)}\t{ec}\t{_tsv_clean(cmd_txt, 120)}")
                for it in st_info["vms"]:
                    print(
                        f"vm\t{_tsv_clean(it.get('name', ''), 64)}\t{int(bool(it.get('running')))}\t"
                        f"{int(it.get('memory_mb') or 0)}\t{int(it.get('cpus') or 0)}\t"
                        f"{int(it.get('ssh_port') or 0)}\t{_tsv_clean(it.get('ssh_user', ''), 64)}"
                    )
            else:
                stor = st_info["storage"]
                gpu = st_info["gpu"]
                cnt = st_info["counts"]
                print(
                    f"api: {'enabled' if st_info['service_enabled'] else 'disabled'} "
                    f"({'running' if st_info['daemon_running'] else 'stopped'}, port={st_info['port']}, "
                    f"tb={'on' if st_info['bind_tb'] else 'off'}, paired={st_info['paired_peers']})"
                )
                print(
                    f"storage: {stor['volume'] or 'root'} "
                    f"({'mounted' if stor['mounted'] else 'UNMOUNTED'}"
                    + (f", {stor['base']}" if stor["base"] else f", {stor['error']}")
                    + ")"
                )
                print(
                    f"gpu: {'enabled' if st_info['gpu_enabled'] else 'disabled'} "
                    f"(devices={gpu['devices']}, nvidia_libs={gpu['nvidia_libs']}"
                    + (f", nvidia={gpu['nvidia_version']}" if gpu["nvidia_version"] else "")
                    + ")"
                )
                print(
                    f"inventory: images={cnt['images']} envs={cnt['envs']} "
                    f"jobs={cnt['jobs_running']}/{cnt['jobs_total']} vms={cnt['vms_running']}/{cnt['vms_total']}"
                )
            return 0

        if args.cmd == "gpu-probe":
            info = discover_gpu_resources()
            if args.json:
                print(json.dumps(info, indent=2, sort_keys=True))
            else:
                print(f"devices={len(info['devices'])} nvidia_libs={len(info['nvidia_libs'])}")
                for d in info["devices"]:
                    print(f"  dev {d}")
            return 0

        if args.cmd == "storage":
            info = _storage_summary()
            if args.json:
                print(json.dumps(info, indent=2, sort_keys=True))
            else:
                print(f"storage_volume: {info['storage_volume'] or 'none (root)'}")
                print(f"compute_base: {info['compute_base']}")
                for v in info["available_volumes"]:
                    m = "mounted" if v["mounted"] else "unmounted"
                    print(f"  {v['name']}\trole={v['role']}\t{m}\t{v['mountpoint']}")
            return 0

        if args.cmd == "serve":
            rc_vals = read_rc_conf()
            tb = args.bind_tb or rc_vals.get("compute_bind_tb") == "1"
            return serve_daemon(
                port=args.port,
                explicit_binds=args.bind or None,
                bind_tb=tb,
                allow_loopback=args.allow_loopback_test,
                tb_ifaces_override=args.tb_iface or None,
                ready_file=args.ready_file,
            )

        if args.cmd == "remote":
            cdir = Path(args.creds_dir)
            if args.rem_cmd == "health":
                st, data = remote_request(cdir, args.host, args.port, "GET", "/v1/health", scope_iface=args.scope_iface)
            elif args.rem_cmd == "envs":
                st, data = remote_request(cdir, args.host, args.port, "GET", "/v1/envs", scope_iface=args.scope_iface)
            elif args.rem_cmd == "reset":
                st, data = remote_request(cdir, args.host, args.port, "POST", f"/v1/envs/{args.env_name}/reset", {}, scope_iface=args.scope_iface)
            elif args.rem_cmd == "jobs":
                st, data = remote_request(cdir, args.host, args.port, "GET", "/v1/jobs", scope_iface=args.scope_iface)
            elif args.rem_cmd == "run":
                cmd = list(args.command)
                if cmd and cmd[0] == "--":
                    cmd = cmd[1:]
                st, data = remote_request(
                    cdir, args.host, args.port, "POST", "/v1/jobs",
                    {"env": args.env_name, "command": cmd}, scope_iface=args.scope_iface,
                )
            elif args.rem_cmd == "job-status":
                st, data = remote_request(cdir, args.host, args.port, "GET", f"/v1/jobs/{args.job_id}", scope_iface=args.scope_iface)
            elif args.rem_cmd == "job-log":
                st, data = remote_request(cdir, args.host, args.port, "GET", f"/v1/jobs/{args.job_id}/log", scope_iface=args.scope_iface)
            elif args.rem_cmd == "job-stop":
                st, data = remote_request(cdir, args.host, args.port, "POST", f"/v1/jobs/{args.job_id}/stop", {}, scope_iface=args.scope_iface)
            elif args.rem_cmd == "vms":
                st, data = remote_request(cdir, args.host, args.port, "GET", "/v1/vms", scope_iface=args.scope_iface)
            elif args.rem_cmd == "vm-start":
                st, data = remote_request(cdir, args.host, args.port, "POST", f"/v1/vms/{args.vm_name}/start", {}, scope_iface=args.scope_iface)
            elif args.rem_cmd == "vm-stop":
                st, data = remote_request(cdir, args.host, args.port, "POST", f"/v1/vms/{args.vm_name}/stop", {}, scope_iface=args.scope_iface)
            else:
                raise ComputeError(f"unknown remote command: {args.rem_cmd}")
            print(json.dumps(data, indent=2, sort_keys=True))
            return 0 if 200 <= st < 300 else 1

    except (ComputeError, peers_mod.PeerStoreError, ssl.SSLError, OSError) as exc:
        print(f"locachy-compute: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
