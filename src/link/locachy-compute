NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
MEM_RE = re.compile(r"^(max|[0-9]+[KMGkmg]?)$")
CPU_RE = re.compile(r"^(max|[0-9]+)\s+[0-9]+$")

FORBIDDEN_HOST_MOUNT_ROOTS = (
    "/etc/locachy/peers",
    "/var/lib/locachy/compute",
    "/var/lib/locachy/containers",
    "/run/locachy/extdisplay-broker",
    "/proc",
    "/sys",
    "/dev",
)

NVIDIA_LIB_PATTERNS = (
    "libcuda.so*",
    "libnvidia-*.so*",
    "libnvcuvid.so*",
