#!/usr/bin/env python3
"""Maintain LOCachy's UEFI entry with efibootmgr, never raw variable writes.

locachy-efi [--esp /efi] [--first] [--ensure-first [--keep-windows-first]]
locachy-efi --bootnext-entry --disk DEV --part N --partuuid UUID
            --label NAME --loader PATH [--esp /efi]
locachy-efi --windows-first --disk DEV --part N --partuuid UUID [--esp /efi]
locachy-efi --remove-entry --label NAME [--partuuid UUID]

--first is the installer's: put this entry first, preserving other entries.
--ensure-first heals BootOrder so LOCachy is first and strips Maintenance
Windows entries from BootOrder (Layer 4 protection).
--windows-first puts a "LOCachy Maintenance Windows (default)" entry first and
LOCachy second (locachy-winmaint boot-default windows). With
--keep-windows-first, --ensure-first keeps that entry first while it still
precedes LOCachy in BootOrder; when it no longer does (Windows' "Return to
LOCachy" put LOCachy first, or the firmware dropped it) LOCachy is made first
as usual and the exit status is 3.
Normal boot-image updates keep the existing order (append if missing).
"""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import uuid

EFI = Path("/sys/firmware/efi")
EFIVARS = EFI / "efivars"
LABEL = "LOCachy"
LOADER = r"\EFI\locachy\locachy.efi"
PREV_LABEL = "LOCachy (Previous)"
PREV_LOADER = r"\EFI\locachy\locachy-prev.efi"
WINMAINT_LABEL = "LOCachy Maintenance Windows"
WINMAINT_LOADER = r"\EFI\Microsoft\Boot\bootmgfw.efi"
# The entry that starts Maintenance Windows first while locachy-winmaint's
# "Windows first" mode is set; the Windows-side guard reads this description.
WINFIRST_LABEL = "LOCachy Maintenance Windows (default)"
# --ensure-first --keep-windows-first: the Windows-first entry no longer
# preceded LOCachy, so LOCachy was made first.
RELEASED = 3
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"


def command(args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=30,
                            stdin=subprocess.DEVNULL, env=dict(os.environ, LC_ALL="C"))
    if result.returncode:
        raise RuntimeError(" ".join(args) + ": " + (result.stderr.strip() or f"status {result.returncode}"))
    return result.stdout


def mounted(path):
    data = json.loads(command(["findmnt", "--json", "--mountpoint", str(path),
                               "--output", "TARGET,SOURCE,FSTYPE,OPTIONS,MAJ:MIN"]))
    mounts = data.get("filesystems", [])
    if len(mounts) != 1 or Path(mounts[0]["target"]) != path:
        raise RuntimeError(f"{path}: an explicit filesystem mount is required")
    return mounts[0]


def private_namespace():
    """Whether this process's mount namespace is not process 1's."""
    try:
        return os.readlink("/proc/self/ns/mnt") != os.readlink("/proc/1/ns/mnt")
    except OSError:
        return False


def variables_mount():
    """The EFI variables' mount. Under `ip netns exec` (pacman's downloads in
    locachy-net, so every hook pacman runs: make.sh --boot, locachy-boot, this)
    /sys is a sysfs of that network namespace's own, without efivarfs. There,
    in that private mount namespace and never in the system's, it is mounted
    again as process 1 mounts it at boot (init.c, switch_root)."""
    try:
        return mounted(EFIVARS)
    except RuntimeError:
        if not private_namespace():
            raise RuntimeError(f"{EFIVARS}: efivarfs is not mounted") from None
    command(["mount", "-t", "efivarfs", "-o", "nosuid,nodev,noexec", "efivarfs", str(EFIVARS)])
    return mounted(EFIVARS)


def block(path):
    data = json.loads(command(["lsblk", "--json", "--nodeps", "--paths", "--properties-by", "blkid", "--output",
                               "PATH,TYPE,PKNAME,PARTN,PARTUUID,PARTTYPE,PTTYPE,MAJ:MIN", path]))
    devices = data.get("blockdevices", [])
    if len(devices) != 1:
        raise RuntimeError(f"{path}: one block device is required")
    return devices[0]


def esp_target(path):
    path = Path(os.path.abspath(path))
    if path.resolve() != path:
        raise RuntimeError(f"{path}: linked mount paths are not accepted")
    fs = mounted(path)
    if fs.get("fstype") != "vfat":
        raise RuntimeError(f"{path}: not a FAT ESP")
    loader = path / "EFI/locachy/locachy.efi"
    if not loader.is_file() or loader.resolve() != loader:
        raise RuntimeError(f"{loader}: installed, non-linked boot image required")
    source = os.path.realpath(fs["source"])
    info = os.stat(source)
    if not stat.S_ISBLK(info.st_mode) or f"{os.major(info.st_rdev)}:{os.minor(info.st_rdev)}" != fs.get("maj:min"):
        raise RuntimeError(f"{source}: mount/block identity mismatch")
    part = block(source)
    if part.get("type") != "part" or part.get("maj:min") != fs.get("maj:min") or \
            str(part.get("parttype", "")).lower() != ESP_TYPE or part.get("pttype") != "gpt":
        raise RuntimeError(f"{source}: a GPT EFI System Partition is required")
    try:
        number = int(part["partn"])
        guid = str(uuid.UUID(part["partuuid"]))
    except (KeyError, ValueError, TypeError) as e:
        raise RuntimeError(f"{source}: missing partition number or GPT UUID") from e
    parent = part.get("pkname") or ""
    if number < 1 or not parent.startswith("/dev/") or block(parent).get("type") != "disk":
        raise RuntimeError(f"{source}: unsupported parent disk")
    return parent, number, guid


def parse_entries(text, labels=None):
    """Parse BootOrder, BootNext and HD(...,GPT,...) entries from efibootmgr -v."""
    order = []
    bootnext = None
    found = []
    for line in text.splitlines():
        if line.startswith("BootOrder:"):
            value = line.partition(":")[2].strip()
            if value and not re.fullmatch(r"[0-9a-fA-F]{4}(?:,[0-9a-fA-F]{4})*", value):
                raise RuntimeError("efibootmgr returned an invalid BootOrder")
            order = [n.upper() for n in value.split(",")] if value else []
            continue
        if line.startswith("BootNext:"):
            value = line.partition(":")[2].strip()
            if re.fullmatch(r"[0-9a-fA-F]{4}", value):
                bootnext = value.upper()
            continue
        match = re.match(r"^Boot([0-9A-Fa-f]{4})(\*)?\s+(.+?)\t(.+)$", line)
        if not match:
            match = re.match(r"^Boot([0-9A-Fa-f]{4})(\*)?\s+(.+?)\s+((?:HD|PciRoot|Pci|VenHw|Acpi|AcpiEx)\(.+)$",
                             line, re.I)
        if not match:
            continue
        label = match[3].strip()
        if labels is not None and label not in labels:
            continue
        devpath = match[4]
        if not re.match(r"(?:HD|PciRoot|Pci|VenHw|Acpi|AcpiEx)\(", devpath, re.I):
            continue
        device = re.search(r"HD\((\d+),GPT,([0-9A-Fa-f-]+),[^)]*\)", devpath, re.I)
        file = re.search(r"File\(([^)]*)\)", devpath, re.I)
        # efibootmgr/libefivar versions print either File(PATH) or /\\PATH.
        path = file[1] if file else devpath[device.end() + 1:].strip() if device else ""
        if device and path.startswith(("\\", "/")):
            found.append({"number": match[1].upper(), "active": bool(match[2]), "label": label,
                          "part": int(device[1]), "guid": device[2].lower(),
                          "loader": path.replace("/", "\\").lower()})
    return order, bootnext, found


def entries(text):
    order, _, found = parse_entries(text, labels=(LABEL, PREV_LABEL))
    return order, found


def require_writable_efivars():
    if not EFI.is_dir():
        raise RuntimeError("not booted in UEFI mode")
    variables = variables_mount()
    if variables.get("fstype") != "efivarfs" or "rw" not in variables.get("options", "").split(",") or \
            not os.access(EFIVARS, os.W_OK):
        raise RuntimeError("EFI variables are unavailable or read-only")


# Every registration's read-modify-write of NVRAM under one lock. Fixed: a test
# harness may assign another path to this name, nothing at run time does.
EFI_LOCK_PATH = "/run/locachy/efi.lock"


def efi_lock():
    path = EFI_LOCK_PATH
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def register(esp, first=False):
    lock = efi_lock()
    try:
        return _register(esp, first)
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        os.close(lock)


def _register(esp, first=False, strip_winmaint=False, winmaint_guid=None, keep_windows_first=False,
              windows_first=None):
    """LOCachy's entries registered and placed. windows_first: a Boot#### placed
    before them (set_windows_first). keep_windows_first: keep the Windows-first
    entry before them while it still precedes LOCachy, else return RELEASED."""
    esp_path = Path(os.path.abspath(esp))
    disk, partition, guid = esp_target(esp_path)
    prev_file = esp_path / "EFI/locachy/locachy-prev.efi"
    if prev_file.is_symlink():
        raise RuntimeError(f"{prev_file}: linked boot image is not accepted")
    want_prev = prev_file.is_file() and prev_file.resolve() == prev_file
    require_writable_efivars()

    def matches(item, label=LABEL, loader=LOADER):
        return (item.get("label", LABEL) == label and item["part"] == partition and
                item["guid"] == guid and item["loader"] == loader.lower())

    def ensure_entry(label, loader, current_order, current_entries):
        exact = [item for item in current_entries if matches(item, label, loader)]
        if not exact:
            if [item for item in current_entries if item.get("label", LABEL) == label]:
                print(f"locachy-efi: other {label} entries point elsewhere; left untouched")
            command(["efibootmgr", "--create-only", "--disk", disk, "--part", str(partition),
                     "--label", label, "--loader", loader])
            _, current_entries = entries(command(["efibootmgr", "--verbose"]))
            exact = [item for item in current_entries if matches(item, label, loader)]
            if not exact:
                raise RuntimeError(f"firmware did not retain the new {label} entry")
        item = next((item for item in exact if item["number"] in current_order), exact[0])
        if not item["active"]:
            command(["efibootmgr", "--bootnum", item["number"], "--active"])
        return item["number"], current_entries

    raw = command(["efibootmgr", "--verbose"])
    order, _, every_entry = parse_entries(raw)
    all_entries = [i for i in every_entry if i["label"] in (LABEL, PREV_LABEL)]
    number, all_entries = ensure_entry(LABEL, LOADER, order, all_entries)
    prev_number = None
    if want_prev:
        prev_number, all_entries = ensure_entry(PREV_LABEL, PREV_LOADER, order, all_entries)

    drop = set()
    wf_number = windows_first
    if strip_winmaint:
        wguid = winmaint_guid.lower() if winmaint_guid else None
        if wf_number is None and keep_windows_first:
            # Windows first only while its entry precedes LOCachy in BootOrder.
            ahead = [item["number"] for item in every_entry
                     if item["label"] == WINFIRST_LABEL and (wguid is None or item["guid"] == wguid) and
                     item["number"] in order and (number not in order or order.index(item["number"]) < order.index(number))]
            if ahead:
                wf_number = min(ahead, key=order.index)
        for item in every_entry:
            if item["label"] in (WINMAINT_LABEL, WINFIRST_LABEL) or (wguid and item["guid"] == wguid):
                if item["number"] not in (number, prev_number, wf_number):
                    drop.add(item["number"])

    if first:
        head = ([wf_number] if wf_number else []) + [number] + ([prev_number] if prev_number else [])
        wanted = head + [n for n in order if n not in head and n not in drop]
    else:
        wanted = [n for n in order if n not in drop]
        if number not in wanted:
            wanted.append(number)
        if prev_number and prev_number not in wanted:
            idx = wanted.index(number) + 1
            wanted.insert(idx, prev_number)
    if wanted != order:
        command(["efibootmgr", "--bootorder", ",".join(wanted)])
    actual_order, actual = entries(command(["efibootmgr", "--verbose"]))
    if actual_order != wanted or not any(matches(i) and i["number"] == number and i["active"] for i in actual) or \
            (prev_number and not any(matches(i, PREV_LABEL, PREV_LOADER) and
                                     i["number"] == prev_number and i["active"] for i in actual)):
        raise RuntimeError("firmware did not retain the requested LOCachy entry/order")
    extra = f", Boot{prev_number} {PREV_LABEL} {PREV_LOADER}" if prev_number else ""
    if first and wf_number:
        where = f"second in BootOrder, behind Boot{wf_number} {WINFIRST_LABEL}"
    else:
        where = "first in BootOrder" if first else "BootOrder preserved" if wanted == order else "added to BootOrder"
    print(f"locachy-efi: Boot{number} {LABEL}, {disk} partition {partition} {LOADER}{extra}; {where}")
    if keep_windows_first and windows_first is None and wf_number is None:
        print(f"locachy-efi: {WINFIRST_LABEL} no longer preceded {LABEL}; {LABEL} is first again")
        return RELEASED
    return 0


def ensure_first(esp="/efi", winmaint_guid=None, keep_windows_first=False):
    """Layer-4 heal: keep LOCachy first in BootOrder and strip Maintenance
    Windows entries (and any Windows entry on winmaint_guid) from BootOrder.
    keep_windows_first: the Windows-first entry stays first while it precedes
    LOCachy (RELEASED, with LOCachy first, once it does not)."""
    lock = efi_lock()
    try:
        return _register(esp, first=True, strip_winmaint=True, winmaint_guid=winmaint_guid,
                         keep_windows_first=keep_windows_first)
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        os.close(lock)


def set_windows_first(disk, partition, partuuid, esp="/efi", loader=WINMAINT_LOADER):
    """Create or reuse the Windows-first entry on the Maintenance Windows ESP
    and put it first in BootOrder, LOCachy's entries right after it (never
    removed); other Maintenance Windows entries leave BootOrder."""
    if not disk.startswith("/dev/"):
        raise RuntimeError(f"{disk}: disk device path must start with /dev/")
    partition = int(partition)
    if partition < 1:
        raise RuntimeError(f"{partition}: partition number must be >= 1")
    guid = str(uuid.UUID(partuuid)).lower()
    if not loader.startswith("\\"):
        raise RuntimeError(f"{loader}: UEFI loader path must start with backslash")
    lock = efi_lock()
    try:
        require_writable_efivars()
        order, _, every = parse_entries(command(["efibootmgr", "--verbose"]))

        def matches(item):
            return (item["label"] == WINFIRST_LABEL and item["part"] == partition and
                    item["guid"] == guid and item["loader"] == loader.lower())

        exact = [item for item in every if matches(item)]
        if not exact:
            command(["efibootmgr", "--create-only", "--disk", disk, "--part", str(partition),
                     "--label", WINFIRST_LABEL, "--loader", loader])
            order, _, every = parse_entries(command(["efibootmgr", "--verbose"]))
            exact = [item for item in every if matches(item)]
            if not exact:
                raise RuntimeError(f"firmware did not retain the new {WINFIRST_LABEL} entry")
        item = next((item for item in exact if item["number"] in order), exact[0])
        if not item["active"]:
            command(["efibootmgr", "--bootnum", item["number"], "--active"])
        _register(esp, first=True, strip_winmaint=True, winmaint_guid=guid, windows_first=item["number"])
        return item["number"]
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        os.close(lock)


def set_bootnext_entry(disk, partition, partuuid, label=WINMAINT_LABEL, loader=WINMAINT_LOADER, esp=None):
    """Register or reuse a Boot#### entry without placing it in BootOrder,
    verify LOCachy stays first (when esp is given), and set BootNext once."""
    if not disk.startswith("/dev/"):
        raise RuntimeError(f"{disk}: disk device path must start with /dev/")
    partition = int(partition)
    if partition < 1:
        raise RuntimeError(f"{partition}: partition number must be >= 1")
    guid = str(uuid.UUID(partuuid)).lower()
    if not loader.startswith("\\"):
        raise RuntimeError(f"{loader}: UEFI loader path must start with backslash")
    lock = efi_lock()
    try:
        require_writable_efivars()
        if esp is not None:
            _register(esp, first=True, strip_winmaint=True, winmaint_guid=guid)
        raw = command(["efibootmgr", "--verbose"])
        order, _, every = parse_entries(raw)

        def matches(item):
            return (item["label"] == label and item["part"] == partition and
                    item["guid"] == guid and item["loader"] == loader.lower())

        exact = [item for item in every if matches(item)]
        if not exact:
            command(["efibootmgr", "--create-only", "--disk", disk, "--part", str(partition),
                     "--label", label, "--loader", loader])
            order, _, every = parse_entries(command(["efibootmgr", "--verbose"]))
            exact = [item for item in every if matches(item)]
            if not exact:
                raise RuntimeError(f"firmware did not retain the new {label} entry")
        item = exact[0]
        number = item["number"]
        if not item["active"]:
            command(["efibootmgr", "--bootnum", number, "--active"])
        if number in order:
            cleaned = [n for n in order if n != number]
            if cleaned:
                command(["efibootmgr", "--bootorder", ",".join(cleaned)])
        command(["efibootmgr", "--bootnext", number])
        after_order, after_next, _ = parse_entries(command(["efibootmgr", "--verbose"]))
        if after_next != number:
            raise RuntimeError(f"firmware did not retain BootNext={number}")
        if number in after_order:
            raise RuntimeError(f"entry Boot{number} must not remain in BootOrder")
        print(f"locachy-efi: BootNext={number} ({label}, {disk} partition {partition} {loader}); BootOrder unchanged")
        return number
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        os.close(lock)


def remove_entry(label=WINMAINT_LABEL, partuuid=None):
    """Remove matching UEFI entries from BootOrder, BootNext and NVRAM."""
    wguid = str(uuid.UUID(partuuid)).lower() if partuuid else None
    lock = efi_lock()
    try:
        require_writable_efivars()
        order, bootnext, every = parse_entries(command(["efibootmgr", "--verbose"]))
        targets = []
        for item in every:
            if item["label"] in (LABEL, PREV_LABEL):
                continue
            if item["label"] == label and (wguid is None or item["guid"] == wguid):
                targets.append(item["number"])
            elif wguid is not None and item["guid"] == wguid:
                targets.append(item["number"])
        targets = list(dict.fromkeys(targets))
        if not targets:
            return 0
        if bootnext in targets:
            command(["efibootmgr", "--delete-bootnext"])
        new_order = [n for n in order if n not in targets]
        if new_order != order and new_order:
            command(["efibootmgr", "--bootorder", ",".join(new_order)])
        for num in targets:
            command(["efibootmgr", "--bootnum", num, "--delete-bootnum"])
        print(f"locachy-efi: removed entries {', '.join('Boot' + n for n in targets)}")
        return 0
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        os.close(lock)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--esp", default="/efi")
    parser.add_argument("--first", action="store_true")
    parser.add_argument("--ensure-first", action="store_true",
                        help="put LOCachy first in BootOrder and strip Maintenance Windows entries from BootOrder")
    parser.add_argument("--keep-windows-first", action="store_true",
                        help="with --ensure-first, keep the Windows-first entry first while it precedes LOCachy "
                             "(exit status 3 when it no longer does and LOCachy was made first)")
    parser.add_argument("--windows-first", action="store_true",
                        help="put the Maintenance Windows (default) entry first in BootOrder, LOCachy second")
    parser.add_argument("--winmaint-guid", default=None,
                        help="optional Maintenance Windows ESP PARTUUID to strip from BootOrder or delete")
    parser.add_argument("--bootnext-entry", action="store_true",
                        help="create/reuse a BootNext-only entry without adding it to BootOrder")
    parser.add_argument("--remove-entry", action="store_true",
                        help="delete Maintenance Windows UEFI entries by label/PARTUUID")
    parser.add_argument("--disk", default=None)
    parser.add_argument("--part", type=int, default=None)
    parser.add_argument("--partuuid", default=None)
    parser.add_argument("--label", default=WINMAINT_LABEL)
    parser.add_argument("--loader", default=WINMAINT_LOADER)
    parser.add_argument("--no-esp-check", action="store_true",
                        help="with --bootnext-entry, skip re-checking LOCachy /efi entry")
    args = parser.parse_args()
    try:
        if os.geteuid() != 0:
            raise RuntimeError("must run as root")
        if args.bootnext_entry:
            if not args.disk or args.part is None or not args.partuuid:
                raise RuntimeError("--bootnext-entry requires --disk, --part and --partuuid")
            set_bootnext_entry(args.disk, args.part, args.partuuid,
                               label=args.label, loader=args.loader,
                               esp=None if args.no_esp_check else args.esp)
            return 0
        if args.windows_first:
            if not args.disk or args.part is None or not args.partuuid:
                raise RuntimeError("--windows-first requires --disk, --part and --partuuid")
            set_windows_first(args.disk, args.part, args.partuuid, esp=args.esp, loader=args.loader)
            return 0
        if args.remove_entry:
            return remove_entry(label=args.label, partuuid=args.partuuid or args.winmaint_guid)
        if args.ensure_first:
            return ensure_first(args.esp, winmaint_guid=args.winmaint_guid,
                                keep_windows_first=args.keep_windows_first)
        return register(args.esp, args.first)
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as e:
        print(f"locachy-efi: boot entry not ready: {e}; fallback EFI/BOOT/BOOTX64.EFI is retained", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
