#!/usr/bin/env python3
"""Maintain LOCachy's UEFI entry with efibootmgr, never raw variable writes.

locachy-efi [--esp /efi] [--first]
--first is the installer's: put this entry first, preserving other entries.
Normal boot-image updates keep the existing order (append if missing).
"""
import argparse
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import uuid

EFI = Path("/sys/firmware/efi")
EFIVARS = EFI / "efivars"
LABEL = "LOCachy"
LOADER = r"\EFI\locachy\locachy.efi"
PREV_LABEL = "LOCachy (Previous)"
PREV_LOADER = r"\EFI\locachy\locachy-prev.efi"
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"


def command(args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=30,
                            stdin=subprocess.DEVNULL, env=dict(os.environ, LC_ALL="C"))
    if result.returncode:
        raise RuntimeError(" ".join(args) + ": " + (result.stderr.strip() or f"status {result.returncode}"))
    return result.stdout


def mounted(path):
    data = json.loads(command(["findmnt", "--json", "--mountpoint", str(path),
                               "--output", "TARGET,SOURCE,FSTYPE,OPTIONS,MAJ:MIN"]))
    mounts = data.get("filesystems", [])
    if len(mounts) != 1 or Path(mounts[0]["target"]) != path:
        raise RuntimeError(f"{path}: an explicit filesystem mount is required")
    return mounts[0]


def private_namespace():
    """Whether this process's mount namespace is not process 1's."""
    try:
        return os.readlink("/proc/self/ns/mnt") != os.readlink("/proc/1/ns/mnt")
    except OSError:
        return False


def variables_mount():
    """The EFI variables' mount. Under `ip netns exec` (pacman's downloads in
    locachy-net, so every hook pacman runs: make.sh --boot, locachy-boot, this)
    /sys is a sysfs of that network namespace's own, without efivarfs. There,
    in that private mount namespace and never in the system's, it is mounted
    again as process 1 mounts it at boot (init.c, switch_root)."""
    try:
        return mounted(EFIVARS)
    except RuntimeError:
        if not private_namespace():
            raise RuntimeError(f"{EFIVARS}: efivarfs is not mounted") from None
    command(["mount", "-t", "efivarfs", "-o", "nosuid,nodev,noexec", "efivarfs", str(EFIVARS)])
    return mounted(EFIVARS)


def block(path):
    data = json.loads(command(["lsblk", "--json", "--nodeps", "--paths", "--properties-by", "blkid", "--output",
                               "PATH,TYPE,PKNAME,PARTN,PARTUUID,PARTTYPE,PTTYPE,MAJ:MIN", path]))
    devices = data.get("blockdevices", [])
    if len(devices) != 1:
        raise RuntimeError(f"{path}: one block device is required")
    return devices[0]


def esp_target(path):
    path = Path(os.path.abspath(path))
    if path.resolve() != path:
        raise RuntimeError(f"{path}: linked mount paths are not accepted")
    fs = mounted(path)
    if fs.get("fstype") != "vfat":
        raise RuntimeError(f"{path}: not a FAT ESP")
    loader = path / "EFI/locachy/locachy.efi"
    if not loader.is_file() or loader.resolve() != loader:
        raise RuntimeError(f"{loader}: installed, non-linked boot image required")
    source = os.path.realpath(fs["source"])
    info = os.stat(source)
    if not stat.S_ISBLK(info.st_mode) or f"{os.major(info.st_rdev)}:{os.minor(info.st_rdev)}" != fs.get("maj:min"):
        raise RuntimeError(f"{source}: mount/block identity mismatch")
    part = block(source)
    if part.get("type") != "part" or part.get("maj:min") != fs.get("maj:min") or \
            str(part.get("parttype", "")).lower() != ESP_TYPE or part.get("pttype") != "gpt":
        raise RuntimeError(f"{source}: a GPT EFI System Partition is required")
    try:
        number = int(part["partn"])
        guid = str(uuid.UUID(part["partuuid"]))
    except (KeyError, ValueError, TypeError) as e:
        raise RuntimeError(f"{source}: missing partition number or GPT UUID") from e
    parent = part.get("pkname") or ""
    if number < 1 or not parent.startswith("/dev/") or block(parent).get("type") != "disk":
        raise RuntimeError(f"{source}: unsupported parent disk")
    return parent, number, guid


def entries(text):
    order = []
    found = []
    for line in text.splitlines():
        if line.startswith("BootOrder:"):
            value = line.partition(":")[2].strip()
            if value and not re.fullmatch(r"[0-9a-fA-F]{4}(?:,[0-9a-fA-F]{4})*", value):
                raise RuntimeError("efibootmgr returned an invalid BootOrder")
            order = [n.upper() for n in value.split(",")] if value else []
        match = re.match(r"^Boot([0-9A-Fa-f]{4})(\*)?\s+(LOCachy \(Previous\)|LOCachy)\s+(.+)$", line)
        if not match or not re.match(r"(?:HD|PciRoot|Pci|VenHw|Acpi|AcpiEx)\(", match[4], re.I):
            continue
        device = re.search(r"HD\((\d+),GPT,([0-9A-Fa-f-]+),[^)]*\)", match[4], re.I)
        file = re.search(r"File\(([^)]*)\)", match[4], re.I)
        # efibootmgr/libefivar versions print either File(PATH) or /\\PATH.
        path = file[1] if file else match[4][device.end() + 1:].strip() if device else ""
        if device and path.startswith(("\\", "/")):
            found.append({"number": match[1].upper(), "active": bool(match[2]), "label": match[3],
                          "part": int(device[1]), "guid": device[2].lower(),
                          "loader": path.replace("/", "\\").lower()})
    return order, found


def register(esp, first=False):
    esp_path = Path(os.path.abspath(esp))
    disk, partition, guid = esp_target(esp_path)
    prev_file = esp_path / "EFI/locachy/locachy-prev.efi"
    if prev_file.is_symlink():
        raise RuntimeError(f"{prev_file}: linked boot image is not accepted")
    want_prev = prev_file.is_file() and prev_file.resolve() == prev_file
    if not EFI.is_dir():
        raise RuntimeError("not booted in UEFI mode")
    variables = variables_mount()
    if variables.get("fstype") != "efivarfs" or "rw" not in variables.get("options", "").split(",") or \
            not os.access(EFIVARS, os.W_OK):
        raise RuntimeError("EFI variables are unavailable or read-only")

    def matches(item, label=LABEL, loader=LOADER):
        return (item.get("label", LABEL) == label and item["part"] == partition and
                item["guid"] == guid and item["loader"] == loader.lower())

    def ensure_entry(label, loader, current_order, current_entries):
        exact = [item for item in current_entries if matches(item, label, loader)]
        if not exact:
            if [item for item in current_entries if item.get("label", LABEL) == label]:
                print(f"locachy-efi: other {label} entries point elsewhere; left untouched")
            command(["efibootmgr", "--create-only", "--disk", disk, "--part", str(partition),
                     "--label", label, "--loader", loader])
            _, current_entries = entries(command(["efibootmgr", "--verbose"]))
            exact = [item for item in current_entries if matches(item, label, loader)]
            if not exact:
                raise RuntimeError(f"firmware did not retain the new {label} entry")
        item = next((item for item in exact if item["number"] in current_order), exact[0])
        if not item["active"]:
            command(["efibootmgr", "--bootnum", item["number"], "--active"])
        return item["number"], current_entries

    order, all_entries = entries(command(["efibootmgr", "--verbose"]))
    number, all_entries = ensure_entry(LABEL, LOADER, order, all_entries)
    prev_number = None
    if want_prev:
        prev_number, all_entries = ensure_entry(PREV_LABEL, PREV_LOADER, order, all_entries)

    if first:
        head = [number] + ([prev_number] if prev_number else [])
        wanted = head + [n for n in order if n not in head]
    else:
        wanted = list(order)
        if number not in wanted:
            wanted.append(number)
        if prev_number and prev_number not in wanted:
            idx = wanted.index(number) + 1
            wanted.insert(idx, prev_number)
    if wanted != order:
        command(["efibootmgr", "--bootorder", ",".join(wanted)])
    actual_order, actual = entries(command(["efibootmgr", "--verbose"]))
    if actual_order != wanted or not any(matches(i) and i["number"] == number and i["active"] for i in actual) or \
            (prev_number and not any(matches(i, PREV_LABEL, PREV_LOADER) and
                                     i["number"] == prev_number and i["active"] for i in actual)):
        raise RuntimeError("firmware did not retain the requested LOCachy entry/order")
    extra = f", Boot{prev_number} {PREV_LABEL} {PREV_LOADER}" if prev_number else ""
    print(f"locachy-efi: Boot{number} {LABEL}, {disk} partition {partition} {LOADER}{extra}; "
          + ("first in BootOrder" if first else "BootOrder preserved" if wanted == order else "added to BootOrder"))
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--esp", default="/efi")
    parser.add_argument("--first", action="store_true")
    args = parser.parse_args()
    try:
        if os.geteuid() != 0:
            raise RuntimeError("must run as root")
        return register(args.esp, args.first)
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as e:
        print(f"locachy-efi: boot entry not ready: {e}; fallback EFI/BOOT/BOOTX64.EFI is retained", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
