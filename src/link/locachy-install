    return (repo if valid_repo_url(repo) else DEFAULT_APPS_REPO,
            branch if valid_branch(branch) else DEFAULT_UPDATE_BRANCH, commit)


def apps_line():
    """(text, not_newest): which app presets this run installs, as
    source_line says it of the source (LOCACHY_APPS: fetched now, fetched
    before, or the medium's own, and why)."""
    repo, branch, commit = detect_apps_git()
    how = os.environ.get("LOCACHY_APPS", "")
    why = how.split(": ", 1)[1] if ": " in how else ""
    if not apps_meta():
        return "none" + (f"; {why}" if why else ""), True
    short = commit[:12] if commit else "unknown commit"
    if how == "bundled: updates are off":
        return f"this medium's own, {short} (updates are off)", False
    if how.startswith("bundled: "):
        return f"this medium's own, {short}; {why}", True
    line = f"{short} of {repo} ({branch})"
    if how == "fetched":
        return line + ", the newest, fetched now", False
    if how == "fetched earlier":
        return line + ", fetched earlier", False
    if how.startswith("fetched before: "):
        return line + ", fetched before; " + why, True
    return line, False


