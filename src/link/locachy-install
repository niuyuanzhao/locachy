def winmaint_default_gib():
    """Maintenance Windows' Windows C: size by default: winmaint_size_gib in this source's rc.conf,
    the default locachy-winmaint reads too (its DEFAULT_WIN_C_GIB), else 48."""
    try:
        for line in (SOURCE / "rc.conf").read_text(encoding="utf-8").splitlines():
            found = re.fullmatch(r'winmaint_size_gib="(\d+)"\s*', line)
            if found:
                return int(found.group(1))
    except OSError:
        pass
