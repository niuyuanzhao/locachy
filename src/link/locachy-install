def live_disks():
    """MAJ:MIN of the running system's and the live medium's devices and of
    the disks they are on: never a target."""
    mounts = json.loads(output(["findmnt", "--json", "--list", "--output", "TARGET,SOURCE"]))
    used = set()
    for item in mounts.get("filesystems", []):
        device = item.get("source", "")
        if (item["target"] == "/" or item["target"].startswith("/run/archiso/")) and device.startswith("/dev/"):
            used |= ancestors(device)
    return used


LSBLK_COLUMNS = ("PATH,MAJ:MIN,TYPE,SIZE,START,LOG-SEC,PTTYPE,MODEL,SERIAL,TRAN,RM,RO,FSTYPE,LABEL,"
                 "PARTLABEL,PARTTYPENAME,MOUNTPOINTS")


def block_devices(path=None):
    return json.loads(output(["lsblk", "--json", "--bytes", "--tree", "--output", LSBLK_COLUMNS]
                             + ([path] if path else []))).get("blockdevices", [])


def winmaint_partition(node):
    """Whether an lsblk node is one of locachy-winmaint's partitions (by its GPT name)."""
    return node.get("type") == "part" and (node.get("partlabel") or "") in WINMAINT_PART_LABELS


def winmaint_free_tail(dev):
    """The free bytes at the end of a disk with 512-byte sectors, as locachy-winmaint create
    measures them (its free_tail_sectors): from the first 1 MiB boundary after the last
    partition (1 MiB on a disk with none; one without a partition table gets an empty GPT
    first) to the last sector before the backup GPT. Free space between partitions does not
    count. None when a partition's start is unknown."""
    last_lba = int(dev.get("size") or 0) // 512 - 34
    start = 2048
    for child in dev.get("children") or []:
        if child.get("type") != "part":
            continue
        if child.get("start") is None:
            return None
        end = int(child["start"]) + int(child.get("size") or 0) // 512 - 1
        start = max(start, (end + 2048) // 2048 * 2048)
    return max(0, last_lba - start + 1) * 512


def in_use(device):
    """Why DEVICE or a part of it cannot be written now (mounted, swap, an
    open LUKS or LVM on it), or ""."""
    def walk(node):
        yield node
        for child in node.get("children") or []:
            yield from walk(child)
    for node in walk(device):
        points = [p for p in node.get("mountpoints") or [] if p]
        if points:
            return f"{node['path']} is in use ({', '.join(points)})"
        if node is not device and node.get("type") != "part":
            return f"{node['path']} is open ({node.get('type')}): close it first"
    return ""


def disks():
    """The disks to install on: not the live medium, a loop, an optical
    drive, zram or read-only; each with what is on it now."""
    live = live_disks()
    found = []
    for d in block_devices():
        if d.get("type") != "disk" or d.get("ro") or d["path"].startswith("/dev/zram") or d.get("maj:min") in live:
            continue
        pttype = (d.get("pttype") or "").lower()
        log_sec = int(d.get("log-sec") or 512)
        parts = [c for c in d.get("children") or [] if c.get("type") == "part"]
        # The free tail Maintenance Windows can use: GPT (or no table yet) with 512-byte sectors only.
        measurable = log_sec == 512 and (pttype == "gpt" or (not pttype and not parts and not d.get("fstype")))
        found.append({"path": d["path"], "size": int(d.get("size") or 0), "model": (d.get("model") or "").strip(),
                      "serial": (d.get("serial") or "").strip(),
                      "tran": d.get("tran") or "", "removable": bool(d.get("rm")), "in_use": in_use(d),
                      "pttype": pttype, "log_sec": log_sec, "fstype": d.get("fstype") or "",
                      "free_tail": winmaint_free_tail(d) if measurable else None,
                      "maintenance_windows": any(winmaint_partition(c) for c in parts),
                      "children": [{"path": c["path"], "type": c.get("type") or "", "size": int(c.get("size") or 0),
                                    "fstype": c.get("fstype") or "", "label": c.get("label") or "",
                                    "parttypename": c.get("parttypename") or "",
                                    "maintenance_windows": winmaint_partition(c),
                                    "mountpoints": [p for p in c.get("mountpoints") or [] if p]}
                                   for c in d.get("children") or []]})
    return found


def check_targets(args):
    """The block devices given, before anything is written: whole disks or
    partitions that are not the live system's, not in use and large enough."""
    live = live_disks()
    primary_ancestors = set()

    def device(path, kind):
        if not (path or "").startswith("/dev/"):
            raise ValueError(f"{path}: not a /dev/ block device")
        try:
            dev = block_devices(path)[0]
        except (IndexError, subprocess.SubprocessError, ValueError):
            raise ValueError(f"{path}: no such block device")
        if isinstance(kind, tuple):
            if dev.get("type") not in kind:
                raise ValueError(f"{path}: unexpected block device type {dev.get('type')}")
        elif dev.get("type") != kind:
            raise ValueError(f"{path}: not a {'whole disk' if kind == 'disk' else 'partition'}")
        if dev.get("ro"):
            raise ValueError(f"{path}: read-only")
        if ancestors(path) & live:
            raise ValueError(f"{path}: on the running system's or the live medium's disk")
        why = in_use(dev)
        if why:
            raise ValueError(why)
        return dev

    if args.disk:
        dev = device(args.disk, "disk")
        if any(winmaint_partition(c) for c in dev.get("children") or []):
            raise ValueError(f"{args.disk}: holds Maintenance Windows partitions; installing here would erase them")
        primary_ancestors |= ancestors(args.disk)
        need = DISK_SLACK_BYTES + ESP_BYTES + max(args.swap_gib, 0) * (1 << 30) + MIN_ROOT_BYTES
        if int(dev.get("size") or 0) < need:
            raise ValueError(f"{args.disk}: {int(dev.get('size') or 0) >> 30} GiB, "
                             f"at least {gib_up(need)} GiB are needed")
    elif args.format_root:
        paths = [p for p in (args.format_esp, args.format_root, args.format_swap) if p]
        if len(set(paths)) != len(paths):
            raise ValueError("The ESP, root and swap partitions must be different")
        identities = set()
        for path in paths:
            dev = device(path, "part")
            identity = dev.get("maj:min") or os.path.realpath(path)
            if identity in identities:
                raise ValueError("The ESP, root and swap partitions must be different")
            identities.add(identity)
            if winmaint_partition(dev):
                raise ValueError(f"{path}: a Maintenance Windows partition; installing here would erase it")
            primary_ancestors |= ancestors(path)
            if path == args.format_root and int(dev.get("size") or 0) < MIN_ROOT_BYTES:
                raise ValueError(f"{path}: the root needs at least {MIN_ROOT_BYTES >> 30} GiB")
    elif getattr(args, "root", None) and getattr(args, "esp", None):
        for mpath in (args.root, args.esp):
            try:
                fs = filesystem(canonical(mpath))
                if fs["source"].startswith("/dev/"):
                    primary_ancestors |= ancestors(fs["source"])
            except (OSError, ValueError, subprocess.SubprocessError):
                pass

    vols = parse_extra_volumes(getattr(args, "extra_volume", None) or [],
                               encrypt_root=bool(getattr(args, "encrypt", False)))
    completed_vols = set()
    if vols and getattr(args, "resume", False) and getattr(args, "root", None):
        completed_vols = checked_extra_volumes(Path(args.root), vols)

    used_whole_disks = set()
    used_ancestors = set()
    used_devices = set()

    for vol in vols:
        if vol["name"] in completed_vols:
            for dev_path in vol["devs"]:
                anc = ancestors(dev_path)
                used_ancestors |= anc
                if vol["mode"] != "attach":
                    used_whole_disks |= anc
            continue
        mode = vol["mode"]
        array_ancestors = set()
        for dev_path in vol["devs"]:
            if mode in ("format", "array"):
                dev = device(dev_path, "disk")
                if any(winmaint_partition(c) for c in dev.get("children") or []):
                    raise ValueError(f"--extra-volume {vol['name']}: {dev_path} holds Maintenance Windows partitions; "
                                     "locachy-storage never formats it")
            else:
                dev = device(dev_path, ("part", "disk"))
                if winmaint_partition(dev) or any(winmaint_partition(c) for c in dev.get("children") or []):
                    raise ValueError(f"--extra-volume {vol['name']}: {dev_path} is a Maintenance Windows partition "
                                     "or holds them; locachy-storage never attaches it")
                fstype = (dev.get("fstype") or "").strip()
                ptype = (dev.get("parttypename") or "").lower()
                if fstype == "swap" or "swap" in ptype or "efi system" in ptype:
                    raise ValueError(f"--extra-volume {vol['name']}: {dev_path} cannot be attached (swap or EFI partition)")
                if fstype not in STORAGE_ATTACH_FS:
                    raise ValueError(
                        f"--extra-volume {vol['name']}: {dev_path} has unsupported or missing filesystem {fstype!r}"
                    )
            anc = ancestors(dev_path)
            dev_id = dev.get("maj:min") or dev_path
            if primary_ancestors and (anc & primary_ancestors):
                raise ValueError(f"--extra-volume {vol['name']}: {dev_path} overlaps the primary system disk")
            if mode == "array" and (anc & array_ancestors):
                raise ValueError(
                    f"--extra-volume {vol['name']}: {dev_path} shares a physical disk with another array member"
                )
            if mode in ("format", "array"):
                if anc & used_ancestors:
                    raise ValueError(f"--extra-volume {vol['name']}: {dev_path} is already used by another volume")
                used_whole_disks |= anc
            else:
                if dev_id in used_devices or (anc & used_whole_disks):
                    raise ValueError(f"--extra-volume {vol['name']}: {dev_path} is already used by another volume")
                if dev.get("type") == "disk":
                    used_whole_disks |= anc
            used_devices.add(dev_id)
            used_ancestors |= anc
            if mode == "array":
                array_ancestors |= anc
    check_winmaint(args, primary_ancestors=primary_ancestors,
                   created_volumes=completed_vols)


def gib_up(size):
    """Bytes as whole GiB, rounded up: a least size is never understated."""
    return (size + (1 << 30) - 1) >> 30


def recorded_maintenance_windows(root):
    """Read existing target metadata; an unreadable record is not an empty disk."""
    path = Path(root) / "var/lib/locachy/winmaint/state.json"
    if not os.path.lexists(path):
        return None
    try:
        if path.is_symlink():
            raise ValueError("unexpected symlink")
        state = json.loads(path.read_text(encoding="utf-8"))
        disk, sectors = state["disk"], state["partitions"]["c"]["sectors"]
        gib, remainder = divmod(sectors * 512, 1 << 30)
        if state.get("schema") != 1 or not isinstance(disk, str) or not disk.startswith("/dev/") or remainder or gib < 1:
            raise ValueError("invalid Maintenance Windows record")
        return state, disk, gib
    except (OSError, ValueError, KeyError, TypeError) as error:
        raise ValueError(f"{path}: Maintenance Windows is recorded on the target but cannot be read ({error})") from error


def matching_maintenance_windows(args, root):
    recorded = recorded_maintenance_windows(root)
    if recorded is None:
        return None
    state, disk, gib = recorded
    if not same_device_path(disk, args.winmaint_disk) or gib != int(args.winmaint_gib):
        raise ValueError(f"Maintenance Windows is already configured on the target ({disk}, {gib} GiB) and is kept; "
                         "a continued installation cannot change it")
    return state


def check_winmaint(args, primary_ancestors=None, created_volumes=()):
    """--winmaint-disk, before anything is written: a whole disk with 512-byte logical sectors
    (locachy-winmaint reads its GPT in 512-byte sectors) that is not the live medium's and has
    room for the Maintenance Windows tail: the system disk (--disk; partitioning reserves the
    tail), a secondary disk a mode=format extra volume formats (locachy-storage reserves the
    tail, leaving at least 1 GiB for the volume), or any other disk not claimed by a Btrfs
    array: a GPT disk, or one without a partition table or filesystem (it gets an empty GPT),
    with enough unallocated space after its last partition, measured as locachy-winmaint
    create measures it. A continued installation checks what is on the disk by then (the
    system disk's partitions, a volume already formatted), so changed --winmaint-disk or
    --winmaint-gib are checked against what create will find. Once Maintenance Windows is
    recorded in the target it is kept, never recreated: a continued installation must then
    name that same disk and size."""
    disk = getattr(args, "winmaint_disk", None)
    if not disk:
        return
    if not disk.startswith("/dev/"):
        raise ValueError("--winmaint-disk must be a /dev/ block device: " + disk)
    if getattr(args, "resume", False) and getattr(args, "root", None):
        if matching_maintenance_windows(args, Path(args.root)) is not None:
            return
    try:
        dev = block_devices(disk)[0]
    except (IndexError, subprocess.SubprocessError, ValueError):
        raise ValueError(f"--winmaint-disk {disk}: no such block device")
    if dev.get("type") != "disk":
        raise ValueError(f"--winmaint-disk {disk}: not a whole disk")
    if dev.get("ro"):
        raise ValueError(f"--winmaint-disk {disk}: read-only")
    anc = ancestors(disk)
    if anc & live_disks():
        raise ValueError(f"--winmaint-disk {disk}: on the running system's or the live medium's disk")
    on_resumed_primary = bool(getattr(args, "resume", False) and primary_ancestors and (anc & primary_ancestors))
    if not on_resumed_primary:
        why = in_use(dev)
        if why:
            raise ValueError("--winmaint-disk: " + why)
    log_sec = int(dev.get("log-sec") or 512)
    if log_sec != 512:
        raise ValueError(f"--winmaint-disk {disk}: {log_sec}-byte logical sectors; Maintenance Windows "
                         "needs a disk with 512-byte sectors")
    tail = winmaint_tail_mib(args) << 20
    size = int(dev.get("size") or 0)
    if args.disk and same_device_path(disk, args.disk):
        need = DISK_SLACK_BYTES + ESP_BYTES + max(args.swap_gib, 0) * (1 << 30) + MIN_ROOT_BYTES + tail
        if size < need:
            raise ValueError(f"{disk}: {size >> 30} GiB, at least {gib_up(need)} GiB are needed with Maintenance Windows")
        return
    shared_format = None
    for vol in parse_extra_volumes(getattr(args, "extra_volume", None) or [],
                                   encrypt_root=bool(getattr(args, "encrypt", False))):
        if any(ancestors(path) & anc for path in vol["devs"]):
            if vol["mode"] == "array":
                raise ValueError(f"--winmaint-disk {disk}: cannot share a disk with array volume {vol['name']}")
            if vol["mode"] == "format" and vol["name"] not in created_volumes:
                shared_format = vol
    if shared_format is not None:
        # locachy-storage --mode format --reserve-tail-mib wipes and partitions the disk,
        # requiring at least 1 GiB for the volume plus GPT overhead plus the reserved tail.
        need = (1 << 30) + tail + (4 << 20)
        if size < need:
            raise ValueError(
                f"--winmaint-disk {disk}: {size >> 30} GiB, at least {gib_up(need)} GiB are needed "
                f"for volume {shared_format['name']} and Maintenance Windows"
            )
        return
    parts = [c for c in dev.get("children") or [] if c.get("type") == "part"]
    pttype = (dev.get("pttype") or "").lower()
    if not pttype and not parts and dev.get("fstype"):
        raise ValueError(f"--winmaint-disk {disk}: has an existing {dev.get('fstype')} filesystem; refusing to overwrite")
    if pttype and pttype != "gpt":
        raise ValueError(f"--winmaint-disk {disk}: has {'an MBR (dos)' if pttype == 'dos' else 'a ' + pttype} "
                         "partition table; Maintenance Windows needs a GPT disk")
    if not pttype and parts:
        raise ValueError(f"--winmaint-disk {disk}: its partition table type is unknown; Maintenance Windows needs a GPT disk")
    if any(winmaint_partition(c) for c in parts):
        raise ValueError(f"--winmaint-disk {disk}: already holds Maintenance Windows partitions")
    free = winmaint_free_tail(dev)
    if free is None:
        raise ValueError(f"--winmaint-disk {disk}: a partition's start is unknown, so the space after "
                         "the last partition cannot be measured")
    if free < tail:
        raise ValueError(f"--winmaint-disk {disk}: {free / (1 << 30):.1f} GiB unallocated at the end of the disk, "
                         f"after its last partition (free space between partitions does not count); "
                         f"at least {tail / (1 << 30):.1f} GiB are needed")


def check_choices(args):
    """Every choice that the build would otherwise reject hours later."""
    if not valid_hostname(args.hostname):
        raise ValueError("Invalid hostname (use 1-63 letters, digits or hyphens): " + args.hostname)
    known = keymaps()
    if not re.fullmatch(r"[A-Za-z0-9._-]+", args.keymap) or (known and args.keymap not in known):
        raise ValueError("Unknown keymap: " + args.keymap)
    if args.timezone != "auto" and (".." in args.timezone or not re.fullmatch(r"[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*", args.timezone)
                                    or (Path(ZONEINFO).is_dir() and not Path(ZONEINFO, args.timezone).is_file())):
        raise ValueError("Unknown timezone: " + args.timezone)
    for feat in parse_csv_items(args.features):
        if feat not in MODULES:
            raise ValueError("Unknown module: " + feat)
    known = presets()
    for cname in parse_csv_items(args.containers):
        if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._-]{0,62}", cname):
            raise ValueError("Invalid container name: " + cname)
        if cname not in known:
            raise ValueError("Unknown app: " + cname)
    if args.machine and args.machine not in {name for name, _ in machine_profiles()}:
        raise ValueError("Unknown machine profile: " + args.machine)
    if re.search(r"[:\n]", args.full_name or ""):
        raise ValueError("The full name cannot have a colon or a line break")
    if args.hibernate_after is not None and args.hibernate_after < 0:
        raise ValueError("--hibernate-after: not a number of seconds")
    if args.tpm and not args.encrypt:
        raise ValueError("--tpm needs --encrypt: the TPM unlocks an encrypted disk")
    if args.secure_boot_microsoft and not args.secure_boot:
        raise ValueError("--secure-boot-microsoft goes with --secure-boot")
    parse_extra_volumes(getattr(args, "extra_volume", None) or [],
                        encrypt_root=bool(getattr(args, "encrypt", False)))
    if not WINMAINT_MIN_GIB <= int(args.winmaint_gib) <= WINMAINT_MAX_GIB:
        raise ValueError(f"--winmaint-gib must be between {WINMAINT_MIN_GIB} and {WINMAINT_MAX_GIB}")
    for option, path in (("--luks-passphrase-file", args.luks_passphrase_file), ("--password-file", args.password_file)):
        if path:
            secret = read_secret(path)
            if not secret or "\n" in secret:
                raise ValueError(f"{option}: empty, or more than one line")


def describe(parser):
    """What the full-screen installer offers: choices, defaults, disks."""
    default = parser.get_default
    repo, branch, _ = detect_source_git()
    apps_repo, apps_branch, _ = detect_apps_git()
    try:
        levels = sorted(supported_levels())
        auto = cpu_level("auto")
        model = cpu_model(auto)
    except (OSError, ValueError, subprocess.SubprocessError):
        levels, auto, model = ["x86-64"], "x86-64", "x86-64"
    try:
        memory = int(re.search(r"^MemTotal:\s+(\d+) kB", Path("/proc/meminfo").read_text(), re.M).group(1)) * 1024
    except (OSError, AttributeError):
        memory = 0
    tpm = tpm_status()
    usable, _, advice = tpm_advice(tpm)
    return {
        "defaults": {"user": default("user"), "hostname": default("hostname"), "keymap": default("keymap"),
                     "timezone": default("timezone"), "swap_gib": default("swap_gib"), "level": default("level"),
                     "cpu": default("cpu"), "repos": repo_sections(default("repos")),
                     "update_repo": repo, "update_branch": branch, "apps_repo": apps_repo,
                     "apps_branch": apps_branch, "copy_network": bool(live_nm_connections())},
        "languages": ["en_US.UTF-8", "zh_CN.UTF-8"],
        "levels": {"supported": levels, "auto": auto, "cpu_model": model},
        "ime": [{"name": k, "label": v} for k, v in IME_LABELS.items()],
        "modules": [{"name": k, "description": v.get("description", "")} for k, v in MODULES.items()],
        "module_defaults": {lang: sorted(default_features(lang)) for lang in ("en_US.UTF-8", "zh_CN.UTF-8")},
        "containers": [{"name": n, "host": h} for n, h in container_presets()],
        "container_defaults": sorted(default_containers({"desktop"})),
        "machines": [{"name": n, "description": d} for n, d in machine_profiles()],
        "repo_sections": list(REPO_SECTIONS),
        "storage_roles": list(STORAGE_ROLES),
        "storage_raids": list(STORAGE_RAIDS),
        "winmaint": {"min_gib": WINMAINT_MIN_GIB, "default_gib": WINMAINT_DEFAULT_GIB, "max_gib": WINMAINT_MAX_GIB},
        "keymaps": keymaps(), "timezones": timezones(),
        "tpm": {"usable": usable, "advice": advice, "version": tpm.get("tpm_version", 0),
                "setup_mode": bool(tpm.get("setup_mode"))},
        "host_security": host_security(),
        "network_profiles": len(live_nm_connections()),
        "memory_bytes": memory, "esp_bytes": ESP_BYTES, "min_root_bytes": MIN_ROOT_BYTES,
        "disks": disks(),
        "source": dict(zip(("text", "not_newest"), source_line())),
        "source_revision": source_revision(),
        "installation": public_resume_record(),
        "apps": dict(zip(("text", "not_newest"), apps_line())),
    }


def apply_customizations(args, root):
    """Apply standard OS identity (hostname, hosts, locale.conf, vconsole.conf,
    timezone, NTP, NetworkManager profiles), optional modules, LUKS marker and
    selected container presets into the target root before make.sh/locachy-boot."""
    features = parse_csv_items(getattr(args, "features", ""))
    for feat in features:
        if feat not in FEATURE_PACKAGES:
            raise ValueError("Unknown feature: " + feat)
    containers = parse_csv_items(getattr(args, "containers", ""))
    for cname in containers:
        if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._-]{0,62}", cname):
            raise ValueError("Invalid container name: " + cname)
    hname = (getattr(args, "hostname", "locachy") or "locachy").strip()
    if not valid_hostname(hname):
        raise ValueError("Invalid hostname (use 1-63 letters, digits or hyphens): " + hname)
    kmap = (getattr(args, "keymap", "us") or "us").strip()
    if not re.fullmatch(r"[A-Za-z0-9._-]+", kmap):
        raise ValueError("Invalid keymap name: " + kmap)
    tzone = (getattr(args, "timezone", "auto") or "auto").strip()
    if tzone != "auto":
        if ".." in tzone or tzone.startswith("/") or not re.fullmatch(r"[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*", tzone):
            raise ValueError("Invalid timezone: " + tzone)
        zroot = root / "usr/share/zoneinfo"
        if zroot.is_dir() and not (zroot / tzone).is_file():
            raise ValueError("Unknown timezone in zoneinfo: " + tzone)

    presets_dir = root / "usr/local/src/locachy/containers"
    host_dir = presets_dir if presets_dir.is_dir() else None
    # The app presets' catalog: this run's, the target's own once it has one
    # (a continued installation keeps the one it started with).
    catalog = root / APPS_CATALOG
    pinned = (catalog / "CATALOG").is_file()
    known = presets(host_dir, catalog if pinned else None)
    for cname in containers:
        if cname not in known:
            raise ValueError("Unknown app: " + cname)
    host_pkgs = host_preset_packages(containers, known=known)
    manifest_changed = False
    manifest = root / "etc/locachy/packages"
    if manifest.is_file():
        existing = {name for line in manifest.read_text().splitlines()
                    for name in line.split("#", 1)[0].split()}
        added = []
        if getattr(args, "encrypt", False) and "cryptsetup" not in existing:
            added.append("cryptsetup")
            existing.add("cryptsetup")
        for pkg in extra_volume_packages(args):
            if pkg not in existing:
                added.append(pkg)
                existing.add(pkg)
        for feat in features:
            for pkg in FEATURE_PACKAGES[feat]:
                if pkg not in existing:
                    added.append(pkg)
                    existing.add(pkg)
        for pkg in host_pkgs:
            if pkg not in existing:
                added.append(pkg)
                existing.add(pkg)
        if added:
            with manifest.open("a", encoding="utf-8") as f:
                f.write("\n# Selected during installation\n")
                for pkg in added:
                    f.write(pkg + "\n")
            manifest_changed = True

    if getattr(args, "encrypt", False):
        (root / "etc/locachy/luks").write_text("1\n", encoding="utf-8")

    # Standard /etc/hostname, /etc/hosts, /etc/locale.conf, /etc/vconsole.conf, /etc/localtime
    etc = root / "etc"
    etc.mkdir(parents=True, exist_ok=True)
    (etc / "hostname").write_text(hname + "\n", encoding="utf-8")
    (etc / "hosts").write_text(
        f"# Static table lookup for hostnames.\n127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t{hname}.localdomain {hname}\n",
        encoding="utf-8",
    )
    eff_lang = getattr(args, "language", "en_US.UTF-8") or "en_US.UTF-8"
    (etc / "locale.conf").write_text(f"LANG={eff_lang}\n", encoding="utf-8")
    (etc / "vconsole.conf").write_text(f"KEYMAP={kmap}\n", encoding="utf-8")
    lt = etc / "localtime"
    if lt.exists() or lt.is_symlink():
        lt.unlink()
    lt.symlink_to("/usr/share/zoneinfo/" + ("UTC" if tzone == "auto" else tzone))

    if getattr(args, "copy_network", False):
        copy_network_profiles(root)

    rc = root / "etc/locachy/rc.conf"
    extra_vols = parse_extra_volumes(getattr(args, "extra_volume", None) or [],
                                     encrypt_root=bool(getattr(args, "encrypt", False)))
    compute_vol = next((v["name"] for v in extra_vols if v["compute_storage"]), "")
    drop_rc = ("service_link=", "debug_link_interface=", "debug_link_mac=", "login_skip=", "language=",
               "update_repo=", "update_branch=", "apps_repo=", "apps_branch=", "machine=", "keymap=")
    if compute_vol:
        drop_rc += ("compute_storage=",)
    if getattr(args, "winmaint_disk", None):
        drop_rc += ("winmaint_size_gib=",)
    lines = [s for s in rc.read_text().splitlines() if not s.startswith(drop_rc)]
    if tzone != "auto":
        lines = [s for s in lines if not s.startswith("service_timezone=")]
    if getattr(args, "no_ntp", False):
        lines = [s for s in lines if not s.startswith("service_ntp=")]
    if kmap != "us":
        lines.append(f'keymap="{kmap}"')
    mach = getattr(args, "machine", "") or ""
    if mach and mach != "generic":
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,62}", mach):
            raise ValueError("Invalid machine profile name: " + mach)
        lines.append(f'machine="{mach}"')
    repo_url, branch, detected_commit = update_source(args)
    lines.append(f'update_repo="{repo_url}"')
    if branch != DEFAULT_UPDATE_BRANCH:
        lines.append(f'update_branch="{branch}"')
    if detected_commit and re.fullmatch(r"[0-9a-f]{40}", detected_commit):
        lib_dir = root / "usr/local/lib/locachy"
        lib_dir.mkdir(parents=True, exist_ok=True)
        (lib_dir / "source-commit").write_text(detected_commit + "\n", encoding="utf-8")
    apps_url, apps_br = apps_source(args)
    lines.append(f'apps_repo="{apps_url}"')
    if apps_br != DEFAULT_UPDATE_BRANCH:
        lines.append(f'apps_branch="{apps_br}"')
    lang = getattr(args, "language", "")
    if lang and lang not in ("en_US.UTF-8", "C.UTF-8"):
        lines.append(f'language="{lang}"')
    if getattr(args, "login_skip", False):
        lines.append('login_skip="1"')
    if getattr(args, "hibernate_after", None) is not None:
        lines = [s for s in lines if not s.startswith("hibernate_after=")]
        lines.insert(0, f'hibernate_after="{int(args.hibernate_after)}"')
    for feat in features:
        for k, v in FEATURE_RC_MAP.get(feat, {}).items():
            lines = [s for s in lines if not s.startswith(k + "=")]
            lines.append(f'{k}="{v}"')
    if compute_vol:
        lines.append(f'compute_storage="{compute_vol}"')
    if getattr(args, "winmaint_disk", None):
        lines.append(f'winmaint_size_gib="{int(args.winmaint_gib)}"')
    rc.write_text("\n".join(lines) + "\n", encoding="utf-8")

    # All of the catalog the installed system's (its updates start from it),
    # the chosen presets its configurations.
    if not pinned and apps_meta():
        APPS.copy_catalog(str(apps_catalog()), str(catalog))
    conf_dir = root / "etc/locachy/containers"
    conf_dir.mkdir(parents=True, exist_ok=True)
    for cname in containers:
        shutil.copyfile(known[cname][0], conf_dir / f"{cname}.conf")
    return manifest_changed


def winmaint_helper():
    loader = importlib.machinery.SourceFileLoader("winmaint", str(SOURCE / "link/locachy-winmaint"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    helper = importlib.util.module_from_spec(spec)
    loader.exec_module(helper)
    return helper


def winmaint_container_present(root):
    path = root / "etc/locachy/containers/winmaint.conf"
    return not path.is_symlink() and path.is_file() and \
        'vm_kind="winmaint"' in path.read_text(encoding="utf-8").splitlines()


def create_maintenance_windows(args, root):
    """Create the Windows tail once; finish its target configuration on a retry."""
    helper = winmaint_helper()
    state = matching_maintenance_windows(args, root)
    if state is not None:
        # The helper saves state after formatting, but before writing the
        # container configuration. Never rerun partitioning in that window.
        try:
            helper.verify_state_against_gpt(state, helper.parse_gpt_disk(args.winmaint_disk))
        except (OSError, RuntimeError, KeyError, TypeError, ValueError) as error:
            raise ValueError(f"Maintenance Windows: recorded partitions cannot be verified: {error}") from error
        print("Maintenance Windows: recorded partitions kept", flush=True)
    else:
        try:
            pttype = output(["blkid", "-p", "-s", "PTTYPE", "-o", "value", args.winmaint_disk])
        except (OSError, subprocess.SubprocessError):
            pttype = ""
        if pttype and pttype != "gpt":
            raise ValueError(f"Maintenance Windows: unsafe or interrupted disk setup on {args.winmaint_disk}; "
                             "inspect the disk in the terminal")
        if not pttype:
            run(["sfdisk", args.winmaint_disk], input="label: gpt\n", text=True)
            run(["udevadm", "settle"])
        run([sys.executable, "-I", str(SOURCE / "link/locachy-winmaint"), "create",
             "--root", str(root), "--disk", args.winmaint_disk, "--size-gib", str(int(args.winmaint_gib))])
        if matching_maintenance_windows(args, root) is None:
            raise RuntimeError("Maintenance Windows: helper did not record the partitions")
    helper.write_container_conf(root)
    if not winmaint_container_present(root):
        raise ValueError("Maintenance Windows: the target container configuration is not a Windows entry")


def validate(root_path, esp_path, install_id=None):
    """The target's mounts; empty, or (install_id: an installation continued)
    marked as that installation's, with an ESP holding only what it writes."""
    root = canonical(root_path)
    if root == Path("/") or root in (Path("/boot"), Path("/efi")) or root.is_relative_to(Path("/run/archiso")) or SOURCE.is_relative_to(root):
        raise ValueError("The running installation environment cannot be the target")
    esp = canonical(esp_path)
    if esp != root / "efi":
        raise ValueError("The ESP must be mounted at TARGET_ROOT/efi")
    root_fs, esp_fs = filesystem(root), filesystem(esp)
    if os.stat(root).st_dev == os.stat("/").st_dev:
        raise ValueError("The target is a bind mount of the running root filesystem")
    if root_fs["fstype"] != "ext4" or esp_fs["fstype"] != "vfat":
        raise ValueError("Target root must be ext4 and ESP must be FAT32 (vfat)")
    for item in (root_fs, esp_fs):
        if "rw" not in item["options"].split(",") or not item["source"].startswith("/dev/"):
            raise ValueError("Writable block-device mounts are required")
    if root_fs["maj:min"] == esp_fs["maj:min"]:
        raise ValueError("Root and ESP must be different filesystems")
    if output(["blkid", "-p", "-s", "LABEL", "-o", "value", root_fs["source"]]) != "locachy-root":
        raise ValueError("The prepared ext4 root must have label locachy-root")
    esp_version = output(["blkid", "-p", "-s", "VERSION", "-o", "value", esp_fs["source"]])
    if esp_version != "FAT32":
        raise ValueError("The ESP must be FAT32")
    marker = root / ".locachy-installer/install-id"
    if install_id and marker.is_file():
        if marker.read_text(encoding="utf-8").strip() != install_id:
            raise ValueError("The target is another installation's; it is not built on")
        if not esp_ours_only(esp):
            raise ValueError("The ESP has files no installation of LOCachy wrote; left untouched")
    else:
        empty_root(root)
        if any(esp.iterdir()):
            raise ValueError("The ESP must be empty; no existing boot files are overwritten")
    mounts = json.loads(output(["findmnt", "--json", "--list", "--output", "TARGET,SOURCE,FSTYPE,MAJ:MIN"]))
    target_ids = {root_fs["maj:min"], esp_fs["maj:min"]}
    target_disks = ancestors(root_fs["source"]) | ancestors(esp_fs["source"])
    for item in mounts.get("filesystems", []):
        where = Path(item["target"])
        if where in (root, esp):
            continue
        if item.get("maj:min") in target_ids:
            raise ValueError("Target filesystem is also mounted at " + str(where))
        if where.is_relative_to(root):
            raise ValueError("Unexpected nested mount below target: " + str(where))
        if where == Path("/") or str(where).startswith("/run/archiso/"):
            device = item.get("source", "")
            if device.startswith("/dev/") and target_disks & ancestors(device):
                raise ValueError("A target disk is used by the running system or live medium")
    return root, esp, root_fs, esp_fs


def effective_ime(args):
    if getattr(args, "no_ime", False):
        return "off"
    choice = getattr(args, "ime", "auto") or "auto"
    if choice == "auto":
        return "zh" if (getattr(args, "language", "") or "").startswith("zh") else "off"
    return choice


def selected_package_roots(args):
    """The installer's effective package definitions, not the live system's installed set."""
    modules = json.loads((SOURCE / "link/modules.json").read_text(encoding="utf-8"))
    names = {name for line in (SOURCE / "packages").read_text(encoding="utf-8").splitlines()
             for name in line.split("#", 1)[0].split()}
    ime = effective_ime(args)
    if ime == "off":
        names = {name for name in names if name not in ("librime", "words") and not name.startswith("rime-")}
    chosen = parse_csv_items(args.features)
    choice = {"en": "ime", "zh": "ime-zh"}.get(ime)
    if choice:
        chosen.append(choice)
    seen = set()
    while chosen:
        name = chosen.pop()
        if name in seen:
            continue
        if name not in modules:
            raise ValueError("Unknown selected module: " + name)
        seen.add(name)
        names.update(modules[name].get("packages", []))
        chosen.extend(modules[name].get("requires", []))
    if args.encrypt:
        names.add("cryptsetup")
    names.update(extra_volume_packages(args))
    known = presets()
    for name in parse_csv_items(args.containers):
        if name not in known:
            raise ValueError("Unknown app: " + name)
        values = APPS.conf_values(known[name][0].read_text(encoding="utf-8"))
        names.update(APPS.packages(values).split())
    # Machine profiles currently select devices and policy, not packages.
    # Should a profile grow an explicit package list it is preflighted too.
    if args.machine and args.machine != "generic":
        profile = SOURCE / "machines" / (args.machine + ".conf")
        if not profile.is_file():
            raise ValueError("Unknown machine profile: " + args.machine)
        text = profile.read_text(encoding="utf-8")
        machine_packages = next((line.split("=", 1)[1].strip().strip('"') for line in text.splitlines()
                                 if line.startswith("packages=")), "")
        names.update(machine_packages.split())
    if any(not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9@._+\-]*", name) for name in names):
        raise ValueError("The selected package definitions contain an invalid package name")
    return sorted(names)


def install_key_helper():
    spec = importlib.util.spec_from_file_location("locachy_install_keys", SOURCE / "link/locachy_install_keys.py")
    helper = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(helper)
    return helper


def preflight_keys(args):
    # A mounted explicit target may already contain an approved build keyring;
    # a --disk run has no target until after the key preflight.
    target = Path(args.root) if args.root else None
    level = cpu_level(args.level)
    cpu = args.cpu if args.cpu != "auto" else cpu_model(level)
    print("Installation preflight: checking package source signing keys before target writes", flush=True)
    return install_key_helper().check(SOURCE, RESUME_RECORD.parent, selected_package_roots(args), level, cpu,
                                      repo_sections(args.repos), target)


def trust_install_keys(fingerprints, target=None):
    return install_key_helper().trust(SOURCE, RESUME_RECORD.parent, fingerprints, target)


def recorded_extra_volumes(root):
    path = root / "etc/locachy/volumes.json"
    if not os.path.lexists(path):
        return set()
    try:
        if path.is_symlink():
            raise ValueError("unexpected symlink")
        data = json.loads(path.read_text(encoding="utf-8"))
        volumes = data["volumes"]
        if data.get("schema") != 1 or not isinstance(volumes, list) or any(
                not isinstance(v, dict) or not VOLUME_NAME_RE.fullmatch(v.get("name") or "") for v in volumes):
            raise ValueError("invalid volume record")
        return {v["name"] for v in volumes}
    except (OSError, ValueError, TypeError, KeyError) as error:
        raise ValueError(f"Cannot read extra storage records in {path}: {error}") from error


def extra_volume_pending(root, name):
    return root / ".locachy-installer" / f"volume-{name}.pending"


def checked_extra_volumes(root, volumes):
    """An unfinished destructive helper cannot be safely invoked twice."""
    recorded = recorded_extra_volumes(root)
    stages = INSTALL_STATE.Stages(root / ".locachy-installer")
    completed = stages.stages.get("extra-volumes", {}).get("success") is True
    for volume in volumes:
        name = volume["name"]
        if name not in recorded and (completed or os.path.lexists(extra_volume_pending(root, name))):
            raise ValueError(f"Extra storage volume {name}: previous work has no volume record; "
                             "inspect the disks in the terminal. Resume will not format them again.")
    return recorded


def apply_extra_volumes(args, root):
    """Create missing volumes; a recorded volume never goes through format again."""
    vols = parse_extra_volumes(getattr(args, "extra_volume", None) or [],
                               encrypt_root=bool(getattr(args, "encrypt", False)))
    existing_names = checked_extra_volumes(root, vols)

    passphrase_path = ""
    temp_passphrase = None
    src_pass = getattr(args, "luks_passphrase_file", None)
    if src_pass and any(v["effective_encrypt"] == "luks" for v in vols):
        raw_bytes = Path(src_pass).read_bytes()
        stripped = raw_bytes.rstrip(b"\r\n")
        if stripped != raw_bytes:
            tmp_dir = "/run" if Path("/run").is_dir() and os.access("/run", os.W_OK) else None
            fd, tmp_name = tempfile.mkstemp(prefix="locachy-vol-pass-", dir=tmp_dir)
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "wb") as fh:
                fh.write(stripped)
            temp_passphrase = Path(tmp_name)
            passphrase_path = tmp_name
        else:
            passphrase_path = str(src_pass)

    winmaint_disk = getattr(args, "winmaint_disk", None) or ""
    winmaint_anc = None

    def matches_winmaint_disk(dev_path):
        nonlocal winmaint_anc
        if not winmaint_disk:
            return False
        if same_device_path(dev_path, winmaint_disk):
            return True
        if winmaint_anc is None:
            try:
                winmaint_anc = ancestors(winmaint_disk)
            except (OSError, subprocess.SubprocessError):
                winmaint_anc = set()
        if not winmaint_anc:
            return False
        try:
            return bool(ancestors(dev_path) & winmaint_anc)
        except (OSError, subprocess.SubprocessError):
            return False

    storage_tool = SOURCE / "link/locachy-storage"
    try:
        for v in vols:
            pending = extra_volume_pending(root, v["name"])
            if v["name"] in existing_names:
                pending.unlink(missing_ok=True)
                print(f"Extra storage volume {v['name']}: already recorded in target, skipped", flush=True)
                continue
            cmd = [sys.executable, "-I", str(storage_tool), "create",
                   "--root", str(root), "--no-mount",
                   "--name", v["name"], "--mode", v["mode"], "--role", v["role"]]
            if v["mode"] == "array":
                cmd.extend(["--devs", ",".join(v["devs"]), "--raid", v["raid"],
                            "--encrypt", v["effective_encrypt"]])
            elif v["mode"] == "format":
                cmd.extend(["--dev", v["devs"][0], "--fs", v["fs"],
                            "--encrypt", v["effective_encrypt"]])
                if matches_winmaint_disk(v["devs"][0]):
                    cmd.extend(["--reserve-tail-mib", str(winmaint_tail_mib(args))])
            else:  # attach
                cmd.extend(["--dev", v["devs"][0], "--encrypt", "none"])
            if v["effective_encrypt"] == "luks" and passphrase_path:
                cmd.extend(["--passphrase-file", passphrase_path])
            print(f"Configuring extra storage volume {v['name']} ({v['mode']}, role={v['role']})...", flush=True)
            if v["mode"] != "attach":
                INSTALL_STATE.write_text(pending, "formatting\n")
            run(cmd)
            if v["name"] not in recorded_extra_volumes(root):
                raise RuntimeError(f"Extra storage volume {v['name']}: helper did not record the volume")
            pending.unlink(missing_ok=True)
    finally:
        if temp_passphrase is not None:
            temp_passphrase.unlink(missing_ok=True)
    return vols


def install(args, root, esp, root_fs, esp_fs, level):
    # A private mount namespace keeps the original ESP mount intact for the
    # live shell, while no build or package script can reach it through root.
    saved = Path(tempfile.mkdtemp(prefix="locachy-install-esp-", dir="/run"))
    run(["mount", "--bind", str(esp), str(saved)])
    try:
        run(["umount", str(esp)])
        work = Path(args.work_dir).absolute() if args.work_dir else root / ".locachy-installer"
        cache = Path(args.cache_dir).absolute() if args.cache_dir else root / "var/cache/pacman/pkg"
        for path in (work, cache):
            if path == Path("/") or path == root or path.is_relative_to(esp):
                raise ValueError("Work/cache directories must not be the root or ESP")
        # The shared builder creates target-local scratch only after checking
        # the empty root; do not consume the live RAM overlay for compilation.
        ime_mode = effective_ime(args)
        chosen_features = parse_csv_items(getattr(args, "features", ""))
        chosen_containers = parse_csv_items(getattr(args, "containers", ""))
        extra_pkgs = []
        if getattr(args, "encrypt", False):
            extra_pkgs.append("cryptsetup")
        for pkg in extra_volume_packages(args):
            if pkg not in extra_pkgs:
                extra_pkgs.append(pkg)
        for hp in host_preset_packages(chosen_containers):
            if hp not in extra_pkgs:
                extra_pkgs.append(hp)
        env = dict(
            os.environ,
            LOCACHY_INSTALLER="1",
            WITH_IME="0" if ime_mode == "off" else ime_mode,
            WITH_FEATURES=",".join(chosen_features),
            WITH_EXTRA_PACKAGES=",".join(extra_pkgs),
            WITH_REPOS=",".join(repo_sections(getattr(args, "repos", ",".join(REPO_SECTIONS)))),
        )
        cpu = getattr(args, "cpu", "auto")
        cpu = cpu if cpu != "auto" else cpu_model(level)
        # The live system's mirror lists ranked from here first: the build
        # takes them, and so does the installed system.
        if not getattr(args, "no_rank_mirrors", False):
            print("Ranking the mirrors (reflector, rate-mirrors)...", flush=True)
            if subprocess.run([sys.executable, "-I", str(SOURCE / "link/locachy-repos"), "rank",
                               "--cachyos-levels", "v3,v4"]).returncode != 0:
                print("Some mirror lists were not ranked; they stay as they are.", flush=True)
        command = ["bash", str(SOURCE / "make-root.sh"), "--target-root", str(root),
                   "--work-dir", str(work), "--cache-dir", str(cache), "--cpu", cpu, level]
        if getattr(args, "install_id", None):
            command[2:2] = ["--install-id", args.install_id] + (["--resume"] if getattr(args, "resume", False) else [])
        build_log = saved.parent / (saved.name + ".build.log")
        with build_log.open("w") as log:
            # tee preserves progress in the live console and the failure log.
            process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env, text=True)
            for line in process.stdout:
                print(line, end="", flush=True)
                log.write(line)
            if process.wait() != 0:
                raise RuntimeError("Target build failed; see " + str(build_log))
        log_copy = root / "var/log/locachy/install-build.log"
        log_copy.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(build_log, log_copy)
        build_log.unlink()
        stages = INSTALL_STATE.Stages(root / ".locachy-installer")
        account_inputs = {"user": args.user, "full_name": args.full_name}
        account_hash = INSTALL_STATE.digest(account_inputs)
        passwd = root / "etc/passwd"
        users = {line.split(":", 1)[0] for line in passwd.read_text(encoding="utf-8").splitlines()} \
            if passwd.is_file() else set()
        # Account creation is once-only. A changed display name or a missing
        # stage journal must never make a continued installation ask for, or
        # overwrite, the user's password again.
        account_needed = args.user not in users or ("account" in stages.stages and
                                                     stages.stages["account"].get("success") is not True)
        if not account_needed and "account" not in stages.stages:
            stages.complete("account", account_hash)
        if account_needed:
            stages.begin("account")
            # useradd may succeed before chpasswd fails. Keep an unfinished
            # account marker so that retry completes it instead of mistaking
            # the new user for an old installation's existing account.
            stages.stages["account"] = {"input": account_hash, "success": False}
            stages.save()
            useradd_cmd = ["arch-chroot", str(root), "useradd", "--uid", "1000", "--create-home",
                           "--groups", "wheel,video,audio", "--shell", "/bin/bash"]
            if getattr(args, "full_name", ""):
                useradd_cmd.extend(["--comment", args.full_name])
            useradd_cmd.append(args.user)
            if args.user not in users:
                run(useradd_cmd)
            if getattr(args, "password_file", None):
                args.password_stdin = read_secret(args.password_file)
            if getattr(args, "password_stdin", None) is not None:
                run(["arch-chroot", str(root), "chpasswd"],
                    input=f"{args.user}:{args.password_stdin}\n", text=True)
            else:
                print("Set the installed user's password (standard passwd; not recorded in the build log).", flush=True)
                run(["arch-chroot", str(root), "passwd", args.user])
            run(["arch-chroot", str(root), "passwd", "-l", "root"])
            stages.complete("account", account_hash)
        config_values = {k: v for k, v in vars(args).items()
                         if k not in ("password_file", "luks_passphrase_file", "password_stdin", "resume", "private",
                                      "install_id", "preflight", "yes", "check", "describe_json", "trust_key")}
        config_inputs = {"options": config_values, "files": INSTALL_STATE.files_digest(
            SOURCE, ("link/modules.json", "link/locachy-install", "machines", "containers", "rc.conf")),
                         "system": stages.stages.get("system", {}), "apps": catalog_digest(apps_catalog())}
        def configure():
            apply_customizations(args, root)
            # An earlier configuration run may already have appended packages
            # to the manifest before its sync failed. Reconcile on every
            # configuration attempt, not only when this attempt appended them.
            run(["arch-chroot", str(root), "/usr/local/bin/locachy-pkg", "sync", "--first-install"])
            run(["arch-chroot", str(root), "sh", "/usr/local/src/locachy/make.sh", level, cpu])
        stages.run("configuration", config_inputs, configure)
        extra_vols = parse_extra_volumes(getattr(args, "extra_volume", None) or [],
                                         encrypt_root=bool(getattr(args, "encrypt", False)))
        if extra_vols:
            extra_inputs = {"volumes": [{"name": v["name"], "mode": v["mode"], "devs": v["devs"],
                                         "fs": v["fs"], "raid": v["raid"], "role": v["role"],
                                         "encrypt": v["effective_encrypt"],
                                         "compute_storage": v["compute_storage"]} for v in extra_vols],
                            "winmaint_disk": getattr(args, "winmaint_disk", None) or "",
                            "winmaint_gib": int(args.winmaint_gib) if getattr(args, "winmaint_disk", None) else 0}
            recorded = checked_extra_volumes(root, extra_vols)
            stages.run("extra-volumes", extra_inputs, lambda: apply_extra_volumes(args, root),
                       present=all(v["name"] in recorded for v in extra_vols))
        secure_boot = getattr(args, "secure_boot", False)
        if getattr(args, "encrypt", False) and getattr(args, "tpm", False) and not secure_boot:
            tpm_inputs = {"encrypted": True, "tpm": True}
            # Old records may already have bound disks. Query the real token
            # state; missing bookkeeping is not permission to enroll twice.
            if args.resume and "tpm" not in stages.stages:
                status = target_tpm_status(root)
                devices = status.get("luks_devices", [])
                if devices and all(status.get("enrolled", {}).get(device) for device in devices):
                    stages.complete("tpm", INSTALL_STATE.digest(tpm_inputs))
            stages.run("tpm", tpm_inputs, lambda: tpm_install(args, root))
        if secure_boot:
            # Existing key material is a successful once-only operation even
            # for an old resume with no stage record. Do not regenerate it.
            key_dir = root / "var/lib/sbctl/keys"
            keys_input = INSTALL_STATE.digest({"secure_boot": True})
            if key_dir.is_dir() and (root / "etc/systemd/tpm2-pcr-private-key.pem").is_file() and "secure-boot-keys" not in stages.stages:
                stages.complete("secure-boot-keys", keys_input)
            stages.run("secure-boot-keys", {"secure_boot": True},
                       lambda: run(["arch-chroot", str(root), "/usr/local/bin/locachy-tpm", "secure-boot"]))
        boot_cmd = ["arch-chroot", str(root), "/usr/local/bin/locachy-boot"]
        if getattr(args, "encrypt", False):
            boot_cmd.append("--luks")
        stages.run("boot", {"configuration": stages.stages.get("configuration", {}), "secure_boot": secure_boot,
                            "encrypted": bool(args.encrypt)}, lambda: run(boot_cmd),
                   present=(root / "usr/local/lib/locachy/boot/locachy.efi").is_file())
        run(["arch-chroot", str(root), "/usr/local/bin/locachy-pkg", "status"])
        (root / "etc/resolv.conf").unlink(missing_ok=True)
        (root / "etc/resolv.conf").touch()
        # Recheck block identities before the first boot-file write or UEFI
        # entry registration; the removable-media path remains a recovery path.
        if filesystem(saved)["maj:min"] != esp_fs["maj:min"] or filesystem(root)["maj:min"] != root_fs["maj:min"]:
            raise RuntimeError("Target mount identities changed during installation")
        if any(saved.iterdir()) and not (getattr(args, "resume", False) and esp_ours_only(saved)):
            raise RuntimeError("The target ESP changed during the build; left untouched")
        # The unified kernel image (locachy-boot): the formal UEFI entry uses
        # EFI/locachy; EFI/BOOT remains the standard fallback.
        image = root / "usr/local/lib/locachy/boot/locachy.efi"
        if not image.is_file():
            raise RuntimeError("The completed target has no boot image (locachy.efi)")
        destination = saved / "EFI/locachy"
        destination.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(image, destination / "locachy.efi")
        shutil.copyfile(image, destination / "locachy-prev.efi")
        fallback = saved / "EFI/BOOT"
        fallback.mkdir(exist_ok=True)
        shutil.copyfile(image, fallback / "BOOTX64.EFI")
        os.sync()
        if secure_boot:
            enrollment_inputs = {"secure_boot": True, "microsoft": args.secure_boot_microsoft, "tpm": bool(args.tpm)}
            if args.resume and "secure-boot-enroll" not in stages.stages:
                status = target_tpm_status(root)
                if status.get("own_keys_in_db") and (not args.tpm or status.get("bound_own_keys") or status.get("pending")):
                    stages.complete("secure-boot-enroll", INSTALL_STATE.digest(enrollment_inputs))
            stages.run("secure-boot-enroll", enrollment_inputs, lambda: secure_boot_install(args, root, saved))
        # Run the installed source's helper in the live system: saved is the
        # verified ESP mount, hidden from target builds and package scripts.
        registered = run([sys.executable, "-I", str(root / "usr/local/bin/locachy-efi"),
                          "--esp", str(saved), "--first"], check=False)
        if registered.returncode:
            print("UEFI entry was not registered (the reason above). The installed image and fallback remain; "
                  "locachy-boot --register-only repairs the entry on the installed system.", flush=True)
        # Maintenance Windows last: nothing before needs it (locachy-boot packs nothing for
        # it unless a shrink plan is armed, and create --root never arms one), so a failed
        # create leaves a target that starts, and --resume reuses the stages before it.
        if getattr(args, "winmaint_disk", None):
            wm_inputs = {"disk": args.winmaint_disk, "gib": int(args.winmaint_gib)}
            # Even a successful old journal is not evidence that the helper's
            # state and container entry are both still present.
            wm_state = matching_maintenance_windows(args, root)
            if wm_state is None and stages.stages.get("winmaint", {}).get("success") is True:
                raise ValueError("Maintenance Windows: the successful stage's disk record is missing; "
                                 "inspect the disk in the terminal. Resume will not recreate it.")
            stages.run("winmaint", wm_inputs, lambda: create_maintenance_windows(args, root),
                       present=wm_state is not None and winmaint_container_present(root))
        state = root / "var/lib/locachy/install.json"
        repo, branch, _ = update_source(args)
        extra_summary = [{"name": v["name"], "mode": v["mode"], "devs": v["devs"], "fs": v["fs"],
                          "raid": v["raid"], "role": v["role"], "encrypt": v["effective_encrypt"],
                          "compute_storage": v["compute_storage"]} for v in extra_vols]
        state.write_text(json.dumps({"cpu_level": level, "cpu": cpu,
                                     "repos": repo_sections(getattr(args, "repos", ",".join(REPO_SECTIONS))),
                                     "ime": effective_ime(args), "user": args.user,
                                     "hostname": getattr(args, "hostname", "locachy") or "locachy",
                                     "timezone": getattr(args, "timezone", "auto") or "auto",
                                     "keymap": getattr(args, "keymap", "us") or "us",
                                     "encrypted": bool(getattr(args, "encrypt", False)),
                                     "language": getattr(args, "language", "en_US.UTF-8") or "en_US.UTF-8",
                                     "features": parse_csv_items(getattr(args, "features", "")),
                                     "containers": parse_csv_items(getattr(args, "containers", "")),
                                     "extra_volumes": extra_summary,
                                     "maintenance_windows": ({"disk": args.winmaint_disk, "gib": int(args.winmaint_gib)}
                                                             if getattr(args, "winmaint_disk", None) else None),
                                     "update_repo": repo, "update_branch": branch,
                                     "root": root_fs["source"], "esp": esp_fs["source"],
                                     "completed": time.strftime("%Y-%m-%d %H:%M:%S")}, indent=2) + "\n")
        os.sync()
        print("Installation completed. Packages for " + level + ", own builds for " + cpu +
              ". No reboot was requested.", flush=True)
    finally:
        run(["umount", str(saved)])
        saved.rmdir()


def target_tpm_status(root):
    try:
        return json.loads(output(["arch-chroot", str(root), "/usr/local/bin/locachy-tpm", "status", "--json"]))
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}


def tpm_install(args, root):
    """The disks bound to the TPM now, as locachy-tpm enroll binds them
    without this machine's own Secure Boot keys (TPM 2.0: PCRs 0+7, which
    read here as at the first start while Secure Boot stays off)."""
    tool = ["arch-chroot", str(root), "/usr/local/bin/locachy-tpm", "enroll"]
    if getattr(args, "luks_passphrase_file", None):
        run(tool + ["--passphrase-stdin"], input=read_secret(args.luks_passphrase_file) + "\n", text=True)
    else:
        print("Bind LUKS2 disk auto-unlock to this computer's TPM chip:", flush=True)
        run(tool)


def luks_passphrase(args):
    if getattr(args, "luks_passphrase_file", None):
        return read_secret(args.luks_passphrase_file)
    return getpass.getpass("The LUKS2 passphrase, to give the TPM a key slot: ")


def secure_boot_install(args, root, esp):
    """This machine's Secure Boot keys into the firmware (setup mode), once
    the image they signed is on the ESP (mounted at the root's /efi for it,
    as on the installed system); with TPM auto-unlock, the disks bound at the
    first start with Secure Boot on (PCR 7 is not that of this live system):
    the passphrase is typed once then. When the keys do not go in, the disks
    are bound as without them."""
    tool = ["arch-chroot", str(root), "/usr/local/bin/locachy-tpm"]
    target = root / "efi"
    target.mkdir(exist_ok=True)
    run(["mount", "--bind", str(esp), str(target)])
    try:
        enroll = run(tool + ["secure-boot", "--enroll"] + (["--microsoft"] if args.secure_boot_microsoft else []),
                     check=False)
        try:
            st = json.loads(output(tool + ["status", "--json"]))
        except (OSError, ValueError, subprocess.SubprocessError):
            st = {}
        enrolled = enroll.returncode == 0 or bool(st.get("own_keys_in_db"))
        if not enrolled:
            print("Secure Boot: this computer's keys were not enrolled (the reason above); the boot image is "
                  "signed with them, and settings' Secure Boot row enrolls them later", flush=True)
        if getattr(args, "encrypt", False) and getattr(args, "tpm", False):
            if enrolled and st.get("tpm_version") == 2:
                run(tool + ["prepare", "--passphrase-stdin"], input=luks_passphrase(args) + "\n", text=True)
            else:
                tpm_install(args, root)
    finally:
        run(["umount", str(target)])


def interactive_wizard(args):
    """Interactive menu-driven installer for partitioning, LUKS2 encryption,
    CPU level, user/security settings, optional system modules and containers."""
    all_features = list(MODULES.keys())
    all_containers = [name for name, _ in container_presets()]
    tpm = None # tpm_advice(), once encryption is on
    if getattr(args, "minimal", False):
        features = set()
    elif args.features:
        features = set(parse_csv_items(args.features))
    else:
        features = default_features(args.language)
    if args.containers:
        containers = set(parse_csv_items(args.containers))
    elif getattr(args, "minimal", False):
        containers = set()
    else:
        containers = default_containers(features)

    while True:
        print("\n=== LOCachy Interactive Installer ===")
        print(f"  1. Target disk / mounts : " + (
            f"auto-partition {args.disk} (swap {args.swap_gib}G)" if args.disk else
            f"format ESP={args.format_esp} Root={args.format_root} Swap={args.format_swap or 'none'}" if args.format_root else
            f"mounted Root={args.root or '(not set)'} ESP={args.esp or '(not set)'}"
        ))
        if getattr(args, "extra_volume", None):
            print(f"     Additional storage   : {'; '.join(args.extra_volume)}")
        fde_desc = ("ON (LUKS2 + TPM auto-unlock: guards a removed disk only)" if args.tpm
                    else "ON (LUKS2 passphrase)") if args.encrypt else "OFF"
        if args.encrypt and tpm is None:
            tpm = tpm_advice()
        print(f"  2. Full Disk Encryption : {fde_desc}")
        if args.encrypt:
            print(f"                            {tpm[2]}")
        detected = cpu_level("auto")
        print(f"  3. CPU                  : packages {args.level} (detected: {detected}); own builds "
              + (f"{cpu_model(detected)} (detected)" if args.cpu == "auto" else args.cpu))
        print(f"  4. Language & keymap    : {args.language}, keymap={args.keymap}")
        print(f"  5. Host, user & lock    : host={args.hostname}, user={args.user}"
              + (f" ({args.full_name})" if getattr(args, "full_name", "") else "")
              + f", boot lock={'OFF' if args.login_skip else 'ON'}")
        print(f"  6. Input method         : {IME_LABELS[effective_ime(args)]}")
        print(f"  7. Optional modules     : {', '.join(sorted(features)) or 'none (minimal core)'}")
        print(f"  8. Containers/host apps : {', '.join(sorted(containers)) or 'none'}")
        print(f"  9. Machine profile      : {args.machine or 'generic PC'}")
        print(f" 10. Timezone, NTP & Wi-Fi: tz={args.timezone}, ntp={'OFF' if args.no_ntp else 'ON'}, "
              f"copy live Wi-Fi={'ON' if args.copy_network else 'OFF'} ({len(live_nm_connections())} profile(s))")
        repo, branch, _ = update_source(args)
        apps_repo, apps_branch = apps_source(args)
        print(f" 11. Updates from         : " + ("off (no source updates)" if repo == "off" else f"{repo}, branch {branch}")
              + "; app presets " + ("off" if apps_repo == "off" else f"{apps_repo}, branch {apps_branch}"))
        print(f" 12. Repositories         : {', '.join(repo_sections(args.repos)) or 'none'}; mirrors "
              + ("kept as they are" if args.no_rank_mirrors else "ranked from here first"))
        print("  i. Start installation")
        print("  q. Cancel")
        choice = input("Choose [1-12, i, q]: ").strip().lower()
        if choice == "q":
            return False
        elif choice == "1":
            mode = input("Partition mode: [a]uto whole disk, [p]ick partitions to format, [m]ounted paths, "
                         "[e]xtra disks/arrays [a/p/m/e]: ").strip().lower()
            if mode == "a":
                subprocess.run(["lsblk", "-d", "-o", "NAME,SIZE,MODEL,TYPE"])
                args.disk = input("Whole disk to partition (e.g. /dev/sda or /dev/nvme0n1): ").strip()
                sg = input(f"Swap size in GiB for hibernation [{args.swap_gib}]: ").strip()
                if sg.isdigit():
                    args.swap_gib = int(sg)
                args.format_esp = args.format_root = args.format_swap = None
            elif mode == "p":
                subprocess.run(["lsblk", "-o", "NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT"])
                args.disk = None
                args.format_esp = input("ESP partition to format FAT32 (e.g. /dev/sda1): ").strip()
                args.format_root = input("Root partition to format ext4/LUKS2 (e.g. /dev/sda2): ").strip()
                args.format_swap = input("Swap partition to format (optional, Enter for none): ").strip() or None
            elif mode == "e":
                subprocess.run(["lsblk", "-o", "NAME,SIZE,TYPE,FSTYPE,LABEL,MODEL"])
                if args.extra_volume:
                    print("Configured additional volumes:")
                    for idx, spec in enumerate(args.extra_volume, 1):
                        print(f"  {idx}. {spec}")
                sub = input("Extra storage: [a]dd volume/array, [c]lear all, [b]ack [a/c/b]: ").strip().lower()
                if sub == "c":
                    args.extra_volume = []
                elif sub == "a":
                    kind = input("Type: [f]ormat whole disk, [t]tach existing partition (keep data), "
                                 "[r]aid Btrfs array [f/t/r]: ").strip().lower()
                    if kind in ("f", "t", "r"):
                        default_name = "pool" if kind == "r" else ("data" if not args.extra_volume else f"data{len(args.extra_volume) + 1}")
                        vname = input(f"Volume name [{default_name}]: ").strip() or default_name
                        role = input("Role [shared / data / compute] [shared]: ").strip() or "shared"
                        parts = [f"name={vname}"]
                        if kind == "f":
                            dev = input("Whole disk to format (e.g. /dev/nvme1n1): ").strip()
                            fs = input("Filesystem [ext4 / btrfs] [ext4]: ").strip() or "ext4"
                            enc = input("Encryption [auto / luks / none] [auto]: ").strip() or "auto"
                            parts += ["mode=format", f"dev={dev}", f"fs={fs}", f"role={role}", f"encrypt={enc}"]
                        elif kind == "t":
                            dev = input("Existing partition to attach without formatting (e.g. /dev/nvme1n1p1): ").strip()
                            parts += ["mode=attach", f"dev={dev}", f"role={role}"]
                        else:
                            raw_devs = input("Whole disks separated by '+' (e.g. /dev/nvme1n1+/dev/nvme2n1): ").strip()
                            raid = input("RAID profile [single / raid0 / raid1 / raid10] [raid1]: ").strip() or "raid1"
                            enc = input("Encryption [auto / luks / none] [auto]: ").strip() or "auto"
                            parts += ["mode=array", f"devs={raw_devs}", f"raid={raid}", f"role={role}", f"encrypt={enc}"]
                        if role in ("shared", "compute"):
                            cs = input("Use as default Compute storage? [y/N]: ").strip().lower()
                            if cs in ("y", "yes"):
                                parts.append("compute_storage=1")
                        spec = ",".join(parts)
                        try:
                            parse_extra_volumes(list(args.extra_volume) + [spec], encrypt_root=bool(args.encrypt))
                            args.extra_volume.append(spec)
                        except ValueError as err:
                            print("Invalid volume: " + str(err))
            else:
                args.disk = args.format_esp = args.format_root = args.format_swap = None
                args.root = input("Mounted empty ext4 root (e.g. /mnt): ").strip()
                args.esp = input("Mounted empty FAT32 ESP (e.g. /mnt/efi): ").strip()
        elif choice == "2":
            # off, then a passphrase, then a passphrase and TPM auto-unlock
            # (that one only on request, and only with a TPM that is on:
            # see tpm_advice)
            tpm = tpm or tpm_advice()
            if not args.encrypt:
                args.encrypt = True
                args.tpm = False
            elif not args.tpm and tpm[0]:
                args.tpm = True
            else:
                args.encrypt = args.tpm = False
        elif choice == "3":
            lvl = input("Packages' CPU level [auto / x86-64-v1 / x86-64-v2 / x86-64-v3 / x86-64-v4]: ").strip()
            if lvl in ("auto", "x86-64", "x86-64-v1", "x86-64-v2", "x86-64-v3", "x86-64-v4"):
                args.level = lvl
            cm = input(f"Own builds' CPU (gcc -march: auto = this CPU, or a name) [{args.cpu}]: ").strip()
            if cm == "auto" or valid_cpu(cm):
                args.cpu = cm
        elif choice == "4":
            sub = input(f"[l] toggle language ({args.language}), [k] set keyboard layout ({args.keymap}) [l/k]: ").strip().lower() or "l"
            if sub == "k":
                km = input(f"Keyboard layout (e.g. us, dvorak, colemak, gb, de, fr, jp) [{args.keymap}]: ").strip()
                if km and re.fullmatch(r"[A-Za-z0-9._-]+", km):
                    args.keymap = km
            else:
                args.language = "zh_CN.UTF-8" if args.language == "en_US.UTF-8" else "en_US.UTF-8"
                if args.language.startswith("zh"):
                    features.add("cjk-fonts")
        elif choice == "5":
            hn = input(f"Hostname [{args.hostname}]: ").strip()
            if hn:
                if valid_hostname(hn):
                    args.hostname = hn
                else:
                    print("Invalid hostname (use 1-63 letters, digits or hyphens).")
            u = input(f"User name [{args.user}]: ").strip()
            if u:
                args.user = u
            fn = input(f"Full name (optional) [{args.full_name}]: ").strip()
            if fn or args.full_name:
                args.full_name = fn
            lk = input("Ask for password at boot? [Y/n]: ").strip().lower()
            args.login_skip = lk == "n"
        elif choice == "6":
            args.no_ime = False
            cur = effective_ime(args)
            args.ime = "en" if cur == "off" else "zh" if cur == "en" else "off"
            if args.ime == "zh":
                features.add("cjk-fonts")
        elif choice == "7":
            print("\nOptional system modules:")
            for idx, m in enumerate(all_features, 1):
                mark = "x" if m in features else " "
                print(f"  [{mark}] {idx:2d}. {m:<11s} {MODULES[m].get('description', '')}")
            t = input("Toggle by number/name (comma-separated), or 'all' / 'none': ").strip().lower()
            if t in ("none", "minimal"):
                features.clear()
            elif t == "all":
                features = set(all_features)
            else:
                for tok in parse_csv_items(t):
                    name = all_features[int(tok) - 1] if tok.isdigit() and 1 <= int(tok) <= len(all_features) else tok
                    if name in all_features:
                        if name in features:
                            features.remove(name)
                        else:
                            features.add(name)
            args.features = ",".join(sorted(features))
        elif choice == "8":
            print("\nAvailable container & host app presets:")
            for idx, c in enumerate(all_containers, 1):
                mark = "x" if c in containers else " "
                print(f"  [{mark}] {idx:2d}. {c}")
            t = input("Toggle by number/name (comma-separated), or 'all' / 'none': ").strip().lower()
            if t == "none":
                containers.clear()
            elif t == "all":
                containers = set(all_containers)
            else:
                for tok in parse_csv_items(t):
                    name = all_containers[int(tok) - 1] if tok.isdigit() and 1 <= int(tok) <= len(all_containers) else tok
                    if name in all_containers:
                        if name in containers:
                            containers.remove(name)
                        else:
                            containers.add(name)
            args.containers = ",".join(sorted(containers))
        elif choice == "9":
            print("Available machine profiles: " + ", ".join(name for name, _ in machine_profiles()))
            m = input("Machine profile [generic]: ").strip() or "generic"
            args.machine = "" if m == "generic" else m
        elif choice == "10":
            tz = input(f"Timezone ('auto' for network GeoIP, or Region/City e.g. Asia/Shanghai, America/New_York, UTC) [{args.timezone}]: ").strip()
            if tz:
                args.timezone = tz
            nt = input(f"Enable NTP network clock sync? [{'Y/n' if not args.no_ntp else 'y/N'}]: ").strip().lower()
            if nt in ("y", "yes"):
                args.no_ntp = False
            elif nt in ("n", "no"):
                args.no_ntp = True
            cn = input(f"Copy live Wi-Fi / NetworkManager profiles to installed system? [{'Y/n' if args.copy_network else 'y/N'}]: ").strip().lower()
            if cn in ("y", "yes"):
                args.copy_network = True
            elif cn in ("n", "no"):
                args.copy_network = False
        elif choice == "11":
            rp = input(f"Git repository for LOCachy source updates ('off' disables) [{repo}]: ").strip()
            if rp and rp != "off" and not valid_repo_url(rp):
                print("Not an https://, ssh:// or git@ URL.")
            elif rp:
                args.update_repo = rp
            br = input(f"Branch to follow [{branch}]: ").strip()
            if br and not valid_branch(br):
                print("Invalid branch name.")
            elif br:
                args.update_branch = br
            rp = input(f"Git repository for the app presets ('off' disables) [{apps_repo}]: ").strip()
            if rp and rp != "off" and not valid_repo_url(rp):
                print("Not an https://, ssh:// or git@ URL.")
            elif rp:
                args.apps_repo = rp
            br = input(f"Its branch to follow [{apps_branch}]: ").strip()
            if br and not valid_branch(br):
                print("Invalid branch name.")
            elif br:
                args.apps_branch = br
        elif choice == "12":
            on = repo_sections(args.repos)
            t = input(f"Toggle sections (comma-separated: {', '.join(REPO_SECTIONS)}; Enter keeps) [{','.join(on)}]: ").strip().lower()
            for tok in parse_csv_items(t):
                if tok in REPO_SECTIONS:
                    on = [x for x in on if x != tok] if tok in on else on + [tok]
            args.repos = ",".join(x for x in REPO_SECTIONS if x in on)
            rk = input(f"Rank the mirrors before building? [{'Y/n' if not args.no_rank_mirrors else 'y/N'}]: ").strip().lower()
            if rk in ("y", "yes"):
                args.no_rank_mirrors = False
            elif rk in ("n", "no"):
                args.no_rank_mirrors = True
        elif choice == "i":
            args.features = ",".join(sorted(features))
            args.containers = ",".join(sorted(containers))
            return True


def make_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root")
    parser.add_argument("--esp")
    parser.add_argument("--disk", help="auto-partition this disk (GPT: ESP + swap + root)")
    parser.add_argument("--swap-gib", type=int, default=8, help="swap size in GiB when --disk is used")
    parser.add_argument("--format-esp", help="format this partition as FAT32 ESP")
    parser.add_argument("--format-root", help="format this partition as ext4 (or LUKS2+ext4) locachy-root")
    parser.add_argument("--format-swap", help="format this partition as swap (or LUKS2+swap) locachy-swap")
    parser.add_argument("--encrypt", action="store_true", help="encrypt root (and swap) with LUKS2")
    parser.add_argument("--tpm", action="store_true", help="bind LUKS2 auto-unlock to TPM 2.0 or TPM 1.2 (unlocks into boot lock screen)")
    parser.add_argument("--luks-passphrase-file", help="file holding the LUKS2 passphrase")
    parser.add_argument("--secure-boot", action="store_true",
                        help="this computer's own Secure Boot keys (sbctl) into the firmware, which must be in "
                             "setup mode; the boot image signed with them, and TPM 2.0 auto-unlock bound to them")
    parser.add_argument("--secure-boot-microsoft", action="store_true",
                        help="with --secure-boot: Microsoft's keys too (Windows, Microsoft-signed boot media, "
                             "firmware drivers some machines need)")
    parser.add_argument("--password-file", help="file holding the installed user's password (else passwd asks)")
    parser.add_argument("--level", default="auto", choices=("auto", "x86-64", "x86-64-v1", "x86-64-v2", "x86-64-v3", "x86-64-v4"),
                        help="the packages' CPU level (the repositories stacked for it)")
    parser.add_argument("--cpu", default="auto",
                        help="what the system's own builds are for (gcc -march): auto, this CPU's model; or a name")
    parser.add_argument("--repos", default="core,extra,multilib",
                        help="the repositories' sections used, in every layer (core,extra,multilib)")
    parser.add_argument("--no-rank-mirrors", action="store_true",
                        help="do not rank the mirror lists (reflector, rate-mirrors) before building")
    parser.add_argument("--language", default="en_US.UTF-8", choices=("en_US.UTF-8", "zh_CN.UTF-8"))
    parser.add_argument("--ime", default="auto", choices=("auto", "off", "en", "zh"),
                        help="input method packages: off (default for English), en (librime+words), zh (rime-frost)")
    parser.add_argument("--no-ime", action="store_true", help="same as --ime off")
    parser.add_argument("--login-skip", action="store_true", help="do not lock the screen at boot")
    parser.add_argument("--hibernate-after", type=int, help="seconds asleep with the lid closed before hibernation (on mains power too)")
    parser.add_argument("--features", default="",
                        help="comma-separated optional modules (" + ",".join(MODULES.keys()) + ")")
    parser.add_argument("--minimal", action="store_true",
                        help="start the wizard with no optional modules or containers preselected")
    parser.add_argument("--containers", default="", help="comma-separated container presets to add (foot,code,edge,firefox,...)")
    parser.add_argument("--machine", default="", help="hardware profile from machines/ (e.g. x230-agan; default: generic PC)")
    parser.add_argument("--update-repo", default="",
                        help="Git URL for LOCachy source updates, or off (default: where this source came from, "
                             "else github.com/niuyuanzhao/locachy)")
    parser.add_argument("--update-branch", default="",
                        help="branch of the update repository to follow (default: this source's branch, else main)")
    parser.add_argument("--apps-repo", default="",
                        help="Git URL for the app presets, or off (default: where this run's catalog came from, "
                             "else github.com/niuyuanzhao/locachy-apps)")
    parser.add_argument("--apps-branch", default="",
                        help="branch of the app presets repository to follow (default: the catalog's, else main)")
    parser.add_argument("--hostname", default="locachy", help="system hostname (/etc/hostname and /etc/hosts)")
    parser.add_argument("--keymap", default="us", help="keyboard layout (e.g. us, dvorak, colemak, gb, de, fr, jp)")
    parser.add_argument("--timezone", default="auto",
                        help="IANA timezone (e.g. Asia/Shanghai, America/New_York, UTC) or 'auto' for GeoIP")
    parser.add_argument("--no-ntp", action="store_true", help="disable automatic NTP network time sync")
    parser.add_argument("--copy-network", dest="copy_network", action="store_true", default=None,
                        help="copy live /etc/NetworkManager/system-connections into the installed system")
    parser.add_argument("--no-copy-network", dest="copy_network", action="store_false")
    parser.add_argument("--user", default="user")
    parser.add_argument("--full-name", default="", help="optional display name for the installed user")
    parser.add_argument("--work-dir", help="build workspace; default TARGET_ROOT/.locachy-installer")
    parser.add_argument("--cache-dir", help="package cache; default TARGET_ROOT/var/cache/pacman/pkg")
    parser.add_argument("--extra-volume", action="append", default=[], metavar="SPEC",
                        help="a storage volume beside the system: name=NAME,mode=format,dev=/dev/DISK,fs=ext4|btrfs,"
                             "role=data|shared|compute,encrypt=auto|luks|none (whole disk, erased); "
                             "name=NAME,mode=attach,dev=/dev/PART,role=... (existing partition, data kept); "
                             "name=NAME,mode=array,devs=/dev/A+/dev/B,raid=single|raid0|raid1|raid10,role=...,encrypt=... "
                             "(Btrfs array); optional compute_storage=1 on one volume with role shared or compute")
    parser.add_argument("--winmaint-disk", metavar="DEV",
                        help="the disk that hosts Maintenance Windows (Windows C: and its tail): the system disk "
                             "(--disk), a formatted --extra-volume's disk, or a secondary disk with free tail space; "
                             "none by default")
    parser.add_argument("--winmaint-gib", type=int, default=WINMAINT_DEFAULT_GIB,
                        help="Windows C: size in GiB with --winmaint-disk (%d..%d, default %d)"
                             % (WINMAINT_MIN_GIB, WINMAINT_MAX_GIB, WINMAINT_DEFAULT_GIB))
    parser.add_argument("--wizard", action="store_true", help="run the interactive configuration wizard")
    parser.add_argument("--yes", action="store_true", help="confirm the explicitly supplied empty target mounts")
    parser.add_argument("--check", action="store_true", help="validate and show targets without writing")
    parser.add_argument("--preflight", action="store_true",
                        help="check selected package source keys before any partition, format or target write")
    parser.add_argument("--describe-json", action="store_true",
                        help="print the choices, their defaults and the disks as JSON, and exit")
    parser.add_argument("--resume", action="store_true",
                        help="continue the installation this live session started, where it stopped, "
                             "on its disk as it is (secrets again: --password-file, --luks-passphrase-file)")
    parser.add_argument("--trust-key", nargs="+", metavar="FINGERPRINT",
                        help="source signing keys the installation stopped for: each shown, and trusted "
                             "when answered y (locachy-build --trust-key, in its target); then --resume")
    parser.add_argument("--install-id", help=argparse.SUPPRESS)
    parser.add_argument("--resume-info", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--resume-status", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--ui", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--refresh-live", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--private", action="store_true", help=argparse.SUPPRESS)
    return parser


def main():
    parser = make_parser()
    args = parser.parse_args()
    if args.describe_json:
        print(json.dumps(describe(parser), indent=1))
        return 0
    if args.resume_info or args.resume_status:
        print(json.dumps(public_resume_record(), indent=1) if public_resume_record() else "null")
        return 0
    if args.ui or args.refresh_live:
        # Older media forward these flags after fetching this backend. Enter
        # the selected snapshot's updater directly, never recurse through the
        # old wrapper or mix live bootstrap with an installation request.
        allowed = {"--ui", "--refresh-live", "--update-repo", "--update-branch", "--apps-repo", "--apps-branch"}
        if args.ui and args.refresh_live or any(a.startswith("-") and a.split("=", 1)[0] not in allowed
                                               for a in sys.argv[1:]):
            parser.error("Live bootstrap accepts only one mode and source repository options")
        if os.geteuid() != 0:
            parser.error("Run from the live installer as root")
        helper = SOURCE / "installer/live-update.py"
        if not helper.is_file():
            parser.error("The selected source has no live updater")
        try:
            repo, branch, _ = update_source(args)
            apps_repo, apps_branch = apps_source(args)
        except ValueError as error:
            parser.error(str(error))
        os.execv(sys.executable, [sys.executable, "-I", str(helper), "--source", str(SOURCE),
                                 "--mode", "refresh" if args.refresh_live else "ui",
                                 "--update-repo=" + repo, "--update-branch=" + branch,
                                 "--apps-repo=" + apps_repo, "--apps-branch=" + apps_branch])
        return 0
    if os.geteuid() != 0:
        parser.error("Run from the live installer as root")
    context = nullcontext(None) if args.check and not (args.private or args.resume or args.trust_key) else \
        installation_lock(args.private)
    try:
        with context as lock_fd:
            return run_installation(parser, args, lock_fd)
    except (OSError, ValueError) as error:
        print("locachy-install: " + str(error), file=sys.stderr)
        return 1


def run_installation(parser, args, lock_fd):
    if (args.resume or args.trust_key) and not args.private:
        try:
            record = read_resume_record()
            before_target = record.get("phase") == "preflight"
            if record.get("phase") == "partitioning":
                raise ValueError("Partitioning was interrupted; inspect the target in the terminal. "
                                 "Resume never repeats partitioning or formatting.")
            root = None if before_target else resumed_target(record)
        except ValueError as e:
            parser.error(str(e))
        if args.trust_key:
            return trust_install_keys(args.trust_key, root)
        # Old records have no phase: they are target resumes, never fresh
        # formatting requests. Preflight records have not touched a target.
        stored = parser.parse_args(record["argv"])
        args = parser.parse_args(record["argv"] + [a for a in sys.argv[1:] if a != "--resume"])
        args.resume, args.install_id = not before_target, record["install_id"]
        # A resume is a continuation, not a second configuration pass. In
        # particular, --wizard must not be able to replace the target after
        # the resume checks have run (the old path allowed exactly that).
        target_options = ("root", "esp", "disk", "format_root", "format_esp", "format_swap", "swap_gib",
                          "encrypt", "tpm", "secure_boot", "secure_boot_microsoft",
                          "extra_volume", "winmaint_disk", "winmaint_gib", "wizard")
        if any(getattr(args, key) != getattr(stored, key) for key in target_options):
            parser.error("A continued installation cannot change its target or storage configuration")
        if not before_target:
            if args.disk or args.format_root or args.format_esp or args.format_swap:
                parser.error("A target resume record must not partition or format")
            if (args.root, args.esp) != (str(root), str(root / "efi")):
                parser.error("A continued installation cannot change the target mounts")
            print("Continuing the installation on " + str(root) + ", where it stopped.", flush=True)
        else:
            print("Continuing installation preflight; no target was partitioned or formatted.", flush=True)
        # The app presets it started with stay pinned, including a preflight
        # that stopped before it had a target to hold them.
        use_resume_catalog(record)
    if args.copy_network is None:
        args.copy_network = bool(live_nm_connections())
    if os.geteuid() != 0:
        parser.error("Run from the live installer as root")
    if (args.wizard or (not args.root and not args.esp and not args.disk and not args.format_root)) and not args.private:
        if not interactive_wizard(args):
            print("Nothing changed.")
            return 0
    if not args.root and not args.disk and not args.format_root:
        parser.error("Specify --root and --esp, --disk, --format-root/--format-esp, or --wizard")
    if not args.disk and not args.format_root and not (args.root and args.esp):
        parser.error("--root and --esp go together")
    if not args.disk and bool(args.format_root) != bool(args.format_esp):
        parser.error("--format-root and --format-esp go together")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", args.user) or args.user in ("root", "locachy-builder"):
        parser.error("Invalid installed user name")
    if args.cpu != "auto" and not valid_cpu(args.cpu):
        parser.error("--cpu: not a CPU name (gcc -march)")
    if args.tpm and args.login_skip:
        parser.error("--tpm with --login-skip: the TPM opens the disk at power-on, so the lock at boot must stay")
    if args.tpm and not args.private and not tpm_advice()[0]:
        parser.error("--tpm: " + tpm_advice()[2])
    try:
        update_source(args)
        apps_source(args)
        repo_sections(args.repos)
        if not args.private:
            check_choices(args)
            check_targets(args)
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        parser.error(str(e))
    if not args.private:
        print_source()
    try:
        level = cpu_level(args.level)
        target = identities = None
        if not (args.disk or args.format_root):
            target = validate(args.root, args.esp, args.install_id if args.resume else None)
            if not args.check and not args.private:
                identities = target_identities(*target[2:])
                if args.resume and "mounts" in record and record["mounts"] != identities:
                    raise ValueError("The target root or ESP filesystem changed since installation began")
        if args.check and (args.disk or args.format_root):
            # --check writes nothing: what would be partitioned and formatted.
            extra_note = ""
            extra_vols = parse_extra_volumes(getattr(args, "extra_volume", None) or [],
                                             encrypt_root=bool(getattr(args, "encrypt", False)))
            if extra_vols:
                extra_note = "; extra volumes: " + ", ".join(
                    f"{v['name']} ({v['mode']} {'+'.join(v['devs'])})" for v in extra_vols
                )
            if args.winmaint_disk:
                extra_note += f"; Maintenance Windows {args.winmaint_gib} GiB on {args.winmaint_disk}"
            print("Would " + (f"partition {args.disk} (all of it) and format it" if args.disk else
                              "format " + ", ".join(p for p in (args.format_esp, args.format_root, args.format_swap) if p)) +
                  ("; LUKS2" + (" + TPM" if args.tpm else "") if args.encrypt else "") +
                  extra_note +
                  f"; CPU {level}, own builds for {args.cpu}", flush=True)
            return 0
        if not args.private and not args.check:
            args.install_id = args.install_id or uuid.uuid4().hex
            try:
                status = preflight_keys(args)
            except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
                print("Installation source-key preflight failed: " + str(error), file=sys.stderr, flush=True)
                status = 1
            if status:
                if not args.resume:
                    write_resume_record(args.install_id, args.root or "", safe_arguments(args), args, phase="preflight")
                print("Continue with: locachy-install --resume", flush=True)
                return status
            if args.preflight:
                print("Installation preflight completed; no target was changed.", flush=True)
                return 0
        if not args.private and (args.disk or args.format_root):
            passphrase = None
            if args.encrypt:
                if args.luks_passphrase_file:
                    passphrase = read_secret(args.luks_passphrase_file)
                else:
                    p1 = getpass.getpass("LUKS2 disk encryption passphrase: ")
                    p2 = getpass.getpass("Confirm LUKS2 passphrase: ")
                    if not p1 or p1 != p2:
                        raise ValueError("LUKS2 passphrases did not match or were empty")
                    passphrase = p1
            if not args.yes and input("Type INSTALL to partition/format and install LOCachy: ") != "INSTALL":
                print("Nothing changed.")
                return 0
            # A crash anywhere in formatting must never leave a preflight
            # record that a later c could mistake for permission to do it again.
            write_resume_record(args.install_id, args.root or "", safe_arguments(args), args, phase="partitioning")
            prepare_partitions(args, passphrase)
            args.yes = True
            # Keep the partitioning record until the mounts are verified and
            # their target-local marker is durable.
            args.disk = args.format_root = args.format_esp = args.format_swap = None
            target = validate(args.root, args.esp)
            identities = target_identities(*target[2:])
        root, esp, root_fs, esp_fs = target
        print("Root: " + root_fs["source"] + " at " + str(root), flush=True)
        print("ESP:  " + esp_fs["source"] + " at " + str(esp), flush=True)
        print("Target CPU: " + level + "; input method: " + effective_ime(args) +
              "; encryption: " + ("LUKS2" + (" + TPM" if args.tpm else "") if args.encrypt else "off"), flush=True)
        if args.encrypt and not args.private:
            print("TPM: " + tpm_advice()[2], flush=True)
        if args.check:
            return 0
        if not args.private:
            if not args.yes and not args.resume and \
                    input("Type INSTALL to build into these empty filesystems: ") != "INSTALL":
                print("Nothing changed.")
                return 0
            args.install_id = args.install_id or uuid.uuid4().hex
            fwd = []
            for k, v in (("--root", str(root)), ("--esp", str(esp)), ("--level", args.level),
                         ("--cpu", args.cpu), ("--repos", args.repos),
                         ("--language", args.language), ("--ime", effective_ime(args)), ("--user", args.user),
                         ("--full-name", args.full_name), ("--hostname", args.hostname), ("--keymap", args.keymap),
                         ("--timezone", args.timezone),
                         ("--features", args.features), ("--containers", args.containers),
                         ("--machine", args.machine), ("--update-repo", args.update_repo),
                         ("--update-branch", args.update_branch), ("--apps-repo", args.apps_repo),
                         ("--apps-branch", args.apps_branch)):
                if v:
                    fwd += [k, v]
            fwd.append("--copy-network" if args.copy_network else "--no-copy-network")
            if args.no_ntp:
                fwd.append("--no-ntp")
            if args.no_rank_mirrors:
                fwd.append("--no-rank-mirrors")
            if args.no_ime:
                fwd.append("--no-ime")
            if args.login_skip:
                fwd.append("--login-skip")
            if args.encrypt:
                fwd.append("--encrypt")
            if args.tpm:
                fwd.append("--tpm")
            if args.secure_boot:
                fwd.append("--secure-boot")
            if args.secure_boot_microsoft:
                fwd.append("--secure-boot-microsoft")
            if args.hibernate_after is not None:
                fwd += ["--hibernate-after", str(args.hibernate_after)]
            if args.work_dir:
                fwd += ["--work-dir", args.work_dir]
            if args.cache_dir:
                fwd += ["--cache-dir", args.cache_dir]
            for spec in getattr(args, "extra_volume", None) or []:
                fwd += ["--extra-volume", spec]
            if args.winmaint_disk:
                fwd += ["--winmaint-disk", args.winmaint_disk, "--winmaint-gib", str(args.winmaint_gib)]
            if not args.resume:
                INSTALL_STATE.write_text(root / ".locachy-installer/install-id", args.install_id + "\n")
            active = write_resume_record(args.install_id, root, fwd, args, mounts=identities)
            use_resume_catalog(active)
            secrets = []
            if args.luks_passphrase_file:
                secrets += ["--luks-passphrase-file", args.luks_passphrase_file]
            if args.password_file:
                secrets += ["--password-file", args.password_file]
            done = run(["unshare", "--mount", "--propagation", "private", "--pid", "--fork", "--kill-child", "--mount-proc",
                        "--cgroup", sys.executable, os.path.realpath(__file__)] + fwd + secrets +
                        ["--install-id", args.install_id, "--resume", "--private", "--yes"], check=False,
                        pass_fds=(lock_fd,), env=dict(os.environ, LOCACHY_INSTALL_LOCK_FD=str(lock_fd)))
            if done.returncode < 0:
                print(f"locachy-install: the installation was stopped by signal {-done.returncode}", file=sys.stderr)
            if done.returncode:
                # Its own last line said why. What it waits for, and the way on.
                keys = untrusted_keys(root)
                if keys:
                    for name, key in keys:
                        print(f"Source key to trust: {name} {key}")
                    print("Check each with its upstream project, then trust it (none is trusted by itself):")
                    print("Trust them: locachy-install --trust-key " + " ".join(sorted({k for _, k in keys})))
                print("Continue with: locachy-install --resume", flush=True)
                return 1
            RESUME_RECORD.unlink(missing_ok=True)
            if active["apps_catalog_path"] is not None:
                shutil.rmtree(active["apps_catalog_path"], ignore_errors=True)
            shutil.rmtree(RESUME_APPS, ignore_errors=True)

        else:
            install(args, root, esp, root_fs, esp_fs, level)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print("locachy-install: " + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
