# Maintenance Windows (locachy-winmaint): the Windows C: size in GiB, and the
# tail it needs beside it (a 128 MiB ESP, a 16 MiB MSR, alignment slack).
WINMAINT_MIN_GIB = 40
WINMAINT_DEFAULT_GIB = winmaint_default_gib()
WINMAINT_MAX_GIB = 4096
WINMAINT_OVERHEAD_MIB = 256
