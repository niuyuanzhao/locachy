    the installer image recorded (source-origin.json apps_*)."""
    meta = apps_meta()
    repo, branch, commit = (meta.get(k, "") for k in ("repo", "branch", "commit"))
    if not repo:
        try:
            origin = json.loads(Path(origin_file).read_text(encoding="utf-8"))
            repo, branch, commit = (str(origin.get(k) or "") for k in ("apps_repo", "apps_branch", "apps_commit"))
        except (OSError, ValueError, AttributeError):
