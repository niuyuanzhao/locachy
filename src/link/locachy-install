def host_preset_packages(containers, presets_dir=None, known=None):
    known = known if known is not None else presets(presets_dir)
    pkgs = []
    for cname in containers:
        entry = known.get(cname)
        if not entry or not entry[1]:
            continue
        values = APPS.conf_values(entry[0].read_text(encoding="utf-8"))
        for name in APPS.packages(values).split():
            if name not in pkgs:
                pkgs.append(name)
    return pkgs


def run(command, check=True, **kwargs):
    return subprocess.run(command, check=check, **kwargs)


def output(command):
    return subprocess.check_output(command, text=True).strip()


def supported_levels():
    loader = output(["/usr/lib/ld-linux-x86-64.so.2", "--help"])
    supported = {"x86-64"}
    supported.update(re.findall(r"(x86-64-v[234]) \(supported", loader))
    return supported


def cpu_level(requested):
    supported = supported_levels()
    if requested == "auto":
        return next(level for level in ("x86-64-v4", "x86-64-v3", "x86-64-v2", "x86-64") if level in supported)
    level = "x86-64" if requested == "x86-64-v1" else requested
    if level not in supported:
        raise ValueError("This machine cannot execute " + level)
    return level


def cpu_macros(march):
    """gcc's feature macros for -march=MARCH (__AVX2__, __AES__...), as
    make-root.sh compares them."""
    out = output(["gcc", "-march=" + march, "-dM", "-E", "-x", "c", "/dev/null"])
    return set(re.findall(r"^#define (__[A-Z0-9_]+__) 1$", out, re.M))


def cpu_model(level):
    """What gcc calls this machine's CPU (its -march=native: ivybridge,
    znver3, ...), for the system's own builds. "native" itself when that name
    has more than this CPU (a feature the firmware turned off, or a virtual
    machine's CPU: skylake without SGX); the level if gcc cannot say."""
    try:
        out = output(["gcc", "-march=native", "-Q", "--help=target"])
        m = re.search(r"^\s*-march=\s+(\S+)\s*$", out, re.M)
        if not m or not valid_cpu(m.group(1)):
            return level
        return m.group(1) if cpu_macros(m.group(1)) <= cpu_macros("native") else "native"
    except (OSError, subprocess.SubprocessError):
        return level


def valid_cpu(name):
    return bool(re.fullmatch(r"[a-z0-9][a-z0-9._+-]{0,40}", name or ""))


# What this machine's TPM can do for the disk (locachy-tpm status), and so
# what to choose with encryption on: (usable, recommended, why). TPM
# auto-unlock opens the disk at power-on with nothing typed; bound as
# without own Secure Boot keys (TPM 1.2: PCR 0, TPM 2.0: PCRs 0+7, the boot
# image unsigned) it guards a disk taken out of the machine only. With the
# firmware in setup mode, this machine's own Secure Boot keys can be enrolled
# (--secure-boot): TPM 2.0 is then bound to them and to the signed images.
def tpm_status():
    try:
        return json.loads(output([sys.executable, "-I", str(SOURCE / "link/locachy-tpm"), "status", "--json"]))
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}


def tpm_advice(st=None):
    st = tpm_status() if st is None else st
    ver, active, sb = st.get("tpm_version", 0), st.get("tpm_active", False), st.get("secure_boot")
    if not ver:
        return False, "passphrase", "no TPM: a passphrase"
    if not active:
        return False, "passphrase", f"TPM {'1.2' if ver == 1 else '2.0'} off in the firmware: a passphrase"
    if ver == 1:
        return True, "passphrase", ("TPM 1.2: a passphrase recommended (TPM auto-unlock binds the firmware only, "
                                    "with no PIN: it guards a removed disk only)")
    if st.get("setup_mode"):
        return True, "tpm", ("TPM 2.0, the firmware in setup mode: with this computer's own Secure Boot keys "
                             "enrolled, TPM auto-unlock opens the disk only for LOCachy's signed boot images "
                             "with Secure Boot on (from the first such start, the passphrase typed once then), "
                             "coming back from hibernation too")
    return True, "passphrase", ("TPM 2.0: a passphrase recommended (TPM auto-unlock binds PCRs 0+7"
                                + (", Secure Boot off" if not sb else "") + ", the boot image unsigned: "
                                "it guards a removed disk only)")


# fwupd's Host Security ID report (fwupdmgr security): the HSI level and each
# check, as fwupd words them; None without fwupd.
def host_security():
    if not shutil.which("fwupdmgr"):
        return None
    try:
        p = subprocess.run(["fwupdmgr", "security", "--no-unreported-check", "--no-security-fix",
                            "--no-reboot-check"], capture_output=True, text=True, timeout=90,
                           stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None
    text = re.sub(r"\x1b\[[0-9;]*m", "", p.stdout)
    found = re.search(r"HSI:\S+(?: \([^)]*\))?", text)
    if p.returncode != 0 or not found:
        return None
    checks = [line.strip() for line in text.splitlines() if line.strip()[:1] in ("\u2714", "\u2718")]
    return {"id": found.group(0), "checks": checks}


REPO_SECTIONS = ("core", "extra", "multilib")


def repo_sections(raw):
    chosen = parse_csv_items(raw)
    for s in chosen:
        if s not in REPO_SECTIONS:
            raise ValueError(f"--repos: {s} is not one of {', '.join(REPO_SECTIONS)}")
    return [s for s in REPO_SECTIONS if s in chosen]


def canonical(path):
    absolute = Path(os.path.abspath(path))
    if absolute.resolve(strict=True) != absolute:
        raise ValueError("Mount paths must not contain symlinks: " + str(absolute))
    return absolute


def filesystem(path):
    data = json.loads(output(["findmnt", "--json", "--mountpoint", str(path),
                              "--output", "TARGET,SOURCE,FSTYPE,OPTIONS,MAJ:MIN"]))
    entries = data.get("filesystems", [])
    if len(entries) != 1 or Path(entries[0]["target"]) != path:
        raise ValueError("An explicit filesystem mount is required: " + str(path))
    return entries[0]


def ancestors(source):
    return set(output(["lsblk", "--inverse", "--noheadings", "--raw", "--output", "MAJ:MIN", source]).splitlines())


def empty_root(root):
    for entry in root.iterdir():
        if entry.name == "lost+found" and entry.is_dir() and not entry.is_symlink() and not any(entry.iterdir()):
            continue
        if entry.name == "efi" and entry.is_dir() and not entry.is_symlink():
            continue
        raise ValueError("Target root is not empty: " + str(entry))


def esp_ours_only(esp):
    """The ESP holds nothing but what an installation writes there."""
    return all(str(p.relative_to(esp)) in ESP_FILES for p in esp.rglob("*"))


@contextmanager
def installation_lock(private=False):
    # One record and one set of target mutations per live session. Never
    # unlink the lock file: another open of its path must see the same inode.
    directory = RESUME_RECORD.parent
    if private:
        fd = private_lock_fd()
    else:
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        if directory.is_symlink():
            raise ValueError(f"installation state must not be a symlink: {directory}")
        fd = os.open(directory / "operation.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        if not private:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise ValueError("Another installation operation is already running") from None
        yield fd
    finally:
        os.close(fd)


def private_lock_fd():
    # The private worker inherits the parent's locked open file description;
    # it must not open a second one and compete with its own parent.
    try:
        fd = int(os.environ.pop("LOCACHY_INSTALL_LOCK_FD", ""))
        if fd < 3 or not os.path.samestat(os.fstat(fd), (RESUME_RECORD.parent / "operation.lock").lstat()):
            raise ValueError
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        os.set_inheritable(fd, False)
        return fd
    except (OSError, ValueError):
        raise ValueError("The private installer requires the live installer's operation lock") from None


def read_resume_record():
    try:
        record = json.loads(RESUME_RECORD.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        raise ValueError("Nothing to continue: no installation was started in this live session")
    if not isinstance(record, dict) or not re.fullmatch(r"[0-9a-f]{32}", str(record.get("install_id", ""))) or \
            not isinstance(record.get("argv"), list) or not all(isinstance(a, str) for a in record["argv"]):
        raise ValueError("The record of the installation to continue is damaged: " + str(RESUME_RECORD))
    return record


def source_revision():
    """The backend's exact input tree, even for a tree without git metadata."""
    repo, branch, commit = detect_source_git()
    return {"repo": repo, "branch": branch, "commit": commit,
            "tree": INSTALL_STATE.files_digest(SOURCE, INSTALL_STATE.SOURCE_INPUTS)}


def public_resume_record():
    try:
        record = read_resume_record()
    except ValueError:
        return None
    shown = {key: record[key] for key in ("schema", "phase", "install_id", "root", "source") if key in record}
    # Older records are accepted, but never echo a secret option someone
    # may have added to one by hand into describe-json or a UI session file.
    argv, skip = [], False
    for value in record["argv"]:
        if skip:
            skip = False
            continue
        if value in ("--password-file", "--luks-passphrase-file"):
            skip = True
        elif not value.startswith(("--password-file=", "--luks-passphrase-file=")):
            argv.append(value)
    shown["argv"] = argv
    return shown


def safe_arguments(args):
    """Parser choices without secret values/paths, flags internal to this run, or trust requests."""
    values = vars(args).copy()
    for key in ("password_file", "luks_passphrase_file", "trust_key", "private", "describe_json", "preflight", "check",
                "resume", "install_id", "yes", "wizard"):
        values.pop(key, None)
    argv = []
    for key, value in values.items():
        if value is None or value is False or value == "" or value == []:
            continue
        if key == "winmaint_gib" and not getattr(args, "winmaint_disk", None):
            continue
        option = "--" + key.replace("_", "-")
        if value is True:
            argv.append(option)
        elif isinstance(value, list):
            for item in value:
                argv.extend((option, str(item)))
        else:
            argv.extend((option, str(value)))
    if args.copy_network is False:
        argv.append("--no-copy-network")
    return argv


def catalog_digest(catalog):
    if catalog is None or not os.path.lexists(catalog):
        return None
    presets = APPS.read_catalog(catalog)
    meta = APPS.read_meta(catalog)
    # copy_catalog changes the installation timestamp, not the catalog inputs.
    meta.pop("installed", None)
    return INSTALL_STATE.digest({"meta": meta, "presets": INSTALL_STATE.files_digest(
        catalog, [Path(path).name for path in presets.values()])})


def write_resume_record(install_id, root, argv, args, phase="target", mounts=None):
    if not re.fullmatch(r"[0-9a-f]{32}", install_id):
        raise ValueError("Invalid installation ID")
    catalog = apps_catalog()
    fingerprint = catalog_digest(catalog)
    if fingerprint is not None:
        # Use a separate snapshot for each install ID. Publishing the new
        # record is the only switch; the previous record's pin stays intact
        # if staging or publication fails.
        pinned = RESUME_APPS.with_name(f"{RESUME_APPS.name}.{install_id}")
        if not os.path.lexists(pinned):
            APPS.copy_catalog(str(catalog), str(pinned))
        if catalog_digest(pinned) != fingerprint:
            raise ValueError("The installation's pinned app catalog does not match its inputs")
    else:
        pinned = None
    record = {"schema": 2, "phase": phase, "install_id": install_id,
              "root": str(root), "argv": argv, "update_repo": args.update_repo or "",
              "update_branch": args.update_branch or "", "apps_repo": args.apps_repo or "",
              "apps_branch": args.apps_branch or "", "apps_commit": apps_meta().get("commit", ""),
              "apps_catalog_path": str(pinned) if pinned is not None else None,
              "apps_catalog_digest": fingerprint, "source": source_revision()}
    if mounts is not None:
        record["mounts"] = mounts
    INSTALL_STATE.write_json(RESUME_RECORD, record)
    return record


def legacy_resume_catalog(record):
    """Reopen a valid pre-snapshot record without accepting a newer catalog."""
    expected = str(record.get("apps_commit") or "")
    candidates = []
    root = record.get("root")
    if root and record.get("phase") != "preflight":
        candidates.append(Path(root) / APPS_CATALOG)
    candidates.append(RESUME_APPS)
    for path in candidates:
        try:
            if catalog_digest(path) is None:
                continue
            meta = APPS.read_meta(str(path))
            if expected and meta.get("commit", "") != expected:
                continue
            return path
        except (OSError, ValueError):
            continue
    if expected:
        raise ValueError("The older installation record's app catalog is missing or changed; refusing a newer one")
    return None


def resume_catalog(record):
    """Open the exact snapshot, or a validated pre-snapshot selection."""
    if "apps_catalog_digest" not in record and "apps_catalog_path" not in record:
        return legacy_resume_catalog(record)
    fingerprint = record.get("apps_catalog_digest")
    path = record.get("apps_catalog_path")
    if fingerprint is None:
        if path is not None:
            raise ValueError("The installation's app catalog pin is damaged")
        return None
    if path != (str(RESUME_APPS) + "." + record["install_id"]):
        raise ValueError("The installation's app catalog pin has an unexpected path")
    try:
        if catalog_digest(Path(path)) == fingerprint:
            return Path(path)
    except (OSError, ValueError):
        pass
    raise ValueError("The installation's pinned app catalog is missing or changed")


def use_resume_catalog(record):
    pinned = resume_catalog(record)
    # Presence, rather than truthiness, distinguishes an explicit no-catalog
    # selection from a legacy medium that should supply its bundled catalog.
    os.environ["LOCACHY_APPS_CATALOG"] = str(pinned) if pinned is not None else ""
    os.environ["LOCACHY_APPS"] = ""


def target_identities(root_fs, esp_fs):
    """Filesystem identities, independent of changing /dev names or major/minor numbers."""
    identities = {}
    for role, fs in (("root", root_fs), ("esp", esp_fs)):
        uuid_value = output(["blkid", "-p", "-s", "UUID", "-o", "value", fs["source"]])
        if not uuid_value:
            raise ValueError(f"Cannot identify the target {role} filesystem: {fs['source']}")
        identities[role] = uuid_value
    return identities


def resumed_target(record):
    """The target of the recorded installation, still mounted and still its."""
    root = Path(record.get("root", ""))
    marker = root / ".locachy-installer/install-id"
    try:
        if not root.is_absolute() or not os.path.ismount(root) or marker.is_symlink() or marker.parent.is_symlink() or \
                marker.read_text(encoding="utf-8").strip() != record["install_id"]:
            raise OSError
    except (OSError, UnicodeError):
        raise ValueError(f"{root} is not that installation's target (not mounted, or another's)")
    return root


def untrusted_keys(root):
    """(name, fingerprint) of each source signing key the target's build
    stopped for, for a person to check and trust."""
    try:
        lines = (Path(root) / UNTRUSTED_KEYS).read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    return [tuple(parts) for parts in (line.split() for line in lines)
            if len(parts) == 2 and re.fullmatch(r"[0-9A-F]{40}|[0-9A-F]{64}", parts[1])]


def partition_child(disk, number):
    sep = "p" if re.search(r"[0-9]$", disk) else ""
    return f"{disk}{sep}{number}"


def same_device_path(a, b):
    """Whether two device paths name the same block device (symlinks resolved)."""
    if not a or not b:
        return False
    return a == b or os.path.realpath(a) == os.path.realpath(b)


def disk_size_bytes(disk):
    """The size of a whole disk in bytes (blockdev, else lsblk)."""
    try:
        return int(output(["blockdev", "--getsize64", disk]))
    except (OSError, ValueError, subprocess.SubprocessError):
        devices = block_devices(disk)
        return int(devices[0].get("size") or 0) if devices else 0


def winmaint_tail_mib(args):
    """The tail Maintenance Windows needs on its disk, in MiB: C: and the 128 MiB ESP and 16 MiB MSR."""
    return int(getattr(args, "winmaint_gib", WINMAINT_DEFAULT_GIB) or WINMAINT_DEFAULT_GIB) * 1024 + WINMAINT_OVERHEAD_MIB


def prepare_partitions(args, passphrase=None):
    """Partition/format target block devices when --disk or --format-root/--format-esp
    are given, optionally wrapping root and swap in LUKS2 (locachy-crypt and
    locachy-swap-crypt), and mount them at target_dir and target_dir/efi."""
    if getattr(args, "disk", None):
        disk = args.disk
        if not disk.startswith("/dev/"):
            raise ValueError("Disk must be a /dev/ block device: " + disk)
        swap_gib = getattr(args, "swap_gib", 8) or 0
        winmaint_disk = getattr(args, "winmaint_disk", None) or ""
        tail_mib = winmaint_tail_mib(args) if winmaint_disk and same_device_path(winmaint_disk, disk) else 0
        sfdisk_script = "label: gpt\n,512M,U\n"
        if tail_mib:
            # The root ends where the Maintenance Windows tail begins: locachy-winmaint appends it there.
            used_mib = 1 + 512 + (int(swap_gib) * 1024 if swap_gib > 0 else 0)
            root_mib = disk_size_bytes(disk) // (1 << 20) - used_mib - tail_mib - 2
            if root_mib < (MIN_ROOT_BYTES >> 20):
                raise ValueError(f"{disk}: no room for the root beside the {tail_mib} MiB Maintenance Windows tail")
            root_line = f",{root_mib}M,L\n"
        else:
            root_line = ",+,L\n"
        if swap_gib > 0:
            sfdisk_script += f",{int(swap_gib)}G,S\n{root_line}"
            esp_part, swap_part, root_part = partition_child(disk, 1), partition_child(disk, 2), partition_child(disk, 3)
        else:
            sfdisk_script += root_line
            esp_part, swap_part, root_part = partition_child(disk, 1), None, partition_child(disk, 2)
        run(["sfdisk", "--wipe", "always", disk], input=sfdisk_script, text=True)
        run(["udevadm", "settle"])
    else:
        esp_part = getattr(args, "format_esp", None)
        root_part = getattr(args, "format_root", None)
        swap_part = getattr(args, "format_swap", None)
        if not esp_part or not root_part:
            raise ValueError("Both --format-esp and --format-root are required when formatting partitions")

    run(["mkfs.fat", "-F", "32", "-n", "LOCACHY_EFI", esp_part])
    if getattr(args, "encrypt", False):
        if not passphrase:
            raise ValueError("A passphrase is required for LUKS2 Full Disk Encryption")
        # As a key file (--key-file -), every byte is the key: no newline, as
        # the boot prompt (init) and locachy-tpm give it.
        key_input = passphrase.rstrip("\r\n")
        run(["cryptsetup", "luksFormat", "--batch-mode", "--type", "luks2",
             "--label", "locachy-crypt", "--key-file", "-", root_part], input=key_input, text=True)
        run(["cryptsetup", "open", "--type", "luks", "--key-file", "-",
             root_part, "locachy-crypt"], input=key_input, text=True)
        root_formatting_dev = "/dev/mapper/locachy-crypt"
        if swap_part:
            run(["cryptsetup", "luksFormat", "--batch-mode", "--type", "luks2",
                 "--label", "locachy-swap-crypt", "--key-file", "-", swap_part], input=key_input, text=True)
            run(["cryptsetup", "open", "--type", "luks", "--key-file", "-",
                 swap_part, "locachy-swap-crypt"], input=key_input, text=True)
            swap_formatting_dev = "/dev/mapper/locachy-swap-crypt"
        else:
            swap_formatting_dev = None
    else:
        root_formatting_dev = root_part
        swap_formatting_dev = swap_part

    run(["mkfs.ext4", "-F", "-L", "locachy-root", root_formatting_dev])
    if swap_formatting_dev:
        run(["mkswap", "-L", "locachy-swap", swap_formatting_dev])

    target = Path(getattr(args, "root", None) or "/run/locachy-install-target")
    target.mkdir(parents=True, exist_ok=True)
    run(["mount", root_formatting_dev, str(target)])
    esp = target / "efi"
    esp.mkdir(parents=True, exist_ok=True)
    run(["mount", esp_part, str(esp)])
    args.root = str(target)
    args.esp = str(esp)
    return root_formatting_dev, esp_part, swap_formatting_dev


def parse_csv_items(raw):
    if not raw:
        return []
    return [item.strip() for item in raw.split(",") if item.strip()]


def valid_repo_url(url):
    return bool(url) and url.startswith(("https://", "ssh://", "git@")) and not re.search(r'[\s"\\$`]', url)


def valid_branch(name):
    """A branch name git accepts and that is safe as one fetch argument."""
    return bool(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]{0,127}", name or "")) and ".." not in name \
        and "//" not in name and not name.endswith(("/", ".", ".lock"))


def detect_source_git(source_dir=None, origin_file=SOURCE_ORIGIN):
    """Return (remote_url, branch, head_commit) of the source: from its git
    checkout, else from the origin the installer image recorded."""
    src = Path(source_dir or SOURCE)
    remote = branch = commit = ""

    def git(*args):
        try:
            return subprocess.run(["git", "-C", str(src), *args], check=True, capture_output=True,
                                  text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return ""
    commit = git("rev-parse", "HEAD")
    if commit:
        remote = git("remote", "get-url", "origin")
        branch = git("symbolic-ref", "--short", "HEAD")
    else:
        try:
            origin = json.loads(Path(origin_file).read_text(encoding="utf-8"))
            remote, branch, commit = (str(origin.get(k) or "") for k in ("repo", "branch", "commit"))
        except (OSError, ValueError, AttributeError):
            pass
    return (remote if valid_repo_url(remote) else DEFAULT_UPDATE_REPO,
            branch if valid_branch(branch) else DEFAULT_UPDATE_BRANCH, commit)


def source_line():
    """(text, not_newest): which LOCachy source this run is, for the
    installation's log and the full-screen installer: its commit, repository
    and branch, and how the live entry got it (LOCACHY_SOURCE: fetched now,
    fetched before, or the medium's own, and why). not_newest: the newest
    was to be fetched and was not."""
    repo, branch, commit = detect_source_git()
    how = os.environ.get("LOCACHY_SOURCE", "")
    short = commit[:12] if commit else "unknown commit"
    if how == "bundled: updates are off":
        return f"this medium's own, {short} (updates are off)", False
    if how.startswith("bundled: "):
        return f"this medium's own, {short}; {how[len('bundled: '):]}", True
    line = f"{short} of {repo} ({branch})"
    if how == "fetched":
        return line + ", the newest, fetched now", False
    if how == "fetched earlier":
        return line + ", fetched earlier", False
    if how.startswith("fetched before: "):
        return line + ", fetched before; " + how[len("fetched before: "):], True
    return line, False


def apps_catalog():
    """The selected catalog path; an explicit empty selection means none."""
    path = os.environ.get("LOCACHY_APPS_CATALOG", MEDIUM_APPS_CATALOG)
    return Path(path) if path else None


def apps_meta():
    """Where that catalog came from (its CATALOG); {} without one."""
