def parse_extra_volumes(specs, encrypt_root=False):
    """Parse and validate repeatable --extra-volume key=value specs."""
    allowed_keys = {"name", "mode", "dev", "devs", "fs", "raid", "role", "encrypt", "compute_storage"}
    volumes = []
    seen_names = set()
    compute_owners = []
    for raw in specs or []:
        text = (raw or "").strip()
        if not text:
            raise ValueError("--extra-volume: empty specification")
        kv = {}
        for part in text.split(","):
            tok = part.strip()
            if not tok or "=" not in tok:
                raise ValueError(f"--extra-volume: expected key=value in {raw!r}")
            k, v = (x.strip() for x in tok.split("=", 1))
            if k not in allowed_keys:
                raise ValueError(f"--extra-volume: unknown key {k!r} in {raw!r}")
            if k in kv:
                raise ValueError(f"--extra-volume: duplicate key {k!r} in {raw!r}")
            kv[k] = v
        name = kv.get("name", "")
        if not VOLUME_NAME_RE.fullmatch(name):
            raise ValueError(f"--extra-volume: invalid volume name {name!r}")
        if name in seen_names:
            raise ValueError(f"--extra-volume: duplicate volume name {name!r}")
        seen_names.add(name)

        mode = kv.get("mode", "")
        if mode not in STORAGE_MODES:
            raise ValueError(f"--extra-volume {name}: mode must be one of {', '.join(STORAGE_MODES)}")

        role = kv.get("role", "shared")
        if role not in STORAGE_ROLES:
            raise ValueError(f"--extra-volume {name}: role must be one of {', '.join(STORAGE_ROLES)}")

        cs_raw = kv.get("compute_storage", "0")
        if cs_raw not in ("0", "1"):
            raise ValueError(f"--extra-volume {name}: compute_storage must be 0 or 1")
        compute_storage = cs_raw == "1"
        if compute_storage:
            if role not in ("shared", "compute"):
                raise ValueError(
                    f"--extra-volume {name}: compute_storage=1 requires role 'shared' or 'compute', not {role!r}"
                )
            compute_owners.append(name)

        if mode == "format":
            if "devs" in kv or "raid" in kv:
                raise ValueError(f"--extra-volume {name}: mode=format does not accept devs or raid")
            dev = kv.get("dev", "")
            if not dev.startswith("/dev/"):
                raise ValueError(f"--extra-volume {name}: mode=format requires dev=/dev/...")
            fs = kv.get("fs", "ext4")
            if fs not in STORAGE_FORMAT_FS:
                raise ValueError(f"--extra-volume {name}: mode=format fs must be ext4 or btrfs")
            enc = kv.get("encrypt", "auto")
            if enc not in STORAGE_ENCRYPT:
                raise ValueError(f"--extra-volume {name}: encrypt must be auto, luks or none")
            eff_enc = ("luks" if encrypt_root else "none") if enc == "auto" else enc
            volumes.append({"name": name, "mode": mode, "devs": [dev], "fs": fs, "raid": "", "role": role,
                            "encrypt": enc, "effective_encrypt": eff_enc, "compute_storage": compute_storage})
        elif mode == "attach":
            if "devs" in kv or "fs" in kv or "raid" in kv:
                raise ValueError(f"--extra-volume {name}: mode=attach does not accept devs, fs or raid")
            if "encrypt" in kv and kv["encrypt"] not in ("", "none", "auto"):
                raise ValueError(f"--extra-volume {name}: mode=attach preserves existing data and cannot set encrypt={kv['encrypt']}")
            dev = kv.get("dev", "")
            if not dev.startswith("/dev/"):
                raise ValueError(f"--extra-volume {name}: mode=attach requires dev=/dev/...")
            volumes.append({"name": name, "mode": mode, "devs": [dev], "fs": "", "raid": "", "role": role,
                            "encrypt": "none", "effective_encrypt": "none", "compute_storage": compute_storage})
        else:  # array
            if "dev" in kv:
                raise ValueError(f"--extra-volume {name}: mode=array requires devs=DEV1+DEV2..., not dev")
            devs = [d.strip() for d in kv.get("devs", "").split("+") if d.strip()]
            if not devs or any(not d.startswith("/dev/") for d in devs):
                raise ValueError(f"--extra-volume {name}: mode=array requires '+'-separated /dev/... paths in devs")
            if len(set(devs)) != len(devs):
                raise ValueError(f"--extra-volume {name}: duplicate device in array devs")
            fs = kv.get("fs", "btrfs")
            if fs != "btrfs":
                raise ValueError(f"--extra-volume {name}: mode=array only supports fs=btrfs")
            raid = kv.get("raid", "raid1")
            if raid not in STORAGE_RAIDS:
                raise ValueError(f"--extra-volume {name}: raid must be one of {', '.join(STORAGE_RAIDS)}")
            min_devs = 4 if raid == "raid10" else 2
            if len(devs) < min_devs:
                raise ValueError(f"--extra-volume {name}: raid={raid} requires at least {min_devs} disks")
            enc = kv.get("encrypt", "auto")
            if enc not in STORAGE_ENCRYPT:
                raise ValueError(f"--extra-volume {name}: encrypt must be auto, luks or none")
            eff_enc = ("luks" if encrypt_root else "none") if enc == "auto" else enc
            volumes.append({"name": name, "mode": mode, "devs": devs, "fs": "btrfs", "raid": raid, "role": role,
                            "encrypt": enc, "effective_encrypt": eff_enc, "compute_storage": compute_storage})

    if len(compute_owners) > 1:
        raise ValueError("At most one --extra-volume may set compute_storage=1 (got: " + ", ".join(compute_owners) + ")")
    return volumes


def extra_volume_packages(args):
    """Packages the storage options need: btrfs-progs (Btrfs volumes and arrays), cryptsetup (LUKS
    volumes), and, with Maintenance Windows, dosfstools and mtools (its ESP and tools; the QEMU
    runner's own packages stay with the winmaint module)."""
    pkgs = []
    vols = parse_extra_volumes(getattr(args, "extra_volume", None) or [],
                               encrypt_root=bool(getattr(args, "encrypt", False)))
    for v in vols:
        if (v["mode"] == "array" or v["fs"] == "btrfs") and "btrfs-progs" not in pkgs:
            pkgs.append("btrfs-progs")
        if v["effective_encrypt"] == "luks" and "cryptsetup" not in pkgs:
            pkgs.append("cryptsetup")
    if getattr(args, "winmaint_disk", None):
        pkgs.extend(p for p in ("dosfstools", "mtools") if p not in pkgs)
    return pkgs


