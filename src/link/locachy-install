LIVE_NM_CONNECTIONS = Path("/etc/NetworkManager/system-connections")


def live_nm_connections():
    if not LIVE_NM_CONNECTIONS.is_dir():
        return []
    return sorted(p for p in LIVE_NM_CONNECTIONS.glob("*.nmconnection") if p.is_file() and not p.is_symlink())


# Profiles of these types name the live system's interface (NetworkManager
# writes interface-name when it completes a profile for a device). The
# installed system names its own (net.ifnames=0, and locachy-net may rename
# one: network-client), and NetworkManager takes a profile of another name
# for incompatible with the device: dropped, the profile is for any device
# of its type. A secret whose flags say an agent keeps it, or nobody (1, 2),
# is not in the file: the installation says so.
NM_DEVICE_TYPES = {"wifi", "802-11-wireless", "ethernet", "802-3-ethernet"}


def carried_nm_profile(text):
    """(text for the installed system, notes) of a live keyfile."""
    section, kind, flags, secrets = "", "", {}, set()
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            section = s[1:-1]
        elif "=" in s and not s.startswith(("#", ";")):
            k, v = (x.strip() for x in s.split("=", 1))
            if section == "connection" and k == "type":
                kind = v
            elif k.endswith("-flags") and section in ("wifi-security", "802-1x"):
                flags[k[:-6]] = v
            elif section in ("wifi-security", "802-1x"):
                secrets.add(k)
    out, section, notes = [], "", []
    for line in text.splitlines(keepends=True):
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            section = s[1:-1]
        elif kind in NM_DEVICE_TYPES and section == "connection" and s.split("=", 1)[0].strip() == "interface-name":
            notes.append(f"not bound to the live system's {s.split('=', 1)[1].strip()}")
            continue
        out.append(line)
    for name, value in sorted(flags.items()):
        if value.isdigit() and int(value) & 3 and name not in secrets:
            notes.append(f"its {name} is not saved in it (an agent kept it): connect with nmtui to enter it")
    return "".join(out), notes


def copy_network_profiles(target):
    """The live system's NetworkManager profiles into the target's, as
    NetworkManager reads them: root's, 0600 from the start (they hold the
    secrets), in a directory of root's alone."""
    sources = live_nm_connections()
    if not sources:
        return
    directory = target / "etc/NetworkManager/system-connections"
    directory.mkdir(parents=True, exist_ok=True)
    os.chmod(directory, 0o700)
    for source in sources:
        text, notes = carried_nm_profile(source.read_text(encoding="utf-8"))
        destination = directory / source.name
        destination.unlink(missing_ok=True)
        fd = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            if os.geteuid() == 0:
                os.fchown(f.fileno(), 0, 0)
            os.fchmod(f.fileno(), 0o600)
            f.write(text)
        print(f"Saved network {source.stem}: copied" + "".join("; " + n for n in notes), flush=True)


