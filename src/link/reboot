#!/bin/sh
# Ask process 1 (init) for a clean system reboot (SIGTERM -> shutdown_request).
# A system job that runs (tools/JOBS.md) is waited for first; -f/--force
# reboots without waiting: systemd's immediate reboot signal, SIGRTMIN+15,
# by number (49: glibc's SIGRTMIN is 34), still ending everything cleanly.
set -eu
if [ "$(id -u)" -ne 0 ]; then
    exec sudo /usr/local/bin/reboot "$@"
fi
case "$*" in
    '')
        active=""
        for ev in /sys/fs/cgroup/locachy-jobs/job-*/cgroup.events; do
            [ -r "$ev" ] || continue
            if grep -qx 'populated 1' "$ev" 2>/dev/null; then
                jid=${ev#/sys/fs/cgroup/locachy-jobs/job-}
                jid=${jid%/cgroup.events}
                kind=$(sed -n 's/^kind=//p' "/run/locachy/jobs/$jid.state" 2>/dev/null | head -n 1)
                active="job $jid${kind:+ ($kind)}"
                break
            fi
        done
        if [ -n "$active" ]; then
            echo "reboot: queued; init will wait for $active to finish (use reboot --force to reboot now)." >&2
        else
            echo "reboot: requested." >&2
        fi
        exec kill -TERM 1
        ;;
    -f | --force)
        echo "reboot: immediate reboot requested." >&2
        exec kill -s 49 1
        ;;
    *) echo 'usage: reboot [--force]' >&2; exit 2 ;;
esac
