#!/bin/sh
# Devices (service_udev): systemd-udevd as packaged, run on its own. It keeps
# the device database (/run/udev) and tells programs (libinput in the shared
# compositor, WirePlumber, NetworkManager) about devices as they come and go.
#   architecture  udevd and udevadm, as the distribution packages them
#   configuration the distribution's rules and hardware database
#                 (/usr/lib/udev), and this machine's own (/etc/udev/rules.d)
#   presets       LOCachy's rules (/usr/local/lib/udev/rules.d), on out of the
#                 box; a file of the same name in /etc/udev/rules.d replaces
#                 one, a link to /dev/null there turns it off
# Two of them, one for the network and one for the rest: the network's runs in
# locachy-net (network-client), where the interfaces and NetworkManager are;
# this one, the host's, describes every other device. A network interface
# that appears on the host only passes through it, to locachy-net (the preset
# 90-locachy-network.rules). Interfaces are numbered per namespace, and the
# kernel tells a namespace only of its own: the two databases must not mix.
# Once it runs, every device but the network's is announced to it
# (coldplug), as at a systemd boot; a program that needs some devices
# described asks for them itself (udevadm trigger --settle), so nothing
# waits on this script.
set -eu

mkdir -p /run/udev
/usr/lib/systemd/systemd-udevd &
udevd=$!
until [ -S /run/udev/control ]; do
    kill -0 "$udevd" 2>/dev/null || exit 1
    sleep 0.05
done
udevadm trigger --type=subsystems --action=add --subsystem-nomatch=net
udevadm trigger --type=devices --action=add --subsystem-nomatch=net
udevadm settle --timeout=30 || true
printf '<6>udev-client: devices described\n' >/dev/kmsg
wait "$udevd"
