def jobs_helper():
    path = Path(__file__).with_name("locachy_jobs.py")
    if not path.is_file():
        path = Path("/usr/local/lib/locachy/locachy_jobs.py")
    spec = importlib.util.spec_from_file_location("locachy_jobs", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def in_net(cmd):
    """The host's Internet is in locachy-net (a system job runs where there is
    only lo): cmd run there when it exists and this process is not in it."""
    try:
        outside = os.stat(NETNS).st_ino != os.stat("/proc/self/ns/net").st_ino
    except OSError:
        outside = False
    return ["ip", "netns", "exec", "locachy-net", *cmd] if outside else cmd


def real_root():
    """root of the initial user namespace (not a test's --map-root-user one)."""
    if os.geteuid() != 0:
        return False
    try:
        with open("/proc/self/uid_map", encoding="ascii") as f:
            return any(line.split()[:3] == ["0", "0", "4294967295"] for line in f)
    except OSError:
        return False


def as_nobody(cmd):
    """Drop to nobody inside locachy-net when running as real host root.
    ip netns exec stays outermost because entering the netns requires root."""
    if real_root():
        cmd = ["setpriv", f"--reuid={NOBODY}", f"--regid={NOBODY}", "--clear-groups", "--no-new-privs", "--", *cmd]
    return in_net(cmd)


def fetch_text(url, what, max_bytes, referer=None, cookie_jar=None, max_redirs=3):
    """One bounded HTTPS answer from Microsoft. As root, curl runs as nobody;
    its only file output is the session cookie jar."""
    cmd = ["curl", "--disable", "--fail", "--silent", "--show-error",
           "--proto", "=https", "--proto-redir", "=https", "--tlsv1.2",
           "--connect-timeout", "20", "--max-time", "60", "--max-filesize", str(max_bytes),
           "--user-agent", USER_AGENT]
    if max_redirs > 0:
        cmd += ["--location", "--max-redirs", str(max_redirs)]
    if cookie_jar is not None:
        cmd += ["--cookie", str(cookie_jar), "--cookie-jar", str(cookie_jar)]
    if referer:
        cmd += ["--referer", referer]
    cmd += ["--", url]
    try:
        p = subprocess.run(as_nobody(cmd), stdin=subprocess.DEVNULL, capture_output=True, cwd="/", timeout=75)
    except subprocess.TimeoutExpired:
        raise MicrosoftFailure(f"{what} did not answer within a minute") from None
    if p.returncode != 0:
        why = p.stderr.decode(errors="replace").strip().splitlines()
        raise MicrosoftFailure(f"{what} answered without success ({why[-1] if why else f'curl status {p.returncode}'})")
    return p.stdout[:max_bytes].decode("utf-8", errors="replace")


def published_sha256(page, row):
    """The SHA-256 Microsoft's page lists for row ("English" -> "English 64-bit")."""
    pattern = re.compile(r"<td[^>]*>\s*" + re.escape(row) + r"\s+64-bit\s*</td>\s*<td[^>]*>\s*([0-9A-Fa-f]{64})\s*</td>",
                         re.IGNORECASE)
    found = {m.lower() for m in pattern.findall(page)}
    if len(found) == 1:
        return found.pop()
    return None


def api_errors(answer):
    """Collect error entries from Microsoft's API JSON (top-level or ValidationContainer)."""
    entries = []
    containers = [answer]
    vc = answer.get("ValidationContainer")
    if isinstance(vc, dict):
        containers.append(vc)
    for container in containers:
        raw = container.get("Errors")
        if isinstance(raw, list):
            entries.extend(raw)
        elif raw:
            entries.append(raw)
    return entries


def is_sentinel_error(entry):
    """True when a parsed JSON Errors entry names Sentinel in Key, Value or Type."""
    if isinstance(entry, dict):
        return any("sentinel" in str(entry.get(k, "")).lower() for k in ("Key", "Value", "Type")
                   if entry.get(k) is not None)
    return isinstance(entry, str) and "sentinel" in entry.lower()


def format_errors(errors):
    parts = []
    for e in errors:
        if isinstance(e, dict):
            msg = e.get("Value")
            if not msg:
                msg = e.get("Key") or e
            parts.append(str(msg))
        else:
            parts.append(str(e))
    return "; ".join(parts)


def refusal_failure(said):
    return MicrosoftFailure(f"Microsoft refused the automated download (it does over Tor, VPNs and some "
                            f"networks; its answer: {said[:200]})")


def download_link(page, page_url, name, cookie_jar):
    """Microsoft's link (valid for a day) to the x64 ISO in language name.

    The public request sequence documented by Fido (github.com/pbatard/Fido,
    GPL-3.0), Mido (github.com/ElliotKillick/Mido, MIT), dockur/windows
    (github.com/dockur/windows, src/mido.sh, MIT; actively maintained) and
    quickget (github.com/quickemu-project/quickemu, MIT), with Microsoft's page
    constants: product edition from the download page, session registration via
    vlscppe/tags and ov-df/mdt.js + reply, session cookies carried through
    getskuinformationbyproductedition and GetProductDownloadLinksBySku. They
    are the reference: when Microsoft changes this flow, follow their change.
    Each request is made once; a refusal ends the fetch."""
    m = re.search(r'<option value="([0-9]{1,16})">Windows', page)
    if not m:
        raise MicrosoftFailure("Microsoft's download page names no product edition (has its download flow changed?)")
    edition, session = m.group(1), str(uuid.uuid4())
    fetch_text(f"{TAGS_BASE}/tags?org_id={ORG_ID}&session_id={session}",
               "Microsoft's session permit", 100 << 10, cookie_jar=cookie_jar, max_redirs=0)
    mdt = fetch_text(f"{OVDF_BASE}/mdt.js?instanceId={INSTANCE_ID}&PageId=si&session_id={session}",
                     "Microsoft's session check", 100 << 10, cookie_jar=cookie_jar, max_redirs=0)
    mw = re.search(r"[?&]w=([A-Fa-f0-9]+)", mdt)
    mr = re.search(r'rticks="\+?(\d+)', mdt)
    if not mw or not mr:
        raise MicrosoftFailure("Microsoft's session check gave no usable tokens (has its download flow changed?)")
    time.sleep(0.2)
    fetch_text(f"{OVDF_BASE}/?session_id={session}&CustomerId={INSTANCE_ID}&PageId=si"
               f"&w={mw.group(1)}&mdt={int(time.time() * 1000)}&rticks={mr.group(1)}",
               "Microsoft's session check reply", 100 << 10, cookie_jar=cookie_jar, max_redirs=0)
    api = f"{MS_BASE}/software-download-connector/api/"
    text = fetch_text(f"{api}getskuinformationbyproductedition?profile={PROFILE}&productEditionId={edition}"
                      f"&SKU=undefined&friendlyFileName=undefined&Locale=en-US&sessionID={session}",
                      "Microsoft's language list", API_MAX, cookie_jar=cookie_jar)
    try:
        answer = json.loads(text)
    except ValueError:
        if "sentinel" in text.lower():
            raise refusal_failure(text.strip()) from None
        raise MicrosoftFailure(f"Microsoft's language list is not a usable answer ({text.strip()[:200]})") from None
    if not isinstance(answer, dict):
        raise MicrosoftFailure(f"Microsoft's language list is not a usable answer ({text.strip()[:200]})")
    errors = api_errors(answer)
    if errors:
        said = format_errors(errors) or text.strip()
        if any(is_sentinel_error(e) for e in errors):
            raise refusal_failure(said)
        raise MicrosoftFailure(f"Microsoft's language list returned an error ({said[:200]})")
    skus = answer.get("Skus")
    if not isinstance(skus, list):
        raise MicrosoftFailure("Microsoft's language list is not a usable answer (missing or invalid Skus)")
    ids = sorted({str(s.get("Id", "")) for s in skus if isinstance(s, dict)
                  and name in (s.get("LocalizedLanguage"), s.get("Language"))})
    if len(ids) != 1 or not re.fullmatch(r"[0-9A-Za-z-]{1,16}", ids[0]):
        raise MicrosoftFailure(f"Microsoft's language list has no single entry for {name}")
    # If Microsoft blocks a request, it is this one; it wants the download page as referer.
    text = fetch_text(f"{api}GetProductDownloadLinksBySku?profile={PROFILE}&productEditionId=undefined"
                      f"&SKU={ids[0]}&friendlyFileName=undefined&Locale=en-US&sessionID={session}",
                      "Microsoft's download link", API_MAX, referer=page_url, cookie_jar=cookie_jar)
    try:
        answer = json.loads(text)
    except ValueError:
        if "sentinel" in text.lower():
            raise refusal_failure(text.strip()) from None
        raise MicrosoftFailure("Microsoft's download service gave no usable answer") from None
    if not isinstance(answer, dict):
        raise MicrosoftFailure("Microsoft's download service gave no usable answer")
    errors = api_errors(answer)
    if errors:
        said = format_errors(errors) or text.strip()
        if any(is_sentinel_error(e) for e in errors):
            raise refusal_failure(said)
        raise MicrosoftFailure(f"Microsoft's download service returned an error ({said[:200]})")
    raw_opts = answer.get("ProductDownloadOptions")
    options = [o for o in raw_opts if isinstance(o, dict)] if isinstance(raw_opts, list) else []
    by_type = [o for o in options if type(o.get("DownloadType")) is int and o.get("DownloadType") == 1]
    if by_type:
        uris = sorted({o["Uri"] for o in by_type if isinstance(o.get("Uri"), str) and o["Uri"]})
    else:
        try:
            uris = sorted({o["Uri"] for o in options
                           if isinstance(o.get("Uri"), str) and "x64" in urlsplit(o["Uri"]).path.lower()})
        except ValueError:
            raise MicrosoftFailure("Microsoft's download service gave a malformed link URL") from None
    if len(uris) != 1:
        raise MicrosoftFailure("Microsoft's download service gave no single x64 link")
    if not uris[0].startswith(LINK_PREFIX):
        raise MicrosoftFailure(f"Microsoft's link is not on the configured ISO download prefix ({LINK_PREFIX})")
    return uris[0]


def download_page(page_url, row, jar):
    """Read Microsoft's published SHA-256 before resolving any download link."""
    page = fetch_text(page_url, "Microsoft's download page", PAGE_MAX, cookie_jar=jar)
    expected = published_sha256(page, row)
    if not expected:
        raise MicrosoftFailure(f"Microsoft's download page lists no single SHA-256 for \"{row} 64-bit\" "
                               f"({page_url}), so a download could not be verified")
    return page, expected


def iso_basename(link):
    base = link.split("?", 1)[0].rsplit("/", 1)[-1]
    if len(link) > 4096 or not re.fullmatch(r"[A-Za-z0-9._-]{1,128}\.iso", base):
        raise MicrosoftFailure("Microsoft's link does not name an ISO")
    return base


def probe_range(link):
    """Send one GET with Range: bytes=0-0 to an already validated ISO URL."""
    cmd = ["curl", "--disable", "--globoff", "--fail", "--silent", "--show-error",
           "--proto", "=https", "--tlsv1.2", "--connect-timeout", "20", "--max-time", "60",
           "--range", "0-0", "--max-filesize", "1", "--user-agent", USER_AGENT,
           "--output", "/dev/null", "--write-out", "%{http_code}\n%{size_download}\n%header{content-range}\n", "--", link]
    try:
        p = subprocess.run(as_nobody(cmd), stdin=subprocess.DEVNULL, capture_output=True,
                           cwd="/", timeout=75, text=True, errors="replace")
    except subprocess.TimeoutExpired:
        raise MicrosoftFailure("Microsoft's download server did not answer within a minute") from None
    fields = p.stdout.splitlines()
    code = fields[0] if fields and re.fullmatch(r"[0-9]{3}", fields[0]) else "-"
    if (p.returncode == 0 and code == "206" and len(fields) == 3 and fields[1] == "1"
            and re.fullmatch(r"bytes 0-0/[1-9][0-9]*", fields[2], re.IGNORECASE)):
        return code
    # HTTP 200 ignored Range. A bare 206 without the correct Content-Range and size
    # is not proof either. Never include curl's URL or response headers in the error.
    raise MicrosoftFailure(f"Microsoft's download server: Range: bytes=0-0 returned HTTP {code} "
                           f"without a valid one-byte partial response (curl status {p.returncode})")


def cmd_check(args):
    tag = choose_language(args.lang)
    name, row = LANGUAGES[tag]
    page_url = MS_BASE + PAGE_PATH
    # Root runs curl as nobody, so the private cookie directory must be
    # reachable and writable by that uid, not kept under root's private TMPDIR.
    root = real_root()
    with tempfile.TemporaryDirectory(prefix="winiso-check.", dir="/tmp" if root else None) as tmp:
        if root:
            os.chown(tmp, NOBODY, NOBODY)
        jar = Path(tmp) / "session.cookies"
        page, expected = download_page(page_url, row, jar)
        link = download_link(page, page_url, name, jar)
    base = iso_basename(link)
    range_code = probe_range(link)
    print(f"ok: windows-{WIN_VERSION} {tag} {base} sha256={expected} range={range_code}", flush=True)
    return 0


def give_a_path(why):
    page = MS_BASE + PAGE_PATH
    return Failure(f"{why}. Nothing is tried again and no other source is used: download the Windows "
                   f"{WIN_VERSION} ISO in a browser from {page} and give its path instead: vm_iso=\"/path/to.iso\" "
                   f"for a VM app, or locachy-winmaint vm --iso /path/to.iso.", REFUSED)


def open_partial_ro(path):
    """Open a partial file nobody controls without following symlinks, refusing
    anything other than a single-linked regular file. Caller closes the fd."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise Failure(f"partial download is a symbolic link, refused: {path}") from None
        raise
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Failure(f"partial download is not a regular file, refused: {path}")
        if st.st_nlink != 1:
            raise Failure(f"partial download has {st.st_nlink} hard links, refused: {path}")
        return fd, st
    except BaseException:
        os.close(fd)
        raise


def sha256_fd(fd):
    os.lseek(fd, 0, os.SEEK_SET)
    h = hashlib.sha256()
    while True:
        chunk = os.read(fd, 4 << 20)
        if not chunk:
            break
        h.update(chunk)
    return h.hexdigest()


def partial_size(path):
    """Size of path if it is an unfollowed regular file, else None."""
    try:
        st = os.lstat(path)
    except OSError:
        return None
    return st.st_size if stat.S_ISREG(st.st_mode) else None


def unlink_in_dir(path):
    """Unlink path via an O_NOFOLLOW-opened parent directory (no symlink traversal)."""
    try:
        dfd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError:
        return
    try:
        os.unlink(path.name, dir_fd=dfd)
    except FileNotFoundError:
        pass
    finally:
        os.close(dfd)


def link_verified_fd(fd, part, final):
    """Install the already-hashed inode fd as final by linking /proc/self/fd/fd
    into ISO_DIR, unlinking the dl/ entry, verifying no other link to the inode
    remains (st_nlink == 1), setting mode 0644, fsyncing, and atomically
    replacing final."""
    tmp = ISO_DIR / f".{final.name}.{os.getpid()}.{uuid.uuid4().hex[:8]}.tmp"
    linked = False
    try:
        try:
            os.link(f"/proc/self/fd/{fd}", tmp, follow_symlinks=True)
        except FileNotFoundError:
            raise Failure(f"partial download was unlinked before installation, refused: {part}") from None
        linked = True
        unlink_in_dir(part)
        st = os.fstat(fd)
        if st.st_nlink != 1:
            raise Failure(f"partial download kept an extra link ({st.st_nlink}) after unlink, refused: {part}")
        os.fchmod(fd, 0o644)
        os.fsync(fd)
        os.replace(tmp, final)
        linked = False
        fsync_dir(ISO_DIR)
    finally:
        if linked:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def ensure_dirs():
    """Prepare ISO_DIR, .partial (root 0711 when real root so nobody can traverse
    into dl/ without listing .partial), and .partial/dl (nobody 0700, holding
    only <name>.part). Returns (partial, dl, lock_fd)."""
    ISO_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    os.chmod(ISO_DIR, 0o755)
    partial = ISO_DIR / ".partial"
    partial.mkdir(mode=0o711, exist_ok=True)
    if os.path.islink(partial) or not partial.is_dir():
        raise Failure(f"{partial} is not a directory")
    os.chmod(partial, 0o711)
    if real_root():
        os.chown(partial, 0, 0)
    dl = partial / "dl"
    dl.mkdir(mode=0o700, exist_ok=True)
    if os.path.islink(dl) or not dl.is_dir():
        raise Failure(f"{dl} is not a directory")
    if real_root():
        os.chown(dl, NOBODY, NOBODY)
    os.chmod(dl, 0o700)
    lock = os.open(partial / ".lock", os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    return partial, dl, lock


def write_atomic(path, text, mode=0o644):
    fd, tmp = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def curl_download(link, part):
    """One curl run (as nobody when real host root, inside locachy-net) that
    continues part where it ends. (status, HTTP code)."""
    cmd = ["curl", "--disable", "--fail", "--location", "--proto", "=https", "--proto-redir", "=https",
           "--tlsv1.2", "--max-redirs", "5", "--continue-at", "-", "--connect-timeout", "30",
           "--speed-limit", "1024", "--speed-time", "120", "--no-progress-meter",
           "--user-agent", USER_AGENT, "--output", str(part), "--write-out", "%{http_code}", "--", link]
    proc = subprocess.Popen(as_nobody(cmd), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            cwd="/", text=True, errors="replace")
    while True:
        try:
            out, err = proc.communicate(timeout=PROGRESS_SECONDS)
            break
        except subprocess.TimeoutExpired:
            sz = partial_size(part)
            if sz is not None:
                say(f"{sz >> 20} MiB downloaded")
    if err.strip():
        print(err.strip(), file=sys.stderr, flush=True)
    return proc.returncode, out.strip()


def seal_partial(fd):
    """Root takes the transferred file from nobody before hashing it: once owned
    by root and mode 0600, nobody cannot open it for writing, and every write made
    before this point is covered by the hash that follows."""
    if real_root():
        os.fchown(fd, 0, 0)
    os.fchmod(fd, 0o600)


def download(link, part):
    """Run one resumable curl transfer into part, then open part safely, take it
    from nobody, and return (fd, stat, sha256) of the opened inode. Caller closes
    fd. A stopped transfer keeps part for a later fetch; it is not retried now."""
    status, code = curl_download(link, part)
    if status == 0 or code == "416":
        # 416: nothing past its end, so the partial file is complete already.
        try:
            fd, st = open_partial_ro(part)
        except FileNotFoundError:
            raise Failure(f"partial download missing after curl finished: {part}") from None
        try:
            seal_partial(fd)
            digest = sha256_fd(fd)
            st = os.fstat(fd)
        except BaseException:
            os.close(fd)
            raise
        return fd, st, digest
    if status == 33:
        unlink_in_dir(part)
        raise MicrosoftFailure("the download server does not continue partial files (curl status 33); "
                               "the partial file is deleted")
    sz = partial_size(part)
    size = (sz >> 20) if sz is not None else 0
    raise MicrosoftFailure(f"the download stopped (curl status {status}, HTTP {code or '-'}); {size} MiB are "
                           f"kept and a later fetch continues from there")


def fetch_inline(tag):
    try:
        partial, dl, lock = ensure_dirs()
    except OSError as e:
        raise Failure(f"cannot use {ISO_DIR}: {e}") from None
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise Failure("another fetch is running") from None
    try:
        return fetch_chain(tag, partial, dl)
    except MicrosoftFailure as e:
        raise give_a_path(str(e)) from None
    finally:
        os.close(lock)


def cleanup_stale_cookie_jars(dl):
    """Remove leftover .session.*.cookies regular files in dl/ from an earlier
    interrupted fetch. Bounded to dl/ only; uses lstat and never follows links."""
    euid = os.geteuid()
    is_root = real_root()
    allowed_uids = {euid, NOBODY} if is_root else {euid}
    try:
        dfd = os.open(dl, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return
    try:
        try:
            names = os.listdir(dfd)
        except OSError:
            return
        for name in names:
            if not fnmatch.fnmatchcase(name, ".session.*.cookies"):
                continue
            try:
                st = os.lstat(name, dir_fd=dfd)
            except OSError:
                continue
            if not stat.S_ISREG(st.st_mode):
                continue
            if st.st_uid not in allowed_uids:
                continue
            try:
                os.unlink(name, dir_fd=dfd)
            except OSError:
                pass
    finally:
        os.close(dfd)


def fetch_chain(tag, partial, dl):
    """The one chain of requests of a fetch: page, download service, ISO."""
    cleanup_stale_cookie_jars(dl)
    name, row = LANGUAGES[tag]
    page_url = MS_BASE + PAGE_PATH
    # Per-fetch cookie jar in .partial/dl/ (writable by nobody when real root);
    # Microsoft's download service ties the session cookies across steps.
    jar = dl / f".session.{os.getpid()}.{uuid.uuid4().hex[:8]}.cookies"
    try:
        page, expected = download_page(page_url, row, jar)
        say(f"Microsoft publishes SHA-256 {expected} for \"{row} 64-bit\" ({page_url})")
        final = iso_file(tag)
        record = verified(final)
        if record and record["sha256"] == expected:
            say(f"{final} is that ISO already")
            update_current(final)
            print(final, flush=True)
            return 0

        link = download_link(page, page_url, name, jar)
    finally:
        unlink_in_dir(jar)
    base = iso_basename(link)
    say(f"downloading {base} from {LINK_PREFIX}")

    part = dl / (final.name + ".part")
    meta = partial / (final.name + ".part.json")
    try:
        before = json.loads(meta.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        before = None
    if before != {"sha256": expected, "source": base}:
        # Another build (or nothing known of it): its bytes are not this ISO's.
        unlink_in_dir(part)
        write_atomic(meta, json.dumps({"sha256": expected, "source": base}) + "\n", 0o600)
    else:
        try:
            st = os.lstat(part)
        except FileNotFoundError:
            st = None
        if st is not None:
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                raise Failure(f"existing partial download is not a regular single-linked file, refused: {part}")
            say(f"continuing at {st.st_size >> 20} MiB")

    say("downloading; SHA-256 is checked at the end")
    fd, st, got = download(link, part)
    try:
        if got != expected:
            unlink_in_dir(part)
            meta.unlink(missing_ok=True)
            raise Failure(f"the download's SHA-256 is {got}, not the {expected} Microsoft publishes for "
                          f"\"{row} 64-bit\": deleted, not used", MISMATCH)
        link_verified_fd(fd, part, final)
        final_size = st.st_size
    finally:
        os.close(fd)
    write_atomic(record_of(final), json.dumps({
        "sha256": expected, "size": final_size, "version": WIN_VERSION, "language": tag,
        "microsoft_name": base, "published_row": f"{row} 64-bit", "page": page_url,
        "verified": int(time.time())}, indent=1, sort_keys=True) + "\n")
    meta.unlink(missing_ok=True)
    update_current(final)
    say(f"verified: SHA-256 {expected}")
    print(final, flush=True)
    return 0


def update_current(iso):
    """windows.iso names the ISO path windows prints."""
    link = ISO_DIR / "windows.iso"
    tmp = ISO_DIR / ".windows.iso.new"
    tmp.unlink(missing_ok=True)
    os.symlink(iso.name, tmp)
    os.replace(tmp, link)
    fsync_dir(ISO_DIR)


def cmd_fetch(args):
    if args.kind == "virtio-win":
        raise Failure("virtio-win comes from the virtio-win package (the winmaint module), not from fetch", 2)
    tag = choose_language(args.lang)
    try:
        jobs = jobs_helper()
        mode = jobs.execution_mode()
        if mode == "queue":
            # Online: the fixed system job, with the language decided here.
            return jobs.submit("winiso-fetch", ["--lang", tag], wait=True)
    except RuntimeError as e:
        if str(e).startswith("job service: "):
            raise Failure(f"fetch was refused by the job service: {str(e)[len('job service: '):]}") from None
        raise Failure(f"fetch: {e}; not run outside the job queue") from None
    except OSError as e:
        raise Failure(f"fetch: {e}; not run outside the job queue (run it as root)") from None
    say(f"Windows {WIN_VERSION}, {tag} ({LANGUAGES[tag][0]})")
    return fetch_inline(tag)


def main(argv=None):
    parser = argparse.ArgumentParser(prog="locachy-winiso", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    for cmd, func in (("path", cmd_path), ("fetch", cmd_fetch)):
        p = sub.add_parser(cmd)
        p.add_argument("kind", choices=("windows", "virtio-win"))
        p.add_argument("--lang", default=None, help="language tag or locale (en-US, zh_CN.UTF-8)")
        p.set_defaults(func=func)
    p = sub.add_parser("check", help="verify Microsoft's download chain without downloading the ISO")
    p.add_argument("--lang", default=None, help="language tag or locale (en-US, zh_CN.UTF-8)")
    p.set_defaults(func=cmd_check)
    args = parser.parse_args(argv)
    for name, value in (("LOCACHY_WINISO_MS_BASE", MS_BASE), ("LOCACHY_WINISO_TAGS_BASE", TAGS_BASE),
                        ("LOCACHY_WINISO_OVDF_BASE", OVDF_BASE), ("LOCACHY_WINISO_LINK_PREFIX", LINK_PREFIX)):
        if not value.startswith("https://"):
            print(f"locachy-winiso: {name} must be an https:// address", file=sys.stderr)
            return 2
    try:
        return args.func(args)
    except Failure as e:
        print(f"locachy-winiso: {e}", file=sys.stderr, flush=True)
        return e.status
    except OSError as e:
        print(f"locachy-winiso: {e}", file=sys.stderr, flush=True)
        return 1


if __name__ == "__main__":
    sys.exit(main())
