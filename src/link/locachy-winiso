class Failure(Exception):
    def __init__(self, message, status=1):
        super().__init__(message)
        self.status = status


class MicrosoftFailure(Failure):
    """Microsoft refused, or one of its answers was not a success: the fetch ends."""

    def __init__(self, message):
        super().__init__(message, REFUSED)


def say(text):
    print(f"locachy-winiso: {text}", flush=True)


def language_tag(text):
    """The LANGUAGES tag for a language tag or locale (en-US, zh_CN.UTF-8,
    sr_RS@latin), or None when Microsoft has no ISO in that language."""
    base = text.strip().split(".", 1)[0].split("@", 1)[0].replace("_", "-")
    parts = [p for p in base.split("-") if p]
    if not parts or not all(re.fullmatch(r"[A-Za-z0-9]{1,8}", p) for p in parts):
        return None
    lang = parts[0].lower()
    region = next((p.upper() for p in parts[1:] if len(p) == 2 and p.isalpha()), "")
    tag = f"{lang}-{region}"
    if tag in LANGUAGES:
        return tag
    if tag in REGION_ALIASES:
        return REGION_ALIASES[tag]
    if lang in LANGUAGE_DEFAULTS:
        return LANGUAGE_DEFAULTS[lang]
    return next((t for t in sorted(LANGUAGES) if t.split("-")[0] == lang), None)


def rc_value(key):
    """KEY="VALUE" of rc.conf, "" when it has none."""
    value = ""
    try:
        text = RC_CONF.read_text(encoding="utf-8")
    except OSError:
        return ""
    for line in text.splitlines():
        m = re.match(r'\s*' + re.escape(key) + r'="([^"]*)"', line)
        if m:
            value = m.group(1)
    return value


def choose_language(explicit):
    if explicit:
        tag = language_tag(explicit)
        if not tag:
            raise Failure(f"--lang {explicit}: Microsoft has no Windows ISO in that language; "
                          f"one of: {' '.join(sorted(LANGUAGES))}", 2)
        return tag
    configured = rc_value("language")
    if configured:
        tag = language_tag(configured)
        if tag:
            return tag
        say(f"rc.conf's language {configured} has no Windows ISO from Microsoft: en-US")
    return "en-US"


def iso_file(tag):
    return ISO_DIR / f"windows-{WIN_VERSION}-{tag}.iso"


def record_of(iso):
    return iso.with_name(iso.name + ".json")


def verified(iso):
    """iso is a regular file whose record (written after its SHA-256 matched
    Microsoft's) is there and of its size."""
    try:
        info = os.lstat(iso)
        record = json.loads(record_of(iso).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not stat.S_ISREG(info.st_mode) or not isinstance(record, dict):
        return None
    if record.get("size") != info.st_size or not re.fullmatch(r"[0-9a-f]{64}", str(record.get("sha256", ""))):
        return None
    return record


def cmd_path(args):
    if args.kind == "virtio-win":
        if args.lang:
            raise Failure("path virtio-win takes no --lang", 2)
        iso = VIRTIO_WIN_ISO
        try:
            ok = stat.S_ISREG(os.stat(iso).st_mode) and os.access(iso, os.R_OK)
        except OSError:
            ok = False
        if not ok:
            return UNAVAILABLE
        print(os.path.realpath(iso))
        return 0
    if args.lang:
        iso = iso_file(choose_language(args.lang))
    else:
        # The last ISO fetch verified (windows.iso names it).
        try:
            name = os.readlink(ISO_DIR / "windows.iso")
        except OSError:
            return UNAVAILABLE
        if not ISO_NAME.fullmatch(name):
            return UNAVAILABLE
        iso = ISO_DIR / name
    if not ISO_NAME.fullmatch(iso.name) or verified(iso) is None:
        return UNAVAILABLE
    print(os.path.realpath(iso))
    return 0


