    ("dediprog", {("0483", "dada")}, "Dediprog SF100 / SF600"),
    ("stlinkv3_spi", {("0483", "374e"), ("0483", "374f"), ("0483", "3753")}, "STLINK-V3 SPI"),
    ("dirtyjtag_spi", {("1209", "c0ca")}, "DirtyJTAG SPI"),
