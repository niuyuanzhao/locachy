#!/bin/bash
# Host PipeWire + WirePlumber + PulseAudio service for LOCachy (no systemd),
# run as PipeWire's and WirePlumber's system-wide units run them
# (pipewire.service.in, pipewire-pulse.service.in, wireplumber.service.in):
# as the system user pipewire, with no new privileges and CAP_SYS_NICE only,
# WirePlumber with the main-systemwide profile, the sockets in /run/pipewire
# (PIPEWIRE_RUNTIME_DIR) and /run/pulse (PULSE_RUNTIME_PATH). Which socket
# gives what: 50-locachy-sockets.conf, 50-locachy-pulse.conf. WirePlumber's
# state is in /var/lib/locachy/audio; its configuration is the system's only.
set -eu
: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"

# Its messages and its servers' go to the kernel log (dmesg), as process 1's
# do, not to the console process 1 has as stderr.
log=/dev/kmsg
[ -w "$log" ] || log=/dev/stderr
say() { # LEVEL MESSAGE (kernel log level: 3 error, 4 warning)
    printf '<%s>audio-client: %s\n' "$1" "$2" >>"$log"
}
exec 3>>"$log"

user=pipewire
sysusers=/usr/local/lib/sysusers.d/locachy-audio.conf
pw_runtime=/run/pipewire
pulse_runtime=/run/pulse
state=/var/lib/locachy/audio

# The user, as systemd-sysusers.service makes those of sysusers.d at boot
# (process 1 here runs no such service): made when missing, else unchanged.
if ! systemd-sysusers "$sysusers" >/dev/null 2>&3 || ! getent passwd "$user" >/dev/null; then
    say 3 "no system user $user ($sysusers)"
    exit 1
fi

# The sound cards described by udevd (udev-client) before WirePlumber looks
# for them; their device files are root's and the audio group's (udev's
# rules), the group the servers get. Containers get the servers' restricted
# sockets, not the devices.
for _ in $(seq 1 100); do
    [ -S /run/udev/control ] && break
    sleep 0.1
done
if [ -S /run/udev/control ]; then
    if ! timeout 30 udevadm trigger --action=add --subsystem-match=sound --settle 2>&3; then
        say 4 "sound-device enumeration did not finish"
    fi
else
    say 4 "no udevd (service_udev): no sound card will be found"
fi

# The runtime directories, the servers' (RuntimeDirectory=pipewire in
# pipewire.service.in), 0700 as a session's runtime directory is: only they
# and root reach a socket in them. A container reaches its sockets through
# its own bind mounts of them (locachy-app), not through these directories.
install -d -o "$user" -g "$user" -m 0700 "$pw_runtime" "$pulse_runtime"
# WirePlumber's state (XDG_STATE_HOME/wireplumber), its user's. One left by a
# WirePlumber that ran as root becomes its user's once: root never works again
# in a tree the server writes, whose links it would follow.
install -d -m 0755 "$state"
if [ -d "$state/wireplumber" ] && [ "$(stat -c %u "$state/wireplumber")" = 0 ]; then
    chown -R -h "$user:$user" "$state/wireplumber"
fi
install -d -o "$user" -g "$user" -m 0700 "$state/wireplumber"

children=()
cleanup() {
    if [ "${#children[@]}" -gt 0 ]; then
        kill "${children[@]}" 2>/dev/null || true
        wait "${children[@]}" 2>/dev/null || true
    fi
    [ ! -L "$XDG_RUNTIME_DIR/pipewire-0" ] || rm -f "$XDG_RUNTIME_DIR/pipewire-0"
}
trap cleanup EXIT
trap 'exit 0' TERM INT

# A server's socket: one slow to start is waited for (30 s, in 0.05 s steps);
# one that has ended has failed, and the group ends with it.
socket_wait=600
await_socket() { # PID SOCKET NAME
    local status=0
    for _ in $(seq 1 "$socket_wait"); do
        [ -S "$2" ] && return 0
        if ! kill -0 "$1" 2>/dev/null; then
            wait "$1" || status=$?
            say 3 "$3 ended before creating $2 (status $status)"
            exit "$((status ? status : 1))"
        fi
        sleep 0.05
    done
    say 3 "$3 did not create $2 in time"
    exit 1
}

# A server as the units start it: User=pipewire, its group and audio only,
# NoNewPrivileges=yes, AmbientCapabilities=CAP_SYS_NICE (realtime, module-rt),
# the units' environment and nothing of root's. Run in the background, which
# it becomes: $! is the server itself, for the waits and kills below.
as_server() { # [NAME=VALUE...] COMMAND ARG...
    exec setpriv --reuid="$user" --regid="$user" --groups=audio \
        --inh-caps=+sys_nice --ambient-caps=+sys_nice --no-new-privs --reset-env -- \
        env PIPEWIRE_RUNTIME_DIR="$pw_runtime" "$@"
}

# What servers that ran as root left in root's runtime directory.
rm -f "$XDG_RUNTIME_DIR/pipewire-0" "$XDG_RUNTIME_DIR/pipewire-0.lock" \
    "$XDG_RUNTIME_DIR/pipewire-0-manager" "$XDG_RUNTIME_DIR/pipewire-0-manager.lock" \
    "$XDG_RUNTIME_DIR/pulse/native" "$XDG_RUNTIME_DIR/pulse/pid"
rmdir "$XDG_RUNTIME_DIR/pulse" 2>/dev/null || true

as_server /usr/bin/pipewire >/dev/null 2>&3 3>&- &
children+=("$!")
for socket in pipewire-0 pipewire-0-manager pipewire-0-restricted; do
    await_socket "${children[0]}" "$pw_runtime/$socket" pipewire
done
# locachy-bar takes the sound to be there when root's runtime directory has
# pipewire-0 (base/status.c); root's programs connect through it.
ln -sfn "$pw_runtime/pipewire-0" "$XDG_RUNTIME_DIR/pipewire-0"

as_server GIO_USE_VFS=local XDG_STATE_HOME="$state" \
    /usr/bin/wireplumber -p main-systemwide >/dev/null 2>&3 3>&- &
children+=("$!")

as_server PULSE_RUNTIME_PATH="$pulse_runtime" /usr/bin/pipewire-pulse >/dev/null 2>&3 3>&- &
children+=("$!")
await_socket "$!" "$pulse_runtime/native" pipewire-pulse

status=0
wait -n "${children[@]}" || status=$?
say 3 "an audio server ended (status $status)"
exit "$status"
