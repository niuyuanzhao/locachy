#!/bin/bash
# Host PipeWire + WirePlumber + PulseAudio service for LOCachy (no systemd).
# Its runtime directory and home are process 1's (XDG_RUNTIME_DIR, HOME), the
# session bus is service_session_bus's (bus-client); its state and
# configuration are its own, in /var/lib/locachy/audio.
set -eu
: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"

# Its messages and its servers' go to the kernel log (dmesg), as process 1's
# do, not to the console process 1 has as stderr.
log=/dev/kmsg
[ -w "$log" ] || log=/dev/stderr
say() { # LEVEL MESSAGE (kernel log level: 3 error, 4 warning)
    printf '<%s>audio-client: %s\n' "$1" "$2" >>"$log"
}
exec 3>>"$log"

mkdir -p -m 0755 /var/lib/locachy/audio

# The sound cards described by udevd (udev-client) before WirePlumber looks
# for them; their device files are root's and the audio group's (udev's
# rules): PipeWire runs as root, and containers get its sockets (pipewire-0,
# pulse/native), not the devices.
for _ in $(seq 1 100); do
    [ -S /run/udev/control ] && break
    sleep 0.1
done
if [ -S /run/udev/control ]; then
    if ! timeout 30 udevadm trigger --action=add --subsystem-match=sound --settle 2>&3; then
        say 4 "sound-device enumeration did not finish"
    fi
else
    say 4 "no udevd (service_udev): no sound card will be found"
fi

export XDG_STATE_HOME="/var/lib/locachy/audio"
export XDG_CONFIG_HOME="/var/lib/locachy/audio"

# WirePlumber cannot keep its devices after losing its session bus. Wait for
# it, and watch the connection below: process 1 restarts this group if the
# bus disconnects. Nothing here starts or stops the bus itself.
for _ in $(seq 1 100); do
    [ -S "$XDG_RUNTIME_DIR/bus" ] && break
    sleep 0.1
done
[ -S "$XDG_RUNTIME_DIR/bus" ] || {
    say 4 "no session bus (service_session_bus) yet"
    exit 1
}

children=()
cleanup() {
    if [ "${#children[@]}" -gt 0 ]; then
        kill "${children[@]}" 2>/dev/null || true
        wait "${children[@]}" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap 'exit 0' TERM INT

# A server's socket: one slow to start is waited for (30 s, in 0.05 s steps);
# one that has ended has failed, and the group ends with it.
socket_wait=600
await_socket() { # PID SOCKET NAME
    local status=0
    for _ in $(seq 1 "$socket_wait"); do
        [ -S "$2" ] && return 0
        if ! kill -0 "$1" 2>/dev/null; then
            wait "$1" || status=$?
            say 3 "$3 ended before creating $2 (status $status)"
            exit "$((status ? status : 1))"
        fi
        sleep 0.05
    done
    say 3 "$3 did not create $2 in time"
    exit 1
}

dbus-monitor --address "unix:path=$XDG_RUNTIME_DIR/bus" \
    'type=signal,interface=org.freedesktop.DBus.Local,member=Disconnected' >/dev/null 2>&3 3>&- &
children+=("$!")
rm -f "$XDG_RUNTIME_DIR/pipewire-0" "$XDG_RUNTIME_DIR/pipewire-0.lock" \
    "$XDG_RUNTIME_DIR/pulse/native" "$XDG_RUNTIME_DIR/pulse/pid"

/usr/bin/pipewire >/dev/null 2>&3 3>&- &
children+=("$!")
await_socket "$!" "$XDG_RUNTIME_DIR/pipewire-0" pipewire
chmod 0666 "$XDG_RUNTIME_DIR/pipewire-0"

/usr/bin/wireplumber >/dev/null 2>&3 3>&- &
children+=("$!")

/usr/bin/pipewire-pulse >/dev/null 2>&3 3>&- &
children+=("$!")
await_socket "$!" "$XDG_RUNTIME_DIR/pulse/native" pipewire-pulse
chmod 0755 "$XDG_RUNTIME_DIR/pulse"
chmod 0666 "$XDG_RUNTIME_DIR/pulse/native"

status=0
wait -n "${children[@]}" || status=$?
say 3 "an audio server or the session bus watch ended (status $status)"
exit "$status"
