mount_build_overlay() {
    # userxattr lets mapped root create overlay whiteouts without trusted.*
    mount -t overlay overlay -o "lowerdir=$1,upperdir=$2/upper,workdir=$2/work,userxattr" "$2/root"
}

new_build_run() {
    mkdir -p "$run/upper" "$run/work" "$run/root" "$run/sealed"
    chmod 0700 "$run/sealed"
    install -d -m 1777 "$run/tmp"
    install -d -m 0755 -o "$user" -g "$user" "$run/out"
}

if [ "${LOCACHY_BUILD_STAGE:-}" = ns ]; then
    root=$run/root
    mount_build_overlay / "$run"
    # Its own /proc, /sys (read-only), /run and /tmp; of /dev, what builds use.
    mount -t proc proc "$root/proc" -o nosuid,noexec,nodev
    # A fresh sysfs mount is refused in a mapped user namespace. Clone the
    # existing tree recursively read-only, including any cgroup mounts.
    mount -o rbind,ro=recursive /sys "$root/sys"
    mount -t tmpfs run "$root/run" -o mode=0755,nosuid,nodev
    if [ -n "$build_jobserver" ]; then
        [[ "$build_jobserver" = /* && -p "$build_jobserver" && ! -L "$build_jobserver" ]] ||
            die "jobserver must be an absolute path to the coordinator's FIFO"
        # Bind just the inode, not its directory. Each worker opens this
        # same FIFO read/write; no other state becomes shared.
        touch "$root$root_jobserver"
        mount --bind -o rw "$build_jobserver" "$root$root_jobserver"
        [[ -p "$root$root_jobserver" && "$build_jobserver" -ef "$root$root_jobserver" ]] ||
            die "mount did not expose the coordinator's FIFO"
    fi
