#!/bin/bash
# locachy-build [-b] [-i] [-r] PKG...: build AUR packages, with pikaur, in a
# build root of their own, as a container is: an overlay over / made for this
# run and thrown away after it, in locachy-net, where builds run as the build
# user, locachy-builder (make.sh makes it). Its home, /var/lib/locachy/builder/
# home, is all that stays from one run to the next: its clones and caches
# (pikaur's, Go's, cargo's, npm's: whatever a build keeps in its home). Of the
# host's own state the build root shows nothing (/var/lib/locachy but that
# home, /var/log/locachy, /root, /home); its /dev has the few devices builds
# use, its /run and /tmp are its own, its environment too (none of the
# caller's variables). What a build needs is installed in its
# root only. The packages it makes are handed over in a directory of their
# own (/var/lib/locachy/builder/out there), from which root takes them into
# /var/cache/locachy-pkgs: root's, read-only in the build root, so that no
# build can change what the host and the containers install. pikaur-static
# builds pikaur itself; with neither, makepkg builds what is asked (to
# bootstrap them). An AUR package LOCachy changes is the AUR's recipe with a
# sed script of LOCachy's applied (aur-patches/NAME.sed), whether asked for
# or needed by another. One run at a time.
#   -b   run detached in the root cgroup (idle priority, never frozen on switch;
#        logs to /var/log/locachy/build.log)
#   -i   install the built package(s) into the system root when done
#   -r   build again even an AUR package already built (pikaur --rebuild)
# locachy-build --files ROOT PKG...: the files of /var/cache/locachy-pkgs to
# install for PKG... into ROOT: each one's newest package, and those of the
# dependencies that neither ROOT nor the repositories have.
# locachy-build [-b] [-i] [-r] --local NAME: the local recipe
# /usr/local/src/locachy/pkgbuilds/NAME, copied into this build root and run
# as the build user (never sourced by root). Dependencies are installed only
# in that root. Its root-owned build record follows the packages into the
# cache; locachy-pkg uses it to notice recipe/patch and host-library changes.
# locachy-build --prepare-batch DIR SHA256: build pinned candidates in
# independent disposable roots, then test their exact outputs together.
# locachy-build --prepare DIR --local NAME: build and seal one pinned output;
# --validate-prepared DIR installs all sealed outputs together in a disposable
# target root and runs its installed-package smoke checks before any host
# transaction. --regress-prepared DIR SHA256 runs the full developer
# regressions against the sealed outputs; it never writes update proofs.
# locachy-build --run COMMAND...: COMMAND in a build root, as the build user
# (what a build sees; for the tests).
# Source signing keys: makepkg checks a recipe's signed sources against its
# validpgpkeys, with the build user's keyring. No key is ever added to it by
# a build: one that is not there yet stops the build before anything is
# built, with "Source key to trust: NAME FINGERPRINT" lines (and in
# /var/lib/locachy/builder/untrusted-keys), exit status 3. A person checks
# each with its upstream project and adds it:
# locachy-build --trust-key FINGERPRINT...: each key fetched by its full
# fingerprint from every keyserver into a keyring of its own (their copies
# merged: one may keep a key's old expiry and miss its newer subkeys),
# shown (fingerprint, owner, subkeys), and added to the build user's
# keyring only when answered y. One trusted already is brought up to date.
# locachy-build --check-keys PKG...: the keys building the AUR packages PKG...
# would check with, found as a build finds them (in a build root of its own),
# looked up in the build user's keyring and nothing else: nothing is built,
# fetched into a keyring or trusted. Exit status 3 when one is not trusted
# yet (written to untrusted-keys as a build does), with one line for each on
# standard output, for the caller to show (locachy-pkg apply, before it
# changes anything): PKG TAB RECIPE TAB FINGERPRINT TAB UPSTREAM TAB SIGNED
# (PKG: those of PKG... it is needed for, comma-separated; RECIPE: the AUR
# recipe whose validpgpkeys name it; UPSTREAM: that recipe's url; SIGNED: its
# signed sources, space-separated; "-": none).
set -euo pipefail
# Its files are made as packages' are, whatever the caller's umask (locachy-app
# has 077): with it the build root's / would be root's alone, closed to the
# build user, whose every program then fails to load its libraries.
umask 022
# The host package domain (/run/locachy/pkg.lock), when a system job passed it
# down: a build needs none of it, and what it starts (the build user's keyring
# daemons, the builds) must never keep the domain past the job. Closed here,
# in this process only (the job's runner keeps its own); found by device and
# inode ([ -ef ]), never by a name given at run time.
for fdpath in /proc/self/fd/*; do
    fd=${fdpath##*/}
    [[ "$fd" =~ ^[0-9]+$ ]] && [ "$fd" -gt 2 ] || continue
    if [ "$fdpath" -ef /run/locachy/pkg.lock ]; then
        eval "exec ${fd}>&-"
    fi
done

bdir=/var/lib/locachy/builder
home=$bdir/home    # the build user's logical home inside a build root
home_source=$home
run=$bdir/run      # this run's root (upper, work, the root itself, tmp, out)
case ${LOCACHY_BUILD_STAGE:-} in
    ns|batch-worker)
        run=${LOCACHY_BUILD_RUN:-$run}
        home_source=${LOCACHY_BUILD_HOME_SOURCE:-$home}
        ;;
esac
handover=$bdir/out # in the build root: what it made
out=/var/cache/locachy-pkgs
user=locachy-builder
recipes=/usr/local/src/locachy/pkgbuilds
patches=/usr/local/src/locachy/aur-patches
records=/var/lib/locachy/local-packages
prepare=${LOCACHY_BUILD_PREPARE:-}
build_jobserver=${LOCACHY_BUILD_JOBSERVER:-}
build_jobs=${LOCACHY_BUILD_JOBS:-}
root_jobserver=/run/locachy-jobserver
validate=0
regress=0
batch=0
batch_hash=
regression_hash=

die() {
    echo "locachy-build: $*" >&2
    exit 1
}

key_uid= key_gid=
as_builder() {
    if [ -n "$key_uid" ]; then
        # Enter as root before dropping the identity: the install target
        # may be below a root-only mountpoint. No ancestor needs opening.
        (cd "$home" && setpriv --reuid="$key_uid" --regid="$key_gid" --clear-groups --reset-env \
            env HOME=. GNUPGHOME=.gnupg "$@")
    else
        setpriv --reuid="$user" --regid="$user" --init-groups --reset-env "$@"
    fi
}

# Only key lookup/trust may use an installation target's existing keyring.
# Its account comes from that root, not an unrelated UID allocated by the
# live medium. This changes no target packages and executes no target code.
key_root() {
    [ "$(id -u)" = 0 ] || die "--key-root requires root"
    local target=$1 identity
    [ -d "$target" ] && [ ! -L "$target" ] && [ "$(realpath -e "$target")" = "$target" ] ||
        die "--key-root must be a canonical directory"
    identity=$(awk -F: '$1 == "locachy-builder" {print $3, $4}' "$target/etc/passwd")
    read -r key_uid key_gid <<<"$identity"
    [[ "$key_uid" =~ ^[0-9]+$ && "$key_gid" =~ ^[0-9]+$ ]] && [ "$key_uid" != 0 ] && [ "$key_gid" != 0 ] ||
        die "no unprivileged build identity in $target"
    bdir=${target%/}/var/lib/locachy/builder
    home=$bdir/home
    [ -d "$home" ] && [ ! -L "$home" ] && [ "$(realpath -e "$home")" = "$home" ] ||
        die "invalid build home in $target"
}

# The build user's keyring, opened by every run that reads or changes it
# (under bdir/lock: no other program uses it then) and closed before the run
# ends. GnuPG's keyboxd holds a lock on its database while it runs
# (public-keys.d/pubring.db.lock), named by host name and process ID. One
# killed with a build root's PID namespace leaves that lock; under another
# host name (the installed system's, after the installer's build roots)
# GnuPG cannot tell it is stale, no key can be read and every key looks
# untrusted. gpgconf --unlock refuses a lock of another host, so
# keyring_open ends the build user's daemons and removes the locks they left
# (each a link to a "PID\nHOST\n" file of GnuPG's dotlock); keyring_close
# ends them, so that no lock is left.
keyring_open() {
    as_builder install -d -m 0700 "$home/.gnupg"
    as_builder gpgconf --kill all >/dev/null 2>&1 || true
    find "$home/.gnupg" -maxdepth 2 -type f \( -name '*.lock' -o -name '.#lk*' \) -delete
}
keyring_close() {
    as_builder gpgconf --kill all >/dev/null 2>&1 || true
}

# "NAME FINGERPRINT [NEEDED UPSTREAM SIGNED...]" lines: the keys not in the
# build user's keyring are written down for the caller (handover/untrusted-
# keys: NAME FINGERPRINT; with --check-keys, sources_out too: what a person
# checks each with); keys_stop ends the run if there was one. It only looks
# keys up: none is fetched, imported or trusted here.
untrusted=0
sources_out=
aur_runner=() # what aur_keys runs its lookup with (--check-keys: the build user, in locachy-net)
check_keys() {
    local name key needed upstream signed
    while read -r name key needed upstream signed; do
        [ -n "$key" ] || continue
        [[ "$key" =~ ^[[:xdigit:]]{40}$ || "$key" =~ ^[[:xdigit:]]{64}$ ]] ||
            die "$name: invalid source PGP fingerprint $key (validpgpkeys takes full fingerprints)"
        key=${key^^}
        if ! as_builder gpg --batch --list-keys "$key" >/dev/null 2>&1; then
            printf '%s %s\n' "$name" "$key" >>"$handover/untrusted-keys"
            [ -z "$sources_out" ] || printf '%s\t%s\t%s\t%s\t%s\n' "${needed:-$name}" "$name" "$key" \
                "${upstream:--}" "${signed:--}" >>"$sources_out"
            untrusted=1
        fi
    done
}
keys_stop() {
    [ "$untrusted" = 0 ] || exit 3
}
# The validpgpkeys of the AUR packages NAME... and of those of their
# dependencies the AUR has to give (neither installed nor in a repository),
# from each one's .SRCINFO: "BASE FINGERPRINT NEEDED UPSTREAM SIGNED..." lines
# (NEEDED: those of NAME... it is needed for, comma-separated; UPSTREAM: the
# recipe's url; SIGNED: its signed sources; "-": none). What the AUR says is
# shown to a person as it is, printable characters only.
aur_keys() {
    "${aur_runner[@]}" python3 -I - "$@" <<'PY'
import json, os, re, subprocess, sys, urllib.parse, urllib.request
# Installation queries use fresh private sync databases, never the live
# system's installed set: a dependency present on the medium may be built
# from the AUR on the target.
installation = len(sys.argv) > 1 and sys.argv[1] == '--installation-db'
config = db = source = ''
if installation:
    config, db, source = sys.argv[2:5]
    sys.argv = [sys.argv[0]] + sys.argv[5:]
def found(*cmd):
    if installation and cmd[:2] == ('pacman', '-T'):
        return False
    if installation and cmd[:2] == ('pacman', '-Sp'):
        cmd = ('pacman', '--config', config, '--dbpath', db, '-Sp', '--', *cmd[2:])
    return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
def get(url):
    with urllib.request.urlopen(url, timeout=30) as r:
        return r.read().decode("utf-8", "replace")
def info(batch):
    return json.loads(get("https://aur.archlinux.org/rpc/v5/info?" +
                          urllib.parse.urlencode([("arg[]", n) for n in batch])))["results"]
def shown(text):
    text = "".join(c for c in text if c.isprintable() and not c.isspace())[:300]
    return text or "-"
# Repository packages need no source build. Tracked overlays do: inspect
# their validated, version-locked metadata too, not an AUR namesake.
local, local_info = {}, {}
if installation:
    from pathlib import Path
    import importlib.util, tempfile
    spec = importlib.util.spec_from_file_location('locachy_upstream', Path(source) / 'link/locachy_upstream.py')
    upstream = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(upstream)
    for metadata in (Path(source) / 'pkgbuilds').glob('*/upstream.json'):
        local[metadata.parent.name] = json.loads(metadata.read_text())
    requested = []
    for name in sys.argv[1:]:
        if name in local:
            package = local[name]['package']
            # The raw extra DB preserves the stable authority even when a
            # newer optimized package wins the merged repository view.
            raw = str(Path(db).parent / 'raw')
            details = subprocess.run(['pacman', '--config', config, '--dbpath', raw, '-Si', 'extra/' + package],
                                     check=True, capture_output=True, text=True, env=dict(os.environ, LC_ALL='C')).stdout
            version = re.search(r'^Version\s*:\s*(\S+)', details, re.M)
            if not version:
                raise RuntimeError('no stable metadata for tracked package: ' + name)
            with tempfile.TemporaryDirectory(prefix='locachy-key-recipe-') as state:
                lock = upstream.prepare_candidate(name, Path(source) / 'pkgbuilds' / name,
                         'extra', version[1], state, stable_version=version[1])
                local_info[name] = upstream.read_srcinfo((lock.parent / 'upstream/.SRCINFO').read_bytes())
        elif not found('pacman', '-Sp', name):
            requested.append(name)
else:
    requested = sys.argv[1:]
roots = {n: {n} for n in requested}
for name, fields in local_info.items():
    for kind in ('depends', 'makedepends', 'checkdepends'):
        for dep in fields.get(kind, []) + fields.get(kind + '_x86_64', []):
            if not found('pacman', '-Sp', dep):
                dep = re.split(r'[<>=]', dep, maxsplit=1)[0]
                roots.setdefault(dep, set()).add(name)
                requested.append(dep)
seen, bases, base_of, todo = set(), {}, {}, list(requested)
while todo:
    batch = sorted(set(todo) - seen)
    todo = []
    if not batch:
        break
    seen |= set(batch)
    answers = info(batch)
    if installation and set(batch) - {p['Name'] for p in answers}:
        raise RuntimeError('the AUR returned no recipe for: ' + ', '.join(sorted(set(batch) - {p['Name'] for p in answers})))
    for pkg in answers:
        name, base = pkg["Name"], pkg["PackageBase"]
        base_of[name] = base
        bases.setdefault(base, set()).update(roots.get(name, {name}))
        for dep in pkg.get("Depends", []) + pkg.get("MakeDepends", []) + pkg.get("CheckDepends", []):
            if not found("pacman", "-T", dep) and not found("pacman", "-Sp", dep):
                dep = re.split(r"[<>=]", dep, maxsplit=1)[0]
                roots.setdefault(dep, set()).update(roots.get(name, {name}))
                if dep in base_of:
                    bases[base_of[dep]].update(roots[dep])
                todo.append(dep)
for name, fields in sorted(local_info.items()):
    url = shown(fields.get('url', ['-'])[0])
    signed = [shown(value) for key, values in fields.items() if re.fullmatch(r'source(_[A-Za-z0-9_]+)?', key)
              for value in values if re.search(r'\.(sig|asc|sign)$|[?&]signed$', value)]
    for key in fields.get('validpgpkeys', []):
        print(name, key, name, url, ' '.join(signed) or '-')
for base in sorted(bases):
    keys, url, signed, in_base = [], "-", [], True
    for line in get("https://aur.archlinux.org/cgit/aur.git/plain/.SRCINFO?h=" + urllib.parse.quote(base)).splitlines():
        in_base = in_base and not line.startswith("pkgname = ")  # the recipe's own url is pkgbase's
        key, _, value = line.strip().partition(" = ")
        value = value.strip()
        if key == "validpgpkeys":
            keys.append(value)
        elif key == "url" and in_base:
            url = shown(value)
        elif re.fullmatch(r"source(_[A-Za-z0-9_]+)?", key) and \
                (re.search(r"\.(sig|asc|sign)$", value) or re.search(r"[?&]signed$", value)):
            signed.append(shown(value))
    for value in keys:
        print(shown(base), value, ",".join(sorted(bases[base])), url, " ".join(signed) or "-")
PY
}

defer_jobserver() {
    printf 'locachy-build: %s: serial build required: %s\n' "$name" "$*" >&2
    exit 76
}

check_jobserver() {
    local features version
    # Use the tools installed in this target, as seen by the build user.
    as_builder test -r "$root_jobserver" && as_builder test -w "$root_jobserver" ||
        die "build user cannot read and write the mounted jobserver FIFO"
    if grep -Eq '^[[:space:]]*options(_[[:alnum:]_]+)?[[:space:]]*=[[:space:]]*!makeflags[[:space:]]*$' /run/locachy-local.srcinfo; then
        defer_jobserver 'the recipe disables MAKEFLAGS'
    fi
    # Do not override an explicit makepkg configuration opt-out.
    local flags_option
    flags_option=$(as_builder bash -c '
        source /usr/share/makepkg/util/config.sh
        source /usr/share/makepkg/util/option.sh
        source_makepkg_config /etc/makepkg.conf >/dev/null
        if check_option makeflags n; then printf disabled; fi
    ') || die 'could not check makepkg jobserver configuration'
    [ "$flags_option" != disabled ] || defer_jobserver 'makepkg configuration disables MAKEFLAGS'
    # Only audited tracked recipes can use the pool. Neither GNU Make nor
    # Ninja joins it if the recipe forces its own -j; the known MuPDF -j1
    # is safe and is not changed here.
    case "$name" in
        libmupdf|libpaper)
            features=$(as_builder /usr/bin/make --no-print-directory -f - <<'MAKE'
probe:
	@printf '%s\n' '$(.FEATURES)'
MAKE
            ) || defer_jobserver 'could not query target GNU Make features'
            [[ " $features " == *' jobserver-fifo '* ]] || defer_jobserver 'target GNU Make lacks FIFO jobserver support'
            ;;
        labwc-locachy|libinput|libinput-tools)
            version=$(as_builder /usr/bin/ninja --version) || defer_jobserver 'could not query target Ninja version'
            [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && [ "$(vercmp "$version" 1.13.0)" -ge 0 ] ||
                defer_jobserver "target Ninja $version lacks supported FIFO jobserver (need 1.13 or newer)"
            ;;
        *) defer_jobserver 'recipe is not approved for the shared jobserver' ;;
    esac
}

if [ "${LOCACHY_BUILD_STAGE:-}" = chroot ]; then
    if [ "${1:-}" = --run ]; then
        shift
        cd "$home"
        exec setpriv --reuid="$user" --regid="$user" --init-groups --reset-env "$@"
    fi
    uid=$(id -u "$user")
    gid=$(id -g "$user")
    tool=$(command -v pikaur || command -v pikaur-static || true)
    # One keyring checks every source signature: the build user's, which
    # --trust-key keeps. pikaur run as root would take pacman's
    # (/etc/pacman.d/gnupg, the packages' signers) unless told this one.
    if [ "${1:-}:${2:-}" != --validate-prepared:--regression ]; then
        keyring_open
        trap keyring_close EXIT
    fi
    keyring=(--build-gpgdir "$home/.gnupg")
    if [ -n "$prepare" ]; then
        # Every candidate starts from the same repository target. Only this
        # disposable root temporarily lacks the old local and AUR packages to
        # rebuild; dependents stay installed and all exact replacements are
        # restored together before tests.
        base_started=$SECONDS
        echo "== locachy-build: preparing the pinned repository base"
        local_names=()
        while read -r name; do [ -z "$name" ] || local_names+=("$name"); done < <(python3 -I - "$prepare/plan.json" <<'PY'
import json, re, sys
with open(sys.argv[1]) as f: data = json.load(f)
names = sorted(set(data.get('recipes', {})) | set(data.get('aur', {})))
if not names or any(not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9@._+\-]*', n) for n in names):
    raise RuntimeError('invalid prepared package names')
print('\n'.join(names))
PY
        )
        [ "${#local_names[@]}" -gt 0 ] || die "prepared update has no package names"
        remove=()
        installed=$(pacman -Qq)
        for name in "${local_names[@]}"; do
            grep -Fxq "$name" <<<"$installed" && remove+=("$name")
        done
        # Bootstrap may still have the stock provider. It is not part of
        # the common base once its selected patched replacement is in plan.
        while read -r provider; do
            [ -n "$provider" ] || continue
            # Some pacman variants resolve a queried provider to its local
            # replacement; remove only exact installed identities.
            grep -Fxq "$provider" <<<"$installed" && remove+=("$provider")
        done < <(python3 -I - "$prepare/plan.json" <<'PY'
import json, sys
with open(sys.argv[1]) as f: recipes=json.load(f).get('recipes', {})
for name, entry in sorted(recipes.items()):
    provider=entry.get('candidate', {}).get('upstream_package')
    if provider and provider != name: print(provider)
PY
        )
        [ "${#remove[@]}" -eq 0 ] || pacman -Rdd --noscriptlet --noconfirm "${remove[@]}"
        ignored=$(IFS=,; echo "${local_names[*]}")
        # LOCachy generates its own initramfs after package reconciliation.
        assume=(--assume-installed initramfs)
        while read -r package; do
            [ -z "$package" ] || assume+=(--assume-installed "$package")
        done < <(python3 -I - "$prepare/plan.json" <<'PY'
import json, sys
with open(sys.argv[1]) as f: data=json.load(f)
for name, entry in sorted(data.get('recipes', {}).items()):
    candidate=entry.get('candidate', {})
    version=candidate.get('package_version')
    print(name + ('=' + version if version else ''))
    provider=candidate.get('upstream_package')
    if provider and provider != name:
        version=candidate.get('source_version')
        print(provider + ('=' + version if version else ''))
for name, entry in sorted(data.get('aur', {}).items()):
    version=entry.get('target_version') or entry.get('installed_version')
    print(name + ('=' + version if version else ''))
    for provide in entry.get('provides', ()):
        if provide:
            print(provide)
PY
        )
        pacman -Su --noscriptlet --noconfirm --ignore "$ignored" "${assume[@]}"
        # Declared packages the host lacks: the host's transaction installs
        # them with the candidates, so every build and contract root has them.
        declared=()
        while read -r package; do
            [ -z "$package" ] || declared+=("$package")
        done < <(python3 -I - "$prepare/plan.json" <<'PY'
import json, re, sys
with open(sys.argv[1]) as f: names = json.load(f).get('missing', [])
if any(not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9@._+\-]*', n) for n in names):
    raise RuntimeError('invalid declared package names')
for name in names: print(name)
PY
        )
        [ "${#declared[@]}" -eq 0 ] || pacman -S --needed --noscriptlet --noconfirm "${assume[@]}" "${declared[@]}"
        pacman -Q >"${LOCACHY_BUILD_BASE_MANIFEST:-$handover/target-base-packages.txt}"
        echo "== locachy-build: pinned repository base ready ($((SECONDS - base_started)) s)"
    fi
    [ "${1:-}" != --validate-prepared ] || exit 0
    if [ "${1:-}" = --aur ]; then
        [ -n "$prepare" ] || die "--aur requires --prepare"
        name=${2:?AUR package name required}
        [ -n "$tool" ] || die "prepared AUR rebuild requires pikaur: $name"
        # The local candidates of this batch and any earlier AUR dependencies
        # were sealed before this AUR build. Installing them here lets the AUR
        # package link the exact new libraries and avoids rebuilding a planned
        # AUR dependency twice.
        candidates=()
        while read -r candidate; do [ -z "$candidate" ] || candidates+=("$candidate"); done < <(python3 -I - "$prepare/plan.json" "$name" "${LOCACHY_BUILD_BASE_MANIFEST:-$handover/target-base-packages.txt}" <<'PY'
import hashlib, json, os, sys
plan_path, current, base_path = sys.argv[1:4]
prepare = os.path.dirname(plan_path)
with open(plan_path) as f: data = json.load(f)
with open(base_path, 'rb') as f: base_sha = hashlib.file_digest(f, 'sha256').hexdigest()
seen = set()
def emit(pkg_dir, artifact_path):
    full = os.path.join(prepare, 'prepared', pkg_dir, os.path.basename(artifact_path))
    if full not in seen:
        seen.add(full)
        print(full)
for name in sorted(data.get('recipes', {})):
    item = os.path.join(prepare, 'prepared', name, 'build.json')
    if not os.path.isfile(item):
        raise RuntimeError(name + ': local candidate is not sealed before the AUR build')
    with open(item) as f: info = json.load(f)
    emit(name, info['artifact'])
for name in sorted(data.get('aur', {})):
    if name == current:
        continue
    item = os.path.join(prepare, 'prepared', name, 'build.json')
    if not os.path.isfile(item):
        continue
    with open(item) as f: info = json.load(f)
    if info.get('source_host_sha256') != data.get('host_sha256') or info.get('target_base_sha256') != base_sha:
        continue
    for extra in info.get('extra_artifacts', []):
        emit(name, extra['artifact'])
    emit(name, info['artifact'])
PY
